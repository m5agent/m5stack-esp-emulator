+.unit-readout-rail { position: relative; box-sizing: border-box; padding: var(--m5-space-m); background: var(--m5-surface-subtle); border-top: 1px solid var(--m5-line); color: var(--m5-ink); text-align: left; touch-action: pan-y; user-select: text; -webkit-user-select: text; }
