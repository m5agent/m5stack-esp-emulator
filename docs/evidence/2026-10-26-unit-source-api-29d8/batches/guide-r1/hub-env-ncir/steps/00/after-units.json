              "heater-off": "0x3066"
            },
            "response": "T[15:8],T[7:0],CRC,RH[15:8],RH[7:0],CRC",
            "warning": "Current driver comment mentions 0x2C06 but executable MEASURE_CMD is 0x2C10."
          },
