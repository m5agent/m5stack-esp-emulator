{"device_id": "cores3", "files": {"boot.py": "_uiflow_run_main = True\n", "control_drivers/__init__.py": "# Exact official driver sources for guest controller regression.\n", "control_drivers/encoder8.py": "# SPDX-FileCopyrightText: 2024 M5Stack Technology CO LTD\n#\n# SPDX-License-Identifier: MIT\n\nfrom machine import I2C\nimport struct\nfrom .pahub import PAHUBUnit\nfrom .unit_helper import UnitError\nimport time\n\n\nclass ENCODER8Unit:\n    \"\"\"\n    note:\n        en: UNIT 8Encoder is a set of 8 rotary encoders as one of the input unit, the internal use of STM32 single-chip microcomputer as the acquisition and communication processor, and the host computer using I2C communication interface, each rotary encoder corresponds to 1 RGB LED light, encoder in addition to left and right rotation, but also radially pressed, in addition to a physical toggle switch and its corresponding RGB LED light, including 5V->3V3 DCDC circuit.\n\n    details:\n        link: https://docs.m5stack.com/en/unit/8Encoder\n        image: https://static-cdn.m5stack.com/resource/docs/products/unit/8Encoder/img-f745fc18-6237-4bc8-8500-6c91ce7e2d75.webp\n        category: Unit\n\n    example:\n        - ../../../examples/unit/encoder8/encoder8_cores3_example.py\n\n    m5f2:\n        - unit/encoder8/encoder8_cores3_example.m5f2\n    \"\"\"\n\n    _ENCODER8_ADDR = 0x41\n\n    _ENCODER_CNT_START_REG = 0x00\n    _ENCODER_CNT_END_REG = 0x1F\n    _ENCODER_INC_START_REG = 0x20\n    _ENCODER_INC_END_REG = 0x3F\n    _ENCODER_CNT_RST_START_REG = 0x40\n    _ENCODER_CNT_RST_END_REG = 0x47\n    _ENCODER_BUTTON_START_REG = 0x50\n    _ENCODER_BUTTON_END_REG = 0x57\n    _ENCODER_SWITCH_REG = 0x60\n    _ENCODER_RGB_START_REG = 0x70\n    _ENCODER_RGB_END_REG = 0x8A\n    _ENCODER_FW_VER_REG = 0xFE\n    _ENCODER_I2C_ADDR_REG = 0xFF\n    _ENCODER_TOTAL_LED = 9\n\n    def __init__(\n        self,\n        i2c: I2C | PAHUBUnit,\n        slave_addr: int = _ENCODER8_ADDR,\n        address: int | list | tuple = 0x41,\n    ) -> None:\n        \"\"\"\n        note:\n            en: Initialize the Encoder8 Unit with the specified I2C interface and address.\n\n        params:\n            i2c:\n                note: The I2C interface or PAHUBUnit instance for communication.\n            slave_addr:\n                note: Deprecated parameter, kept for backward compatibility.\n            address:\n                note: The I2C address of the Encoder8 Unit. Default is 0x41.\n        \"\"\"\n        address = slave_addr\n        self.encoder8_i2c = i2c\n        self.init_i2c_address(address)\n\n    def init_i2c_address(self, slave_addr: int = _ENCODER8_ADDR) -> None:\n        \"\"\"\n        note:\n            en: Set or change the I2C address of the Encoder8 Unit.\n\n        params:\n            slave_addr:\n                note: The new I2C address to set. Range: 1 to 127.\n        \"\"\"\n        if slave_addr >= 1 and slave_addr <= 127:\n            self.i2c_addr = slave_addr\n        self.available()\n\n    def available(self) -> None:\n        \"\"\"\n        note:\n            en: Check if the Encoder8 Unit is connected on the I2C bus.\n\n        params:\n            note:\n        \"\"\"\n        if self.i2c_addr in self.encoder8_i2c.scan():\n            pass\n        else:\n            raise UnitError(\"Encoder 8 unit maybe not connect\")\n\n    def get_counter_value(self, channel: int = 1) -> int:\n        \"\"\"\n        note:\n            en: Get the current counter value of the specified channel.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n\n        returns:\n            note: The current counter value as an integer.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel *= 4\n        if not (channel >= self._ENCODER_CNT_START_REG and channel <= self._ENCODER_CNT_END_REG):\n            channel = self._ENCODER_CNT_START_REG\n        buf = self.read_reg_data(channel, 4)\n        return struct.unpack(\"<i\", buf)[0]\n\n    def set_counter_value(self, channel: int = 1, value: int = 0) -> None:\n        \"\"\"\n        note:\n            en: Set the counter value for the specified channel.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n            value:\n                note: The counter value to set.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel *= 4\n        if not (channel >= self._ENCODER_CNT_START_REG and channel <= self._ENCODER_CNT_END_REG):\n            channel = self._ENCODER_CNT_START_REG\n        self.write_reg_data(channel, struct.pack(\"<i\", value))\n\n    def get_increment_value(self, channel: int = 1) -> int:\n        \"\"\"\n        note:\n            en: Get the incremental value of the specified channel.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n\n        returns:\n            note: The incremental value as an integer.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel = self._ENCODER_INC_START_REG + (channel * 4)\n        if not (channel >= self._ENCODER_INC_START_REG and channel <= self._ENCODER_INC_END_REG):\n            channel = self._ENCODER_INC_START_REG\n        buf = self.read_reg_data(channel, 4)\n        return struct.unpack(\"<i\", buf)[0]\n\n    def reset_counter_value(self, channel: int = 1) -> None:\n        \"\"\"\n        note:\n            en: Reset the counter value for the specified channel.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel += self._ENCODER_CNT_RST_START_REG\n        if not (\n            channel >= self._ENCODER_CNT_RST_START_REG and channel <= self._ENCODER_CNT_RST_END_REG\n        ):\n            channel = self._ENCODER_CNT_RST_START_REG\n        self.write_reg_data(channel, [0x01])\n\n    def get_button_status(self, channel: int = 1) -> bool:\n        \"\"\"\n        note:\n            en: Get the button status for the specified channel.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n\n        returns:\n            note: True if the button is pressed, False otherwise.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel += self._ENCODER_BUTTON_START_REG\n        if not (\n            channel >= self._ENCODER_BUTTON_START_REG and channel <= self._ENCODER_BUTTON_END_REG\n        ):\n            channel = self._ENCODER_BUTTON_START_REG\n        return self.read_reg_data(channel, 1)[0] == 0\n\n    def get_switch_status(self) -> bool:\n        \"\"\"\n        note:\n            en: Get the status of the global switch.\n\n        params:\n            note:\n\n        returns:\n            note: True if the switch is on, False otherwise.\n        \"\"\"\n        return bool(self.read_reg_data(self._ENCODER_SWITCH_REG, 1)[0])\n\n    def set_led_rgb(self, channel: int = 1, rgb: int = 0) -> None:\n        \"\"\"\n        note:\n            en: Set the RGB color of the specified channel's LED.\n\n        params:\n            channel:\n                note: The encoder channel (1-8). Default is 1.\n            rgb:\n                note: The RGB color value (0-0xFFFFFF). Default is 0.\n        \"\"\"\n        channel = min(8, max(channel, 1)) - 1\n        channel = self._ENCODER_RGB_START_REG + (channel * 3)\n        if not (channel >= self._ENCODER_RGB_START_REG and channel <= self._ENCODER_RGB_END_REG):\n            channel = self._ENCODER_RGB_START_REG\n        self.write_reg_data(channel, rgb.to_bytes(3, \"big\"))\n\n    def set_led_rgb_from(self, begin: int = 0, end: int = 0, rgb: int = 0) -> None:\n        \"\"\"\n        note:\n            en: Set the RGB color for a range of channels' LEDs.\n\n        params:\n            begin:\n                note: The starting channel index. Default is 0.\n            end:\n                note: The ending channel index. Default is 0.\n            rgb:\n                note: The RGB color value (0-0xFFFFFF). Default is 0.\n        \"\"\"\n        begin = min(self._ENCODER_TOTAL_LED, max(begin, 0))\n        end = min(self._ENCODER_TOTAL_LED, max(end, 0))\n        for i in range(begin, end + 1):\n            self.set_led_rgb(i, rgb)\n\n    def get_device_status(self, mode: int = 0xFE) -> int:\n        \"\"\"\n        note:\n            en: Get the device firmware version or I2C address.\n\n        params:\n            mode:\n                note: The mode to read. 0xFE for firmware version, 0xFF for I2C address. Default is 0xFE.\n\n        returns:\n            note: The value read from the specified mode register.\n        \"\"\"\n        if mode >= self._ENCODER_FW_VER_REG and mode <= self._ENCODER_I2C_ADDR_REG:\n            return self.read_reg_data(mode, 1)[0]\n\n    def set_i2c_address(self, addr: int = 0x41) -> None:\n        \"\"\"\n        note:\n            en: Set a new I2C address for the device.\n\n        params:\n            addr:\n                note: The new I2C address. Default is 0x41.\n        \"\"\"\n        if addr >= 0x08 and addr <= 0x77:\n            if addr != self.i2c_addr:\n                self.write_reg_data(self._ENCODER_I2C_ADDR_REG, [addr])\n                self.i2c_addr = addr\n                time.sleep_ms(50)\n\n    def read_reg_data(self, reg: int = 0, num: int = 0) -> bytearray:\n        \"\"\"\n        note:\n            en: Read data from a specified register.\n\n        params:\n            reg:\n                note: The register address to read from.\n            num:\n                note: The number of bytes to read.\n\n        returns:\n            note: The requested value as an integer.\n        \"\"\"\n        buf = bytearray(1)\n        buf[0] = reg\n        time.sleep_ms(1)\n        self.encoder8_i2c.writeto(self.i2c_addr, buf)\n        buf = bytearray(num)\n        self.encoder8_i2c.readfrom_into(self.i2c_addr, buf)\n        return buf\n\n    def write_reg_data(self, reg, byte_lst):\n        \"\"\"\n        note:\n            en: Write data to a specified register.\n\n        params:\n            reg:\n                note: The register address to write to.\n            byte_lst:\n                note: A list of bytes to write to the register.\n        \"\"\"\n        buf = bytearray(1 + len(byte_lst))\n        buf[0] = reg\n        buf[1:] = bytes(byte_lst)\n        time.sleep_ms(1)\n        self.encoder8_i2c.writeto(self.i2c_addr, buf)\n\n    def deinit(self):\n        \"\"\"\n        note:\n            en: Deinitialize the Encoder8 Unit instance.\n\n        params:\n            note:\n        \"\"\"\n        pass\n\n\nclass Encoder8Unit(ENCODER8Unit):\n    def __init__(\n        self, i2c: I2C | PAHUBUnit, address: int | list | tuple = ENCODER8Unit._ENCODER8_ADDR\n    ) -> None:\n        super().__init__(i2c, slave_addr=address)\n", "control_drivers/pahub.py": "# SPDX-FileCopyrightText: 2024 M5Stack Technology CO LTD\n#\n# SPDX-License-Identifier: MIT\nfrom machine import I2C\nfrom micropython import const\nimport time\nimport sys\n\nif sys.platform != \"esp32\":\n    from typing import Literal\n\n\nPAHUB_CHN0 = const(0)\nPAHUB_CHN1 = const(1)\nPAHUB_CHN2 = const(2)\nPAHUB_CHN3 = const(3)\nPAHUB_CHN4 = const(4)\nPAHUB_CHN5 = const(5)\n\nPAHUB_DEFAULT_ADDR = const(0x70)\n\n\nclass PAHUBUnit:\n    _i2c = None\n    _chn = -1\n    _addr = PAHUB_DEFAULT_ADDR\n\n    def __init__(\n        self, i2c: I2C, address=PAHUB_DEFAULT_ADDR, channel: Literal[0, 1, 2, 3, 4, 5] = 0\n    ) -> None:\n        self._i2c = i2c\n        self._chn = channel\n        self._addr = address\n\n    def select_channel(self, channel: int) -> None:\n        buf = bytearray(1)\n        buf[0] = self._i2c.readfrom(self._addr, 1)[0] | (1 << channel)\n        self._i2c.writeto(self._addr, buf)\n\n    def release_channel(self, channel: int) -> None:\n        buf = bytearray(1)\n        buf[0] = self._i2c.readfrom(self._addr, 1)[0] & (~(1 << channel))\n        self._i2c.writeto(self._addr, buf)\n\n    def deinit(self) -> None:\n        self.release_channel(self._chn)\n\n    def scan(self, *args, **kwargs) -> list[int]:\n        self.select_channel(self._chn)\n        result = self._i2c.scan(*args, **kwargs)\n        self.release_channel(self._chn)\n        return result\n\n    def start(self) -> None:\n        self.select_channel(self._chn)\n        self._i2c.start()\n        self.release_channel(self._chn)\n\n    def stop(self) -> None:\n        self.select_channel(self._chn)\n        self._i2c.stop()\n        self.release_channel(self._chn)\n\n    def readinto(self, buf, nack: bool = True) -> None:\n        self.select_channel(self._chn)\n        self._i2c.readinto(buf, nack)\n        self.release_channel(self._chn)\n\n    def write(self, buf) -> int:\n        self.select_channel(self._chn)\n        result = self._i2c.write(buf)\n        self.release_channel(self._chn)\n        return result\n\n    def readfrom(self, addr: int, nbytes: int, *args, **kwargs) -> bytes:\n        self.select_channel(self._chn)\n        result = self._i2c.readfrom(addr, nbytes, *args, **kwargs)\n        self.release_channel(self._chn)\n        return result\n\n    def readfrom_into(self, addr: int, buf, *args, **kwargs) -> None:\n        self.select_channel(self._chn)\n        self._i2c.readfrom_into(addr, buf, *args, **kwargs)\n        self.release_channel(self._chn)\n\n    def writeto(self, addr: int, buf, *args, **kwargs) -> int:\n        self.select_channel(self._chn)\n        result = self._i2c.writeto(addr, buf, *args, **kwargs)\n        time.sleep_ms(100)\n        self.release_channel(self._chn)\n        return result\n\n    def writevto(self, addr: int, vector, *args, **kwargs) -> int:\n        self.select_channel(self._chn)\n        result = self._i2c.writevto(addr, vector, *args, **kwargs)\n        self.release_channel(self._chn)\n        return result\n\n    def readfrom_mem(self, addr: int, memaddr: int, nbytes: int, *args, **kwargs) -> bytes:\n        self.select_channel(self._chn)\n        result = self._i2c.readfrom_mem(addr, memaddr, nbytes, *args, **kwargs)\n        self.release_channel(self._chn)\n        return result\n\n    def readfrom_mem_into(self, addr: int, memaddr: int, buf, *args, **kwargs) -> None:\n        self.select_channel(self._chn)\n        self._i2c.readfrom_mem_into(addr, memaddr, buf, *args, **kwargs)\n        self.release_channel(self._chn)\n\n    def writeto_mem(self, addr: int, memaddr: int, buf, *args, **kwargs) -> None:\n        self.select_channel(self._chn)\n        self._i2c.writeto_mem(addr, memaddr, buf, *args, **kwargs)\n        self.release_channel(self._chn)\n", "control_drivers/unit_helper.py": "# SPDX-FileCopyrightText: 2024 M5Stack Technology CO LTD\n#\n# SPDX-License-Identifier: MIT\n\n\nclass UnitError(Exception):\n    pass\n", "host_control_layout.py": "FONT_NAME = \"Montserrat12\"\nDISPLAY_PROFILES = {\n    \"atoms3r\": {\"native\": (128, 128), \"canvas\": (128, 128), \"text\": (4, 4, 120),\n                 \"text_size\": 0.7, \"font_height\": 10},\n    \"sticks3\": {\"native\": (135, 240), \"canvas\": (135, 240), \"text\": (4, 4, 127),\n                \"text_size\": 1.0, \"font_height\": 15},\n    \"stopwatch\": {\"native\": (466, 466), \"canvas\": (468, 468), \"text\": (110, 45, 246),\n                  \"text_size\": 2.0, \"font_height\": 30},\n}\n\n\ndef value_lines(case, value):\n    if case == \"joystick-v11\":\n        return (\"x %d\" % value[0], \"y %d\" % value[1], \"button %d\" % value[2])\n    if case == \"encoder\":\n        return (\"count %d\" % value[0], \"pressed %d\" % value[1])\n    if case == \"8encoder\":\n        counts, pressed, switch = value\n        return tuple(\"%d %d\" % (index + 1, count) for index, count in enumerate(counts)) + (\n            \"P \" + \"\".join(str(bit) for bit in pressed), \"SW %d\" % switch)\n    if case == \"cardkb\":\n        return (\"key %d\" % value,)\n    if value is None:\n        return (\"No card\",)\n    return (\"UID\",) + tuple(value[index:index + 10] for index in range(0, len(value), 10))\n\n\ndef worst_value(case):\n    return {\n        \"joystick-v11\": (255, 255, 1),\n        \"encoder\": (-32768, 1),\n        \"8encoder\": ([-2147483648] * 8, [1] * 8, 1),\n        \"cardkb\": 255,\n        \"rfid2\": \"04010203040506070809\",\n    }[case]\n\n\ndef checked_layout(device_id, case, font_height, text_width):\n    \"\"\"Use runtime fontHeight/textWidth; never infer a glyph from its name.\"\"\"\n    profile = DISPLAY_PROFILES[device_id]\n    if font_height != profile[\"font_height\"]:\n        raise RuntimeError(\"font metrics differ from the explicitly pinned UIFlow2 2.5.3 profile\")\n    x, y, width = profile[\"text\"]\n    combined = device_id + \" \" + case\n    headers = (combined,) if text_width(combined) <= width else (device_id, case)\n    lines = value_lines(case, worst_value(case))\n    if any(text_width(text) > width for text in headers + lines):\n        raise RuntimeError(\"actual font width exceeds native readout bounds\")\n    # fontHeight truncates scaled height. One extra pixel covers the fractional\n    # font-cell edge and keeps adjacent rows separate (10 -> 11 on Atom).\n    line_height = font_height + 1\n    body_y = y + len(headers) * line_height + 2\n    body_rows = 10 if case == \"8encoder\" else len(lines)\n    bottom = body_y + body_rows * line_height\n    native_width, native_height = profile[\"native\"]\n    if not (0 <= x < x + width <= native_width and 0 <= y < bottom <= native_height):\n        raise RuntimeError(\"native readout rectangle would be clipped\")\n    if device_id == \"stopwatch\":\n        # Check native 466px circular geometry, not the larger 468px canvas.\n        center, radius = native_width / 2, native_width / 2\n        if any((cx - center) ** 2 + (cy - center) ** 2 > radius ** 2\n               for cx in (x, x + width) for cy in (y, bottom)):\n            raise RuntimeError(\"readout rectangle leaves the native round display\")\n    return {\"x\": x, \"y\": y, \"width\": width, \"headers\": headers, \"font_height\": font_height,\n            \"line_height\": line_height, \"body_y\": body_y, \"body_rows\": body_rows, \"bottom\": bottom}\n\n\ndef print_checked(screen, layout, text, y):\n    if screen.textWidth(text) > layout[\"width\"]:\n        raise RuntimeError(\"actual readout text would wrap or clip\")\n    screen.setCursor(layout[\"x\"], y)\n    screen.print(text)\n", "main.py": "import time\nimport io\nimport sys\nfrom hardware import UART\nimport M5\nfrom machine import I2C, Pin\nfrom probe_config import CASE, WHITE, YELLOW\nfrom probe_display import prepare_display, draw_display\n\nlog_uart = None\n\n\ndef emit(*parts):\n    message = \" \".join(str(part) for part in parts)\n    print(message)\n    if log_uart is not None:\n        log_uart.write(message + \"\\r\\n\")\n\n\ndef run():\n    global log_uart\n    M5.begin()\n    log_uart = UART(0, baudrate=115200, tx=43, rx=44)\n    screen = M5.Display\n    layout = prepare_display(screen, CASE, emit)\n    bus = I2C(0, scl=Pin(WHITE), sda=Pin(YELLOW), freq=100000)\n    emit(\"CONTROL_I2C_SCAN\", [hex(value) for value in bus.scan()])\n\n    if CASE == \"joystick-v11\":\n        from control_drivers.joystick import JoystickUnit\n        unit = JoystickUnit(bus)\n    elif CASE == \"encoder\":\n        from control_drivers.encoder import EncoderUnit\n        unit = EncoderUnit(bus)\n        unit.set_color(0, 0)\n        unit.set_color(1, 0x112233)\n        unit.set_color(2, 0x445566)\n    elif CASE == \"8encoder\":\n        from control_drivers.encoder8 import Encoder8Unit\n        unit = Encoder8Unit(bus)\n        unit.set_counter_value(2, -1234567)\n        written = unit.get_counter_value(2)\n        unit.reset_counter_value(2)\n        reset = unit.get_counter_value(2)\n        emit(\"CONTROL_ENCODER8_REGISTER_WRITE\", written, reset)\n        for channel in range(1, 9):\n            unit.set_led_rgb(channel, channel * 0x010203)\n        # The current official helper clamps its LED argument to eight even though\n        # nine physical LEDs/register triplets exist. Exercise triplet nine directly.\n        bus.writeto_mem(0x41, 0x88, bytes([0x19, 0x29, 0x39]))\n        unit.set_i2c_address(0x42)\n        emit(\"CONTROL_ENCODER8_ADDRESS\", unit.get_device_status(0xFF))\n    elif CASE == \"cardkb\":\n        from control_drivers.cardkb import CardKBI2C\n        unit = CardKBI2C(bus)\n        emit(\"CONTROL_CARDKB_LEGACY\", int(not unit._v2_report_mode))\n    elif CASE == \"rfid2\":\n        from control_drivers.mfrc522 import MFRC522\n        unit = MFRC522(bus, 0x28)\n        unit.pcd_init()\n        crc = bytearray(2)\n        crc_status = unit.pcd_calculate_crc(b\"123456789\", crc)\n        emit(\"CONTROL_RFID_CRC_VECTOR\", int(crc_status == unit.STATUS_OK), crc.hex())\n    else:\n        raise ValueError(\"unknown control Unit\")\n\n    emit(\"CONTROL_PROBE_READY\", CASE)\n    previous = None\n    last_uid = None\n    last_at = time.ticks_ms()\n    while True:\n        M5.update()\n        if CASE == \"joystick-v11\":\n            value = (unit.get_x_raw(), unit.get_y_raw(), int(unit.get_button_status()))\n            marker = \"CONTROL_JOYSTICK %d %d %d\" % value\n        elif CASE == \"encoder\":\n            value = (unit._get_rotary_value(), int(unit.get_button_status()))\n            marker = \"CONTROL_ENCODER %d %d\" % value\n        elif CASE == \"8encoder\":\n            counts = [unit.get_counter_value(i) for i in range(1, 9)]\n            pressed = [int(unit.get_button_status(i)) for i in range(1, 9)]\n            increments = [unit.get_increment_value(i) for i in range(1, 9)]\n            switch = int(unit.get_switch_status())\n            value = (counts, pressed, switch)\n            marker = \"CONTROL_ENCODER8 %s %s %d INC %s\" % (counts, pressed, switch, increments)\n        elif CASE == \"cardkb\":\n            key = unit.get_key()\n            if key is not None:\n                emit(\"CONTROL_CARDKB_KEY\", key)\n                value = key\n                marker = \"CONTROL_CARDKB_LAST %d\" % key\n            else:\n                time.sleep_ms(10)\n                continue\n        else:\n            # The vendored official UID container never assigns .size. Read\n            # UID-size bits from the real ATQA response instead of patching the\n            # driver or borrowing the host's injected uid-hex length.\n            atqa = bytearray(2)\n            request = unit.picc_request_a(atqa)\n            present = request == unit.STATUS_OK or request == unit.STATUS_COLLISION\n            if present and unit.picc_read_card_serial():\n                uid_size = (4, 7, 10)[(atqa[0] >> 6) & 3]\n                uid = bytes(unit._uid.uid[:uid_size])\n                value = uid.hex()\n                marker = \"CONTROL_RFID_UID \" + value\n                if last_uid != uid:\n                    emit(marker)\n                    bad_crc, _, _ = unit.pcd_transceive_data(bytearray([0x30, 4, 0, 0]))\n                    emit(\"CONTROL_RFID_BAD_CRC\", int(bad_crc != unit.STATUS_OK))\n                    bad = unit.pcd_authenticate(0x60, 4, bytes([0] * 6), unit._uid)\n                    emit(\"CONTROL_RFID_BAD_KEY\", int(bad != unit.STATUS_OK))\n                    good = unit.pcd_authenticate(0x60, 4, bytes([0xFF] * 6), unit._uid)\n                    wrong_sector = unit.mifare_read(8, bytearray(16))\n                    emit(\"CONTROL_RFID_SECTOR_DENIED\", int(wrong_sector != unit.STATUS_OK))\n                    data = bytes([0x31 + i for i in range(16)])\n                    write = unit.mifare_write(4, data)\n                    read = bytearray(16)\n                    status = unit.mifare_read(4, read)\n                    emit(\"CONTROL_RFID_BLOCK\", int(good == unit.STATUS_OK), int(write == unit.STATUS_OK), int(status == unit.STATUS_OK), read.hex())\n                    unit.picc_halt_a()\n                    unit.pcd_stop_crypto1()\n                    denied = unit.mifare_read(4, bytearray(16))\n                    emit(\"CONTROL_RFID_HALT_DENIED\", int(denied != unit.STATUS_OK))\n                    unit.pcd_antenna_off()\n                    emit(\"CONTROL_RFID_ANTENNA_OFF\", int(not unit.picc_is_new_card_present()))\n                    unit.pcd_antenna_on()\n                    last_uid = uid\n            else:\n                value = None\n                marker = \"CONTROL_RFID_NO_CARD\"\n        if value != previous or time.ticks_diff(time.ticks_ms(), last_at) > 2000:\n            emit(marker)\n            draw_display(screen, layout, CASE, value)\n            previous = value\n            last_at = time.ticks_ms()\n        time.sleep_ms(120)\n\n\ntry:\n    run()\nexcept Exception as error:\n    emit(\"CONTROL_PROBE_ERROR\", repr(error))\n    trace = io.StringIO()\n    sys.print_exception(error, trace)\n    if log_uart is not None:\n        log_uart.write(trace.getvalue().replace(\"\\n\", \"\\r\\n\"))\n    raise\n", "probe_config.py": "CASE = '8encoder'\nWHITE = 1\nYELLOW = 2\n", "probe_display.py": "from host_control_layout import DISPLAY_PROFILES, FONT_NAME, checked_layout, print_checked, value_lines\nDISPLAY_PROFILES[\"cores3\"] = {\"native\": (320, 240), \"canvas\": (320, 240), \"text\": (6, 6, 308), \"text_size\": 1.0, \"font_height\": 15}\n\ndef prepare_display(screen, case, emit):\n    screen.setRotation(1)\n    screen.setBrightness(255)\n    screen.fillScreen(0xFFFFFF)\n    screen.setTextColor(0x0282CB, 0xFFFFFF)\n    screen.setFont(screen.FONTS.Montserrat12)\n    screen.setTextSize(1.0)\n    layout = checked_layout(\"cores3\", case, screen.fontHeight(), screen.textWidth)\n    emit(\"SOURCE_CONTROL_GEOMETRY\", screen.width(), screen.height(), 1)\n    emit(\"SOURCE_CONTROL_FONT\", FONT_NAME, 1.0, screen.fontHeight())\n    emit(\"SOURCE_CONTROL_LAYOUT\", layout[\"x\"], layout[\"y\"], layout[\"width\"], layout[\"body_y\"], layout[\"line_height\"], layout[\"body_rows\"], layout[\"bottom\"], len(layout[\"headers\"]))\n    if (screen.width(), screen.height()) != (320, 240):\n        raise RuntimeError(\"CoreS3 native display geometry differs\")\n    for index, text in enumerate(layout[\"headers\"]):\n        print_checked(screen, layout, text, layout[\"y\"] + index * layout[\"line_height\"])\n    return layout\n\ndef draw_display(screen, layout, case, value):\n    lines = value_lines(case, value)\n    if len(lines) > layout[\"body_rows\"]:\n        raise RuntimeError(\"Unit readout exceeds native display rows\")\n    screen.fillRect(layout[\"x\"], layout[\"body_y\"], layout[\"width\"], layout[\"body_rows\"] * layout[\"line_height\"], 0xFFFFFF)\n    for index, text in enumerate(lines):\n        print_checked(screen, layout, text, layout[\"body_y\"] + index * layout[\"line_height\"])\n"}, "expected_base_sha256": "1324f12d3ddd5392f47a9eff537f9ce0b01a8e6e36d829b6bd22cdf82d2c1264"}