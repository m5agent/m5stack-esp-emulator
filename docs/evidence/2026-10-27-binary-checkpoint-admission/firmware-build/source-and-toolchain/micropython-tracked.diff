+
+static SemaphoreHandle_t hosted_rx_mutex;
+static SemaphoreHandle_t hosted_host_exited;
+static bool hosted_rx_enabled;
+static bool hosted_controller_initialized;
+static bool hosted_controller_enabled;
+static bool hosted_host_stopped;
+
+// Linked with --wrap=hci_rx_handler. ESP-Hosted otherwise delivers packets
+// even after NimBLE's pools have been freed.
+int __real_hci_rx_handler(uint8_t *buf, size_t len);
+int __wrap_hci_rx_handler(uint8_t *buf, size_t len) {
+    if (hosted_rx_mutex == NULL) {
+        return ESP_OK;
+    }
+    xSemaphoreTake(hosted_rx_mutex, portMAX_DELAY);
+    int ret = hosted_rx_enabled ? __real_hci_rx_handler(buf, len) : ESP_OK;
+    xSemaphoreGive(hosted_rx_mutex);
+    return ret;
+}
+
+static int hosted_set_rx(bool enabled) {
+    if (xSemaphoreTake(hosted_rx_mutex, pdMS_TO_TICKS(2000)) != pdTRUE) {
+        return MP_ETIMEDOUT;
+    }
+    hosted_rx_enabled = enabled;
+    xSemaphoreGive(hosted_rx_mutex);
+    return 0;
+}
+
+int mp_bluetooth_nimble_port_init(void) {
+    if (hosted_rx_mutex == NULL) {
+        hosted_rx_mutex = xSemaphoreCreateMutex();
+    }
+    if (hosted_host_exited == NULL) {
+        hosted_host_exited = xSemaphoreCreateBinary();
+    }
+    if (hosted_rx_mutex == NULL || hosted_host_exited == NULL) {
+        return MP_ENOMEM;
+    }
+    if (esp_hosted_connect_to_slave() != ESP_OK) {
+        return MP_ETIMEDOUT;
+    }
+    if (!hosted_controller_initialized) {
+        if (esp_hosted_bt_controller_init() != ESP_OK) {
+            return MP_EIO;
+        }
+        hosted_controller_initialized = true;
+    }
+    if (!hosted_controller_enabled) {
+        if (esp_hosted_bt_controller_enable() != ESP_OK) {
+            return MP_EIO;
+        }
+        hosted_controller_enabled = true;
+    }
+    // No host task exists yet and RX is gated until all pools are ready.
+    if (nimble_port_init() != ESP_OK) {
+        // Do not permit a retry over a partially initialized host.
+        mp_bluetooth_nimble_ble_state = MP_BLUETOOTH_NIMBLE_BLE_STATE_STOPPING;
+        return MP_EIO;
+    }
+    hosted_host_stopped = false;
+    int ret = hosted_set_rx(true);
+    if (ret != 0) {
+        mp_bluetooth_nimble_ble_state = MP_BLUETOOTH_NIMBLE_BLE_STATE_STOPPING;
+    }
+    return ret;
+}
+#endif
