{"schema_version": 1, "units": [{"id": "env-iii", "name": "ENV III", "sku": "U001-C", "visual_asset": {"entry": "src/units/env-iii/index.js", "export": "GroveModule"}, "official_docs": "https://docs.m5stack.com/en/unit/envIII", "checked_at": "2026-10-26", "chips": [{"part": "SHT30", "status": "officially-documented"}, {"part": "QMP6988", "status": "officially-documented"}], "interface": {"bus": "i2c", "connector": "HY2.0-4P", "address_7bit": [68, 112], "pins": {"yellow": {"signal": "SDA", "direction": "bidirectional"}, "white": {"signal": "SCL", "direction": "bidirectional"}, "red": {"signal": "5V", "direction": "power"}, "black": {"signal": "GND", "direction": "ground"}}, "power": {"nominal_v": 5, "source": "official-product-PinMap", "logic_v": null, "logic_voltage_status": "do not derive GPIO logic voltage from the 5V supply label"}}, "protocol": {"status": "documented", "summary": "SHT30 uses 16-bit commands and six-byte T/RH responses with CRC8 per 16-bit word (poly 0x31, init 0xFF). QMP6988 requires chip identity, 25-byte calibration, configuration, status and compensated 24-bit pressure/temperature samples. ENVUnit pressure API returns hPa; the injected pressure-pa state uses Pa.", "registers": [{"chip": "SHT30", "commands": {"measure-driver": "0x2C10", "status": "0xF32D", "reset": "0x30A2", "clear-status": "0x3041", "heater-on": "0x306D", "heater-off": "0x3066"}, "response": "T[15:8],T[7:0],CRC,RH[15:8],RH[7:0],CRC", "warning": "Current driver comment mentions 0x2C06 but executable MEASURE_CMD is 0x2C10."}, {"chip": "QMP6988", "chip_id": "0xD1 -> 0x5C", "calibration": "0xA0, 25 bytes", "reset": "0xE0 <- 0xE6", "iir": "0xF1", "status": "0xF3 bit3 measuring", "control": "0xF4", "io_setup": "0xF5", "samples": "0xF7, pressure[3] then temperature[3], each unsigned 24-bit minus 2^23"}], "gaps": ["QMP6988 raw bytes must be consistent with calibration and compensation; do not substitute host-calculated API values.", "Fixture humidity permits the protocol range 0..100%RH; product accuracy specification is 10..90%RH."], "offline_reference": "platform/units/qmp6988_reference.py", "synthetic_calibration_fixture": "platform/units/fixtures/env-iii-qmp6988.json"}, "inputs": {"temperature-c": {"type": "number", "label": "温度", "default": 25, "default_source": "synthetic-test-fixture", "unit": "degC", "minimum": -40, "maximum": 120, "readOnly": false}, "humidity-pct": {"type": "number", "label": "相对湿度", "default": 50, "default_source": "synthetic-test-fixture", "unit": "%RH", "minimum": 0, "maximum": 100, "readOnly": false}, "pressure-pa": {"type": "number", "label": "气压", "default": 101325, "default_source": "synthetic-test-fixture", "unit": "Pa", "minimum": 30000, "maximum": 110000, "readOnly": false}}, "outputs": {}, "evidence": [{"kind": "official-product", "url": "https://docs.m5stack.com/en/unit/envIII", "checked_at": "2026-10-26", "claims": ["SKU and chip identity", "PinMap wire colors", "documented electrical and functional limits"]}, {"kind": "official-driver", "url": "https://raw.githubusercontent.com/m5stack/uiflow-micropython/master/m5stack/libs/unit/env.py", "checked_at": "2026-10-26", "claims": ["guest driver transaction path and encoding"], "sha256": "a93c1b9fa822c2d707edd16205e68cf842160594993a4061044976fe96e2cce5"}, {"kind": "official-driver", "url": "https://raw.githubusercontent.com/m5stack/uiflow-micropython/master/m5stack/libs/driver/sht30.py", "checked_at": "2026-10-26", "claims": ["guest driver transaction path and encoding"], "sha256": "7c8842ee297b2b50c888f2f28ab976e4cc1b1867078a4ffea5a9a68eae9db36d"}, {"kind": "official-driver", "url": "https://raw.githubusercontent.com/m5stack/uiflow-micropython/master/m5stack/libs/driver/qmp6988.py", "checked_at": "2026-10-26", "claims": ["guest driver transaction path and encoding"], "sha256": "48ea71495622173423fb296c846d6fcf371c6fa0646d92f764822519388b8d7d"}, {"kind": "official-linked-datasheet-or-schematic", "url": "https://m5stack.oss-cn-shenzhen.aliyuncs.com/resource/doc