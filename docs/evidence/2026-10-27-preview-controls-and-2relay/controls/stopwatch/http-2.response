ignal": "GND", "direction": "ground"}}, "power": {"nominal_v": 5, "source": "official-product-PinMap", "logic_v": null, "logic_voltage_status": "do not derive GPIO logic voltage from the 5V supply label"}}, "protocol": {"status": "documented", "summary": "Eight encoder channels and nine RGB outputs (eight encoder LEDs plus switch LED). Counter and increment registers are signed 32-bit little-endian; buttons are active low. A global toggle and firmware/address registers are exposed.", "registers": [{"counter": "0x00..0x1F, int32 LE per channel", "increment": "0x20..0x3F, int32 LE", "reset": "0x40..0x47", "button": "0x50..0x57, 0=pressed", "switch": "0x60", "rgb": "0x70..0x8A, 3 RGB bytes per LED, 9 total", "firmware": "0xFE", "address": "0xFF"}], "gaps": ["Increment clear-on-read, wraparound, reset and address-change persistence need internal firmware confirmation."]}, "inputs": {"counters": {"type": "array", "label": "八通道计数", "default": [0, 0, 0, 0, 0, 0, 0, 0], "default_source": "synthetic-test-fixture", "items": {"type": "integer", "minimum": -2147483648, "maximum": 2147483647}, "minItems": 8, "maxItems": 8, "readOnly": false}, "pressed": {"type": "array", "label": "八通道按下", "default": [false, false, false, false, false, false, false, false], "default_source": "synthetic-test-fixture", "items": {"type": "boolean"}, "minItems": 8, "maxItems": 8, "readOnly": false}, "switch-on": {"type": "boolean", "label": "拨动开关", "default": false, "default_source": "synthetic-test-fixture", "readOnly": false}}, "outputs": {"led-rgb": {"type": "array", "label": "九颗灯颜色", "default": [0, 0, 0, 0, 0, 0, 0, 0, 0], "default_source": "synthetic-test-fixture", "items": {"type": "integer", "minimum": 0, "maximum": 16777215}, "minItems": 9, "maxItems": 9, "readOnly": true}}, "evidence": [{"kind": "official-product", "url": "https://docs.m5stack.com/en/unit/Unit_8Encoder", "checked_at": "2026-10-26", "claims": ["SKU and chip identity", "PinMap wire colors", "documented electrical and functiona