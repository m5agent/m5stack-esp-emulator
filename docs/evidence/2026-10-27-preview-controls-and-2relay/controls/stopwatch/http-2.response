splay-gen9-a8fe/batches/stopwatch/stopwatch/8encoder/normalization-receipt.json", "normalization_receipt_sha256": "772602606bdd88d7d5fbcfacae5024578ce8965ebb058d53cb5689f03e1145cf", "hardware": "NOT RUN", "batch_selection": "docs/evidence/2026-10-26-unit-control-display-gen9-a8fe/batches/stopwatch/selection.json", "batch_selection_sha256": "2c951c86988f4d55493b01427e88dda4021da22068bdc7b5a406e0789810c130", "strict_selected_aggregate": "docs/evidence/2026-10-26-unit-control-display-gen9-a8fe/batches/stopwatch/strict-selected-aggregate.json"}}}, "blocker": "Only the recorded firmware/controller/Web paths have device-local evidence. Other host and firmware combinations remain unvalidated; physical and visual-binding limits remain explicit.", "input_semantics": "External world/fixture state, to be delivered through a controller-level device model; not direct guest API return values.", "output_semantics": "Observed guest-to-Unit output; read-only to clients.", "limitations": ["All default values are synthetic UI/test fixtures, not measured hardware defaults.", "This catalog alone does not authorize a simulated or functional-PASS claim."], "research_snapshot": {"scope": "protocol research only; not current runtime capability", "model_status": "planned", "runtime_status": "unsupported", "blocker": "The official contract is documented, but no external Unit controller model, board routing and device-local runtime evidence is validated by this research artifact. Open protocol/electrical questions: Increment clear-on-read, wraparound, reset and address-change persistence need internal firmware confirmation."}}, {"id": "scroll", "name": "Scroll", "sku": "U186", "visual_asset": {"entry": "src/units/scroll/index.js", "export": "GroveModule"}, "official_docs": "https://docs.m5stack.com/en/unit/Unit_Scroll", "checked_at": "2026-10-26", "chips": [{"part": "STM32F030F4P6", "status": "officially-documented"}, {"part": "EC10E encoder", "status": "officially-documented"}, {"part": "WS2812C x1", "status": "officially-documented"}], "interface": {"bus": "i2c", "connector": "HY2.0-4P", "address_7bit": [64], "pins": {"yellow": {"signal": "SDA", "direction": "bidirectional"}, "white": {"signal": "SCL", "direction": "bidirectional"}, "red": {"signal": "5V", "direction": "power"}, "black": {"signal": "GND", "direction": "ground"}}}, "protocol": {"status": "documented", "summary": "Pinned internal FW ae60717a; independent Scroll I2C slave, LE int32 counter, active-low button, RR/GG/BB bytes at 0x31..33, bounded TX snapshot loops. Selecting an increment register snapshots and clears before read. UIFlow low16 getters and Python-only setter offsets are preserved.", "registers": [{"counter": "0x10..13 LE int32, partial writes", "pressed": "0x20 active-low byte", "led-rgb": "0x31..33 R,G,B", "reset": "0x40 value1 clears logical count/increment, not physical source", "increments": "0x50..53 LE int32; selection snapshots remaining suffix and clears", "direction": "0x60 physical TIM direction; 0xFB configured AB direction", "system": "0xFC bootloader flash read unsupported, 0xFE firmware version1, 0xFF address change; 0xFD bootloader transition unsupported"}], "gaps": ["TIM16 rollover IRQ/NVIC reachability is not proven for pinned vendor source; source input is explicitly bounded.", "RGB is a synchronous latest-value model for quiescent writes. The MCU multi-slot RGB queue, burst/slot-dependent partial writes and LED scheduling are not simulated.", "No STM32 bootloader execution, persistent configuration Flash or mechanical angle mapping.", "QEMU address-zero broadcast/unicast mismatch and address collision are rejected explicitly."]}, "inputs": {"source-count": {"type": "integer", "label": "外部编码器源计数（有界TIM区间）", "minimum": -32768, "maximum": 32767, "default": 0, "default_source": "synthetic-test-fixture", "readOnly": false, "description": "Synthetic electrical tick position; TIM16=0x8000+source-count. Single event delta at most 32767; timer rollover and signed counter overflow fail closed. This is separate from guest-writable counter and is not a mechanical angle."}, "pressed": {"type": "boolean", "label": "滚轮按下", "default": false, "default_source": "synthetic-test-fixture", "readOnly": false}}, "outputs": {"counter": {"type": "integer", "label": "内部int32计数", "minimum": -2147483648, "maximum": 2147483647, "default": 0, "default_source": "synthetic-test-fixture", "readOnly": true}, "increments": {"type": "integer", "label": "尚未被选择读取的int32增量", "minimum": -2147483648, "maximum": 2147483647, "default": 0, "default_source": "synthetic-test-fixture", "readOnly": true}, "direction": {"type": "integer", "label": "最后物理源方向（TIM up=1）", "minimum": 0, "maximum": 1, "default": 1, "default_source": "synthetic-test-fixture", "readOnly": true}, "ab-direction": {"type": "integer", "label": "AB方向配置", "minimum": 0, "maximum": 1, "default": 0, "default_source": "synthetic-test-fixture", "readOnly": true}, "led-rgb": {"type": "integer", "label": "单颗RGB颜色", "minimum": 0, "maximum": 16777215, "default": 0, "default_source": "synthetic-test-fixture", "readOnly": true}, "source-step-limit": {"type": "integer", "label": "单次源计数差分上限", "default": 32767, "default_source": "explicit-model-policy", "readOnly": true, "minimum": 0, "maximum": 9223372036854775807}, "timer-rollover-supported": {"type": "boolean", "label": "TIM回绕已模拟", "default": false, "default_source": "explicit-model-policy", "readOnly": true}, "bootloader-supported": {"type": "boolean", "label": "STM32 bootloader已模拟", "default": false, "default_source": "explicit-model-policy", "readOnly": true}, "zero-address-unicast-supported": {"type": "boolean", "label": "地址0单播受支持", "default": false, "default_source": "explicit-model-policy", "readOnly": true}, "bootloader-requests": {"type": "integer", "label": "不支持的bootloader请求数", "default": 0, "default_source": "synthetic-test-fixture", "readOnly": true, "minimum": 0, "maximum": 9223372036854775807}, "command-errors": {"type": "integer", "label": "不支持或