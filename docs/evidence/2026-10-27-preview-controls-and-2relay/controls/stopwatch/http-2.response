7215, "readOnly": true}}, "evidence": [{"kind": "official-product", "url": "https://docs.m5stack.com/en/unit/key", "checked_at": "2026-10-26", "claims": ["SKU and chip identity", "PinMap wire colors", "documented electrical and functional limits"]}, {"kind": "official-driver", "url": "https://raw.githubusercontent.com/m5stack/uiflow-micropython/master/m5stack/libs/unit/key.py", "checked_at": "2026-10-26", "claims": ["guest driver transaction path and encoding"], "sha256": "fde43cccc637b8075585d61502bd5afcb14fc3dd5309e29b714055c99841b921"}, {"kind": "official-driver", "url": "https://raw.githubusercontent.com/m5stack/uiflow-micropython/master/m5stack/libs/driver/neopixel/sk6812.py", "checked_at": "2026-10-26", "claims": ["guest driver transaction path and encoding"], "sha256": "a03925be7ed5c61c644d3a176990a53c21dbb5bad4b2e854200ee4a0725ecb39"}, {"kind": "official-linked-datasheet-or-schematic", "url": "https://m5stack-doc.oss-cn-shenzhen.aliyuncs.com/599/SCH_unitKey_V1.0.pdf", "checked_at": "2026-10-26", "retrieval_status": "linked-by-verified-product-page", "claims": ["reference for implementation; linked document content is not claimed to have been independently reviewed"]}], "research_status": "confirmed-contract", "model_status": "implemented", "runtime": {"status": "implemented", "hosts": ["cores3", "atoms3r", "sticks3", "stopwatch"], "blocker": "Development admission includes AtomS3R/StickS3/StopWatch, but NOT RUN entries are not functional validation. Only exact recorded firmware/controller/Web paths have PASS; ADC calibration, original driver risks and physical/visual boundaries remain separate.", "inputs": {"pressed": {"property": "pressed"}}, "state": {"pressed": {"property": "pressed"}, "led-rgb": {"property": "led-rgb"}, "input-level": {"property": "input-level"}, "led-frames": {"property": "led-frames"}, "incomplete-frames": {"property": "incomplete-frames"}, "transactions": {"property": "transactions"}, "read-bytes": {"property": "read-bytes"}, "written