+static bool esp32_native_hci_parse_hex_bytes(
+    const char *text,
+    uint8_t *output,
+    size_t capacity,
+    size_t *length)
+{
+    size_t count = 0;
+
+    if (!text) {
+        *length = 0;
+        return true;
+    }
+    while (*text) {
+        int high;
+        int low;
+
+        while (*text && (g_ascii_isspace(*text) ||
+                         *text == ':' || *text == '-')) {
+            text++;
+        }
+        if (!*text) {
+            break;
+        }
+        if (!g_ascii_isxdigit(text[0]) ||
+            !g_ascii_isxdigit(text[1]) ||
+            count == capacity) {
+            return false;
+        }
+        high = g_ascii_xdigit_value(text[0]);
+        low = g_ascii_xdigit_value(text[1]);
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        output[count++] = (uint8_t)((high << 4) | low);
+        text += 2;
+    }
+    *length = count;
+    return true;
+}
