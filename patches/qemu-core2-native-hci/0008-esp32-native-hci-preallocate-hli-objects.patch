+static uint64_t esp32_native_hci_hli_take_prealloc(uint64_t *pool,
+                                                   uint32_t *count)
+{
+    uint64_t address;
+
+    if (!*count) {
+        return 0;
+    }
+    address = pool[*count - 1];
+    pool[*count - 1] = 0;
+    (*count)--;
+    return address;
+}
+
+static bool esp32_native_hci_hli_refill(CPUState *cs,
+                                        Esp32NativeHciState *s,
+                                        uint64_t allocator,
+                                        uint64_t *pool,
+                                        uint32_t *count,
+                                        uint32_t target)
+{
+    uint32_t status;
+    uint32_t steps;
+
+    while (*count < target) {
+        if (!allocator ||
+            !esp32_native_hci_guest_call(
+                cs, allocator, 0, 0, 0, 0, &status, &steps) ||
+            !status) {
+            s->hli_prealloc_failures++;
+            return false;
+        }
+        pool[(*count)++] = status;
+    }
+    return true;
+}
