+            if (addr >= 0x74 && addr < 0x74 + GPIO_NPINS * 4) {
+                uint64_t bit = 1ULL << ((addr - 0x74) / 4);
+                if (value & (1u << 2)) {
+                    g_open_drain |= bit;
+                } else {
+                    g_open_drain &= ~bit;
+                }
+            }
+        }
+        break;
+    }
+    gpio_notify(before, gpio_line64());
 }
 
