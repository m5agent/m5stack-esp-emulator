diff --git a/hw/misc/esp32c6_board_i2c.c b/hw/misc/esp32c6_board_i2c.c
new file mode 100644
index 0000000..434fc03
--- /dev/null
+++ b/hw/misc/esp32c6_board_i2c.c
@@ -0,0 +1,416 @@
+/*
+ * Minimal I2C devices used by the Arduino Nesso N1 board.
+ *
+ * The board detector needs PI4IOE1/PI4IOE2 ACKs and the board's
+ * FT5x06-compatible touch controller.  The models are deliberately
+ * register-level rather than full peripheral emulations so firmware can
+ * complete autodetection and UI input without a physical board.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include <math.h>
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/misc/esp32c6_board_i2c.h"
+
+enum {
+    C6_DEV_GENERIC,
+    C6_DEV_FT5X06,
+    C6_DEV_PI4IOE,
+    C6_DEV_BMI270,
+    C6_DEV_BQ27220,
+    C6_DEV_AW32001,
+};
+
+typedef struct C6BoardI2CDev {
+    I2CSlave parent_obj;
+    char *model_name;
+    int model;
+    uint8_t regs[256];
+    uint8_t ptr;
+    uint8_t read_start;
+    bool ptr_set;
+    uint8_t bq_write_count;
+    uint16_t bq_subreg;
+    int64_t battery_mv;
+    int64_t battery_current_ma;
+    int64_t battery_level;
+    double accel[3];
+    double gyro[3];
+    bool charging;
+} C6BoardI2CDev;
+
+OBJECT_DECLARE_SIMPLE_TYPE(C6BoardI2CDev, ESP32C6_BOARD_I2C_DEV)
+
+static C6BoardI2CDev *g_ft;
+static int g_touch_pressed;
+static int g_touch_x;
+static int g_touch_y;
+static uint8_t g_buttons = 0x03;
+static C6BoardI2CDev *g_nesso_pi4ioe[2];
+static C6BoardI2CDev *g_nesso_aw32001;
+
+static uint8_t nesso_pi4ioe_input(C6BoardI2CDev *s)
+{
+    uint8_t external = (s == g_nesso_pi4ioe[0]) ? g_buttons : 0xff;
+    return external & ~s->regs[0x03];
+}
+
+static void nesso_pi4ioe_update_irq(C6BoardI2CDev *s)
+{
+    if (s == g_nesso_pi4ioe[0]) {
+        esp32_gpio_force_line(3, s->regs[0x13] == 0);
+    }
+}
+
+void esp32c6_ft_touch_set(int pressed, int x, int y)
+{
+    g_touch_pressed = pressed;
+    g_touch_x = x;
+    g_touch_y = y;
+    if (g_ft) {
+        g_ft->regs[0x02] = pressed ? 1 : 0;
+        g_ft->regs[0x03] = (x >> 8) & 0x0f;
+        g_ft->regs[0x04] = x & 0xff;
+        g_ft->regs[0x05] = (y >> 8) & 0x0f;
+        g_ft->regs[0x06] = y & 0xff;
+    }
+    esp32_gpio_force_line(3, !pressed);
+}
+
+void esp32c6_pi4ioe_button_set(int button, bool pressed)
+{
+    uint8_t old;
+
+    if (button < 0 || button > 1) {
+        return;
+    }
+    old = g_buttons;
+    if (pressed) {
+        g_buttons &= ~(1u << button);
+    } else {
+        g_buttons |= 1u << button;
+    }
+    if (g_nesso_pi4ioe[0] && old != g_buttons) {
+        g_nesso_pi4ioe[0]->regs[0x13] |= old ^ g_buttons;
+    }
+}
+
+static uint8_t c6_i2c_read(C6BoardI2CDev *s, uint8_t reg)
+{
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-i2c] read model=%d reg=%02x\n", s->model, reg);
+    }
+    if (s->model == C6_DEV_FT5X06) {
+        switch (reg) {
+        case 0x02:
+            return g_touch_pressed ? 1 : 0;
+        case 0x03:
+            return (g_touch_x >> 8) & 0x0f;
+        case 0x04:
+            return g_touch_x & 0xff;
+        case 0x05:
+            return (g_touch_y >> 8) & 0x0f;
+        case 0x06:
+            return g_touch_y & 0xff;
+        case 0xA3:
+            return 0x51;
+        case 0xA6:
+            return 0x10;
+        case 0xA8:
+            return 0x11;
+        default:
+            break;
+        }
+    } else if (s->model == C6_DEV_PI4IOE) {
+        if (reg == 0x01) {
+            uint8_t value = s->regs[reg];
+            s->regs[reg] &= ~0x02;
+            return value;
+        }
+        if (reg == 0x0f) {
+            return nesso_pi4ioe_input(s);
+        }
+        if (reg == 0x13) {
+            uint8_t value = s->regs[reg];
+            s->regs[reg] = 0;
+            nesso_pi4ioe_update_irq(s);
+            return value;
+        }
+    } else if (s->model == C6_DEV_BMI270) {
+        if (reg >= 0x0c && reg <= 0x17) {
+            int index = (reg - 0x0c) / 2;
+            double value = index < 3
+                ? s->accel[index] * 32768.0 / 8.0
+                : s->gyro[index - 3] * 32768.0 / 2000.0;
+            int32_t raw = (int32_t)lrint(value);
+            raw = MAX(-32768, MIN(raw, 32767));
+            return ((reg - 0x0c) & 1)
+                ? ((uint16_t)raw >> 8) : ((uint16_t)raw & 0xff);
+        }
+        if (reg == 0x1d) {
+            return 0xc0;                    /* ACC and GYR data ready */
+        }
+        if (reg == 0x21) {
+            return s->regs[0x59] & 1 ? 1 : 0;
+        }
+        if (reg == 0x03) {
+            return 0xc0;
+        }
+    } else if (s->model == C6_DEV_BQ27220) {
+        if (s->read_start == 0x3e) {
+            unsigned offset = reg - 0x3e;
+            static const uint8_t device_type[4] = { 0x20, 0x00, 0x00, 0x00 };
+            return offset < sizeof(device_type) ? device_type[offset] : 0;
+        }
+        if (reg == 0x08 || reg == 0x09) {
+            uint16_t value = s->battery_mv;
+            return reg == 0x08 ? value & 0xff : value >> 8;
+        }
+        if (reg == 0x14 || reg == 0x15) {
+            uint16_t value = (int16_t)s->battery_current_ma;
+            return reg == 0x14 ? value & 0xff : value >> 8;
+        }
+        if (reg == 0x2c || reg == 0x2d) {
+            uint16_t value = s->battery_level;
+            return reg == 0x2c ? value & 0xff : value >> 8;
+        }
+    } else if (s->model == C6_DEV_AW32001) {
+        if (reg == 0x08) {
+            return s->charging ? 0x10 : 0x00;
+        }
+    }
+    return s->regs[reg];
+}
+
+static int c6_i2c_event(I2CSlave *i2c, enum i2c_event event)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+        s->bq_write_count = 0;
+    } else if (event == I2C_START_RECV) {
+        s->read_start = s->ptr;
+    }
+    return 0;
+}
+
+static uint8_t c6_i2c_recv(I2CSlave *i2c)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+    uint8_t value;
+
+    if (s->model == C6_DEV_BQ27220 && s->read_start == 0x3e
+        && s->ptr < 0x40) {
+        value = c6_i2c_read(s, s->ptr++);
+        return value;
+    }
+    value = c6_i2c_read(s, s->ptr++);
+    return value;
+}
+
+static int c6_i2c_send(I2CSlave *i2c, uint8_t data)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+
+    if (s->model == C6_DEV_BQ27220) {
+        if (s->bq_write_count == 0) {
+            s->ptr = data;
+            s->ptr_set = true;
+            if (data != 0x3e) {
+                s->bq_subreg = 0;
+            }
+        } else if (s->bq_write_count == 1) {
+            s->bq_subreg = data;
+        } else if (s->bq_write_count == 2) {
+            s->bq_subreg |= data << 8;
+        }
+        s->bq_write_count++;
+        return 0;
+    }
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+        return 0;
+    }
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-i2c] write model=%d reg=%02x data=%02x\n",
+                s->model, s->ptr, data);
+    }
+    if (s->model == C6_DEV_BMI270) {
+        if (s->ptr == 0x5e) {
+            return 0;                       /* INIT_DATA burst */
+        }
+        if (s->ptr == 0x7e && data == 0xb6) {
+            s->regs[0x7c] = 0x03;
+            s->ptr++;
+            return 0;
+        }
+    }
+    if (s->model == C6_DEV_PI4IOE && s->ptr == 0x01 && (data & BIT(0))) {
+        memset(s->regs, 0, sizeof(s->regs));
+        s->regs[0x01] = 0xa2;
+        s->regs[0x07] = 0xff;
+        s->regs[0x0b] = 0xff;
+        s->ptr++;
+        nesso_pi4ioe_update_irq(s);
+        return 0;
+    }
+    if (s->model == C6_DEV_PI4IOE && (s->ptr == 0x0f || s->ptr == 0x13)) {
+        s->ptr++;
+        return 0;
+    }
+    s->regs[s->ptr++] = data;
+    return 0;
+}
+
+static void c6_prop_get_i64(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    visit_type_int64(v, name, (int64_t *)op, errp);
+}
+
+static void c6_prop_get_num(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    visit_type_number(v, name, (double *)op, errp);
+}
+
+static void c6_prop_set_num(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    double value;
+
+    if (visit_type_number(v, name, &value, errp)) {
+        *(double *)op = value;
+    }
+}
+
+static void c6_prop_set_i64(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    int64_t value;
+
+    if (visit_type_int64(v, name, &value, errp)) {
+        *(int64_t *)op = value;
+    }
+}
+
+static void c6_prop_get_bool(Object *o, Visitor *v, const char *name,
+                             void *op, Error **errp)
+{
+    visit_type_bool(v, name, (bool *)op, errp);
+}
+
+static void c6_prop_set_bool(Object *o, Visitor *v, const char *name,
+                             void *op, Error **errp)
+{
+    bool value;
+
+    if (visit_type_bool(v, name, &value, errp)) {
+        *(bool *)op = value;
+    }
+}
+
+static void c6_i2c_realize(DeviceState *dev, Error **errp)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)dev;
+    const char *model = s->model_name ? s->model_name : "generic";
+
+    s->model = C6_DEV_GENERIC;
+    if (!strcmp(model, "ft5x06")) {
+        s->model = C6_DEV_FT5X06;
+        g_ft = s;
+    } else if (!strcmp(model, "pi4ioe")) {
+        s->model = C6_DEV_PI4IOE;
+        s->regs[0x01] = 0xa2;
+        s->regs[0x07] = 0xff;
+        s->regs[0x0b] = 0xff;
+        if (s->parent_obj.address == 0x43) {
+            g_nesso_pi4ioe[0] = s;
+        } else if (s->parent_obj.address == 0x44) {
+            g_nesso_pi4ioe[1] = s;
+        }
+    } else if (!strcmp(model, "bmi270")) {
+        static const char *accel_names[] = {
+            "accel-x", "accel-y", "accel-z"
+        };
+        static const char *gyro_names[] = {
+            "gyro-x", "gyro-y", "gyro-z"
+        };
+
+        s->model = C6_DEV_BMI270;
+        s->regs[0x00] = 0x24;
+        s->regs[0x03] = 0xc0;
+        s->regs[0x7c] = 0x03;
+        s->regs[0x1d] = 0xc0;
+        s->accel[2] = 1.0;
+        for (int i = 0; i < 3; i++) {
+            object_property_add(OBJECT(s), accel_names[i], "number",
+                                c6_prop_get_num, c6_prop_set_num,
+                                NULL, &s->accel[i]);
+            object_property_add(OBJECT(s), gyro_names[i], "number",
+                                c6_prop_get_num, c6_prop_set_num,
+                                NULL, &s->gyro[i]);
+        }
+    } else if (!strcmp(model, "bq27220")) {
+        s->model = C6_DEV_BQ27220;
+        s->battery_mv = 4000;
+        s->battery_current_ma = 250;
+        s->battery_level = 87;
+        object_property_add(OBJECT(s), "battery-mv", "int", c6_prop_get_i64,
+                            c6_prop_set_i64, NULL, &s->battery_mv);
+        object_property_add(OBJECT(s), "current-ma", "int", c6_prop_get_i64,
+                            c6_prop_set_i64, NULL, &s->battery_current_ma);
+        object_property_add(OBJECT(s), "battery-level", "int", c6_prop_get_i64,
+                            c6_prop_set_i64, NULL, &s->battery_level);
+    } else if (!strcmp(model, "aw32001")) {
+        s->model = C6_DEV_AW32001;
+        s->regs[0x01] = 0;
+        s->regs[0x02] = 11;                         /* 100 mA */
+        s->regs[0x04] = 39;                         /* 4200 mV */
+        s->regs[0x0a] = 0x49;
+        s->charging = true;
+        object_property_add(OBJECT(s), "charging", "bool", c6_prop_get_bool,
+                            c6_prop_set_bool, NULL, &s->charging);
+        g_nesso_aw32001 = s;
+    }
+}
+
+static Property c6_i2c_props[] = {
+    DEFINE_PROP_STRING("model", C6BoardI2CDev, model_name),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void c6_i2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = c6_i2c_realize;
+    device_class_set_props(dc, c6_i2c_props);
+    k->event = c6_i2c_event;
+    k->recv = c6_i2c_recv;
+    k->send = c6_i2c_send;
+}
+
+static const TypeInfo c6_i2c_info = {
+    .name = TYPE_ESP32C6_BOARD_I2C_DEV,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(C6BoardI2CDev),
+    .class_init = c6_i2c_class_init,
+};
+
+static void c6_i2c_register_types(void)
+{
+    type_register_static(&c6_i2c_info);
+}
+
+type_init(c6_i2c_register_types)
diff --git a/hw/misc/esp32c6_i2s.c b/hw/misc/esp32c6_i2s.c
new file mode 100644
index 0000000..25d07df
--- /dev/null
+++ b/hw/misc/esp32c6_i2s.c
@@ -0,0 +1,366 @@
+/*
+ * ESP32-C6 I2S register, GDMA and PCM data-plane model.
+ *
+ * The controller exposes the same I2S register front-end used by the
+ * ESP-IDF std driver, while the actual buffers are consumed from the C6
+ * AHB GDMA descriptor chain. TX PCM is captured from the guest buffer;
+ * RX PCM can be injected from M5SW_I2S_RX_PCM_FILE.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qapi/error.h"
+#include "hw/dma/esp_gdma.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/misc/esp32c6_i2s.h"
+
+#define ESP32C6_I2S_BASE       0x6000c000
+#define ESP32C6_I2S_IRQ_SOURCE 41
+#define TYPE_ESP32C6_I2S "esp32c6.i2s"
+
+#define R_INT_RAW  0x0c
+#define R_INT_ST   0x10
+#define R_INT_ENA  0x14
+#define R_INT_CLR  0x18
+#define R_RX_CONF  0x20
+#define R_TX_CONF  0x24
+#define RX_START   BIT(2)
+#define TX_START   BIT(2)
+#define I2S_PCM_MAX_BYTES (4 << 20)
+#define I2S_DMA_PERIOD_MS 10
+
+typedef struct Esp32C6I2SState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    ESPGdmaState *gdma;
+    uint32_t regs[0x1000 / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    bool trace;
+    bool tx_started;
+    bool tx_active;
+    uint32_t tx_channel;
+    uint32_t tx_events;
+    QEMUTimer *tx_timer;
+    FILE *pcm_file;
+    uint32_t pcm_writes;
+    uint64_t pcm_bytes;
+    bool pcm_started;
+    int64_t capture_until_ms;
+    int64_t dma_due_ms;
+    bool dma_active;
+    bool rx_started;
+    bool rx_active;
+    uint32_t rx_channel;
+    uint8_t *rx_pcm;
+    uint32_t rx_pcm_size;
+    uint32_t rx_pcm_pos;
+    QEMUTimer *rx_timer;
+} Esp32C6I2SState;
+
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32C6I2SState, ESP32C6_I2S)
+
+static void i2s_update_irq(Esp32C6I2SState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static uint64_t i2s_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C6I2SState *s = opaque;
+
+    switch (addr) {
+    case R_INT_RAW:
+        return s->int_raw;
+    case R_INT_ST:
+        return s->int_raw & s->int_ena;
+    case R_INT_ENA:
+        return s->int_ena;
+    default:
+        return addr < sizeof(s->regs) ? s->regs[addr / 4] : 0;
+    }
+}
+
+static void i2s_capture_pcm(Esp32C6I2SState *s)
+{
+    uint8_t buffer[4096];
+    uint32_t bytes;
+    bool nonzero = false;
+
+    if (!s->gdma || !s->tx_active ||
+        s->pcm_bytes >= I2S_PCM_MAX_BYTES) {
+        return;
+    }
+    if (!esp_gdma_get_channel_periph(s->gdma, GDMA_I2S0,
+                                     ESP_GDMA_OUT_IDX, &s->tx_channel)) {
+        return;
+    }
+    bytes = esp_gdma_complete_out_descriptor(
+        s->gdma, s->tx_channel, buffer, sizeof(buffer));
+    if (!bytes) {
+        if (s->trace) {
+            fprintf(stderr, "[c6-i2s] gdma complete channel=%u empty\n",
+                    s->tx_channel);
+        }
+        return;
+    }
+    if (s->trace) {
+        fprintf(stderr, "[c6-i2s] dma channel=%u bytes=%u head=",
+                s->tx_channel, bytes);
+        for (uint32_t i = 0; i < MIN(bytes, 16); i++) {
+            fprintf(stderr, "%02x", buffer[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    for (uint32_t i = 0; i < bytes; i++) {
+        if (buffer[i]) {
+            nonzero = true;
+            break;
+        }
+    }
+    if (!nonzero) {
+        return;
+    }
+    if (!s->pcm_started) {
+        const char *path = getenv("M5SW_I2S_PCM_FILE");
+        if (!path) {
+            return;
+        }
+        s->pcm_file = fopen(path, "wb");
+        if (!s->pcm_file) {
+            return;
+        }
+        s->pcm_started = true;
+    }
+    uint32_t write_size = MIN(bytes, I2S_PCM_MAX_BYTES - s->pcm_bytes);
+    if (write_size) {
+        fwrite(buffer, 1, write_size, s->pcm_file);
+        fflush(s->pcm_file);
+        s->pcm_bytes += write_size;
+        s->pcm_writes++;
+    }
+    if (s->trace) {
+        fprintf(stderr, "[c6-i2s] capture bytes=%u total=%" PRIu64 "\n",
+                bytes, s->pcm_bytes);
+    }
+}
+
+static void i2s_tx_timer(void *opaque)
+{
+    Esp32C6I2SState *s = opaque;
+    uint32_t channel;
+
+    if (!s->tx_started || !s->tx_active ||
+        qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= s->capture_until_ms ||
+        s->pcm_bytes >= I2S_PCM_MAX_BYTES) {
+        return;
+    }
+    timer_mod(s->tx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+    if (!s->dma_active) {
+        if (!s->gdma ||
+            !esp_gdma_get_channel_periph(s->gdma, GDMA_I2S0,
+                                         ESP_GDMA_OUT_IDX, &channel)) {
+            return;
+        }
+        s->tx_channel = channel;
+        s->dma_active = true;
+        s->dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                      + I2S_DMA_PERIOD_MS;
+    }
+    if (qemu_clock_get_ms(QEMU_CLOCK_REALTIME) < s->dma_due_ms) {
+        return;
+    }
+    i2s_capture_pcm(s);
+    s->dma_active = false;
+    s->dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                  + I2S_DMA_PERIOD_MS;
+}
+
+static void i2s_load_rx_pcm(Esp32C6I2SState *s)
+{
+    const char *path = getenv("M5SW_I2S_RX_PCM_FILE");
+    g_autofree char *contents = NULL;
+    gsize length = 0;
+
+    if (!path || s->rx_pcm ||
+        !g_file_get_contents(path, &contents, &length, NULL)) {
+        return;
+    }
+    s->rx_pcm = (uint8_t *)g_memdup2(contents, length);
+    s->rx_pcm_size = length;
+    s->rx_pcm_pos = 0;
+}
+
+static void i2s_rx_timer(void *opaque)
+{
+    Esp32C6I2SState *s = opaque;
+    uint8_t buffer[4096];
+    uint32_t available;
+    uint32_t chunk;
+
+    if (!s->rx_started || !s->rx_active || !s->gdma ||
+        !s->rx_pcm || !s->rx_pcm_size) {
+        return;
+    }
+    available = s->rx_pcm_size - s->rx_pcm_pos;
+    if (!available) {
+        s->rx_pcm_pos = 0;
+        available = s->rx_pcm_size;
+    }
+    chunk = MIN(available, sizeof(buffer));
+    memcpy(buffer, s->rx_pcm + s->rx_pcm_pos, chunk);
+    s->rx_pcm_pos = (s->rx_pcm_pos + chunk) % s->rx_pcm_size;
+    esp_gdma_complete_in_descriptor(s->gdma, s->rx_channel, buffer, chunk);
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + I2S_DMA_PERIOD_MS);
+}
+
+static void i2s_write(void *opaque, hwaddr addr, uint64_t value,
+                      unsigned size)
+{
+    Esp32C6I2SState *s = opaque;
+    uint32_t v = value;
+
+    if (s->trace) {
+        fprintf(stderr, "[c6-i2s] wr %03x <- %08x\n",
+                (unsigned)addr, v);
+    }
+    switch (addr) {
+    case R_INT_ENA:
+        s->int_ena = v;
+        i2s_update_irq(s);
+        break;
+    case R_INT_CLR:
+        s->int_raw &= ~v;
+        i2s_update_irq(s);
+        break;
+    case R_RX_CONF:
+        if ((v & RX_START) && !s->rx_started && s->gdma &&
+            esp_gdma_get_channel_periph(s->gdma, GDMA_I2S0,
+                                        ESP_GDMA_IN_IDX, &s->rx_channel)) {
+            s->rx_active = true;
+            s->rx_pcm_pos = 0;
+            i2s_load_rx_pcm(s);
+            timer_mod(s->rx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+        }
+        s->rx_started = !!(v & RX_START);
+        s->regs[addr / 4] = v & ~BIT(8);
+        break;
+    case R_TX_CONF:
+        if ((v & TX_START) && !s->tx_started) {
+            bool found = s->gdma &&
+                esp_gdma_get_channel_periph(s->gdma, GDMA_I2S0,
+                                            ESP_GDMA_OUT_IDX,
+                                            &s->tx_channel);
+            if (s->trace) {
+                fprintf(stderr, "[c6-i2s] tx start gdma=%p found=%d chan=%u\n",
+                        (void *)s->gdma, found, s->tx_channel);
+            }
+            if (found) {
+                s->tx_active = true;
+                s->pcm_writes = 0;
+                s->tx_events = 0;
+                s->dma_active = false;
+                s->capture_until_ms =
+                    qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 5000;
+                timer_mod(s->tx_timer,
+                          qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                          + I2S_DMA_PERIOD_MS);
+            }
+        }
+        s->tx_started = !!(v & TX_START);
+        s->regs[addr / 4] = v & ~BIT(8);
+        break;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+        break;
+    }
+}
+
+static const MemoryRegionOps i2s_ops = {
+    .read = i2s_read,
+    .write = i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void i2s_reset(DeviceState *dev)
+{
+    Esp32C6I2SState *s = ESP32C6_I2S(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->tx_started = false;
+    s->tx_active = false;
+    s->dma_active = false;
+    s->rx_started = false;
+    s->rx_active = false;
+    s->pcm_started = false;
+    if (s->tx_timer) {
+        timer_del(s->tx_timer);
+    }
+    if (s->rx_timer) {
+        timer_del(s->rx_timer);
+    }
+}
+
+static void i2s_init(Object *obj)
+{
+    Esp32C6I2SState *s = ESP32C6_I2S(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &i2s_ops, s,
+                          "esp32c6.i2s", 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->trace = getenv("M5SW_I2S_TRACE") != NULL;
+    s->tx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_tx_timer, s);
+    s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_rx_timer, s);
+}
+
+static void i2s_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, i2s_reset);
+}
+
+static const TypeInfo esp32c6_i2s_info = {
+    .name = TYPE_ESP32C6_I2S,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32C6I2SState),
+    .instance_init = i2s_init,
+    .class_init = i2s_class_init,
+};
+
+static void esp32c6_i2s_register_types(void)
+{
+    type_register_static(&esp32c6_i2s_info);
+}
+
+type_init(esp32c6_i2s_register_types)
+
+void esp32c6_i2s_board_init(MemoryRegion *sys_mem, ESP32C6GdmaState *gdma,
+                            DeviceState *intmatrix)
+{
+    DeviceState *dev = qdev_new(TYPE_ESP32C6_I2S);
+
+    object_property_add_child(qdev_get_machine(), "i2s0", OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    Esp32C6I2SState *s = ESP32C6_I2S(dev);
+    s->gdma = &gdma->parent.parent;
+    memory_region_add_subregion_overlap(
+        sys_mem, ESP32C6_I2S_BASE,
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 1);
+    sysbus_connect_irq(
+        SYS_BUS_DEVICE(dev), 0,
+        qdev_get_gpio_in(intmatrix, ESP32C6_I2S_IRQ_SOURCE));
+}
diff --git a/hw/misc/esp32c6_nesso_panel.c b/hw/misc/esp32c6_nesso_panel.c
new file mode 100644
index 0000000..1cdedce
--- /dev/null
+++ b/hw/misc/esp32c6_nesso_panel.c
@@ -0,0 +1,354 @@
+/*
+ * Arduino Nesso N1 ST7789 panel model.
+ *
+ * The board's display is a 135x240 ST7789 behind a 52/40 controller
+ * offset.  This model implements the DCS subset used by M5GFX, keeps an
+ * RGB565 framebuffer, and exposes it through a QEMU console so screendump
+ * and the device-center preview path can consume it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "hw/misc/esp32c6_nesso_panel.h"
+#include "hw/misc/esp32c6_board_i2c.h"
+
+#define PANEL_W 135
+#define PANEL_H 240
+#define PANEL_OFF_X 52
+#define PANEL_OFF_Y 40
+#define MEM_W 240
+#define MEM_H 320
+
+struct ESP32C6NessoPanelState {
+    DeviceState parent_obj;
+    QemuConsole *con;
+    QEMUBH *refresh_bh;
+    uint16_t *mem;
+    uint8_t madctl;
+    uint8_t cmd;
+    uint8_t params[4];
+    unsigned pidx;
+    uint16_t xs;
+    uint16_t xe;
+    uint16_t ys;
+    uint16_t ye;
+    uint16_t cx;
+    uint16_t cy;
+    bool pixel_half;
+    uint8_t pix_hi;
+    bool disp_on;
+    bool sleep;
+    bool dirty;
+    unsigned trace_count;
+    bool saw_nonzero;
+    int mouse_x;
+    int mouse_y;
+    bool mouse_down;
+};
+
+static void nesso_panel_reset_window(ESP32C6NessoPanelState *s)
+{
+    s->cx = s->xs;
+    s->cy = s->ys;
+}
+
+static void nesso_panel_put_pixel(ESP32C6NessoPanelState *s, uint16_t px)
+{
+    int x = s->cx;
+    int y = s->cy;
+    if (getenv("M5SW_NESSO_PANEL_PIXEL_TRACE") && s->trace_count++ < 8) {
+        fprintf(stderr, "[nesso-pixel] (%d,%d) window x=%u..%u y=%u..%u\n",
+                x, y, s->xs, s->xe, s->ys, s->ye);
+    }
+    static int row_trace;
+    static int last_y = -1;
+    if (getenv("M5SW_NESSO_ROW_TRACE") && y != last_y && px != 0 &&
+        row_trace < 8) {
+        fprintf(stderr, "[nesso-row] first y=%d x=%d px=%04x\n", y, x, px);
+        last_y = y;
+        row_trace++;
+    }
+    if (px == 0xf800) {
+        s->saw_nonzero = true;
+    } else if (px == 0 && s->saw_nonzero &&
+               getenv("M5SW_NESSO_PANEL_BLACK_TRACE")) {
+        fprintf(stderr, "[nesso-black] x=%d y=%d\n", x, y);
+    }
+
+    /*
+     * M5GFX already applies the board rotation and the 52/40 controller
+     * offset when it programs CASET/RASET.  Apply MADCTL a second time
+     * here and the 135-wide stream is transposed into a diagonal pattern.
+     */
+    if (x >= 0 && x < MEM_W && y >= 0 && y < MEM_H) {
+        s->mem[y * MEM_W + x] = px;
+    }
+    if (++s->cx > s->xe) {
+        s->cx = s->xs;
+        if (++s->cy > s->ye) {
+            s->cy = s->ys;
+        }
+    }
+}
+
+void esp32c6_nesso_panel_write(void *opaque, const uint8_t *buf, uint32_t len,
+                               bool command_phase)
+{
+    ESP32C6NessoPanelState *s = opaque;
+    static unsigned dump_count;
+    if (getenv("M5SW_NESSO_PANEL_DUMP") && s->cmd == 0x2c &&
+        !command_phase) {
+        dump_count++;
+    }
+    if (getenv("M5SW_NESSO_PANEL_DUMP") && s->cmd == 0x2c &&
+        (dump_count <= 2 || (dump_count >= 1000 && dump_count <= 1005)) &&
+        !command_phase) {
+        fprintf(stderr, "[nesso-dump] len=%u first:", len);
+        for (uint32_t i = 0; i < MIN(len, 32u); i++) {
+            fprintf(stderr, " %02x", buf[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    for (uint32_t i = 0; i < len; i++) {
+        uint8_t b = buf[i];
+
+        if (command_phase) {
+            s->cmd = b;
+            s->pidx = 0;
+            s->pixel_half = false;
+            if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                fprintf(stderr, "[nesso-panel] CMD %02x\n", b);
+            }
+            switch (b) {
+            case 0x28:
+                s->disp_on = false;
+                s->dirty = true;
+                break;
+            case 0x29:
+                s->disp_on = true;
+                s->dirty = true;
+                break;
+            case 0x10:
+                s->sleep = true;
+                s->dirty = true;
+                break;
+            case 0x11:
+                s->sleep = false;
+                s->dirty = true;
+                break;
+            case 0x01:
+                s->disp_on = false;
+                s->sleep = true;
+                s->madctl = 0;
+                break;
+            case 0x2C:
+            case 0x3C:
+                nesso_panel_reset_window(s);
+                s->trace_count = 0;
+                break;
+            default:
+                break;
+            }
+            continue;
+        }
+
+        if (i == 0 && getenv("M5SW_NESSO_PANEL_TRACE")) {
+            fprintf(stderr, "[nesso-panel] DATA cmd=%02x len=%u first=%02x\n",
+                    s->cmd, len, b);
+        }
+        switch (s->cmd) {
+        case 0x2A:
+            if (s->pidx < 4) {
+                s->params[s->pidx++] = b;
+            }
+            if (s->pidx == 4) {
+                s->xs = (s->params[0] << 8) | s->params[1];
+                s->xe = (s->params[2] << 8) | s->params[3];
+                if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                    fprintf(stderr, "[nesso-panel] CASET %u..%u\n", s->xs, s->xe);
+                }
+            }
+            break;
+        case 0x2B:
+            if (s->pidx < 4) {
+                s->params[s->pidx++] = b;
+            }
+            if (s->pidx == 4) {
+                s->ys = (s->params[0] << 8) | s->params[1];
+                s->ye = (s->params[2] << 8) | s->params[3];
+                if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                    fprintf(stderr, "[nesso-panel] RASET %u..%u\n", s->ys, s->ye);
+                }
+            }
+            break;
+        case 0x2C:
+        case 0x3C:
+            if (!s->pixel_half) {
+                s->pix_hi = b;
+                s->pixel_half = true;
+            } else {
+                nesso_panel_put_pixel(s, (s->pix_hi << 8) | b);
+                s->pixel_half = false;
+                s->dirty = true;
+            }
+            break;
+        case 0x36:
+            s->madctl = b;
+            s->dirty = true;
+            break;
+        default:
+            break;
+        }
+    }
+    if (s->dirty && s->refresh_bh) {
+        qemu_bh_schedule(s->refresh_bh);
+    }
+}
+
+static void nesso_panel_update(void *opaque)
+{
+    ESP32C6NessoPanelState *s = opaque;
+    DisplaySurface *surf;
+    uint32_t *dst;
+    int stride;
+
+    if (!s->dirty) {
+        return;
+    }
+    s->dirty = false;
+    surf = qemu_console_surface(s->con);
+    if (!surf || surface_bits_per_pixel(surf) != 32 ||
+        surface_width(surf) != PANEL_W ||
+        surface_height(surf) != PANEL_H) {
+        surf = qemu_create_displaysurface(PANEL_W, PANEL_H);
+        dpy_gfx_replace_surface(s->con, surf);
+    }
+    if (getenv("M5SW_NESSO_UPDATE_TRACE")) {
+        fprintf(stderr, "[nesso-update] surface=%ux%u stride=%d dirty-sample=%04x\n",
+                surface_width(surf), surface_height(surf), surface_stride(surf),
+                s->mem[(PANEL_OFF_Y + 20) * MEM_W + PANEL_OFF_X + 20]);
+    }
+    dst = (uint32_t *)surface_data(surf);
+    stride = surface_stride(surf) / 4;
+    for (int py = 0; py < PANEL_H; py++) {
+        for (int px = 0; px < PANEL_W; px++) {
+            uint16_t p = s->mem[(py + PANEL_OFF_Y) * MEM_W +
+                                (px + PANEL_OFF_X)];
+            uint32_t r = ((p >> 11) & 0x1f) * 255 / 31;
+            uint32_t g = ((p >> 5) & 0x3f) * 255 / 63;
+            uint32_t b = (p & 0x1f) * 255 / 31;
+            if (!s->disp_on || s->sleep) {
+                r = g = b = 0;
+            }
+            dst[py * stride + px] = 0xff000000u | (r << 16) | (g << 8) | b;
+        }
+    }
+    dpy_gfx_update(s->con, 0, 0, PANEL_W, PANEL_H);
+}
+
+static void nesso_panel_refresh(void *opaque)
+{
+    nesso_panel_update(opaque);
+}
+
+static void nesso_panel_input(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_KEY: {
+        InputKeyEvent *key = evt->u.key.data;
+        int q = qemu_input_key_value_to_qcode(key->key);
+        if (getenv("M5SW_INPUT_TRACE")) {
+            fprintf(stderr, "[nesso-input] key=%d down=%d\n", q, key->down);
+        }
+        if (q == Q_KEY_CODE_A || q == Q_KEY_CODE_1) {
+            esp32c6_pi4ioe_button_set(0, key->down);
+        } else if (q == Q_KEY_CODE_B || q == Q_KEY_CODE_2) {
+            esp32c6_pi4ioe_button_set(1, key->down);
+        }
+        break;
+    }
+    case INPUT_EVENT_KIND_ABS: {
+        InputMoveEvent *m = evt->u.abs.data;
+        if (m->axis == INPUT_AXIS_X) {
+            s->mouse_x = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
+                                               INPUT_EVENT_ABS_MAX, 0,
+                                               PANEL_W - 1);
+        } else if (m->axis == INPUT_AXIS_Y) {
+            s->mouse_y = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
+                                               INPUT_EVENT_ABS_MAX, 0,
+                                               PANEL_H - 1);
+        }
+        break;
+    }
+    case INPUT_EVENT_KIND_BTN: {
+        InputBtnEvent *b = evt->u.btn.data;
+        if (b->button == INPUT_BUTTON_LEFT) {
+            s->mouse_down = b->down;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+static void nesso_panel_input_sync(DeviceState *dev)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+    esp32c6_ft_touch_set(s->mouse_down, s->mouse_x, s->mouse_y);
+}
+
+static const QemuInputHandler nesso_panel_input_handler = {
+    .name = "Nesso N1 touch",
+    .mask = INPUT_EVENT_MASK_KEY | INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = nesso_panel_input,
+    .sync = nesso_panel_input_sync,
+};
+
+static const GraphicHwOps nesso_panel_ops = {
+    .gfx_update = nesso_panel_update,
+};
+
+static void nesso_panel_realize(DeviceState *dev, Error **errp)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+    QemuInputHandlerState *hs;
+
+    s->mem = g_new0(uint16_t, MEM_W * MEM_H);
+    s->disp_on = true;
+    s->sleep = false;
+    s->con = graphic_console_init(dev, 0, &nesso_panel_ops, s);
+    qemu_console_resize(s->con, PANEL_W, PANEL_H);
+    s->refresh_bh = qemu_bh_new(nesso_panel_refresh, s);
+    hs = qemu_input_handler_register(dev, &nesso_panel_input_handler);
+    qemu_input_handler_activate(hs);
+    qemu_bh_schedule(s->refresh_bh);
+}
+
+static void nesso_panel_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = nesso_panel_realize;
+}
+
+static const TypeInfo nesso_panel_info = {
+    .name = TYPE_ESP32C6_NESSO_PANEL,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(ESP32C6NessoPanelState),
+    .class_init = nesso_panel_class_init,
+};
+
+static void nesso_panel_register_types(void)
+{
+    type_register_static(&nesso_panel_info);
+}
+
+type_init(nesso_panel_register_types)
diff --git a/hw/misc/esp32c6_rmt.c b/hw/misc/esp32c6_rmt.c
new file mode 100644
index 0000000..4c6ff88
--- /dev/null
+++ b/hw/misc/esp32c6_rmt.c
@@ -0,0 +1,281 @@
+/*
+ * ESP32-C6 RMT APB, FIFO and hardware-memory model.
+ *
+ * The UIFlow2 IR stack uses the new RMT TX encoder in non-DMA mode.  This
+ * model accepts both direct memory writes and APB FIFO writes, captures the
+ * resulting rmt_symbol_word_t stream, and raises the channel TX_END interrupt.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32c6_rmt.h"
+
+#define RMT_MEM_OFFSET      0x400
+#define RMT_MEM_SIZE        0x800
+#define RMT_TX_CHANNELS     2
+#define RMT_SYMBOLS_PER_CH  48
+
+#define RMT_CH_DATA(ch)     (0x00 + (ch) * 4)
+#define RMT_CH_TX_CONF0(ch) (0x10 + (ch) * 4)
+#define RMT_CH_RX_CONF0(ch) (0x18 + (ch) * 8)
+#define RMT_CH_RX_CONF1(ch) (0x1c + (ch) * 8)
+#define RMT_RX_STATUS(ch)   (0x30 + (ch) * 4)
+#define RMT_INT_RAW         0x38
+#define RMT_INT_ST          0x3c
+#define RMT_INT_ENA         0x40
+#define RMT_INT_CLR         0x44
+
+typedef struct Esp32C6RmtState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    MemoryRegion mem;
+    qemu_irq irq;
+    uint32_t regs[RMT_MEM_OFFSET / 4];
+    uint32_t symbols[RMT_MEM_SIZE / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    uint32_t pending_tx;
+    uint32_t pending_rx;
+    uint32_t fifo_index[2];
+    bool rx_injected[2];
+    bool trace;
+    QEMUTimer *tx_timer;
+    QEMUTimer *rx_timer;
+    FILE *tx_file;
+} Esp32C6RmtState;
+
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32C6RmtState, ESP32C6_RMT)
+
+static void rmt_update_irq(Esp32C6RmtState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static void rmt_capture_tx(Esp32C6RmtState *s, uint32_t channel)
+{
+    uint32_t conf = s->regs[RMT_CH_TX_CONF0(channel) / 4];
+    uint32_t blocks = MAX((conf >> 16) & 0x7, 1);
+    uint32_t limit = MIN(blocks * RMT_SYMBOLS_PER_CH,
+                         RMT_SYMBOLS_PER_CH);
+    uint32_t base = channel * RMT_SYMBOLS_PER_CH;
+    uint32_t count = 0;
+
+    for (uint32_t i = 0; i < limit; i++) {
+        uint32_t symbol = s->symbols[base + i];
+        if ((symbol & 0x7fff) == 0 &&
+            ((symbol >> 16) & 0x7fff) == 0) {
+            break;
+        }
+        count++;
+    }
+    if (!s->tx_file) {
+        const char *path = getenv("M5SW_RMT_TX_FILE");
+        if (path) {
+            s->tx_file = fopen(path, "wb");
+        }
+    }
+    if (s->tx_file && count) {
+        fwrite(&s->symbols[base], sizeof(uint32_t), count, s->tx_file);
+        fflush(s->tx_file);
+    }
+    if (s->trace) {
+        fprintf(stderr,
+                "[c6-rmt] tx channel=%u symbols=%u blocks=%u fifo=%u\n",
+                channel, count, blocks, s->fifo_index[channel]);
+    }
+    s->int_raw |= 1u << channel;
+    rmt_update_irq(s);
+}
+
+static void rmt_tx_timer(void *opaque)
+{
+    Esp32C6RmtState *s = opaque;
+    uint32_t pending = s->pending_tx;
+    s->pending_tx = 0;
+
+    for (uint32_t channel = 0; channel < RMT_TX_CHANNELS; channel++) {
+        if (pending & (1u << channel)) {
+            rmt_capture_tx(s, channel);
+        }
+    }
+}
+
+static void rmt_rx_timer(void *opaque)
+{
+    Esp32C6RmtState *s = opaque;
+    uint32_t pending = s->pending_rx;
+    s->pending_rx = 0;
+
+    for (uint32_t channel = 0; channel < 2; channel++) {
+        if (pending & (1u << channel)) {
+            s->int_raw |= 1u << (2 + channel);
+        }
+    }
+    rmt_update_irq(s);
+}
+
+static void rmt_inject_rx(Esp32C6RmtState *s, uint32_t channel)
+{
+    const char *path = getenv("M5SW_RMT_RX_FILE");
+    g_autofree uint8_t *data = NULL;
+    gsize size = 0;
+    uint32_t count;
+    uint32_t base = (2 + channel) * RMT_SYMBOLS_PER_CH;
+
+    if (!path || s->rx_injected[channel] ||
+        !g_file_get_contents(path, (gchar **)&data, &size, NULL)) {
+        return;
+    }
+    count = MIN(size / sizeof(uint32_t), RMT_SYMBOLS_PER_CH);
+    memcpy(&s->symbols[base], data, count * sizeof(uint32_t));
+    s->regs[RMT_RX_STATUS(channel) / 4] = count;
+    s->rx_injected[channel] = true;
+    s->pending_rx |= 1u << channel;
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20);
+    if (s->trace) {
+        fprintf(stderr, "[c6-rmt] rx channel=%u symbols=%u\n",
+                channel, count);
+    }
+}
+
+static uint64_t rmt_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C6RmtState *s = opaque;
+
+    if (addr == RMT_INT_RAW) {
+        return s->int_raw;
+    }
+    if (addr == RMT_INT_ST) {
+        return s->int_raw & s->int_ena;
+    }
+    if (addr == RMT_INT_ENA) {
+        return s->int_ena;
+    }
+    return addr < RMT_MEM_OFFSET ? s->regs[addr / 4] : 0;
+}
+
+static void rmt_write(void *opaque, hwaddr addr, uint64_t value,
+                      unsigned size)
+{
+    Esp32C6RmtState *s = opaque;
+    uint32_t v = value;
+
+    if (s->trace) {
+        fprintf(stderr, "[c6-rmt] wr %03x <- %08x\n",
+                (unsigned)addr, v);
+    }
+    if (addr == RMT_INT_ENA) {
+        s->int_ena = v;
+        rmt_update_irq(s);
+        return;
+    }
+    if (addr == RMT_INT_CLR) {
+        s->int_raw &= ~v;
+        rmt_update_irq(s);
+        return;
+    }
+    if (addr < RMT_TX_CHANNELS * 4) {
+        uint32_t channel = addr / 4;
+        uint32_t index = s->fifo_index[channel];
+        if (index < RMT_SYMBOLS_PER_CH) {
+            s->symbols[channel * RMT_SYMBOLS_PER_CH + index] = v;
+            s->fifo_index[channel]++;
+        }
+        s->regs[addr / 4] = v;
+        return;
+    }
+    if (addr >= RMT_CH_TX_CONF0(0) &&
+        addr <= RMT_CH_TX_CONF0(RMT_TX_CHANNELS - 1)) {
+        uint32_t channel = (addr - RMT_CH_TX_CONF0(0)) / 4;
+        if (v & BIT(2)) {
+            s->fifo_index[channel] = 0;
+        }
+        s->regs[addr / 4] = v & ~1u;
+        if (v & BIT(0)) {
+            s->pending_tx |= 1u << channel;
+            timer_mod(s->tx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+        }
+        return;
+    }
+    if (addr == RMT_CH_RX_CONF1(0) || addr == RMT_CH_RX_CONF1(1)) {
+        uint32_t channel = (addr - RMT_CH_RX_CONF1(0)) / 8;
+        bool was_enabled = s->regs[addr / 4] & BIT(0);
+        s->regs[addr / 4] = v;
+        if (!was_enabled && (v & BIT(0))) {
+            rmt_inject_rx(s, channel);
+        }
+        return;
+    }
+    if (addr < RMT_MEM_OFFSET) {
+        s->regs[addr / 4] = v;
+    }
+}
+
+static const MemoryRegionOps rmt_ops = {
+    .read = rmt_read,
+    .write = rmt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void rmt_reset(DeviceState *dev)
+{
+    Esp32C6RmtState *s = ESP32C6_RMT(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->symbols, 0, sizeof(s->symbols));
+    memset(s->fifo_index, 0, sizeof(s->fifo_index));
+    memset(s->rx_injected, 0, sizeof(s->rx_injected));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->pending_tx = 0;
+    s->pending_rx = 0;
+    timer_del(s->tx_timer);
+    timer_del(s->rx_timer);
+}
+
+static void rmt_init(Object *obj)
+{
+    Esp32C6RmtState *s = ESP32C6_RMT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &rmt_ops, s, TYPE_ESP32C6_RMT,
+                          RMT_MEM_OFFSET);
+    memory_region_init_ram_ptr(&s->mem, obj, TYPE_ESP32C6_RMT ".mem",
+                               RMT_MEM_SIZE, s->symbols);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_mmio(sbd, &s->mem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->trace = getenv("M5SW_RMT_TRACE") != NULL;
+    s->tx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rmt_tx_timer, s);
+    s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rmt_rx_timer, s);
+}
+
+static void rmt_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, rmt_reset);
+}
+
+static const TypeInfo rmt_info = {
+    .name = TYPE_ESP32C6_RMT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32C6RmtState),
+    .instance_init = rmt_init,
+    .class_init = rmt_class_init,
+};
+
+static void rmt_register_types(void)
+{
+    type_register_static(&rmt_info);
+}
+
+type_init(rmt_register_types)
diff --git a/hw/misc/esp32c6_soft_i2c.c b/hw/misc/esp32c6_soft_i2c.c
new file mode 100644
index 0000000..3ffeafb
--- /dev/null
+++ b/hw/misc/esp32c6_soft_i2c.c
@@ -0,0 +1,221 @@
+/*
+ * Software-I2C bridge for ESP32-C6 board autodetection.
+ *
+ * M5GFX bit-bangs SDA/SCL before it knows which board it is running on.
+ * Decode that GPIO waveform and forward complete transfers to QEMU's I2C
+ * bus, so the same PI4IOE/FT5x06 models answer both the probe and the
+ * hardware-I2C path after handover.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/i2c/i2c.h"
+#include "hw/misc/esp32c6_soft_i2c.h"
+
+typedef enum {
+    C6_SOFT_I2C_IDLE,
+    C6_SOFT_I2C_ADDR,
+    C6_SOFT_I2C_TX,
+    C6_SOFT_I2C_RX,
+    C6_SOFT_I2C_ACK_ADDR,
+    C6_SOFT_I2C_ACK_TX,
+    C6_SOFT_I2C_ACK_RX,
+} C6SoftI2CState;
+
+typedef struct C6SoftI2C {
+    I2CBus *bus;
+    int sda_pin;
+    int scl_pin;
+    int sda;
+    int scl;
+    bool active;
+    bool in_xfer;
+    bool read;
+    C6SoftI2CState state;
+    bool ack_pending;
+    bool master_ack;
+    bool ack_step;
+    unsigned bit;
+    uint8_t shift;
+    uint8_t rx;
+} C6SoftI2C;
+
+static void c6_soft_i2c_drive_sda(C6SoftI2C *s, int level)
+{
+    esp32_gpio_set_input(s->sda_pin, level ? 1 : 0);
+    s->sda = esp32_gpio_get_line(s->sda_pin);
+}
+
+static void c6_soft_i2c_release_sda(C6SoftI2C *s)
+{
+    esp32_gpio_set_input(s->sda_pin, 1);
+    s->sda = esp32_gpio_get_line(s->sda_pin);
+}
+
+static void c6_soft_i2c_end(C6SoftI2C *s)
+{
+    if (s->in_xfer) {
+        i2c_end_transfer(s->bus);
+        s->in_xfer = false;
+    }
+    c6_soft_i2c_release_sda(s);
+}
+
+static void c6_soft_i2c_line(void *opaque, int pin, int level)
+{
+    C6SoftI2C *s = opaque;
+    int old_sda = s->sda;
+    int old_scl = s->scl;
+
+    if (pin == s->sda_pin) {
+        s->sda = level;
+    } else if (pin == s->scl_pin) {
+        s->scl = level;
+    } else {
+        return;
+    }
+
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-soft-i2c] pin=%d level=%d sda=%d scl=%d state=%d\n",
+                pin, level, s->sda, s->scl, s->state);
+    }
+
+    if (old_scl && old_sda && !s->sda && s->scl) {
+        c6_soft_i2c_end(s);
+        s->active = true;
+        s->state = C6_SOFT_I2C_ADDR;
+        s->bit = 0;
+        s->shift = 0;
+        s->ack_step = false;
+        c6_soft_i2c_release_sda(s);
+        return;
+    }
+
+    if (old_scl && !old_sda && s->sda && s->scl) {
+        c6_soft_i2c_end(s);
+        s->active = false;
+        s->state = C6_SOFT_I2C_IDLE;
+        return;
+    }
+
+    if (!s->active) {
+        return;
+    }
+
+    if (!old_scl && s->scl) {
+        switch (s->state) {
+        case C6_SOFT_I2C_ADDR:
+        case C6_SOFT_I2C_TX:
+            s->shift = (s->shift << 1) | (s->sda ? 1 : 0);
+            if (++s->bit == 8) {
+                if (s->state == C6_SOFT_I2C_ADDR) {
+                    uint8_t addr = s->shift >> 1;
+                    s->read = s->shift & 1;
+                    s->in_xfer = i2c_start_transfer(s->bus, addr,
+                                                    s->read) == 0;
+                    s->ack_pending = s->in_xfer;
+                    s->ack_step = false;
+                    c6_soft_i2c_release_sda(s);
+                    s->state = C6_SOFT_I2C_ACK_ADDR;
+                } else {
+                    bool ack = s->in_xfer &&
+                               i2c_send(s->bus, s->shift) == 0;
+                    s->ack_pending = ack;
+                    s->ack_step = false;
+                    c6_soft_i2c_release_sda(s);
+                    s->state = C6_SOFT_I2C_ACK_TX;
+                }
+                s->bit = 0;
+            }
+            break;
+        case C6_SOFT_I2C_RX:
+            s->shift = (s->shift << 1) | (s->sda ? 1 : 0);
+            if (++s->bit == 8) {
+                s->state = C6_SOFT_I2C_ACK_RX;
+                s->ack_step = false;
+            }
+            break;
+        case C6_SOFT_I2C_ACK_RX:
+            if (s->ack_step) {
+                s->master_ack = s->sda;
+                s->ack_step = false;
+                s->bit = 0;
+            }
+            break;
+        default:
+            break;
+        }
+        return;
+    }
+
+    if (old_scl && !s->scl) {
+        switch (s->state) {
+        case C6_SOFT_I2C_ACK_ADDR:
+            if (!s->ack_step) {
+                c6_soft_i2c_drive_sda(s, s->ack_pending ? 0 : 1);
+                s->ack_step = true;
+            } else {
+                c6_soft_i2c_release_sda(s);
+                if (s->read) {
+                    s->rx = s->in_xfer ? i2c_recv(s->bus) : 0xff;
+                    s->state = C6_SOFT_I2C_RX;
+                    s->bit = 0;
+                    c6_soft_i2c_drive_sda(s, (s->rx >> 7) & 1);
+                } else {
+                    s->state = C6_SOFT_I2C_TX;
+                    s->bit = 0;
+                }
+            }
+            break;
+        case C6_SOFT_I2C_ACK_TX:
+            if (!s->ack_step) {
+                c6_soft_i2c_drive_sda(s, s->ack_pending ? 0 : 1);
+                s->ack_step = true;
+            } else {
+                c6_soft_i2c_release_sda(s);
+                s->state = C6_SOFT_I2C_TX;
+                s->bit = 0;
+            }
+            break;
+        case C6_SOFT_I2C_RX:
+            if (s->bit > 0 && s->bit < 8) {
+                c6_soft_i2c_drive_sda(s, (s->rx >> (7 - s->bit)) & 1);
+            }
+            break;
+        case C6_SOFT_I2C_ACK_RX:
+            if (!s->ack_step) {
+                c6_soft_i2c_release_sda(s);
+                s->ack_step = true;
+            } else if (s->master_ack && s->in_xfer) {
+                i2c_nack(s->bus);
+                s->state = C6_SOFT_I2C_IDLE;
+            } else if (s->in_xfer) {
+                s->rx = i2c_recv(s->bus);
+                s->state = C6_SOFT_I2C_RX;
+                s->bit = 0;
+                c6_soft_i2c_drive_sda(s, (s->rx >> 7) & 1);
+            } else {
+                s->state = C6_SOFT_I2C_IDLE;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+void esp32c6_soft_i2c_init_pins(I2CBus *bus, int sda_pin, int scl_pin)
+{
+    C6SoftI2C *s = g_new0(C6SoftI2C, 1);
+
+    s->bus = bus;
+    s->sda_pin = sda_pin;
+    s->scl_pin = scl_pin;
+    s->sda = 1;
+    s->scl = 1;
+    esp32_gpio_set_open_drain(sda_pin, true);
+    esp32_gpio_set_open_drain(scl_pin, true);
+    esp32_gpio_add_out_listener(sda_pin, c6_soft_i2c_line, s);
+    esp32_gpio_add_out_listener(scl_pin, c6_soft_i2c_line, s);
+}
diff --git a/hw/misc/esp32c6_sx1262.c b/hw/misc/esp32c6_sx1262.c
new file mode 100644
index 0000000..75f9cce
--- /dev/null
+++ b/hw/misc/esp32c6_sx1262.c
@@ -0,0 +1,331 @@
+/*
+ * Semtech SX1262 SPI modem model for the Arduino Nesso N1.
+ *
+ * This implements the command/status/register/FIFO protocol and a local TX
+ * loopback packet path. RF propagation and multi-device airtime are out of
+ * scope; bytes still pass through the ESP32-C6 SPI2 controller on the board
+ * MOSI/MISO/SCK pins and GPIO23 chip select.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/misc/esp32c6_sx1262.h"
+
+#define SX1262_MAX_PACKET 255
+
+typedef enum {
+    SX_IDLE,
+    SX_ARGS,
+    SX_RESPONSE,
+    SX_WRITE_BUFFER,
+    SX_READ_BUFFER,
+} Sx1262Mode;
+
+typedef struct Esp32C6Sx1262State {
+    Sx1262Mode mode;
+    uint8_t opcode;
+    uint8_t args[16];
+    uint8_t arg_count;
+    uint8_t expected_args;
+    uint8_t response[264];
+    uint16_t response_len;
+    uint16_t response_pos;
+    uint8_t tx_packet[SX1262_MAX_PACKET];
+    uint8_t rx_packet[SX1262_MAX_PACKET];
+    uint16_t tx_len;
+    uint16_t rx_len;
+    uint16_t rx_pos;
+    uint16_t irq_status;
+    uint16_t registers[16];
+    int soft_cs;
+    int soft_sck;
+    int soft_mosi;
+    int soft_miso;
+    bool soft_selected;
+    int soft_sck_level;
+    uint8_t soft_tx_byte;
+    uint8_t soft_rx_byte;
+    uint8_t soft_bit_count;
+} Esp32C6Sx1262State;
+
+static uint8_t sx1262_status(void)
+{
+    return 0x20; /* STDBY_RC, command status OK */
+}
+
+static void sx1262_set_response(Esp32C6Sx1262State *s,
+                                const uint8_t *data, uint16_t size)
+{
+    memcpy(s->response, data, MIN(size, sizeof(s->response)));
+    s->response_len = MIN(size, sizeof(s->response));
+    s->response_pos = 0;
+    s->mode = SX_RESPONSE;
+}
+
+static void sx1262_command(Esp32C6Sx1262State *s)
+{
+    uint8_t response[4] = { sx1262_status(), 0, 0, 0 };
+
+    switch (s->opcode) {
+    case 0x02: /* CLR_IRQ_STATUS */
+        s->irq_status &= ~(((uint16_t)s->args[0] << 8) | s->args[1]);
+        s->mode = SX_IDLE;
+        break;
+    case 0x07: /* CLR_ERRORS */
+        s->mode = SX_IDLE;
+        break;
+    case 0x08: /* CFG_DIO_IRQ */
+        s->mode = SX_IDLE;
+        break;
+    case 0x0d: { /* WRITE_REGISTER */
+        uint16_t addr = ((uint16_t)s->args[0] << 8) | s->args[1];
+        s->registers[(addr >> 4) & 0xf] = s->args[2];
+        s->mode = SX_IDLE;
+        break;
+    }
+    case 0x0e: /* WRITE_BUFFER */
+        s->tx_len = 0;
+        s->mode = SX_WRITE_BUFFER;
+        break;
+    case 0x12: /* GET_IRQ_STATUS */
+        response[1] = s->irq_status >> 8;
+        response[2] = s->irq_status;
+        sx1262_set_response(s, response, 3);
+        break;
+    case 0x13: /* GET_RX_BUFFER_STATUS */
+        response[1] = s->rx_len;
+        response[2] = 0;
+        sx1262_set_response(s, response, 3);
+        break;
+    case 0x14: /* GET_PACKET_STATUS */
+        response[1] = 0xb0;
+        response[2] = 0x08;
+        response[3] = 0xb0;
+        sx1262_set_response(s, response, 4);
+        break;
+    case 0x17: /* GET_ERROR */
+        sx1262_set_response(s, response, 3);
+        break;
+    case 0x1d: { /* READ_REGISTER */
+        uint16_t addr = ((uint16_t)s->args[0] << 8) | s->args[1];
+        response[0] = s->registers[(addr >> 4) & 0xf];
+        sx1262_set_response(s, response, 1);
+        break;
+    }
+    case 0x1e: /* READ_BUFFER */
+        s->rx_pos = 0;
+        response[0] = sx1262_status();
+        sx1262_set_response(s, response, 1);
+        s->mode = SX_READ_BUFFER;
+        break;
+    case 0x80: /* SET_STANDBY */
+    case 0x84: /* SET_SLEEP */
+    case 0x82: /* SET_RX */
+    case 0x83: /* SET_TX */
+    case 0x86: /* SET_RF_FREQUENCY */
+    case 0x89: /* CALIBRATE */
+    case 0x8a: /* SET_PACKET_TYPE */
+    case 0x8b: /* SET_MODULATION_PARAMS */
+    case 0x8c: /* SET_PACKET_PARAMS */
+    case 0x8e: /* SET_TX_PARAMS */
+    case 0x8f: /* SET_BUFFER_BASE_ADDRESS */
+    case 0x95: /* SET_PA_CONFIG */
+    case 0x97: /* SET_DIO3_AS_TCXO_CTRL */
+    case 0x98: /* CALIBRATE_IMAGE */
+    case 0x9d: /* SET_DIO2_AS_RF_SWITCH_CTRL */
+        if (s->opcode == 0x83) {
+            memcpy(s->rx_packet, s->tx_packet, s->tx_len);
+            s->rx_len = s->tx_len;
+            s->irq_status = 1; /* TX_DONE */
+        } else if (s->opcode == 0x82 && s->rx_len) {
+            s->irq_status = 2; /* RX_DONE */
+        }
+        s->mode = SX_IDLE;
+        break;
+    case 0xc0: /* GET_STATUS */
+        response[0] = sx1262_status();
+        sx1262_set_response(s, response, 1);
+        break;
+    default:
+        s->mode = SX_IDLE;
+        break;
+    }
+}
+
+static uint8_t sx1262_transfer(void *opaque, uint8_t value)
+{
+    Esp32C6Sx1262State *s = opaque;
+
+    if (getenv("M5SW_SX1262_TRACE")) {
+        fprintf(stderr, "[c6-sx1262] mode=%d tx=%02x\n", s->mode, value);
+    }
+
+    switch (s->mode) {
+    case SX_IDLE:
+        s->opcode = value;
+        s->arg_count = 0;
+        s->expected_args = 0;
+        s->response_pos = 0;
+        s->response_len = 0;
+        switch (value) {
+        case 0x02: s->expected_args = 2; break;
+        case 0x07: s->expected_args = 1; break;
+        case 0x08: s->expected_args = 8; break;
+        case 0x0d: s->expected_args = 3; break;
+        case 0x0e: s->expected_args = 1; break;
+        case 0x1d: s->expected_args = 3; break;
+        case 0x1e: s->expected_args = 1; break;
+        case 0x80: s->expected_args = 1; break;
+        case 0x82: s->expected_args = 3; break;
+        case 0x83: s->expected_args = 3; break;
+        case 0x84: s->expected_args = 1; break;
+        case 0x86: s->expected_args = 4; break;
+        case 0x89: s->expected_args = 1; break;
+        case 0x8a: s->expected_args = 1; break;
+        case 0x8b: s->expected_args = 4; break;
+        case 0x8c: s->expected_args = 6; break;
+        case 0x8e: s->expected_args = 2; break;
+        case 0x8f: s->expected_args = 2; break;
+        case 0x95: s->expected_args = 4; break;
+        case 0x97: s->expected_args = 4; break;
+        case 0x98: s->expected_args = 2; break;
+        case 0x9d: s->expected_args = 1; break;
+        default: break;
+        }
+        if (s->expected_args == 0) {
+            sx1262_command(s);
+        } else {
+            s->mode = SX_ARGS;
+        }
+        return sx1262_status();
+    case SX_ARGS:
+        if (s->arg_count < sizeof(s->args)) {
+            s->args[s->arg_count] = value;
+        }
+        s->arg_count++;
+        if (s->arg_count >= s->expected_args) {
+            sx1262_command(s);
+        }
+        return sx1262_status();
+    case SX_RESPONSE:
+        if (s->response_pos < s->response_len) {
+            return s->response[s->response_pos++];
+        }
+        return sx1262_status();
+    case SX_WRITE_BUFFER:
+        if (s->tx_len < SX1262_MAX_PACKET) {
+            s->tx_packet[s->tx_len++] = value;
+        }
+        return sx1262_status();
+    case SX_READ_BUFFER:
+        if (!s->response_pos) {
+            s->response_pos++;
+            return sx1262_status();
+        }
+        if (s->rx_pos < s->rx_len) {
+            return s->rx_packet[s->rx_pos++];
+        }
+        return 0;
+    default:
+        return sx1262_status();
+    }
+}
+
+static void sx1262_soft_prepare_next(Esp32C6Sx1262State *s)
+{
+    if (s->mode == SX_RESPONSE &&
+        s->response_pos < s->response_len) {
+        s->soft_rx_byte = s->response[s->response_pos];
+    } else if (s->mode == SX_READ_BUFFER &&
+               s->response_pos > 0 && s->rx_pos < s->rx_len) {
+        s->soft_rx_byte = s->rx_packet[s->rx_pos];
+    } else {
+        s->soft_rx_byte = sx1262_status();
+    }
+}
+
+static void sx1262_cs_changed(void *opaque, int pin, int level)
+{
+    Esp32C6Sx1262State *s = opaque;
+
+    if (getenv("M5SW_SX1262_TRACE")) {
+        fprintf(stderr, "[c6-sx1262] cs pin=%d level=%d\n", pin, level);
+    }
+    if (level) {
+        s->mode = SX_IDLE;
+        s->response_pos = 0;
+        s->response_len = 0;
+    }
+}
+
+static void sx1262_soft_pin_changed(void *opaque, int pin, int level)
+{
+    Esp32C6Sx1262State *s = opaque;
+
+    if (pin == s->soft_cs) {
+        sx1262_cs_changed(opaque, pin, level);
+        s->soft_selected = !level;
+        s->soft_bit_count = 0;
+        s->soft_tx_byte = 0;
+        s->soft_rx_byte = sx1262_status();
+        esp32_gpio_force_line(s->soft_miso,
+                              !!(s->soft_rx_byte & 0x80));
+        return;
+    }
+    if (pin != s->soft_sck || !s->soft_selected) {
+        return;
+    }
+    if (level && !s->soft_sck_level) {
+        s->soft_tx_byte = (s->soft_tx_byte << 1) |
+                          esp32_gpio_get_line(s->soft_mosi);
+        s->soft_bit_count++;
+        if (s->soft_bit_count == 8) {
+            sx1262_transfer(s, s->soft_tx_byte);
+            sx1262_soft_prepare_next(s);
+            s->soft_tx_byte = 0;
+            s->soft_bit_count = 0;
+        }
+    } else if (!level) {
+        esp32_gpio_force_line(s->soft_miso,
+                              !!(s->soft_rx_byte & 0x80));
+        s->soft_rx_byte <<= 1;
+    }
+    s->soft_sck_level = level;
+}
+
+void esp32c6_sx1262_attach(DeviceState *spi, int cs_pin,
+                           int busy_pin, int dio1_pin)
+{
+    Esp32C6Sx1262State *s = g_new0(Esp32C6Sx1262State, 1);
+
+    esp32c3_spi_set_m5_slave(spi, cs_pin, s, sx1262_transfer);
+    esp32_gpio_add_out_listener(cs_pin, sx1262_cs_changed, s);
+    esp32_gpio_set_input(busy_pin, 0);
+    esp32_gpio_force_line(busy_pin, 0);
+    esp32_gpio_set_input(dio1_pin, 0);
+    esp32_gpio_force_line(dio1_pin, 0);
+}
+
+void esp32c6_sx1262_attach_soft_spi(int cs_pin, int sck_pin,
+                                   int mosi_pin, int miso_pin,
+                                   int busy_pin, int dio1_pin)
+{
+    Esp32C6Sx1262State *s = g_new0(Esp32C6Sx1262State, 1);
+
+    s->soft_cs = cs_pin;
+    s->soft_sck = sck_pin;
+    s->soft_mosi = mosi_pin;
+    s->soft_miso = miso_pin;
+    s->soft_rx_byte = sx1262_status();
+    esp32_gpio_add_out_listener(cs_pin, sx1262_soft_pin_changed, s);
+    esp32_gpio_add_out_listener(sck_pin, sx1262_soft_pin_changed, s);
+    esp32_gpio_add_out_listener(mosi_pin, sx1262_soft_pin_changed, s);
+    esp32_gpio_set_input(busy_pin, 0);
+    esp32_gpio_force_line(busy_pin, 0);
+    esp32_gpio_set_input(dio1_pin, 0);
+    esp32_gpio_force_line(dio1_pin, 0);
+    esp32_gpio_set_input(miso_pin, 1);
+    esp32_gpio_force_line(miso_pin, 1);
+}
