diff --git a/hw/misc/esp32c6_board_i2c.c b/hw/misc/esp32c6_board_i2c.c
new file mode 100644
index 0000000..437bd3e
--- /dev/null
+++ b/hw/misc/esp32c6_board_i2c.c
@@ -0,0 +1,192 @@
+/*
+ * Minimal I2C devices used by the Arduino Nesso N1 board.
+ *
+ * The board detector needs PI4IOE1/PI4IOE2 ACKs and the board's
+ * FT5x06-compatible touch controller.  The models are deliberately
+ * register-level rather than full peripheral emulations so firmware can
+ * complete autodetection and UI input without a physical board.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/i2c/i2c.h"
+#include "hw/qdev-properties.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/misc/esp32c6_board_i2c.h"
+
+enum {
+    C6_DEV_GENERIC,
+    C6_DEV_FT5X06,
+    C6_DEV_PI4IOE,
+    C6_DEV_BMI270,
+};
+
+typedef struct C6BoardI2CDev {
+    I2CSlave parent_obj;
+    char *model_name;
+    int model;
+    uint8_t regs[256];
+    uint8_t ptr;
+    bool ptr_set;
+} C6BoardI2CDev;
+
+OBJECT_DECLARE_SIMPLE_TYPE(C6BoardI2CDev, ESP32C6_BOARD_I2C_DEV)
+
+static C6BoardI2CDev *g_ft;
+static int g_touch_pressed;
+static int g_touch_x;
+static int g_touch_y;
+static uint8_t g_buttons = 0x03;
+
+void esp32c6_ft_touch_set(int pressed, int x, int y)
+{
+    g_touch_pressed = pressed;
+    g_touch_x = x;
+    g_touch_y = y;
+    if (g_ft) {
+        g_ft->regs[0x02] = pressed ? 1 : 0;
+        g_ft->regs[0x03] = (x >> 8) & 0x0f;
+        g_ft->regs[0x04] = x & 0xff;
+        g_ft->regs[0x05] = (y >> 8) & 0x0f;
+        g_ft->regs[0x06] = y & 0xff;
+    }
+    esp32_gpio_force_line(3, !pressed);
+}
+
+void esp32c6_pi4ioe_button_set(int button, bool pressed)
+{
+    if (button < 0 || button > 1) {
+        return;
+    }
+    if (pressed) {
+        g_buttons &= ~(1u << button);
+    } else {
+        g_buttons |= 1u << button;
+    }
+}
+
+static uint8_t c6_i2c_read(C6BoardI2CDev *s, uint8_t reg)
+{
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-i2c] read model=%d reg=%02x\n", s->model, reg);
+    }
+    if (s->model == C6_DEV_FT5X06) {
+        switch (reg) {
+        case 0x02:
+            return g_touch_pressed ? 1 : 0;
+        case 0x03:
+            return (g_touch_x >> 8) & 0x0f;
+        case 0x04:
+            return g_touch_x & 0xff;
+        case 0x05:
+            return (g_touch_y >> 8) & 0x0f;
+        case 0x06:
+            return g_touch_y & 0xff;
+        case 0xA3:
+            return 0x51;
+        case 0xA6:
+            return 0x10;
+        case 0xA8:
+            return 0x11;
+        default:
+            break;
+        }
+    } else if (s->model == C6_DEV_PI4IOE) {
+        if (reg == 0x01) {
+            return 0x01;
+        }
+        if (reg == 0x0f) {
+            return g_buttons;
+        }
+    } else if (s->model == C6_DEV_BMI270 && reg == 0x00) {
+        return 0x24;
+    }
+    return s->regs[reg];
+}
+
+static int c6_i2c_event(I2CSlave *i2c, enum i2c_event event)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+
+    if (event == I2C_START_SEND) {
+        s->ptr_set = false;
+    }
+    return 0;
+}
+
+static uint8_t c6_i2c_recv(I2CSlave *i2c)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+    uint8_t value = c6_i2c_read(s, s->ptr++);
+    return value;
+}
+
+static int c6_i2c_send(I2CSlave *i2c, uint8_t data)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)i2c;
+
+    if (!s->ptr_set) {
+        s->ptr = data;
+        s->ptr_set = true;
+        return 0;
+    }
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-i2c] write model=%d reg=%02x data=%02x\n",
+                s->model, s->ptr, data);
+    }
+    s->regs[s->ptr++] = data;
+    return 0;
+}
+
+static void c6_i2c_realize(DeviceState *dev, Error **errp)
+{
+    C6BoardI2CDev *s = (C6BoardI2CDev *)dev;
+    const char *model = s->model_name ? s->model_name : "generic";
+
+    s->model = C6_DEV_GENERIC;
+    if (!strcmp(model, "ft5x06")) {
+        s->model = C6_DEV_FT5X06;
+        g_ft = s;
+    } else if (!strcmp(model, "pi4ioe")) {
+        s->model = C6_DEV_PI4IOE;
+    } else if (!strcmp(model, "bmi270")) {
+        s->model = C6_DEV_BMI270;
+        s->regs[0x00] = 0x24;
+        s->regs[0x03] = 0xc0;
+        s->regs[0x1d] = 0xc0;
+    }
+}
+
+static Property c6_i2c_props[] = {
+    DEFINE_PROP_STRING("model", C6BoardI2CDev, model_name),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void c6_i2c_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    dc->realize = c6_i2c_realize;
+    device_class_set_props(dc, c6_i2c_props);
+    k->event = c6_i2c_event;
+    k->recv = c6_i2c_recv;
+    k->send = c6_i2c_send;
+}
+
+static const TypeInfo c6_i2c_info = {
+    .name = TYPE_ESP32C6_BOARD_I2C_DEV,
+    .parent = TYPE_I2C_SLAVE,
+    .instance_size = sizeof(C6BoardI2CDev),
+    .class_init = c6_i2c_class_init,
+};
+
+static void c6_i2c_register_types(void)
+{
+    type_register_static(&c6_i2c_info);
+}
+
+type_init(c6_i2c_register_types)
diff --git a/hw/misc/esp32c6_nesso_panel.c b/hw/misc/esp32c6_nesso_panel.c
new file mode 100644
index 0000000..f6bcbe3
--- /dev/null
+++ b/hw/misc/esp32c6_nesso_panel.c
@@ -0,0 +1,341 @@
+/*
+ * Arduino Nesso N1 ST7789 panel model.
+ *
+ * The board's display is a 135x240 ST7789 behind a 52/40 controller
+ * offset.  This model implements the DCS subset used by M5GFX, keeps an
+ * RGB565 framebuffer, and exposes it through a QEMU console so screendump
+ * and the device-center preview path can consume it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "hw/qdev-core.h"
+#include "hw/qdev-properties.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "hw/misc/esp32c6_nesso_panel.h"
+#include "hw/misc/esp32c6_board_i2c.h"
+
+#define PANEL_W 135
+#define PANEL_H 240
+#define PANEL_OFF_X 52
+#define PANEL_OFF_Y 40
+#define MEM_W 240
+#define MEM_H 320
+
+struct ESP32C6NessoPanelState {
+    DeviceState parent_obj;
+    QemuConsole *con;
+    QEMUBH *refresh_bh;
+    uint16_t *mem;
+    uint8_t madctl;
+    uint8_t cmd;
+    uint8_t params[4];
+    unsigned pidx;
+    uint16_t xs;
+    uint16_t xe;
+    uint16_t ys;
+    uint16_t ye;
+    uint16_t cx;
+    uint16_t cy;
+    bool pixel_half;
+    uint8_t pix_hi;
+    bool disp_on;
+    bool sleep;
+    bool dirty;
+    unsigned trace_count;
+    bool saw_nonzero;
+    int mouse_x;
+    int mouse_y;
+    bool mouse_down;
+};
+
+static void nesso_panel_reset_window(ESP32C6NessoPanelState *s)
+{
+    s->cx = s->xs;
+    s->cy = s->ys;
+}
+
+static void nesso_panel_put_pixel(ESP32C6NessoPanelState *s, uint16_t px)
+{
+    int x = s->cx;
+    int y = s->cy;
+    if (getenv("M5SW_NESSO_PANEL_PIXEL_TRACE") && s->trace_count++ < 8) {
+        fprintf(stderr, "[nesso-pixel] (%d,%d) window x=%u..%u y=%u..%u\n",
+                x, y, s->xs, s->xe, s->ys, s->ye);
+    }
+    static int row_trace;
+    static int last_y = -1;
+    if (getenv("M5SW_NESSO_ROW_TRACE") && y != last_y && px != 0 &&
+        row_trace < 8) {
+        fprintf(stderr, "[nesso-row] first y=%d x=%d px=%04x\n", y, x, px);
+        last_y = y;
+        row_trace++;
+    }
+    if (px == 0xf800) {
+        s->saw_nonzero = true;
+    } else if (px == 0 && s->saw_nonzero &&
+               getenv("M5SW_NESSO_PANEL_BLACK_TRACE")) {
+        fprintf(stderr, "[nesso-black] x=%d y=%d\n", x, y);
+    }
+
+    /*
+     * M5GFX already applies the board rotation and the 52/40 controller
+     * offset when it programs CASET/RASET.  Apply MADCTL a second time
+     * here and the 135-wide stream is transposed into a diagonal pattern.
+     */
+    if (x >= 0 && x < MEM_W && y >= 0 && y < MEM_H) {
+        s->mem[y * MEM_W + x] = px;
+    }
+    if (++s->cx > s->xe) {
+        s->cx = s->xs;
+        if (++s->cy > s->ye) {
+            s->cy = s->ys;
+        }
+    }
+}
+
+void esp32c6_nesso_panel_write(void *opaque, const uint8_t *buf, uint32_t len,
+                               bool command_phase)
+{
+    ESP32C6NessoPanelState *s = opaque;
+    static unsigned dump_count;
+    if (getenv("M5SW_NESSO_PANEL_DUMP") && s->cmd == 0x2c &&
+        !command_phase) {
+        dump_count++;
+    }
+    if (getenv("M5SW_NESSO_PANEL_DUMP") && s->cmd == 0x2c &&
+        (dump_count <= 2 || (dump_count >= 1000 && dump_count <= 1005)) &&
+        !command_phase) {
+        fprintf(stderr, "[nesso-dump] len=%u first:", len);
+        for (uint32_t i = 0; i < MIN(len, 32u); i++) {
+            fprintf(stderr, " %02x", buf[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    for (uint32_t i = 0; i < len; i++) {
+        uint8_t b = buf[i];
+
+        if (command_phase) {
+            s->cmd = b;
+            s->pidx = 0;
+            s->pixel_half = false;
+            if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                fprintf(stderr, "[nesso-panel] CMD %02x\n", b);
+            }
+            switch (b) {
+            case 0x28:
+                s->disp_on = false;
+                s->dirty = true;
+                break;
+            case 0x29:
+                s->disp_on = true;
+                s->dirty = true;
+                break;
+            case 0x10:
+                s->sleep = true;
+                s->dirty = true;
+                break;
+            case 0x11:
+                s->sleep = false;
+                s->dirty = true;
+                break;
+            case 0x01:
+                s->disp_on = false;
+                s->sleep = true;
+                s->madctl = 0;
+                break;
+            case 0x2C:
+            case 0x3C:
+                nesso_panel_reset_window(s);
+                s->trace_count = 0;
+                break;
+            default:
+                break;
+            }
+            continue;
+        }
+
+        if (i == 0 && getenv("M5SW_NESSO_PANEL_TRACE")) {
+            fprintf(stderr, "[nesso-panel] DATA cmd=%02x len=%u first=%02x\n",
+                    s->cmd, len, b);
+        }
+        switch (s->cmd) {
+        case 0x2A:
+            if (s->pidx < 4) {
+                s->params[s->pidx++] = b;
+            }
+            if (s->pidx == 4) {
+                s->xs = (s->params[0] << 8) | s->params[1];
+                s->xe = (s->params[2] << 8) | s->params[3];
+                if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                    fprintf(stderr, "[nesso-panel] CASET %u..%u\n", s->xs, s->xe);
+                }
+            }
+            break;
+        case 0x2B:
+            if (s->pidx < 4) {
+                s->params[s->pidx++] = b;
+            }
+            if (s->pidx == 4) {
+                s->ys = (s->params[0] << 8) | s->params[1];
+                s->ye = (s->params[2] << 8) | s->params[3];
+                if (getenv("M5SW_NESSO_PANEL_TRACE")) {
+                    fprintf(stderr, "[nesso-panel] RASET %u..%u\n", s->ys, s->ye);
+                }
+            }
+            break;
+        case 0x2C:
+        case 0x3C:
+            if (!s->pixel_half) {
+                s->pix_hi = b;
+                s->pixel_half = true;
+            } else {
+                nesso_panel_put_pixel(s, (s->pix_hi << 8) | b);
+                s->pixel_half = false;
+                s->dirty = true;
+            }
+            break;
+        case 0x36:
+            s->madctl = b;
+            s->dirty = true;
+            break;
+        default:
+            break;
+        }
+    }
+    if (s->dirty && s->refresh_bh) {
+        qemu_bh_schedule(s->refresh_bh);
+    }
+}
+
+static void nesso_panel_update(void *opaque)
+{
+    ESP32C6NessoPanelState *s = opaque;
+    DisplaySurface *surf;
+    uint32_t *dst;
+    int stride;
+
+    if (!s->dirty) {
+        return;
+    }
+    s->dirty = false;
+    surf = qemu_console_surface(s->con);
+    if (!surf || surface_bits_per_pixel(surf) != 32 ||
+        surface_width(surf) != PANEL_W ||
+        surface_height(surf) != PANEL_H) {
+        surf = qemu_create_displaysurface(PANEL_W, PANEL_H);
+        dpy_gfx_replace_surface(s->con, surf);
+    }
+    if (getenv("M5SW_NESSO_UPDATE_TRACE")) {
+        fprintf(stderr, "[nesso-update] surface=%ux%u stride=%d dirty-sample=%04x\n",
+                surface_width(surf), surface_height(surf), surface_stride(surf),
+                s->mem[(PANEL_OFF_Y + 20) * MEM_W + PANEL_OFF_X + 20]);
+    }
+    dst = (uint32_t *)surface_data(surf);
+    stride = surface_stride(surf) / 4;
+    for (int py = 0; py < PANEL_H; py++) {
+        for (int px = 0; px < PANEL_W; px++) {
+            uint16_t p = s->mem[(py + PANEL_OFF_Y) * MEM_W +
+                                (px + PANEL_OFF_X)];
+            uint32_t r = ((p >> 11) & 0x1f) * 255 / 31;
+            uint32_t g = ((p >> 5) & 0x3f) * 255 / 63;
+            uint32_t b = (p & 0x1f) * 255 / 31;
+            if (!s->disp_on || s->sleep) {
+                r = g = b = 0;
+            }
+            dst[py * stride + px] = 0xff000000u | (r << 16) | (g << 8) | b;
+        }
+    }
+    dpy_gfx_update(s->con, 0, 0, PANEL_W, PANEL_H);
+}
+
+static void nesso_panel_refresh(void *opaque)
+{
+    nesso_panel_update(opaque);
+}
+
+static void nesso_panel_input(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS: {
+        InputMoveEvent *m = evt->u.abs.data;
+        if (m->axis == INPUT_AXIS_X) {
+            s->mouse_x = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
+                                               INPUT_EVENT_ABS_MAX, 0,
+                                               PANEL_W - 1);
+        } else if (m->axis == INPUT_AXIS_Y) {
+            s->mouse_y = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
+                                               INPUT_EVENT_ABS_MAX, 0,
+                                               PANEL_H - 1);
+        }
+        break;
+    }
+    case INPUT_EVENT_KIND_BTN: {
+        InputBtnEvent *b = evt->u.btn.data;
+        if (b->button == INPUT_BUTTON_LEFT) {
+            s->mouse_down = b->down;
+        }
+        break;
+    }
+    default:
+        break;
+    }
+}
+
+static void nesso_panel_input_sync(DeviceState *dev)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+    esp32c6_ft_touch_set(s->mouse_down, s->mouse_x, s->mouse_y);
+}
+
+static const QemuInputHandler nesso_panel_input_handler = {
+    .name = "Nesso N1 touch",
+    .mask = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = nesso_panel_input,
+    .sync = nesso_panel_input_sync,
+};
+
+static const GraphicHwOps nesso_panel_ops = {
+    .gfx_update = nesso_panel_update,
+};
+
+static void nesso_panel_realize(DeviceState *dev, Error **errp)
+{
+    ESP32C6NessoPanelState *s = (ESP32C6NessoPanelState *)dev;
+    QemuInputHandlerState *hs;
+
+    s->mem = g_new0(uint16_t, MEM_W * MEM_H);
+    s->disp_on = true;
+    s->sleep = false;
+    s->con = graphic_console_init(dev, 0, &nesso_panel_ops, s);
+    qemu_console_resize(s->con, PANEL_W, PANEL_H);
+    s->refresh_bh = qemu_bh_new(nesso_panel_refresh, s);
+    hs = qemu_input_handler_register(dev, &nesso_panel_input_handler);
+    qemu_input_handler_activate(hs);
+    qemu_bh_schedule(s->refresh_bh);
+}
+
+static void nesso_panel_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->realize = nesso_panel_realize;
+}
+
+static const TypeInfo nesso_panel_info = {
+    .name = TYPE_ESP32C6_NESSO_PANEL,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(ESP32C6NessoPanelState),
+    .class_init = nesso_panel_class_init,
+};
+
+static void nesso_panel_register_types(void)
+{
+    type_register_static(&nesso_panel_info);
+}
+
+type_init(nesso_panel_register_types)
diff --git a/hw/misc/esp32c6_soft_i2c.c b/hw/misc/esp32c6_soft_i2c.c
new file mode 100644
index 0000000..3ffeafb
--- /dev/null
+++ b/hw/misc/esp32c6_soft_i2c.c
@@ -0,0 +1,221 @@
+/*
+ * Software-I2C bridge for ESP32-C6 board autodetection.
+ *
+ * M5GFX bit-bangs SDA/SCL before it knows which board it is running on.
+ * Decode that GPIO waveform and forward complete transfers to QEMU's I2C
+ * bus, so the same PI4IOE/FT5x06 models answer both the probe and the
+ * hardware-I2C path after handover.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/gpio/esp32_gpio.h"
+#include "hw/i2c/i2c.h"
+#include "hw/misc/esp32c6_soft_i2c.h"
+
+typedef enum {
+    C6_SOFT_I2C_IDLE,
+    C6_SOFT_I2C_ADDR,
+    C6_SOFT_I2C_TX,
+    C6_SOFT_I2C_RX,
+    C6_SOFT_I2C_ACK_ADDR,
+    C6_SOFT_I2C_ACK_TX,
+    C6_SOFT_I2C_ACK_RX,
+} C6SoftI2CState;
+
+typedef struct C6SoftI2C {
+    I2CBus *bus;
+    int sda_pin;
+    int scl_pin;
+    int sda;
+    int scl;
+    bool active;
+    bool in_xfer;
+    bool read;
+    C6SoftI2CState state;
+    bool ack_pending;
+    bool master_ack;
+    bool ack_step;
+    unsigned bit;
+    uint8_t shift;
+    uint8_t rx;
+} C6SoftI2C;
+
+static void c6_soft_i2c_drive_sda(C6SoftI2C *s, int level)
+{
+    esp32_gpio_set_input(s->sda_pin, level ? 1 : 0);
+    s->sda = esp32_gpio_get_line(s->sda_pin);
+}
+
+static void c6_soft_i2c_release_sda(C6SoftI2C *s)
+{
+    esp32_gpio_set_input(s->sda_pin, 1);
+    s->sda = esp32_gpio_get_line(s->sda_pin);
+}
+
+static void c6_soft_i2c_end(C6SoftI2C *s)
+{
+    if (s->in_xfer) {
+        i2c_end_transfer(s->bus);
+        s->in_xfer = false;
+    }
+    c6_soft_i2c_release_sda(s);
+}
+
+static void c6_soft_i2c_line(void *opaque, int pin, int level)
+{
+    C6SoftI2C *s = opaque;
+    int old_sda = s->sda;
+    int old_scl = s->scl;
+
+    if (pin == s->sda_pin) {
+        s->sda = level;
+    } else if (pin == s->scl_pin) {
+        s->scl = level;
+    } else {
+        return;
+    }
+
+    if (getenv("M5SW_C6_I2C_TRACE")) {
+        fprintf(stderr, "[c6-soft-i2c] pin=%d level=%d sda=%d scl=%d state=%d\n",
+                pin, level, s->sda, s->scl, s->state);
+    }
+
+    if (old_scl && old_sda && !s->sda && s->scl) {
+        c6_soft_i2c_end(s);
+        s->active = true;
+        s->state = C6_SOFT_I2C_ADDR;
+        s->bit = 0;
+        s->shift = 0;
+        s->ack_step = false;
+        c6_soft_i2c_release_sda(s);
+        return;
+    }
+
+    if (old_scl && !old_sda && s->sda && s->scl) {
+        c6_soft_i2c_end(s);
+        s->active = false;
+        s->state = C6_SOFT_I2C_IDLE;
+        return;
+    }
+
+    if (!s->active) {
+        return;
+    }
+
+    if (!old_scl && s->scl) {
+        switch (s->state) {
+        case C6_SOFT_I2C_ADDR:
+        case C6_SOFT_I2C_TX:
+            s->shift = (s->shift << 1) | (s->sda ? 1 : 0);
+            if (++s->bit == 8) {
+                if (s->state == C6_SOFT_I2C_ADDR) {
+                    uint8_t addr = s->shift >> 1;
+                    s->read = s->shift & 1;
+                    s->in_xfer = i2c_start_transfer(s->bus, addr,
+                                                    s->read) == 0;
+                    s->ack_pending = s->in_xfer;
+                    s->ack_step = false;
+                    c6_soft_i2c_release_sda(s);
+                    s->state = C6_SOFT_I2C_ACK_ADDR;
+                } else {
+                    bool ack = s->in_xfer &&
+                               i2c_send(s->bus, s->shift) == 0;
+                    s->ack_pending = ack;
+                    s->ack_step = false;
+                    c6_soft_i2c_release_sda(s);
+                    s->state = C6_SOFT_I2C_ACK_TX;
+                }
+                s->bit = 0;
+            }
+            break;
+        case C6_SOFT_I2C_RX:
+            s->shift = (s->shift << 1) | (s->sda ? 1 : 0);
+            if (++s->bit == 8) {
+                s->state = C6_SOFT_I2C_ACK_RX;
+                s->ack_step = false;
+            }
+            break;
+        case C6_SOFT_I2C_ACK_RX:
+            if (s->ack_step) {
+                s->master_ack = s->sda;
+                s->ack_step = false;
+                s->bit = 0;
+            }
+            break;
+        default:
+            break;
+        }
+        return;
+    }
+
+    if (old_scl && !s->scl) {
+        switch (s->state) {
+        case C6_SOFT_I2C_ACK_ADDR:
+            if (!s->ack_step) {
+                c6_soft_i2c_drive_sda(s, s->ack_pending ? 0 : 1);
+                s->ack_step = true;
+            } else {
+                c6_soft_i2c_release_sda(s);
+                if (s->read) {
+                    s->rx = s->in_xfer ? i2c_recv(s->bus) : 0xff;
+                    s->state = C6_SOFT_I2C_RX;
+                    s->bit = 0;
+                    c6_soft_i2c_drive_sda(s, (s->rx >> 7) & 1);
+                } else {
+                    s->state = C6_SOFT_I2C_TX;
+                    s->bit = 0;
+                }
+            }
+            break;
+        case C6_SOFT_I2C_ACK_TX:
+            if (!s->ack_step) {
+                c6_soft_i2c_drive_sda(s, s->ack_pending ? 0 : 1);
+                s->ack_step = true;
+            } else {
+                c6_soft_i2c_release_sda(s);
+                s->state = C6_SOFT_I2C_TX;
+                s->bit = 0;
+            }
+            break;
+        case C6_SOFT_I2C_RX:
+            if (s->bit > 0 && s->bit < 8) {
+                c6_soft_i2c_drive_sda(s, (s->rx >> (7 - s->bit)) & 1);
+            }
+            break;
+        case C6_SOFT_I2C_ACK_RX:
+            if (!s->ack_step) {
+                c6_soft_i2c_release_sda(s);
+                s->ack_step = true;
+            } else if (s->master_ack && s->in_xfer) {
+                i2c_nack(s->bus);
+                s->state = C6_SOFT_I2C_IDLE;
+            } else if (s->in_xfer) {
+                s->rx = i2c_recv(s->bus);
+                s->state = C6_SOFT_I2C_RX;
+                s->bit = 0;
+                c6_soft_i2c_drive_sda(s, (s->rx >> 7) & 1);
+            } else {
+                s->state = C6_SOFT_I2C_IDLE;
+            }
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+void esp32c6_soft_i2c_init_pins(I2CBus *bus, int sda_pin, int scl_pin)
+{
+    C6SoftI2C *s = g_new0(C6SoftI2C, 1);
+
+    s->bus = bus;
+    s->sda_pin = sda_pin;
+    s->scl_pin = scl_pin;
+    s->sda = 1;
+    s->scl = 1;
+    esp32_gpio_set_open_drain(sda_pin, true);
+    esp32_gpio_set_open_drain(scl_pin, true);
+    esp32_gpio_add_out_listener(sda_pin, c6_soft_i2c_line, s);
+    esp32_gpio_add_out_listener(scl_pin, c6_soft_i2c_line, s);
+}
