diff --git a/target/riscv/esp_cpu.c b/target/riscv/esp_cpu.c
index e3cc1ed..16a3a12 100644
--- a/target/riscv/esp_cpu.c
+++ b/target/riscv/esp_cpu.c
@@ -18,6 +18,7 @@
 #include "hw/irq.h"
 #include "hw/qdev-properties.h"
 #include "sysemu/reset.h"
+#include "exec/exec-all.h"
 #include "esp_cpu.h"
 
 #define BIT_SET(reg, bit)   ((reg) & BIT(bit))
@@ -334,10 +335,26 @@ static void set_misa(CPURISCVState *env, RISCVMXL mxl, uint32_t ext)
 static void esp_cpu_reset(void *opaque)
 {
     EspRISCVCPU *cpu = opaque;
+    CPUState *cs = CPU(cpu);
+    CPURISCVState *env = &cpu->parent_obj.env;
+
     cpu->irq_lines = 0;
     cpu->mie_enabled = 0;
     qemu_irq_lower(cpu->parent_irq);
-    cpu_reset(CPU(cpu));
+    cpu_reset(cs);
+
+    if (cpu->has_pma) {
+        /*
+         * The C6 ROM configures PMP entries during early boot and expects a
+         * software reset to restore the reset-visible PMP state.  The generic
+         * RISC-V reset only unlocks entries, leaving permission bits and
+         * ranges behind.  A second ROM boot can then fault while copying its
+         * LP-RAM trampoline before it has a chance to replace the old rules.
+         */
+        memset(&env->pmp_state, 0, sizeof(env->pmp_state));
+        env->mseccfg = 0;
+        tlb_flush(cs);
+    }
 }
 
 static void esp_cpu_realize(DeviceState *dev, Error **errp)
