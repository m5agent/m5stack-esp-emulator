+/* The C6 divider retains source-cycle progress across PCR mux/gate changes.
+ * Split seconds and nanoseconds to avoid overflow and retain sub-tick progress;
+ * integer output Hz would lose RC_FAST / 20000 = 875 Hz entirely in the legacy
+ * counter, which rounds frequency down to whole kHz. Other SoCs keep that path.
+ */
+static int64_t esp_wdt_counter_update(ESPWdtState *wdt)
+{
+    ESPVirtualCounter *counter = &wdt->counter;
+    if (!wdt->external_clock) {
+        return esp_virtual_counter_update(counter);
+    }
+    uint64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint64_t elapsed = now - counter->base;
+    if (wdt->armed) {
+        uint64_t fraction = (elapsed % 1000000000ULL) * wdt->source_hz +
+                            wdt->source_fraction;
+        uint64_t cycles = (elapsed / 1000000000ULL) * wdt->source_hz +
+                          fraction / 1000000000ULL + wdt->source_cycles;
+        uint32_t divider = MAX(wdt->prescaler, 1);
+        counter->value += cycles / divider;
+        wdt->source_cycles = cycles % divider;
+        wdt->source_fraction = fraction % 1000000000ULL;
+    }
+    counter->base = now;
+    return counter->value;
+}
+
+static void esp_wdt_reschedule(ESPWdtState *wdt)
+{
+    timer_del(&wdt->counter.timer);
+    if (!wdt->armed || !wdt->source_hz) {
+        return;
+    }
+    uint64_t delay = 0;
+    if (wdt->target > wdt->counter.value) {
+        uint64_t cycles = (wdt->target - wdt->counter.value) *
+                          MAX(wdt->prescaler, 1) - wdt->source_cycles;
+        int64_t fraction = (int64_t)((cycles % wdt->source_hz) * 1000000000ULL) -
+                           (int64_t)wdt->source_fraction;
+        int64_t hz = wdt->source_hz;
+        /* Signed division rounds a negative numerator toward zero (ceil). */
+        int64_t ns = fraction > 0 ?
+            (fraction + hz - 1) / hz : fraction / hz;
+        delay = (cycles / wdt->source_hz) * 1000000000ULL + ns;
+    }
+    timer_mod_ns(&wdt->counter.timer, wdt->counter.base + delay);
+}
+
+static void esp_wdt_alarm_in_ticks(ESPWdtState *wdt, uint64_t ticks)
+{
+    if (!wdt->external_clock) {
+        esp_virtual_counter_alarm_in_ticks(&wdt->counter, ticks);
+        return;
+    }
+    wdt->counter.base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    wdt->counter.value = 0;
+    wdt->source_cycles = 0;
+    wdt->source_fraction = 0;
+    wdt->target = ticks;
+    wdt->armed = true;
+    esp_wdt_reschedule(wdt);
+}
+
+void esp_timg_set_wdt_clock(ESPTimgState *s, uint64_t hz)
+{
+    ESPWdtState *wdt = &s->wdt;
+    if (wdt->external_clock) {
+        esp_wdt_counter_update(wdt);
+    }
+    wdt->external_clock = true;
+    wdt->source_hz = hz;
+    wdt->counter.frequency = hz / MAX(wdt->prescaler, 1);
+    esp_wdt_reschedule(wdt);
+}
