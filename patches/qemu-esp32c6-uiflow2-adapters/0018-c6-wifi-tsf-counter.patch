     uint32_t mac_regs[ESP32C6_WIFI_MAC_IO_SIZE / sizeof(uint32_t)];
     uint32_t modem_regs[ESP32C6_WIFI_MODEM_IO_SIZE / sizeof(uint32_t)];
     uint32_t rf_regs[ESP32C6_WIFI_RF_IO_SIZE / sizeof(uint32_t)];
