+/*
+ * Fixed USB Serial/JTAG CDC endpoints, distinct from USB OTG.
+ * The IN FIFO/host-frame path follows the existing ESP32-S3/C3 model.
+ * This chardev is an explicit virtual serial host, not USB enumeration.
+ * Off without an explicit virtual host chardev.
+ */
+enum {
+    EP1 = 0x00,
+    EP1_CONF = 0x04,
+    INT_RAW = 0x08,
+    INT_STATUS = 0x0c,
+    INT_ENABLE = 0x10,
+    INT_CLEAR = 0x14,
+    CONF0 = 0x18,
+    FRAME_NUM = 0x24,
+
+    WR_DONE = BIT(0),
+    IN_DATA_FREE = BIT(1),
+    OUT_DATA_AVAIL = BIT(2),
+    IRQ_SOF = BIT(1),
+    IRQ_OUT_PACKET = BIT(2),
+    IRQ_IN_EMPTY = BIT(3),
+    PHY_EXTERNAL = BIT(0),
+    PAD_PULL_OVERRIDE = BIT(8),
+    DP_PULLUP = BIT(9),
+    PAD_ENABLE = BIT(14),
+};
+
+static void esp32c6_jtag_update_irq(ESP32C6UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_enable) != 0);
+}
+
+static bool esp32c6_jtag_host_attached(ESP32C6UsbJtagState *s)
+{
+    return qemu_chr_fe_backend_open(&s->chr) &&
+           (s->conf & PAD_ENABLE) && !(s->conf & PHY_EXTERNAL) &&
+           (!(s->conf & PAD_PULL_OVERRIDE) || (s->conf & DP_PULLUP));
+}
+
+static int esp32c6_jtag_can_receive(void *opaque)
+{
+    ESP32C6UsbJtagState *s = opaque;
+    /* One complete OUT packet remains owned by the guest until consumed. */
+    return esp32c6_jtag_host_attached(s) && !s->rx_len ? sizeof(s->rx) : 0;
+}
+
+static void esp32c6_jtag_receive(void *opaque, const uint8_t *buf, int size)
+{
+    ESP32C6UsbJtagState *s = opaque;
+    int accepted = MIN(size, esp32c6_jtag_can_receive(s));
+    if (accepted <= 0) {
+        return;
+    }
+    memcpy(s->rx, buf, accepted);
+    s->rx_pos = 0;
+    s->rx_len = accepted;
+    s->rx_bytes += accepted;
+    s->int_raw |= IRQ_OUT_PACKET;
+    esp32c6_jtag_update_irq(s);
+}
+
+static void esp32c6_jtag_host_frame(void *opaque)
+{
+    ESP32C6UsbJtagState *s = opaque;
+
+    if (esp32c6_jtag_host_attached(s)) {
+        s->frame = (s->frame + 1) & 0x7ff;
+        s->int_raw |= IRQ_SOF;
+        if (s->committed) {
+            int done = s->tx_len ? qemu_chr_fe_write(&s->chr, s->tx, s->tx_len) : 0;
+            if (done > 0) {
+                s->tx_bytes += done;
+                s->tx_len -= done;
+                memmove(s->tx, s->tx + done, s->tx_len);
+            }
+            if (!s->tx_len) {
+                s->tx_packets++;
+                s->committed = false;
+                s->int_raw |= IRQ_IN_EMPTY;
+            }
+        }
+    }
+    esp32c6_jtag_update_irq(s);
+    timer_mod(s->host_frame, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
+}
