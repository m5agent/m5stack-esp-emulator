 static void esp32c6_jtag_reset_hold(Object *obj, ResetType type)
 {
     ESP32C6UsbJtagState *s = ESP32C6_JTAG(obj);
 
     s->int_raw = IRQ_IN_EMPTY;
     s->int_enable = 0;
     s->conf = PAD_ENABLE | DP_PULLUP;
     s->frame = 0;
     s->tx_len = 0;
