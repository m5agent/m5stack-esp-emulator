                 s->rx_pos = 0;
                 qemu_chr_fe_accept_input(&s->chr);
             }
         }
         return value;
     }
     case EP1_CONF:
         return (!s->committed && s->tx_len < sizeof(s->tx) ? IN_DATA_FREE : 0) |
                (s->rx_len ? OUT_DATA_AVAIL : 0);
