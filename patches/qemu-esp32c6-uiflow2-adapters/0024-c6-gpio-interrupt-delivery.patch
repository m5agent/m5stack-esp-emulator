 static void esp32_gpio_reset_hold(Object *obj, ResetType type)
 {
+    Esp32GpioState *s = ESP32_GPIO(obj);
+    if (!s->irq_pin_count) {
+        return;
+    }
+    /* SoC reset does not acknowledge external I2C chips or release their
+     * driven pad. Clear only the newly modeled interrupt state. */
+    g_regs[0x44 / 4] = 0;
+    g_regs[0x50 / 4] = 0;
+    for (unsigned pin = 0; pin < s->irq_pin_count; pin++) {
+        g_regs[(0x74 + pin * 4) / 4] &= ~((7u << 7) | (31u << 13));
+    }
+    qemu_set_irq(s->irq, 0);
 }
 
 static void esp32_gpio_realize(DeviceState *dev, Error **errp)
 {
+    Esp32GpioState *s = ESP32_GPIO(dev);
+    if (s->irq_pin_count > 32) {
+        error_setg(errp, "GPIO interrupt model supports at most 32 pins");
+        return;
+    }
+    if (s->irq_pin_count) {
+        if (g_irq_owner && g_irq_owner != s) {
+            error_setg(errp, "GPIO interrupt block is already registered");
+            return;
+        }
+        g_irq_owner = s;
+    }
+}
+
+static void esp32_gpio_unrealize(DeviceState *dev)
+{
+    if (g_irq_owner == ESP32_GPIO(dev)) {
+        g_irq_owner = NULL;
+    }
 }
 
