 static uint64_t gpio_line64(void);
+/* The C6 machine has one GPIO block. Other subclasses retain their existing
+ * behavior unless they explicitly opt into the interrupt register model. */
+static Esp32GpioState *g_irq_owner;
+
+static uint32_t gpio_irq_cpu_status(unsigned route)
+{
+    uint32_t enabled = 0;
+    if (!g_irq_owner) {
+        return 0;
+    }
+    for (unsigned pin = 0; pin < g_irq_owner->irq_pin_count; pin++) {
+        if (g_regs[(0x74 + pin * 4) / 4] & BIT(13 + route)) {
+            enabled |= BIT(pin);
+        }
+    }
+    return g_regs[0x44 / 4] & enabled;
+}
+
+static void gpio_irq_update(uint64_t before, uint64_t after)
+{
+    if (!g_irq_owner) {
+        return;
+    }
+    uint32_t valid = (uint32_t)((1ULL << g_irq_owner->irq_pin_count) - 1);
+    uint32_t pending = g_regs[0x44 / 4] & valid;
+    for (unsigned pin = 0; pin < g_irq_owner->irq_pin_count; pin++) {
+        unsigned type = (g_regs[(0x74 + pin * 4) / 4] >> 7) & 7;
+        bool old = (before >> pin) & 1;
+        bool level = (after >> pin) & 1;
+        bool triggered = (type == 1 && !old && level) ||
+                         (type == 2 && old && !level) ||
+                         (type == 3 && old != level) ||
+                         (type == 4 && !level) ||
+                         (type == 5 && level);
+        if (triggered) {
+            pending |= BIT(pin);
+        }
+    }
+    /* STATUS is the event latch; INT_ENA routes that latch, not its capture.
+     * A W1TC while a level remains active therefore reasserts that bit. */
+    g_regs[0x44 / 4] = pending;
+    g_regs[0x50 / 4] = 0;
+    qemu_set_irq(g_irq_owner->irq, gpio_irq_cpu_status(0) != 0);
+}
 
