 #include "qemu/error-report.h"
 #include "hw/qdev-properties.h"
 #include "qemu/units.h"
@@ -55,6 +56,7 @@
 
 #define ESP32C61_HP_I2C_BASE         0x60004000
 #define ESP32C61_HP_I2C_IRQ          45
+#define ESP32C61_WDEV_TIME_BASE      0x600ad800
 
 void m5_corematrix_attach(Object *machine, I2CBus *bus);
 
@@ -95,6 +97,7 @@ struct Esp32C61MachineState {
     ESP32C61SpiMemState spi_mem;
