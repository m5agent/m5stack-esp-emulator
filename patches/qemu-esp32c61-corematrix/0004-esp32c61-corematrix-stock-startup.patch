+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t esp32c61_fe_dac_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    if (addr == FE_DAC_COMMAND) {
+        return s->fe_dac_command;
+    }
+    if (addr == FE_DAC_STATUS &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) < s->fe_dac_deadline_ns) {
+        return FE_DAC_BUSY;
+    }
+    return 0;
+}
+
+static void esp32c61_fe_dac_write(void *opaque, hwaddr addr, uint64_t value,
+                                  unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    if (addr == FE_DAC_COMMAND) {
+        if ((value & FE_DAC_WRITE) && !(s->fe_dac_command & FE_DAC_WRITE)) {
+            s->fe_dac_offset[extract32(value, 15, 2)][extract32(value, 2, 4)] =
+                extract32(value, 6, 9);
+            s->fe_dac_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000;
+        }
+        s->fe_dac_command = value;
+    }
+}
