+/*
+ * Digital front-end I/Q estimator control for the idle radio. The estimator
+ * accumulates a configured window of samples. This model's input is zero
+ * with no RF source, so the correlation, DC and power sums are all zero.
+ * Completion is derived from a start transition and virtual elapsed time.
+ */
+static uint64_t esp32c61_fe_iq_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    switch (addr) {
+    case FE_IQ_CONFIG:
+        return s->fe_iq_config;
+    case FE_IQ_COMMAND:
+        return s->fe_iq_command;
+    case FE_IQ_STATUS:
+        return s->fe_iq_deadline_ns &&
+               qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->fe_iq_deadline_ns
+               ? FE_IQ_DONE : 0;
+    default:
+        return 0;
+    }
+}
+
+static void esp32c61_fe_iq_write(void *opaque, hwaddr addr, uint64_t value,
+                                 unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    if (addr == FE_IQ_CONFIG) {
+        s->fe_iq_config = value;
+    } else if (addr == FE_IQ_COMMAND) {
+        const uint32_t start = FE_IQ_ENABLE | FE_IQ_START;
+
+        if ((value & start) != start) {
+            s->fe_iq_deadline_ns = 0;
+        } else if (!(s->fe_iq_command & FE_IQ_START)) {
+            /* Idle front-end samples at 40 MHz. */
+            uint32_t samples = extract32(value, 2, 15) + 1;
+            s->fe_iq_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                                   samples * 25;
+        }
+        s->fe_iq_command = value;
+    }
+}
+
+static void esp32c61_fe_iq_reset(void *opaque)
+{
+    Esp32C61MachineState *s = opaque;
+    s->fe_iq_config = 0;
+    s->fe_iq_command = 0;
+    s->fe_iq_deadline_ns = 0;
+    s->fe_txdc_command = 0;
+    s->fe_txdc_result = 0;
+    s->fe_tone_config = 0;
+    s->fe_dac_command = 0;
+    s->fe_txdc_deadline_ns = 0;
+    s->fe_dac_deadline_ns = 0;
+    s->fe_pwdet_deadline_ns = 0;
+    s->fe_freq_deadline_ns = 0;
+    s->fe_freq_channel = 0;
+    s->wdev_reset_reg = 0;
+    s->wdev_reset_deadline_ns = 0;
+    memset(s->fe_pwdet_config, 0, sizeof(s->fe_pwdet_config));
+    memset(s->fe_freq_regs, 0, sizeof(s->fe_freq_regs));
+    memset(s->fe_freq_table, 0, sizeof(s->fe_freq_table));
+    memset(s->fe_dac_offset, 0, sizeof(s->fe_dac_offset));
+}
+
+static const MemoryRegionOps esp32c61_fe_iq_ops = {
+    .read = esp32c61_fe_iq_read,
+    .write = esp32c61_fe_iq_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t esp32c61_fe_txdc_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    uint32_t result = s->fe_txdc_command;
+
+    if (addr == 4) {
+        return s->fe_tone_config;
+    }
+    if (s->fe_txdc_deadline_ns &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->fe_txdc_deadline_ns) {
+        result |= FE_TXDC_DONE | s->fe_txdc_result;
+    }
+    return result;
+}
+
+static void esp32c61_fe_txdc_write(void *opaque, hwaddr addr, uint64_t value,
+                                   unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    const uint32_t start = FE_TXDC_ENABLE | FE_TXDC_START;
+
+    if (addr == 4) {
+        s->fe_tone_config = value;
+        return;
+    }
+    if ((value & start) != start) {
+        s->fe_txdc_deadline_ns = 0;
+    } else if (!(s->fe_txdc_command & FE_TXDC_START)) {
+        /* In the ideal offset-binary DAC, each channel crosses zero at 256. */
+        s->fe_txdc_result =
+            (s->fe_dac_offset[1][2] >= 256 ? FE_TXDC_I_ABOVE_ZERO : 0) |
+            (s->fe_dac_offset[1][3] >= 256 ? FE_TXDC_Q_ABOVE_ZERO : 0);
+        s->fe_txdc_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000;
+    }
+    s->fe_txdc_command = value &
+        ~(FE_TXDC_DONE | FE_TXDC_I_ABOVE_ZERO | FE_TXDC_Q_ABOVE_ZERO);
+}
