diff --git a/hw/misc/esp32c61_jtag.c b/hw/misc/esp32c61_jtag.c
index b600c65..4de3e50 100644
--- a/hw/misc/esp32c61_jtag.c
+++ b/hw/misc/esp32c61_jtag.c
@@ -9,12 +9,180 @@
  */
 #include "qemu/osdep.h"
 #include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/qdev-properties-system.h"
 #include "hw/misc/esp32c61_jtag.h"
 
+#define USB_JTAG_EP1             0x00
+#define USB_JTAG_EP1_CONF        0x04
+#define USB_JTAG_INT_RAW         0x08
+#define USB_JTAG_INT_ST          0x0c
+#define USB_JTAG_INT_ENA         0x10
+#define USB_JTAG_INT_CLR         0x14
+#define USB_JTAG_REG_SIZE        0x84
+#define USB_JTAG_WR_DONE         BIT(0)
+#define USB_JTAG_TX_FREE         BIT(1)
+#define USB_JTAG_RX_AVAIL        BIT(2)
+#define USB_JTAG_IRQ_RX_PACKET   BIT(2)
+#define USB_JTAG_IRQ_TX_EMPTY    BIT(3)
+
+static void esp32c61_jtag_update_irq(ESP32C61UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_enable));
+}
+
+static int esp32c61_jtag_can_receive(void *opaque)
+{
+    ESP32C61UsbJtagState *s = opaque;
+    return fifo8_num_free(&s->rx_fifo);
+}
+
+static void esp32c61_jtag_receive(void *opaque, const uint8_t *data, int size)
+{
+    ESP32C61UsbJtagState *s = opaque;
+    uint32_t count = MIN((uint32_t)size, fifo8_num_free(&s->rx_fifo));
+
+    if (count) {
+        fifo8_push_all(&s->rx_fifo, data, count);
+        s->int_raw |= USB_JTAG_IRQ_RX_PACKET;
+        esp32c61_jtag_update_irq(s);
+    }
+}
+
+static uint64_t esp32c61_jtag_read(void *opaque, hwaddr addr, unsigned size)
+{
+    ESP32C61UsbJtagState *s = opaque;
+    uint8_t byte;
+
+    switch (addr) {
+    case USB_JTAG_EP1:
+        if (fifo8_is_empty(&s->rx_fifo)) {
+            return 0;
+        }
+        byte = fifo8_pop(&s->rx_fifo);
+        qemu_chr_fe_accept_input(&s->chr);
+        return byte;
+    case USB_JTAG_EP1_CONF:
+        return (s->tx_count < sizeof(s->tx_fifo) ? USB_JTAG_TX_FREE : 0) |
+               (!fifo8_is_empty(&s->rx_fifo) ? USB_JTAG_RX_AVAIL : 0);
+    case USB_JTAG_INT_RAW:
+        return s->int_raw;
+    case USB_JTAG_INT_ST:
+        return s->int_raw & s->int_enable;
+    case USB_JTAG_INT_ENA:
+        return s->int_enable;
+    default:
+        return 0;
+    }
+}
+
+static void esp32c61_jtag_write(void *opaque, hwaddr addr, uint64_t value,
+                                unsigned size)
+{
+    ESP32C61UsbJtagState *s = opaque;
+
+    switch (addr) {
+    case USB_JTAG_EP1:
+        if (s->tx_count < sizeof(s->tx_fifo)) {
+            s->tx_fifo[s->tx_count++] = value;
+        }
+        s->int_raw &= ~USB_JTAG_IRQ_TX_EMPTY;
+        break;
+    case USB_JTAG_EP1_CONF:
+        if (value & USB_JTAG_WR_DONE) {
+            if (s->tx_count && qemu_chr_fe_backend_connected(&s->chr)) {
+                qemu_chr_fe_write_all(&s->chr, s->tx_fifo, s->tx_count);
+            }
+            s->tx_count = 0;
+            s->int_raw |= USB_JTAG_IRQ_TX_EMPTY;
+        }
+        break;
+    case USB_JTAG_INT_RAW:
+    case USB_JTAG_INT_CLR:
+        s->int_raw &= ~value;
+        break;
+    case USB_JTAG_INT_ENA:
+        if (!s->tx_count && (value & ~s->int_enable & USB_JTAG_IRQ_TX_EMPTY)) {
+            s->int_raw |= USB_JTAG_IRQ_TX_EMPTY;
+        }
+        s->int_enable = value;
+        break;
+    }
+    esp32c61_jtag_update_irq(s);
+}
+
+static const MemoryRegionOps esp32c61_jtag_ops = {
+    .read = esp32c61_jtag_read,
+    .write = esp32c61_jtag_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static void esp32c61_jtag_reset_hold(Object *obj, ResetType type)
+{
+    ESP32C61UsbJtagState *s = ESP32C61_JTAG(obj);
+    fifo8_reset(&s->rx_fifo);
+    s->tx_count = 0;
+    s->int_raw = USB_JTAG_IRQ_TX_EMPTY;
+    s->int_enable = 0;
+    esp32c61_jtag_update_irq(s);
+}
+
+static void esp32c61_jtag_realize(DeviceState *dev, Error **errp)
+{
+    ESP32C61UsbJtagState *s = ESP32C61_JTAG(dev);
+    qemu_chr_fe_set_handlers(&s->chr, esp32c61_jtag_can_receive,
+                            esp32c61_jtag_receive, NULL, NULL, s, NULL, true);
+}
+
+static void esp32c61_jtag_unrealize(DeviceState *dev)
+{
+    ESP32C61UsbJtagState *s = ESP32C61_JTAG(dev);
+    qemu_chr_fe_set_handlers(&s->chr, NULL, NULL, NULL, NULL, NULL, NULL, false);
+}
+
+static void esp32c61_jtag_init(Object *obj)
+{
+    ESP32C61UsbJtagState *s = ESP32C61_JTAG(obj);
+    SysBusDevice *bus = SYS_BUS_DEVICE(obj);
+
+    fifo8_create(&s->rx_fifo, 64);
+    memory_region_init_io(&s->iomem, obj, &esp32c61_jtag_ops, s,
+                          TYPE_ESP32C61_JTAG, USB_JTAG_REG_SIZE);
+    sysbus_init_mmio(bus, &s->iomem);
+    sysbus_init_irq(bus, &s->irq);
+}
+
+static void esp32c61_jtag_finalize(Object *obj)
+{
+    ESP32C61UsbJtagState *s = ESP32C61_JTAG(obj);
+    fifo8_destroy(&s->rx_fifo);
+}
+
+static Property esp32c61_jtag_properties[] = {
+    DEFINE_PROP_CHR("chardev", ESP32C61UsbJtagState, chr),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32c61_jtag_class_init(ObjectClass *class, void *data)
+{
+    DeviceClass *device = DEVICE_CLASS(class);
+    ResettableClass *reset = RESETTABLE_CLASS(class);
+
+    device->realize = esp32c61_jtag_realize;
+    device->unrealize = esp32c61_jtag_unrealize;
+    reset->phases.hold = esp32c61_jtag_reset_hold;
+    device_class_set_props(device, esp32c61_jtag_properties);
+}
+
 static const TypeInfo esp32c61_jtag_info = {
     .name = TYPE_ESP32C61_JTAG,
-    .parent = TYPE_ESP32C5_JTAG,
+    .parent = TYPE_SYS_BUS_DEVICE,
     .instance_size = sizeof(ESP32C61UsbJtagState),
+    .instance_init = esp32c61_jtag_init,
+    .instance_finalize = esp32c61_jtag_finalize,
+    .class_init = esp32c61_jtag_class_init,
 };
 
