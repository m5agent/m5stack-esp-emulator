+/*
+ * SAR power detector sequencing with no RF input. The command starts one
+ * conversion, which returns the finite-state controller to idle. A zero
+ * input produces zero sampled power.
+ */
+static uint64_t esp32c61_fe_pwdet_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    uint32_t value = addr <= FE_PWDET_CONFIG_END
+        ? s->fe_pwdet_config[addr / 4] : 0;
+
+    if (addr == FE_PWDET_STATUS &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->fe_pwdet_deadline_ns) {
+        value |= FE_PWDET_FSM_IDLE;
+    }
+    return value;
+}
+
+static void esp32c61_fe_pwdet_write(void *opaque, hwaddr addr, uint64_t value,
+                                    unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+
+    if (addr > FE_PWDET_CONFIG_END) {
+        return;
+    }
+    if (addr == FE_PWDET_COMMAND) {
+        if (!(value & FE_PWDET_START)) {
+            s->fe_pwdet_deadline_ns = 0;
+        } else if (!(s->fe_pwdet_config[0] & FE_PWDET_START)) {
+            s->fe_pwdet_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 2000;
+        }
+    } else if (addr == FE_PWDET_STATUS) {
+        value &= ~FE_PWDET_FSM_IDLE;
+    }
+    s->fe_pwdet_config[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32c61_fe_pwdet_ops = {
+    .read = esp32c61_fe_pwdet_read,
+    .write = esp32c61_fe_pwdet_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t esp32c61_fe_freq_read(void *opaque, hwaddr addr, unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+
+    if (addr == FE_FREQ_STATUS) {
+        return s->fe_freq_deadline_ns &&
+               qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->fe_freq_deadline_ns
+               ? FE_FREQ_DONE : 0;
+    }
+    return s->fe_freq_regs[addr / 4];
+}
+
+static void esp32c61_fe_freq_write(void *opaque, hwaddr addr, uint64_t value,
+                                   unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+    uint32_t rising = value & ~s->fe_freq_regs[FE_FREQ_COMMAND / 4];
+
+    if (addr == FE_FREQ_STATUS) {
+        return;
+    }
+    if (addr == FE_FREQ_COMMAND) {
+        if (rising & FE_FREQ_TABLE_WRITE) {
+            s->fe_freq_table[extract32(value, 7, 10)] =
+                s->fe_freq_regs[FE_FREQ_CONFIG_DATA / 4];
+        }
+        if (rising & FE_FREQ_START) {
+            s->fe_freq_channel = extract32(value, 0, 7);
+            s->fe_freq_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 10000;
+        } else if (!(value & FE_FREQ_RESET_N) &&
+                   (s->fe_freq_regs[FE_FREQ_COMMAND / 4] & FE_FREQ_RESET_N)) {
+            s->fe_freq_deadline_ns = 0;
+            s->fe_freq_channel = 0;
+        }
+    }
+    s->fe_freq_regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32c61_fe_freq_ops = {
+    .read = esp32c61_fe_freq_read,
+    .write = esp32c61_fe_freq_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static uint64_t esp32c61_wdev_reset_read(void *opaque, hwaddr addr,
+                                         unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+
+    if (s->wdev_reset_deadline_ns &&
+        qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >= s->wdev_reset_deadline_ns) {
+        return s->wdev_reset_reg | WDEV_MAC_RESET_DONE;
+    }
+    return s->wdev_reset_reg;
+}
+
+static void esp32c61_wdev_reset_write(void *opaque, hwaddr addr, uint64_t value,
+                                      unsigned size)
+{
+    Esp32C61MachineState *s = opaque;
+
+    s->wdev_reset_reg = value & ~(WDEV_MAC_RESET_DONE | WDEV_MAC_RESET);
+    if (value & WDEV_MAC_RESET) {
+        s->wdev_reset_deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000;
+    }
+}
+
+static const MemoryRegionOps esp32c61_wdev_reset_ops = {
+    .read = esp32c61_wdev_reset_read,
+    .write = esp32c61_wdev_reset_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
