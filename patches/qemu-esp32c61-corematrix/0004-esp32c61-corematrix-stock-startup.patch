diff --git a/hw/gpio/esp32c61_gpio.c b/hw/gpio/esp32c61_gpio.c
index ec2c1a2..576fd4b 100644
--- a/hw/gpio/esp32c61_gpio.c
+++ b/hw/gpio/esp32c61_gpio.c
@@ -28,8 +28,52 @@ static void esp32c61_gpio_init(Object *obj)
     s->in_off         = 0x64;
 }
 
+static uint32_t esp32c61_gpio_i2c_release(Esp32GpioState *s)
+{
+    return ~(s->gpio_enable & ~s->gpio_out);
+}
+
+static uint32_t esp32c61_gpio_resolve_pads(Esp32GpioState *s, uint32_t levels)
+{
+    bitbang_i2c_interface *i2c = &ESP32C61_GPIO(s)->board_i2c;
+
+    if (i2c->bus) {
+        uint32_t released = esp32c61_gpio_i2c_release(s);
+        uint32_t sda = (released & 1) && i2c->device_out;
+
+        /* G0/SDA and G1/SCL have external pull-ups on the board. */
+        levels = (levels & ~3u) | (released & 2) | sda;
+    }
+    return levels;
+}
+
+static void esp32c61_gpio_outputs_changed(Esp32GpioState *s)
+{
+    bitbang_i2c_interface *i2c = &ESP32C61_GPIO(s)->board_i2c;
+    uint32_t released = esp32c61_gpio_i2c_release(s);
+    bool scl = released & 2;
+
+    if (i2c->bus) {
+        if (!scl) {
+            bitbang_i2c_set(i2c, BITBANG_I2C_SCL, 0);
+        }
+        bitbang_i2c_set(i2c, BITBANG_I2C_SDA, released & 1);
+        if (scl) {
+            bitbang_i2c_set(i2c, BITBANG_I2C_SCL, 1);
+        }
+    }
+}
+
+void esp32c61_gpio_connect_board_i2c(ESP32C61GPIOState *s, I2CBus *bus)
+{
+    bitbang_i2c_init(&s->board_i2c, bus);
+}
+
 static void esp32c61_gpio_class_init(ObjectClass *klass, void *data)
 {
+    Esp32GpioClass *gpio_class = ESP32_GPIO_CLASS(klass);
+    gpio_class->resolve_pads = esp32c61_gpio_resolve_pads;
+    gpio_class->outputs_changed = esp32c61_gpio_outputs_changed;
 }
 
