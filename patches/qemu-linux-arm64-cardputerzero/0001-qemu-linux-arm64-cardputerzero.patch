 #define GPPUDCLK0 0x98
 #define GPPUDCLK1 0x9C
 
+static BCM2835GpioState *g_bcm2835_gpio;
+
+static void bcm2835_gpio_record_ir_tx(BCM2835GpioState *s, int level)
+{
+    uint64_t now;
+
+    if (!s->ir_tx_file) {
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (!s->ir_tx_start_ns) {
+        s->ir_tx_start_ns = now;
+    }
+    fprintf(s->ir_tx_file, "%" PRIu64 ",%d\n", now - s->ir_tx_start_ns,
+            level);
+    fflush(s->ir_tx_file);
+}
+
+static void bcm2835_gpio_ir_rx_next(void *opaque)
+{
+    BCM2835GpioState *s = opaque;
+    unsigned delta_us;
+    int level;
+
+    if (!s->ir_rx_file ||
+        fscanf(s->ir_rx_file, "%u,%d", &delta_us, &level) != 2) {
+        if (s->ir_rx_file) {
+            fclose(s->ir_rx_file);
+            s->ir_rx_file = NULL;
+        }
+        return;
+    }
+    timer_mod(s->ir_rx_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (uint64_t)delta_us * 1000);
+    bcm2835_gpio_set_input(13, level);
+}
+
+void bcm2835_gpio_ir_rx_start(void)
+{
+    BCM2835GpioState *s = g_bcm2835_gpio;
+
+    if (!s || !s->ir_rx_file) {
+        return;
+    }
+    rewind(s->ir_rx_file);
+    timer_mod(s->ir_rx_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1000);
+}
+
+static void bcm2835_gpio_update_irq(BCM2835GpioState *s)
+{
+    qemu_set_irq(s->irq, (s->eds0 | s->eds1) != 0);
+}
+
+static void bcm2835_gpio_record_event(BCM2835GpioState *s, int pin,
+                                      bool rising, bool falling)
+{
+    uint32_t bit = BIT(pin & 31);
+    uint32_t *eds = pin < 32 ? &s->eds0 : &s->eds1;
+    uint32_t *ren = pin < 32 ? &s->ren0 : &s->ren1;
+    uint32_t *fen = pin < 32 ? &s->fen0 : &s->fen1;
+    uint32_t *hen = pin < 32 ? &s->hen0 : &s->hen1;
+    uint32_t *len = pin < 32 ? &s->len0 : &s->len1;
+    uint32_t *aren = pin < 32 ? &s->aren0 : &s->aren1;
+    uint32_t *afen = pin < 32 ? &s->afen0 : &s->afen1;
+
+    if ((rising && ((*ren | *aren) & bit)) ||
+        (falling && ((*fen | *afen) & bit)) ||
+        (*hen & bit) || (*len & bit)) {
+        *eds |= bit;
+        bcm2835_gpio_update_irq(s);
+    }
+}
+
+void bcm2835_gpio_set_input(int pin, int level)
+{
+    BCM2835GpioState *s = g_bcm2835_gpio;
+    uint32_t bit;
+    uint32_t *lev;
+    bool old_level;
+
+    if (!s || pin < 0 || pin >= 54) {
+        return;
+    }
+    if (getenv("M5SW_GPIO_TRACE")) {
+        fprintf(stderr, "[bcm2835-gpio] input pin=%d level=%d\n", pin, level);
+    }
+
+    bit = BIT(pin & 31);
+    lev = pin < 32 ? &s->lev0 : &s->lev1;
+    old_level = (*lev & bit) != 0;
+    level = !!level;
+    if (old_level == level) {
+        return;
+    }
+
+    if (level) {
+        *lev |= bit;
+    } else {
+        *lev &= ~bit;
+    }
+    bcm2835_gpio_record_event(s, pin, level && !old_level,
+                              !level && old_level);
+    if (getenv("M5SW_GPIO_TRACE")) {
+        fprintf(stderr,
+                "[bcm2835-gpio] irq=%d eds0=%08x ren0=%08x fen0=%08x "
+                "hen0=%08x len0=%08x\n",
+                (s->eds0 | s->eds1) != 0, s->eds0, s->ren0, s->fen0,
+                s->hen0, s->len0);
+    }
+}
+
