 /* All three I2C controllers share the same IRQ */
 #define ORGATED_I2C_IRQ_COUNT 3
 
+#define BCM2835_ASB_REQ_STOP BIT(0)
+#define BCM2835_ASB_ACK BIT(1)
+#define BCM2835_ASB_BRDG_ID 0x62726467
+#define BCM2835_ASB_BRDG_ID_OFFSET 0x20
+
+static uint64_t bcm2835_asb_read(void *opaque, hwaddr offset, unsigned size)
+{
+    BCM2835PeripheralState *s = BCM2835_PERIPHERALS(opaque);
+
+    if (offset == BCM2835_ASB_BRDG_ID_OFFSET) {
+        return BCM2835_ASB_BRDG_ID;
+    }
+    if (offset >= sizeof(s->asb_regs) || (offset & 3)) {
+        return 0;
+    }
+    return s->asb_regs[offset / sizeof(uint32_t)];
+}
+
+static void bcm2835_asb_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    BCM2835PeripheralState *s = BCM2835_PERIPHERALS(opaque);
+    uint32_t val = value;
+
+    if (offset >= sizeof(s->asb_regs) || (offset & 3) ||
+        offset == BCM2835_ASB_BRDG_ID_OFFSET) {
+        return;
+    }
+
+    val &= ~0xff000000;
+    if (val & BCM2835_ASB_REQ_STOP) {
+        val &= ~BCM2835_ASB_ACK;
+    } else {
+        val |= BCM2835_ASB_ACK;
+    }
+    s->asb_regs[offset / sizeof(uint32_t)] = val;
+}
+
+static const MemoryRegionOps bcm2835_asb_ops = {
+    .read = bcm2835_asb_read,
+    .write = bcm2835_asb_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+#define BCM2835_I2S_CS_RXF BIT(22)
+#define BCM2835_I2S_CS_TXE BIT(21)
+#define BCM2835_I2S_CS_RXD BIT(20)
+#define BCM2835_I2S_CS_TXD BIT(19)
+
+static void bcm2835_i2s_abort_dma(BCM2835PeripheralState *s)
+{
+    int i;
+
+    for (i = 0; i < BCM2835_DMA_NCHANS; i++) {
+        BCM2835DMAChan *ch = &s->parent_obj.dma.chan[i];
+
+        if (ch->cs & BIT(0)) {
+            ch->conblk_ad = 0;
+            ch->nextconbk = 0;
+        }
+    }
+}
+
+static uint64_t bcm2835_i2s_read(void *opaque, hwaddr offset, unsigned size)
+{
+    BCM2835PeripheralState *s = BCM2835_PERIPHERALS(opaque);
+
+    if (offset >= sizeof(s->i2s_regs) || (offset & 3)) {
+        return 0;
+    }
+    if (offset == 0x04) {
+        uint32_t value = 0;
+        bool read_ok = s->i2s_rx_file &&
+                       fread(&value, sizeof(value), 1,
+                             s->i2s_rx_file) == 1;
+        if (read_ok) {
+            s->i2s_rx_words++;
+            s->i2s_rx_bytes += sizeof(value);
+        }
+        if (!read_ok ||
+            (s->i2s_rx_limit && s->i2s_rx_bytes >= s->i2s_rx_limit)) {
+            bcm2835_i2s_abort_dma(s);
+        }
+        return value;
+    }
+    if (offset == 0x00) {
+        uint32_t value = s->i2s_regs[0] | BCM2835_I2S_CS_TXE;
+        if (s->i2s_rx_file && !feof(s->i2s_rx_file)) {
+            value |= BCM2835_I2S_CS_RXD;
+        }
+        return value;
+    }
+    return s->i2s_regs[offset / sizeof(uint32_t)];
+}
+
+static void bcm2835_i2s_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    BCM2835PeripheralState *s = BCM2835_PERIPHERALS(opaque);
+    uint32_t val = value;
+
+    if (offset >= sizeof(s->i2s_regs) || (offset & 3)) {
+        return;
+    }
+    if (offset == 0x04) {
+        if (!s->i2s_tx_limit ||
+            s->i2s_tx_bytes + sizeof(val) <= s->i2s_tx_limit) {
+            if (s->i2s_tx_file) {
+                fwrite(&val, sizeof(val), 1, s->i2s_tx_file);
+            }
+            s->i2s_tx_words++;
+            s->i2s_tx_bytes += sizeof(val);
+        }
+        if (s->i2s_tx_limit &&
+            s->i2s_tx_bytes >= s->i2s_tx_limit) {
+            if (s->i2s_tx_file) {
+                fflush(s->i2s_tx_file);
+            }
+            bcm2835_i2s_abort_dma(s);
+        }
+        return;
+    }
+    s->i2s_regs[offset / sizeof(uint32_t)] = val;
+}
+
+static const MemoryRegionOps bcm2835_i2s_ops = {
+    .read = bcm2835_i2s_read,
+    .write = bcm2835_i2s_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
