+                          "bcm2835-asb", 0x24);
+    memory_region_init_io(&s->i2s_iomem, obj, &bcm2835_i2s_ops, s,
+                          "bcm2835-i2s", 0x24);
+    if (getenv("M5SW_I2S_TX_FILE")) {
+        s->i2s_tx_file = fopen(getenv("M5SW_I2S_TX_FILE"), "wb");
+    }
+    s->i2s_tx_limit = getenv("M5SW_I2S_TX_LIMIT_BYTES")
