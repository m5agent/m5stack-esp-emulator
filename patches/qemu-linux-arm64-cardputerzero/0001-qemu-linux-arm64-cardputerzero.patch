 #define R_RSTS 0x20
 #define V_RSTS_POWEROFF 0x555 /* Linux uses partition 63 to indicate halt. */
 #define R_WDOG 0x24
+#define WDOG_TICKS_PER_SECOND 65536
+
+static void bcm2835_watchdog_expire(void *opaque)
+{
+    BCM2835PowerMgtState *s = opaque;
+
+    if (s->ignore_reset) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_powermgt: watchdog expiry ignored\n");
+        return;
+    }
+    if ((s->rsts & 0xfff) == V_RSTS_POWEROFF) {
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    } else {
+        qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    }
+}
+
+static void bcm2835_watchdog_arm(BCM2835PowerMgtState *s)
+{
+    uint64_t ticks = s->wdog & 0x000fffff;
+    uint64_t timeout_ns;
+
+    if (!(s->rstc & V_RSTC_RESET) || ticks == 0) {
+        timer_del(s->watchdog_timer);
+        return;
+    }
+    timeout_ns = ticks * NANOSECONDS_PER_SECOND / WDOG_TICKS_PER_SECOND;
+    timer_mod(s->watchdog_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + MAX(timeout_ns, 1));
+}
 
