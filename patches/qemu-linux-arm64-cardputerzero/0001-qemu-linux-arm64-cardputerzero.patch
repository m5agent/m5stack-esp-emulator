diff --git a/hw/arm/m5sw_gpio_stubs.c b/hw/arm/m5sw_gpio_stubs.c
new file mode 100644
index 0000000..943a5d5
--- /dev/null
+++ b/hw/arm/m5sw_gpio_stubs.c
@@ -0,0 +1,33 @@
+/*
+ * ARM-side compatibility stubs for the shared M5 peripheral register models.
+ * BCM2837 board glue will replace these with real GPIO wiring as the
+ * CardputerZero machine is brought up.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/gpio/bcm2835_gpio.h"
+#include "hw/m5stopwatch/m5stopwatch.h"
+
+void esp32_gpio_set_input(int pin, int level)
+{
+    /*
+     * Shared M5 peripheral models use ESP32 GPIO 11 for the TCA8418
+     * active-low interrupt. CardputerZero routes that line to BCM GPIO27.
+     */
+    if (pin == 11) {
+        bcm2835_gpio_set_input(27, level);
+    }
+}
+
+void esp32_gpio_force_line(int pin, int level)
+{
+    if (pin == 11) {
+        bcm2835_gpio_set_input(27, level);
+    }
+}
+
+void m5sw_ir_rx_start(void)
+{
+    bcm2835_gpio_ir_rx_start();
+}
