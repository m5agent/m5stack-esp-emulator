diff -ruN a/hw/m5stopwatch/m5_can_peer.c b/hw/m5stopwatch/m5_can_peer.c
--- a/hw/m5stopwatch/m5_can_peer.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_can_peer.c	2026-10-21 14:46:58
@@ -0,0 +1,52 @@
+/*
+ * Virtual CAN peer for M5Stack board models.
+ *
+ * The peer is a real client on QEMU's CAN bus.  When enabled, it echoes every
+ * frame back to the controller, allowing the unmodified guest TWAI driver to
+ * exercise TX, RX, filtering, interrupts and its receive FIFOs.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "net/can_emu.h"
+#include "qom/object.h"
+#include "m5stopwatch.h"
+
+typedef struct M5CanPeer {
+    CanBusClientState client;
+    bool echo;
+} M5CanPeer;
+
+static bool m5_can_peer_can_receive(CanBusClientState *client)
+{
+    return true;
+}
+
+static ssize_t m5_can_peer_receive(CanBusClientState *client,
+                                   const struct qemu_can_frame *frames,
+                                   size_t frames_cnt)
+{
+    M5CanPeer *peer = container_of(client, M5CanPeer, client);
+
+    if (peer->echo && frames_cnt) {
+        can_bus_client_send(client, frames, frames_cnt);
+    }
+    return frames_cnt;
+}
+
+static CanBusClientInfo m5_can_peer_info = {
+    .can_receive = m5_can_peer_can_receive,
+    .receive = m5_can_peer_receive,
+};
+
+struct CanBusState *m5_can_bus_create(void)
+{
+    CanBusState *bus = CAN_BUS(object_new(TYPE_CAN_BUS));
+    M5CanPeer *peer = g_new0(M5CanPeer, 1);
+
+    object_property_add_child(qdev_get_machine(), "m5-canbus", OBJECT(bus));
+    peer->echo = getenv("M5SW_CAN_ECHO") != NULL;
+    peer->client.info = &m5_can_peer_info;
+    can_bus_insert_client(bus, &peer->client);
+    return bus;
+}
diff -ruN a/hw/m5stopwatch/m5_i2s.c b/hw/m5stopwatch/m5_i2s.c
--- a/hw/m5stopwatch/m5_i2s.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_i2s.c	2026-10-21 13:09:30
@@ -0,0 +1,458 @@
+/*
+ * ESP32-S3 I2S register front-end.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "hw/dma/esp_gdma.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "hw/xtensa/esp32s3_intc.h"
+#include "m5stopwatch.h"
+
+#define R_INT_RAW  0x0c
+#define R_INT_ST   0x10
+#define R_INT_ENA  0x14
+#define R_INT_CLR  0x18
+#define R_RX_CONF  0x20
+#define R_TX_CONF  0x24
+#define RX_UPDATE  (1u << 8)
+#define TX_UPDATE  (1u << 8)
+#define RX_START   (1u << 2)
+#define TX_START   (1u << 2)
+
+struct M5I2SState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t regs[0x1000 / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    ESPGdmaState *gdma;
+    uint32_t port;
+    FILE *pcm_file;
+    uint64_t pcm_bytes;
+    uint64_t pcm_limit;
+    uint32_t last_pcm_hash;
+    uint32_t pcm_writes;
+    QEMUTimer *tx_timer;
+    int64_t capture_until_ms;
+    int64_t dma_due_ms;
+    uint32_t dma_events;
+    bool dma_irq;
+    bool tx_started;
+    bool dma_active;
+    uint32_t dma_channel;
+    QEMUTimer *rx_timer;
+    uint8_t *rx_pcm;
+    uint32_t rx_pcm_size;
+    uint32_t rx_pcm_pos;
+    uint32_t rx_dma_channel;
+    int64_t rx_dma_due_ms;
+    bool rx_started;
+    bool rx_dma_active;
+    bool trace;
+};
+
+static void i2s_update_irq(M5I2SState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static uint64_t i2s_read(void *opaque, hwaddr addr, unsigned size)
+{
+    M5I2SState *s = opaque;
+    switch (addr) {
+    case R_INT_RAW:
+        return s->int_raw;
+    case R_INT_ST:
+        return s->int_raw & s->int_ena;
+    case R_INT_ENA:
+        return s->int_ena;
+    default:
+        return addr < sizeof(s->regs) ? s->regs[addr / 4] : 0;
+    }
+}
+
+static void i2s_capture_tx(M5I2SState *s)
+{
+    uint32_t channel;
+    uint32_t bytes;
+    GdmaPeripheral periph = s->port ? GDMA_I2S1 : GDMA_I2S0;
+
+    if (!s->gdma
+        || !esp_gdma_get_channel_periph(s->gdma, periph,
+                                         ESP_GDMA_OUT_IDX, &channel)) {
+        return;
+    }
+    s->dma_channel = channel;
+    s->dma_active = true;
+    bytes = esp_gdma_get_out_transfer_size(s->gdma, channel, 1 << 20);
+    if (!bytes) {
+        return;
+    }
+    if (s->trace) {
+        fprintf(stderr, "[i2s%d] dma start bytes=%u\n", s->port, bytes);
+    }
+}
+
+static bool i2s_store_pcm(M5I2SState *s, const uint8_t *buffer, uint32_t bytes);
+
+static void i2s_complete_dma(M5I2SState *s, uint32_t channel)
+{
+    const uint32_t snapshot_size = 4096;
+    g_autofree uint8_t *buffer = g_malloc0(snapshot_size);
+    uint32_t bytes;
+
+    if (!s->gdma) {
+        return;
+    }
+    bytes = esp_gdma_complete_out_descriptor(
+        s->gdma, channel, buffer, snapshot_size);
+    if (!bytes) {
+        if (s->trace) {
+            fprintf(stderr, "[i2s%d] dma complete empty chan=%u\n",
+                    s->port, channel);
+        }
+        return;
+    }
+    if (s->trace) {
+        fprintf(stderr, "[i2s%d] dma read chan=%u bytes=%u head=",
+                s->port, channel, bytes);
+        for (uint32_t i = 0; i < MIN(bytes, 16); i++) {
+            fprintf(stderr, "%02x", buffer[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    for (uint32_t i = 0; i < bytes; i++) {
+        if (buffer[i]) {
+            i2s_store_pcm(s, buffer, bytes);
+            break;
+        }
+    }
+    s->dma_events++;
+}
+
+static uint32_t i2s_hash(const uint8_t *data, uint32_t size)
+{
+    uint32_t hash = 2166136261u;
+    for (uint32_t i = 0; i < size; i++) {
+        hash ^= data[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static bool i2s_store_pcm(M5I2SState *s, const uint8_t *buffer, uint32_t bytes)
+{
+    uint32_t hash;
+
+    if (!bytes || s->pcm_writes >= 8) {
+        return false;
+    }
+    if (!s->pcm_file) {
+        const char *path = getenv("M5SW_I2S_PCM_FILE");
+        if (!path) {
+            return false;
+        }
+        s->pcm_file = fopen(path, "wb");
+        if (!s->pcm_file) {
+            return false;
+        }
+    }
+    hash = i2s_hash(buffer, bytes);
+    if (s->pcm_writes && hash == s->last_pcm_hash) {
+        return false;
+    }
+    if (s->pcm_bytes < s->pcm_limit) {
+        uint32_t write_size = MIN(bytes, s->pcm_limit - s->pcm_bytes);
+        fwrite(buffer, 1, write_size, s->pcm_file);
+        fflush(s->pcm_file);
+        s->pcm_bytes += write_size;
+        s->pcm_writes++;
+        s->last_pcm_hash = hash;
+    }
+    if (s->trace) {
+        fprintf(stderr,
+                "[i2s%d] pcm bytes=%u total=%" PRIu64
+                " writes=%u hash=%08x\n",
+                s->port, bytes, s->pcm_bytes, s->pcm_writes, hash);
+    }
+    return true;
+}
+
+static void i2s_tx_timer(void *opaque)
+{
+    M5I2SState *s = opaque;
+    const uint32_t snapshot_size = 1 << 20;
+    g_autofree uint8_t *buffer = NULL;
+    uint32_t channel;
+    uint32_t bytes;
+    uint32_t nonzero = 0;
+    bool any_nonzero = false;
+    GdmaPeripheral periph = s->port ? GDMA_I2S1 : GDMA_I2S0;
+
+    if (qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= s->capture_until_ms
+        || s->pcm_writes >= 8) {
+        return;
+    }
+    timer_mod(s->tx_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+    if (s->dma_irq && s->dma_active && s->dma_events < 128
+        && qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= s->dma_due_ms) {
+        if (s->trace) {
+            fprintf(stderr, "[i2s%d] dma completion due chan=%u\n",
+                    s->port, s->dma_channel);
+        }
+        i2s_complete_dma(s, s->dma_channel);
+        s->dma_active = false;
+        s->dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20;
+    }
+    if (!s->gdma
+        || !esp_gdma_get_channel_periph(s->gdma, periph,
+                                         ESP_GDMA_OUT_IDX, &channel)) {
+        return;
+    }
+    if (!s->dma_active) {
+        s->dma_channel = channel;
+        s->dma_active = true;
+        s->dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20;
+    }
+
+    buffer = g_malloc(snapshot_size);
+    bytes = esp_gdma_snapshot_out_channel(s->gdma, channel, buffer,
+                                          snapshot_size);
+    if (s->trace) {
+        fprintf(stderr, "[i2s%d] timer snapshot bytes=%u writes=%u head=",
+                s->port, bytes, s->pcm_writes);
+        for (uint32_t i = 0; i < MIN(bytes, 16); i++) {
+            fprintf(stderr, "%02x", buffer[i]);
+        }
+        fprintf(stderr, "\n");
+    }
+    if (!bytes) {
+        return;
+    }
+    for (uint32_t i = 0; i < bytes; i++) {
+        if (buffer[i]) {
+            nonzero++;
+            any_nonzero = true;
+        }
+    }
+    if (s->trace) {
+        fprintf(stderr, "[i2s%d] snapshot nonzero=%u\n", s->port, nonzero);
+    }
+    if (!any_nonzero) {
+        return;
+    }
+    i2s_store_pcm(s, buffer, bytes);
+}
+
+static void i2s_rx_timer(void *opaque)
+{
+    M5I2SState *s = opaque;
+    uint8_t buffer[4096];
+    uint32_t available;
+    uint32_t chunk;
+    uint32_t sent;
+
+    if (!s->rx_started || !s->rx_dma_active || !s->gdma
+        || !s->rx_pcm || !s->rx_pcm_size) {
+        return;
+    }
+    if (qemu_clock_get_ms(QEMU_CLOCK_REALTIME) < s->rx_dma_due_ms) {
+        timer_mod(s->rx_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+        return;
+    }
+    available = s->rx_pcm_size - s->rx_pcm_pos;
+    if (!available) {
+        s->rx_pcm_pos = 0;
+        available = s->rx_pcm_size;
+    }
+    chunk = MIN(available, sizeof(buffer));
+    memcpy(buffer, s->rx_pcm + s->rx_pcm_pos, chunk);
+    s->rx_pcm_pos = (s->rx_pcm_pos + chunk) % s->rx_pcm_size;
+    sent = esp_gdma_complete_in_descriptor(
+        s->gdma, s->rx_dma_channel, buffer, chunk);
+    if (s->trace) {
+        fprintf(stderr, "[i2s%d] rx dma inject chan=%u bytes=%u\n",
+                s->port, s->rx_dma_channel, sent);
+    }
+    s->rx_dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20;
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+}
+
+static void i2s_rx_start(M5I2SState *s)
+{
+    uint32_t channel;
+    const char *path = getenv("M5SW_I2S_RX_PCM_FILE");
+    GdmaPeripheral periph = s->port ? GDMA_I2S1 : GDMA_I2S0;
+
+    if (!s->gdma
+        || !esp_gdma_get_channel_periph(s->gdma, periph,
+                                         ESP_GDMA_IN_IDX, &channel)) {
+        return;
+    }
+    s->rx_dma_channel = channel;
+    s->rx_dma_active = true;
+    s->rx_pcm_pos = 0;
+    s->rx_dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20;
+    if (path) {
+        g_autofree char *contents = NULL;
+        gsize length = 0;
+        if (g_file_get_contents(path, &contents, &length, NULL) && length) {
+            g_free(s->rx_pcm);
+            s->rx_pcm = (uint8_t *)contents;
+            contents = NULL;
+            s->rx_pcm_size = length;
+        }
+    }
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+}
+
+static void i2s_write(void *opaque, hwaddr addr, uint64_t value,
+                      unsigned size)
+{
+    M5I2SState *s = opaque;
+    uint32_t v = value;
+
+    if (s->trace) {
+        fprintf(stderr, "[i2s] wr %03x <- %08x\n",
+                (unsigned)addr, v);
+    }
+    switch (addr) {
+    case R_INT_ENA:
+        s->int_ena = v;
+        i2s_update_irq(s);
+        break;
+    case R_INT_CLR:
+        s->int_raw &= ~v;
+        i2s_update_irq(s);
+        break;
+    case R_RX_CONF:
+        if ((v & RX_START) && !s->rx_started) {
+            i2s_rx_start(s);
+        }
+        s->rx_started = !!(v & RX_START);
+        s->regs[addr / 4] = v & ~RX_UPDATE;
+        break;
+    case R_TX_CONF:
+        if ((v & TX_START) && !s->tx_started) {
+            i2s_capture_tx(s);
+            s->pcm_writes = 0;
+            s->last_pcm_hash = 0;
+            s->dma_events = 0;
+            s->capture_until_ms =
+                qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2000;
+            s->dma_due_ms = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 500;
+            timer_mod(s->tx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 1);
+        }
+        s->tx_started = !!(v & TX_START);
+        s->regs[addr / 4] = v & ~TX_UPDATE;
+        break;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+        break;
+    }
+}
+
+static const MemoryRegionOps i2s_ops = {
+    .read = i2s_read,
+    .write = i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void i2s_reset(DeviceState *dev)
+{
+    M5I2SState *s = M5_I2S(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->tx_started = false;
+    s->dma_active = false;
+    s->dma_channel = 0;
+    s->rx_started = false;
+    s->rx_dma_active = false;
+    s->rx_dma_channel = 0;
+    if (s->rx_timer) {
+        timer_del(s->rx_timer);
+    }
+    if (s->tx_timer) {
+        timer_del(s->tx_timer);
+    }
+}
+
+static void i2s_init(Object *obj)
+{
+    M5I2SState *s = M5_I2S(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &i2s_ops, s, TYPE_M5_I2S, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->trace = getenv("M5SW_I2S_TRACE") != NULL;
+    s->dma_irq = getenv("M5SW_I2S_DMA_IRQ") != NULL;
+    s->pcm_limit = 4 << 20;
+    s->tx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_tx_timer, s);
+    s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_rx_timer, s);
+}
+
+void m5_i2s_attach(DeviceState *dev, ESPGdmaState *gdma, uint32_t port)
+{
+    M5I2SState *s = M5_I2S(dev);
+    s->gdma = gdma;
+    s->port = port;
+}
+
+static void i2s_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, i2s_reset);
+}
+
+static const TypeInfo i2s_info = {
+    .name = TYPE_M5_I2S,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(M5I2SState),
+    .instance_init = i2s_init,
+    .class_init = i2s_class_init,
+};
+
+static void i2s_register(void)
+{
+    type_register_static(&i2s_info);
+}
+type_init(i2s_register)
+
+void m5_i2s_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
+                       ESPGdmaState *gdma)
+{
+    static const struct {
+        hwaddr base;
+        int irq_source;
+    } ports[] = {
+        { 0x6000f000, ETS_I2S0_INTR_SOURCE },
+        { 0x6002d000, ETS_I2S1_INTR_SOURCE },
+    };
+
+    for (int i = 0; i < ARRAY_SIZE(ports); i++) {
+        DeviceState *dev = qdev_new(TYPE_M5_I2S);
+        m5_i2s_attach(dev, gdma, i);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+        memory_region_add_subregion_overlap(
+            sys_mem, ports[i].base,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 1);
+        sysbus_connect_irq(
+            SYS_BUS_DEVICE(dev), 0,
+            qdev_get_gpio_in(intmatrix, ports[i].irq_source));
+    }
+}
diff -ruN a/hw/m5stopwatch/m5_i2s_esp32.c b/hw/m5stopwatch/m5_i2s_esp32.c
--- a/hw/m5stopwatch/m5_i2s_esp32.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_i2s_esp32.c	2026-10-21 14:07:29
@@ -0,0 +1,563 @@
+/*
+ * ESP32 classic I2S controller model.
+ *
+ * The original ESP32 uses the I2S block's own linked-list DMA engine rather
+ * than the GDMA block found on ESP32-S3.  Core2 uses I2S0 for both the NS4168
+ * speaker path and the SPM1423 PDM microphone path.  This model consumes the
+ * real IDF DMA descriptors and provides host PCM capture/injection at the
+ * controller boundary.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "hw/irq.h"
+#include "hw/misc/esp32_reg.h"
+#include "hw/qdev-properties.h"
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+#include "m5stopwatch.h"
+
+#define R_CONF          0x008
+#define R_INT_RAW       0x00c
+#define R_INT_ST        0x010
+#define R_INT_ENA       0x014
+#define R_INT_CLR       0x018
+#define R_OUT_LINK      0x030
+#define R_IN_LINK       0x034
+#define R_OUT_EOF_DESC  0x038
+#define R_IN_EOF_DESC   0x03c
+#define R_STATE         0x0bc
+
+#define CONF_TX_RESET       BIT(0)
+#define CONF_RX_RESET       BIT(1)
+#define CONF_TX_FIFO_RESET  BIT(2)
+#define CONF_RX_FIFO_RESET  BIT(3)
+#define CONF_TX_START       BIT(4)
+#define CONF_RX_START       BIT(5)
+
+#define LINK_STOP           BIT(28)
+#define LINK_START          BIT(29)
+#define LINK_RESTART        BIT(30)
+#define LINK_ADDR_MASK      0x000fffff
+
+#define INT_RX_EOF          BIT(9)
+#define INT_TX_EOF          BIT(12)
+#define INT_RX_DSCR_ERR     BIT(13)
+#define INT_TX_DSCR_ERR     BIT(14)
+
+#define I2S_DESC_SIZE       12
+#define I2S_DESC_MAX_BYTES  4092
+#define I2S_PCM_MAX_WRITES  64
+#define I2S_DMA_PERIOD_MS   10
+
+typedef struct M5Esp32I2SState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t port;
+    uint32_t regs[0x1000 / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    QEMUTimer *tx_timer;
+    QEMUTimer *rx_timer;
+    uint32_t tx_desc;
+    uint32_t tx_first_desc;
+    uint32_t rx_desc;
+    uint32_t rx_first_desc;
+    bool tx_running;
+    bool rx_running;
+    bool trace;
+    FILE *pcm_file;
+    uint64_t pcm_bytes;
+    uint32_t pcm_writes;
+    uint32_t last_pcm_hash;
+    uint8_t *rx_pcm;
+    uint32_t rx_pcm_size;
+    uint32_t rx_pcm_pos;
+} M5Esp32I2SState;
+
+typedef struct M5Esp32I2SDesc {
+    uint32_t dw0;
+    uint32_t buffer;
+    uint32_t next;
+} M5Esp32I2SDesc;
+
+static void i2s_update_irq(M5Esp32I2SState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static uint32_t i2s_hash(const uint8_t *data, uint32_t size)
+{
+    uint32_t hash = 2166136261u;
+
+    for (uint32_t i = 0; i < size; i++) {
+        hash ^= data[i];
+        hash *= 16777619u;
+    }
+    return hash;
+}
+
+static bool i2s_store_pcm(M5Esp32I2SState *s, const uint8_t *buffer,
+                          uint32_t bytes)
+{
+    uint32_t hash;
+
+    if (!bytes || s->pcm_writes >= I2S_PCM_MAX_WRITES) {
+        return false;
+    }
+    for (uint32_t i = 0; i < bytes; i++) {
+        if (buffer[i]) {
+            break;
+        }
+        if (i + 1 == bytes) {
+            return false;
+        }
+    }
+    if (!s->pcm_file) {
+        const char *path = getenv("M5SW_I2S_PCM_FILE");
+        if (!path) {
+            return false;
+        }
+        s->pcm_file = fopen(path, "wb");
+        if (!s->pcm_file) {
+            return false;
+        }
+    }
+    hash = i2s_hash(buffer, bytes);
+    if (s->pcm_writes && hash == s->last_pcm_hash) {
+        return false;
+    }
+    fwrite(buffer, 1, bytes, s->pcm_file);
+    fflush(s->pcm_file);
+    s->pcm_bytes += bytes;
+    s->pcm_writes++;
+    s->last_pcm_hash = hash;
+    if (s->trace) {
+        fprintf(stderr,
+                "[esp32-i2s%d] pcm bytes=%u total=%" PRIu64
+                " writes=%u hash=%08x\n",
+                s->port, bytes, s->pcm_bytes, s->pcm_writes, hash);
+    }
+    return true;
+}
+
+static uint32_t i2s_desc_decode_addr(uint32_t link_reg)
+{
+    /*
+     * The legacy I2S link register stores the low 20 bits of an internal-RAM
+     * address.  IDF places I2S descriptors in ESP32 DRAM at 0x3ffxxxxx.
+     */
+    return 0x3ff00000u | (link_reg & LINK_ADDR_MASK);
+}
+
+static bool i2s_read_desc(uint32_t addr, M5Esp32I2SDesc *desc)
+{
+    uint8_t raw[I2S_DESC_SIZE];
+
+    if (!addr || address_space_read(&address_space_memory, addr,
+                                    MEMTXATTRS_UNSPECIFIED, raw,
+                                    sizeof(raw)) != MEMTX_OK) {
+        return false;
+    }
+    desc->dw0 = ldl_le_p(raw);
+    desc->buffer = ldl_le_p(raw + 4);
+    desc->next = ldl_le_p(raw + 8);
+    return true;
+}
+
+static bool i2s_write_desc_length(uint32_t addr, uint32_t length)
+{
+    uint8_t raw[4];
+    uint32_t dw0;
+
+    if (address_space_read(&address_space_memory, addr,
+                           MEMTXATTRS_UNSPECIFIED, raw, sizeof(raw))
+        != MEMTX_OK) {
+        return false;
+    }
+    dw0 = ldl_le_p(raw);
+    dw0 = (dw0 & ~0x00fff000u) | ((length & 0xfff) << 12);
+    stl_le_p(raw, dw0);
+    return address_space_write(&address_space_memory, addr,
+                               MEMTXATTRS_UNSPECIFIED, raw,
+                               sizeof(raw)) == MEMTX_OK;
+}
+
+static uint32_t i2s_desc_bytes(const M5Esp32I2SDesc *desc)
+{
+    uint32_t bytes = desc->dw0 & 0xfff;
+
+    return bytes ? MIN(bytes, I2S_DESC_MAX_BYTES) : 4096;
+}
+
+static uint32_t i2s_next_desc(const M5Esp32I2SDesc *desc, uint32_t current,
+                              uint32_t first)
+{
+    if (desc->next && desc->next != current) {
+        return desc->next;
+    }
+    return (desc->dw0 & BIT(30)) ? first : 0;
+}
+
+static void i2s_tx_timer(void *opaque)
+{
+    M5Esp32I2SState *s = opaque;
+    M5Esp32I2SDesc desc;
+    g_autofree uint8_t *buffer = NULL;
+    uint32_t bytes;
+
+    if (!s->tx_running || !s->tx_desc) {
+        return;
+    }
+    if (!i2s_read_desc(s->tx_desc, &desc)) {
+        s->int_raw |= INT_TX_DSCR_ERR;
+        i2s_update_irq(s);
+        s->tx_running = false;
+        return;
+    }
+    bytes = i2s_desc_bytes(&desc);
+    buffer = g_malloc0(bytes);
+    if (bytes && address_space_read(&address_space_memory, desc.buffer,
+                                    MEMTXATTRS_UNSPECIFIED, buffer,
+                                    bytes) != MEMTX_OK) {
+        s->int_raw |= INT_TX_DSCR_ERR;
+        i2s_update_irq(s);
+        s->tx_running = false;
+        return;
+    }
+    if (s->trace) {
+        fprintf(stderr,
+                "[esp32-i2s%d] tx desc=%08x buffer=%08x bytes=%u next=%08x\n",
+                s->port, s->tx_desc, desc.buffer, bytes, desc.next);
+    }
+    i2s_store_pcm(s, buffer, bytes);
+    s->regs[R_OUT_EOF_DESC / 4] = s->tx_desc;
+    s->int_raw |= INT_TX_EOF;
+    i2s_update_irq(s);
+    s->tx_desc = i2s_next_desc(&desc, s->tx_desc, s->tx_first_desc);
+    if (!s->tx_desc) {
+        s->tx_running = false;
+        return;
+    }
+    timer_mod(s->tx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + I2S_DMA_PERIOD_MS);
+}
+
+static void i2s_load_rx_pcm(M5Esp32I2SState *s)
+{
+    const char *path = getenv("M5SW_I2S_RX_PCM_FILE");
+    g_autofree char *contents = NULL;
+    gsize length = 0;
+
+    g_free(s->rx_pcm);
+    s->rx_pcm = NULL;
+    s->rx_pcm_size = 0;
+    s->rx_pcm_pos = 0;
+    if (!path) {
+        return;
+    }
+    if (g_file_get_contents(path, &contents, &length, NULL) && length) {
+        s->rx_pcm = (uint8_t *)contents;
+        contents = NULL;
+        s->rx_pcm_size = length;
+    }
+}
+
+static void i2s_rx_timer(void *opaque)
+{
+    M5Esp32I2SState *s = opaque;
+    M5Esp32I2SDesc desc;
+    g_autofree uint8_t *buffer = NULL;
+    uint32_t bytes;
+    uint32_t available;
+    uint32_t first;
+
+    if (!s->rx_running || !s->rx_desc) {
+        return;
+    }
+    if (!i2s_read_desc(s->rx_desc, &desc)) {
+        s->int_raw |= INT_RX_DSCR_ERR;
+        i2s_update_irq(s);
+        s->rx_running = false;
+        return;
+    }
+    bytes = i2s_desc_bytes(&desc);
+    buffer = g_malloc0(bytes);
+    if (s->rx_pcm_size && bytes) {
+        available = s->rx_pcm_size - s->rx_pcm_pos;
+        if (!available) {
+            s->rx_pcm_pos = 0;
+            available = s->rx_pcm_size;
+        }
+        first = MIN(bytes, available);
+        memcpy(buffer, s->rx_pcm + s->rx_pcm_pos, first);
+        if (first < bytes) {
+            memcpy(buffer + first, s->rx_pcm,
+                   MIN(bytes - first, s->rx_pcm_size));
+        }
+        s->rx_pcm_pos = (s->rx_pcm_pos + first) % s->rx_pcm_size;
+    }
+    if (bytes && address_space_write(&address_space_memory, desc.buffer,
+                                     MEMTXATTRS_UNSPECIFIED, buffer,
+                                     bytes) != MEMTX_OK) {
+        s->int_raw |= INT_RX_DSCR_ERR;
+        i2s_update_irq(s);
+        s->rx_running = false;
+        return;
+    }
+    i2s_write_desc_length(s->rx_desc, bytes);
+    if (s->trace) {
+        fprintf(stderr,
+                "[esp32-i2s%d] rx desc=%08x buffer=%08x bytes=%u next=%08x\n",
+                s->port, s->rx_desc, desc.buffer, bytes, desc.next);
+    }
+    s->regs[R_IN_EOF_DESC / 4] = s->rx_desc;
+    s->int_raw |= INT_RX_EOF;
+    i2s_update_irq(s);
+    s->rx_desc = i2s_next_desc(&desc, s->rx_desc, s->rx_first_desc);
+    if (!s->rx_desc) {
+        s->rx_running = false;
+        return;
+    }
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + I2S_DMA_PERIOD_MS);
+}
+
+static uint64_t i2s_read(void *opaque, hwaddr addr, unsigned size)
+{
+    M5Esp32I2SState *s = opaque;
+
+    switch (addr) {
+    case R_INT_RAW:
+        return s->int_raw;
+    case R_INT_ST:
+        return s->int_raw & s->int_ena;
+    case R_INT_ENA:
+        return s->int_ena;
+    case R_STATE:
+        return (!s->tx_running ? BIT(0) : 0) |
+               (!s->rx_running ? BIT(2) : 0);
+    default:
+        return addr < sizeof(s->regs) ? s->regs[addr / 4] : 0;
+    }
+}
+
+static void i2s_write_link(M5Esp32I2SState *s, hwaddr addr, uint32_t value,
+                           bool tx)
+{
+    uint32_t first;
+
+    s->regs[addr / 4] = value;
+    first = i2s_desc_decode_addr(value);
+    if (tx) {
+        s->tx_first_desc = first;
+        if (value & (LINK_START | LINK_RESTART)) {
+            s->tx_desc = first;
+            s->tx_running = true;
+            if (s->regs[R_CONF / 4] & CONF_TX_START) {
+                timer_mod(s->tx_timer,
+                          qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                          + I2S_DMA_PERIOD_MS);
+            }
+        }
+        if (value & LINK_STOP) {
+            s->tx_running = false;
+            timer_del(s->tx_timer);
+        }
+    } else {
+        s->rx_first_desc = first;
+        if (value & (LINK_START | LINK_RESTART)) {
+            s->rx_desc = first;
+            s->rx_running = true;
+            i2s_load_rx_pcm(s);
+            if (s->regs[R_CONF / 4] & CONF_RX_START) {
+                timer_mod(s->rx_timer,
+                          qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                          + I2S_DMA_PERIOD_MS);
+            }
+        }
+        if (value & LINK_STOP) {
+            s->rx_running = false;
+            timer_del(s->rx_timer);
+        }
+    }
+}
+
+static void i2s_write(void *opaque, hwaddr addr, uint64_t value,
+                      unsigned size)
+{
+    M5Esp32I2SState *s = opaque;
+    uint32_t v = value;
+    bool old_tx_start;
+    bool old_rx_start;
+
+    if (s->trace) {
+        fprintf(stderr, "[esp32-i2s%d] wr %03x <- %08x\n",
+                s->port, (unsigned)addr, v);
+    }
+    switch (addr) {
+    case R_INT_ENA:
+        s->int_ena = v;
+        i2s_update_irq(s);
+        return;
+    case R_INT_CLR:
+        s->int_raw &= ~v;
+        i2s_update_irq(s);
+        return;
+    case R_CONF:
+        old_tx_start = !!(s->regs[addr / 4] & CONF_TX_START);
+        old_rx_start = !!(s->regs[addr / 4] & CONF_RX_START);
+        if (v & CONF_TX_RESET) {
+            s->tx_running = false;
+            timer_del(s->tx_timer);
+            s->tx_desc = 0;
+        }
+        if (v & CONF_RX_RESET) {
+            s->rx_running = false;
+            timer_del(s->rx_timer);
+            s->rx_desc = 0;
+        }
+        s->regs[addr / 4] = v & ~(CONF_TX_RESET | CONF_RX_RESET |
+                                  CONF_TX_FIFO_RESET | CONF_RX_FIFO_RESET);
+        if ((v & CONF_TX_START) && !old_tx_start && s->tx_first_desc) {
+            s->tx_desc = s->tx_first_desc;
+            s->tx_running = true;
+            s->pcm_writes = 0;
+            s->last_pcm_hash = 0;
+            timer_mod(s->tx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                      + I2S_DMA_PERIOD_MS);
+        }
+        if ((v & CONF_RX_START) && !old_rx_start && s->rx_first_desc) {
+            s->rx_desc = s->rx_first_desc;
+            s->rx_running = true;
+            i2s_load_rx_pcm(s);
+            timer_mod(s->rx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME)
+                      + I2S_DMA_PERIOD_MS);
+        }
+        if (!(v & CONF_TX_START)) {
+            s->tx_running = false;
+            timer_del(s->tx_timer);
+        }
+        if (!(v & CONF_RX_START)) {
+            s->rx_running = false;
+            timer_del(s->rx_timer);
+        }
+        return;
+    case R_OUT_LINK:
+        i2s_write_link(s, addr, v, true);
+        return;
+    case R_IN_LINK:
+        i2s_write_link(s, addr, v, false);
+        return;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+    }
+}
+
+static const MemoryRegionOps i2s_ops = {
+    .read = i2s_read,
+    .write = i2s_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void i2s_reset(DeviceState *dev)
+{
+    M5Esp32I2SState *s = M5_ESP32_I2S(dev);
+
+    timer_del(s->tx_timer);
+    timer_del(s->rx_timer);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->tx_desc = 0;
+    s->tx_first_desc = 0;
+    s->rx_desc = 0;
+    s->rx_first_desc = 0;
+    s->tx_running = false;
+    s->rx_running = false;
+    qemu_set_irq(s->irq, 0);
+}
+
+static void i2s_init(Object *obj)
+{
+    M5Esp32I2SState *s = M5_ESP32_I2S(obj);
+
+    memory_region_init_io(&s->iomem, obj, &i2s_ops, s,
+                          TYPE_M5_ESP32_I2S, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+    s->tx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_tx_timer, s);
+    s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, i2s_rx_timer, s);
+    s->trace = getenv("M5SW_I2S_TRACE") != NULL;
+}
+
+static void i2s_finalize(Object *obj)
+{
+    M5Esp32I2SState *s = M5_ESP32_I2S(obj);
+
+    timer_free(s->tx_timer);
+    timer_free(s->rx_timer);
+    if (s->pcm_file) {
+        fclose(s->pcm_file);
+    }
+    g_free(s->rx_pcm);
+}
+
+static void i2s_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, i2s_reset);
+}
+
+static const TypeInfo i2s_info = {
+    .name = TYPE_M5_ESP32_I2S,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(M5Esp32I2SState),
+    .instance_init = i2s_init,
+    .instance_finalize = i2s_finalize,
+    .class_init = i2s_class_init,
+};
+
+static void i2s_register_types(void)
+{
+    type_register_static(&i2s_info);
+}
+
+type_init(i2s_register_types)
+
+void m5_esp32_i2s_board_init(MemoryRegion *sys_mem, BusState *periph_bus,
+                             DeviceState *intmatrix)
+{
+    static const struct {
+        hwaddr base;
+        int irq;
+    } ports[] = {
+        { DR_REG_I2S_BASE, ETS_I2S0_INTR_SOURCE },
+        { DR_REG_I2S1_BASE, ETS_I2S1_INTR_SOURCE },
+    };
+
+    for (uint32_t i = 0; i < ARRAY_SIZE(ports); i++) {
+        DeviceState *dev = qdev_new(TYPE_M5_ESP32_I2S);
+        M5Esp32I2SState *s = M5_ESP32_I2S(dev);
+        char name[16];
+
+        s->port = i;
+        snprintf(name, sizeof(name), "esp32.i2s%u", i);
+        object_property_add_child(qdev_get_machine(), name, OBJECT(dev));
+        qdev_realize(dev, periph_bus, &error_fatal);
+        memory_region_add_subregion_overlap(
+            sys_mem, ports[i].base,
+            sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 0);
+        sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                           qdev_get_gpio_in(intmatrix, ports[i].irq));
+    }
+}
diff -ruN a/hw/m5stopwatch/m5_lcd_cam.c b/hw/m5stopwatch/m5_lcd_cam.c
--- a/hw/m5stopwatch/m5_lcd_cam.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_lcd_cam.c	2026-10-21 10:33:48
@@ -0,0 +1,269 @@
+/*
+ * Minimal ESP32-S3 LCD_CAM camera front-end.
+ *
+ * The camera sensor is configured through SCCB by the guest.  This model
+ * supplies deterministic RGB565 frames through the real LCD_CAM interrupt
+ * and GDMA RX descriptor path used by esp32-camera.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "hw/dma/esp_gdma.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "m5stopwatch.h"
+
+#define R_CAM_CTRL   0x04
+#define R_CAM_CTRL1  0x08
+#define R_CAM_RGB    0x0c
+#define R_INT_ENA    0x64
+#define R_INT_RAW    0x68
+#define R_INT_ST     0x6c
+#define R_INT_CLR    0x70
+#define CAM_UPDATE   (1u << 4)
+#define CAM_START    (1u << 29)
+#define CAM_RESET    (1u << 30)
+#define CAM_AFIFO_RST (1u << 31)
+#define CAM_VSYNC_INT (1u << 2)
+
+struct M5LcdCamState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    ESPGdmaState *gdma;
+    uint32_t regs[0x100 / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    uint32_t width;
+    uint32_t height;
+    uint32_t frame_offset;
+    uint32_t frame_bytes;
+    uint32_t chunk_len;
+    uint32_t chunks_left;
+    uint8_t *frame_data;
+    uint32_t frame_data_size;
+    bool started;
+    QEMUTimer *capture_timer;
+};
+
+static void lcd_cam_update_irq(M5LcdCamState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static uint16_t camera_pattern_pixel(M5LcdCamState *s, uint32_t pixel)
+{
+    uint32_t area = MAX(1u, s->width * s->height);
+    uint32_t p = pixel % area;
+    uint32_t x = p % MAX(1u, s->width);
+    uint32_t y = p / MAX(1u, s->width);
+    uint8_t r, g, b;
+
+    if (y < MAX(1u, s->height / 4)) {
+        r = 235; g = 48; b = 48;
+    } else if (y < MAX(1u, s->height / 2)) {
+        r = 235; g = 190; b = 35;
+    } else if (y < MAX(1u, (s->height * 3) / 4)) {
+        r = 40; g = 190; b = 80;
+    } else {
+        r = 35; g = 105; b = 235;
+    }
+    if ((x % 40) < 2 || (y % 40) < 2) {
+        r = g = b = 245;
+    }
+    return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+}
+
+static void lcd_cam_fill_frame(M5LcdCamState *s, uint8_t *data, uint32_t len)
+{
+    uint32_t frame_bytes = MAX(2u, s->width * s->height * 2);
+    if (s->frame_data && s->frame_data_size >= frame_bytes) {
+        for (uint32_t i = 0; i < len; i++) {
+            data[i] = s->frame_data[(s->frame_offset + i) % frame_bytes];
+        }
+        s->frame_offset = (s->frame_offset + len) % frame_bytes;
+        return;
+    }
+    for (uint32_t i = 0; i < len; i += 2) {
+        uint32_t offset = (s->frame_offset + i) % frame_bytes;
+        uint16_t pixel = camera_pattern_pixel(s, offset / 2);
+        data[i] = pixel & 0xff;
+        if (i + 1 < len) {
+            data[i + 1] = pixel >> 8;
+        }
+    }
+    s->frame_offset = (s->frame_offset + len) % frame_bytes;
+}
+
+static void lcd_cam_capture(M5LcdCamState *s)
+{
+    uint32_t channel;
+    uint32_t len = s->chunk_len;
+    g_autofree uint8_t *data = g_malloc0(len);
+
+    if (!(s->int_ena & CAM_VSYNC_INT)) {
+        timer_mod(s->capture_timer,
+                  qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 10);
+        return;
+    }
+
+    lcd_cam_fill_frame(s, data, len);
+    if (s->gdma) {
+        bool found = esp_gdma_get_channel_periph(
+            s->gdma, GDMA_LCDCAM, ESP_GDMA_IN_IDX, &channel);
+        if (!found) {
+            if (getenv("M5SW_CAMERA_TRACE")) {
+                fprintf(stderr, "[lcd-cam] waiting for camera GDMA channel\n");
+            }
+            timer_mod(s->capture_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 10);
+            return;
+        }
+        if (s->chunks_left) {
+            esp_gdma_write_channel(s->gdma, channel, data, len);
+            esp_gdma_set_chan_interrupt(s->gdma, ESP_GDMA_IN_IDX, channel,
+                                        R_GDMA_INTERRUPT_IN_SUC_EOF_MASK);
+            s->chunks_left--;
+            timer_mod(s->capture_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
+        } else {
+            s->int_raw |= CAM_VSYNC_INT;
+            lcd_cam_update_irq(s);
+            if (getenv("M5SW_CAMERA_TRACE")) {
+                fprintf(stderr, "[lcd-cam] frame complete bytes=%u\n",
+                        s->frame_bytes);
+            }
+        }
+    }
+}
+
+static uint64_t lcd_cam_read(void *opaque, hwaddr addr, unsigned size)
+{
+    M5LcdCamState *s = opaque;
+    switch (addr) {
+    case R_INT_ENA:
+        return s->int_ena;
+    case R_INT_RAW:
+        return s->int_raw;
+    case R_INT_ST:
+        return s->int_raw & s->int_ena;
+    default:
+        return addr < sizeof(s->regs) ? s->regs[addr / 4] : 0;
+    }
+}
+
+static void lcd_cam_write(void *opaque, hwaddr addr, uint64_t value,
+                          unsigned size)
+{
+    M5LcdCamState *s = opaque;
+    uint32_t v = value;
+
+    switch (addr) {
+    case R_CAM_CTRL:
+        s->regs[addr / 4] = v & ~CAM_UPDATE;
+        break;
+    case R_CAM_CTRL1: {
+        bool start = !!(v & CAM_START);
+        bool rising = start && !s->started;
+        s->regs[addr / 4] = v & ~(CAM_RESET | CAM_AFIFO_RST);
+        s->started = start;
+        if (rising) {
+            s->frame_bytes = MAX(2u, s->width * s->height * 2);
+            s->chunk_len = (v & 0xffff) + 1;
+            s->chunks_left = (s->frame_bytes + s->chunk_len - 1)
+                           / s->chunk_len;
+            s->frame_offset = 0;
+            lcd_cam_capture(s);
+        }
+        break;
+    }
+    case R_INT_ENA:
+        s->int_ena = v;
+        lcd_cam_update_irq(s);
+        break;
+    case R_INT_CLR:
+        s->int_raw &= ~v;
+        lcd_cam_update_irq(s);
+        break;
+    default:
+        if (addr < sizeof(s->regs)) {
+            s->regs[addr / 4] = v;
+        }
+        break;
+    }
+}
+
+static const MemoryRegionOps lcd_cam_ops = {
+    .read = lcd_cam_read,
+    .write = lcd_cam_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void lcd_cam_reset(DeviceState *dev)
+{
+    M5LcdCamState *s = M5_LCD_CAM(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->frame_offset = 0;
+    s->frame_bytes = 0;
+    s->chunk_len = 0;
+    s->chunks_left = 0;
+    s->started = false;
+}
+
+static void lcd_cam_init(Object *obj)
+{
+    M5LcdCamState *s = M5_LCD_CAM(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+    memory_region_init_io(&s->iomem, obj, &lcd_cam_ops, s,
+                          TYPE_M5_LCD_CAM, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->capture_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                    (QEMUTimerCB *)lcd_cam_capture, s);
+}
+
+static void lcd_cam_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, lcd_cam_reset);
+}
+
+static const TypeInfo lcd_cam_info = {
+    .name = TYPE_M5_LCD_CAM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(M5LcdCamState),
+    .instance_init = lcd_cam_init,
+    .class_init = lcd_cam_class_init,
+};
+
+static void lcd_cam_register(void)
+{
+    type_register_static(&lcd_cam_info);
+}
+type_init(lcd_cam_register)
+
+void m5_lcd_cam_attach(DeviceState *dev, ESPGdmaState *gdma,
+                       uint32_t width, uint32_t height)
+{
+    M5LcdCamState *s = M5_LCD_CAM(dev);
+    s->gdma = gdma;
+    s->width = width;
+    s->height = height;
+    const char *frame_path = getenv("M5SW_CAMERA_FRAME");
+    if (frame_path) {
+        gsize size = 0;
+        if (!g_file_get_contents(frame_path, (gchar **)&s->frame_data,
+                                 &size, NULL)) {
+            s->frame_data = NULL;
+            size = 0;
+        }
+        s->frame_data_size = MIN(size, UINT32_MAX);
+    }
+}
diff -ruN a/hw/m5stopwatch/m5_rmt.c b/hw/m5stopwatch/m5_rmt.c
--- a/hw/m5stopwatch/m5_rmt.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_rmt.c	2026-10-21 11:16:42
@@ -0,0 +1,284 @@
+/*
+ * ESP32-S3 RMT APB and hardware-memory model.
+ *
+ * The UIFlow2 IR stack uses the new RMT driver in non-DMA mode: the encoder
+ * writes rmt_symbol_word_t entries into RMTMEM, starts the channel through
+ * CHnCONF0, and waits for the TX_END interrupt. This model implements that
+ * data path and records transmitted symbols for host-side assertions.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "hw/irq.h"
+#include "hw/misc/esp32s3_reg.h"
+#include "hw/sysbus.h"
+#include "hw/xtensa/esp32s3_intc.h"
+#include "m5stopwatch.h"
+
+#define RMT_MEM_OFFSET      0x800
+#define RMT_MEM_SIZE        0x800
+#define RMT_TX_CHANNELS     4
+#define RMT_SYMBOLS_PER_CH  48
+
+#define RMT_CH0CONF0        0x20
+#define RMT_CH4CONF0        0x30
+#define RMT_CH4STATUS       0x60
+#define RMT_INT_RAW         0x70
+#define RMT_INT_ST          0x74
+#define RMT_INT_ENA         0x78
+#define RMT_INT_CLR         0x7c
+
+struct M5RmtState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    MemoryRegion mem;
+    qemu_irq irq;
+    uint32_t regs[RMT_MEM_OFFSET / 4];
+    uint32_t symbols[RMT_MEM_SIZE / 4];
+    uint32_t int_ena;
+    uint32_t int_raw;
+    QEMUTimer *tx_timer;
+    QEMUTimer *rx_timer;
+    FILE *tx_file;
+    uint32_t pending_mask;
+    uint32_t rx_pending_mask;
+    bool rx_injected[4];
+    bool trace;
+};
+
+static void rmt_update_irq(M5RmtState *s)
+{
+    qemu_set_irq(s->irq, !!(s->int_raw & s->int_ena));
+}
+
+static void rmt_capture_tx(M5RmtState *s, uint32_t channel)
+{
+    uint32_t conf = s->regs[(RMT_CH0CONF0 + channel * 4) / 4];
+    uint32_t blocks = MAX((conf >> 16) & 0xf, 1);
+    uint32_t count = 0;
+    uint32_t limit = MIN(blocks * RMT_SYMBOLS_PER_CH,
+                         RMT_SYMBOLS_PER_CH);
+    uint32_t base = channel * RMT_SYMBOLS_PER_CH;
+
+    for (uint32_t i = 0; i < limit; i++) {
+        uint32_t symbol = s->symbols[base + i];
+        if ((symbol & 0x7fff) == 0
+            && ((symbol >> 16) & 0x7fff) == 0) {
+            break;
+        }
+        count++;
+    }
+    if (!s->tx_file) {
+        const char *path = getenv("M5SW_RMT_TX_FILE");
+        if (path) {
+            s->tx_file = fopen(path, "wb");
+        }
+    }
+    if (s->tx_file && count) {
+        fwrite(&s->symbols[base], sizeof(uint32_t), count, s->tx_file);
+        fflush(s->tx_file);
+    }
+    if (s->trace) {
+        fprintf(stderr, "[rmt] tx channel=%u symbols=%u blocks=%u\n",
+                channel, count, blocks);
+    }
+
+    s->int_raw |= 1u << channel;
+    rmt_update_irq(s);
+}
+
+static void rmt_tx_timer(void *opaque)
+{
+    M5RmtState *s = opaque;
+    uint32_t pending = s->pending_mask;
+    s->pending_mask = 0;
+
+    for (uint32_t channel = 0; channel < RMT_TX_CHANNELS; channel++) {
+        if (pending & (1u << channel)) {
+            rmt_capture_tx(s, channel);
+        }
+    }
+}
+
+static void rmt_rx_timer(void *opaque)
+{
+    M5RmtState *s = opaque;
+    uint32_t pending = s->rx_pending_mask;
+    s->rx_pending_mask = 0;
+
+    for (uint32_t channel = 0; channel < 4; channel++) {
+        if (pending & (1u << channel)) {
+            s->int_raw |= 1u << (16 + channel);
+        }
+    }
+    rmt_update_irq(s);
+}
+
+static void rmt_inject_rx(M5RmtState *s, uint32_t channel)
+{
+    const char *path = getenv("M5SW_RMT_RX_FILE");
+    g_autofree uint8_t *data = NULL;
+    gsize size = 0;
+    uint32_t count;
+
+    if (!path || s->rx_injected[channel]) {
+        return;
+    }
+    if (!g_file_get_contents(path, (gchar **)&data, &size, NULL)) {
+        return;
+    }
+    count = MIN(size / sizeof(uint32_t), RMT_SYMBOLS_PER_CH);
+    memcpy(&s->symbols[(4 + channel) * RMT_SYMBOLS_PER_CH],
+           data, count * sizeof(uint32_t));
+    /* mem_waddr_ex is an absolute RMTMEM word address; each channel
+     * occupies 48 words on ESP32-S3 and starts at (channel + 4) * 48. */
+    s->regs[(RMT_CH4STATUS + channel * 4) / 4] =
+        (channel + 4) * 48 + count;
+    s->rx_injected[channel] = true;
+    s->rx_pending_mask |= 1u << channel;
+    timer_mod(s->rx_timer,
+              qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 20);
+    if (s->trace) {
+        fprintf(stderr, "[rmt] rx inject channel=%u symbols=%u\n",
+                channel, count);
+    }
+}
+
+static uint64_t rmt_read(void *opaque, hwaddr addr, unsigned size)
+{
+    M5RmtState *s = opaque;
+
+    if (addr == RMT_INT_RAW) {
+        return s->int_raw;
+    }
+    if (addr == RMT_INT_ST) {
+        return s->int_raw & s->int_ena;
+    }
+    if (addr == RMT_INT_ENA) {
+        return s->int_ena;
+    }
+    return addr < RMT_MEM_OFFSET ? s->regs[addr / 4] : 0;
+}
+
+static void rmt_write(void *opaque, hwaddr addr, uint64_t value,
+                      unsigned size)
+{
+    M5RmtState *s = opaque;
+    uint32_t v = value;
+
+    if (s->trace) {
+        fprintf(stderr, "[rmt] wr %03x <- %08x\n", (unsigned)addr, v);
+    }
+    if (addr == RMT_INT_ENA) {
+        s->int_ena = v;
+        rmt_update_irq(s);
+        return;
+    }
+    if (addr == RMT_INT_CLR) {
+        s->int_raw &= ~v;
+        rmt_update_irq(s);
+        return;
+    }
+    if (addr >= RMT_CH0CONF0 && addr < RMT_CH0CONF0 + RMT_TX_CHANNELS * 4) {
+        uint32_t channel = (addr - RMT_CH0CONF0) / 4;
+        s->regs[addr / 4] = v & ~1u;
+        if (v & 1u) {
+            s->pending_mask |= 1u << channel;
+            timer_mod(s->tx_timer,
+                      qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 2);
+        }
+        return;
+    }
+    if (addr >= RMT_CH4CONF0 && addr < RMT_CH4CONF0 + 4 * 8) {
+        uint32_t offset = addr - RMT_CH4CONF0;
+        uint32_t channel = offset / 8;
+        if ((offset % 8) == 4) {
+            bool was_enabled = s->regs[addr / 4] & 1u;
+            s->regs[addr / 4] = v;
+            if (!was_enabled && (v & 1u)) {
+                rmt_inject_rx(s, channel);
+            }
+            return;
+        }
+    }
+    if (addr < RMT_MEM_OFFSET) {
+        s->regs[addr / 4] = v;
+    }
+}
+
+static const MemoryRegionOps rmt_ops = {
+    .read = rmt_read,
+    .write = rmt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static void rmt_reset(DeviceState *dev)
+{
+    M5RmtState *s = M5_RMT(dev);
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->symbols, 0, sizeof(s->symbols));
+    s->int_ena = 0;
+    s->int_raw = 0;
+    s->pending_mask = 0;
+    s->rx_pending_mask = 0;
+    memset(s->rx_injected, 0, sizeof(s->rx_injected));
+    timer_del(s->tx_timer);
+    timer_del(s->rx_timer);
+}
+
+static void rmt_init(Object *obj)
+{
+    M5RmtState *s = M5_RMT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &rmt_ops, s, TYPE_M5_RMT,
+                          RMT_MEM_OFFSET);
+    memory_region_init_ram_ptr(&s->mem, obj, TYPE_M5_RMT ".mem",
+                               RMT_MEM_SIZE, s->symbols);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_mmio(sbd, &s->mem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->trace = getenv("M5SW_RMT_TRACE") != NULL;
+    s->tx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rmt_tx_timer, s);
+    s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, rmt_rx_timer, s);
+}
+
+static void rmt_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    device_class_set_legacy_reset(dc, rmt_reset);
+}
+
+static const TypeInfo rmt_info = {
+    .name = TYPE_M5_RMT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(M5RmtState),
+    .instance_init = rmt_init,
+    .class_init = rmt_class_init,
+};
+
+static void rmt_register(void)
+{
+    type_register_static(&rmt_info);
+}
+type_init(rmt_register)
+
+void esp32s3_rmt_init(MemoryRegion *sys_mem, DeviceState *intmatrix)
+{
+    DeviceState *dev = qdev_new(TYPE_M5_RMT);
+    object_property_add_child(qdev_get_machine(), "rmt0", OBJECT(dev));
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    memory_region_add_subregion_overlap(
+        sys_mem, DR_REG_RMT_BASE,
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 1);
+    memory_region_add_subregion_overlap(
+        sys_mem, DR_REG_RMT_BASE + RMT_MEM_OFFSET,
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 1), 1);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                       qdev_get_gpio_in(intmatrix, ETS_RMT_INTR_SOURCE));
+}
diff -ruN a/hw/m5stopwatch/m5_scs_servo.c b/hw/m5stopwatch/m5_scs_servo.c
--- a/hw/m5stopwatch/m5_scs_servo.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_scs_servo.c	2026-10-21 12:56:41
@@ -0,0 +1,205 @@
+/*
+ * Minimal SCS serial servo bus peer for StackChan.
+ *
+ * The guest UART bytes are parsed as SCSCL packets. Servo ID 1/2 expose the
+ * EEPROM/SRAM fields used by the UIFlow2 driver, including position, torque,
+ * voltage, current and PWM-mode angle limits.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "hw/char/esp32_uart.h"
+#include "m5stopwatch.h"
+
+#define SCS_MAX_PACKET 256
+#define SCS_MEM_SIZE 71
+#define SCS_ID_X 1
+#define SCS_ID_Y 2
+
+typedef struct M5ScsServoState {
+    ESP32UARTState *uart;
+    uint8_t packet[SCS_MAX_PACKET];
+    uint16_t packet_len;
+    uint8_t mem[3][SCS_MEM_SIZE];
+} M5ScsServoState;
+
+static void scs_put_be16(uint8_t *mem, int addr, uint16_t value)
+{
+    mem[addr] = value >> 8;
+    mem[addr + 1] = value;
+}
+
+static uint16_t scs_get_be16(const uint8_t *mem, int addr)
+{
+    return ((uint16_t)mem[addr] << 8) | mem[addr + 1];
+}
+
+static void scs_init_mem(M5ScsServoState *s)
+{
+    for (int id = SCS_ID_X; id <= SCS_ID_Y; id++) {
+        uint8_t *m = s->mem[id];
+        memset(m, 0, SCS_MEM_SIZE);
+        m[3] = 0x01;                         /* version low */
+        m[4] = 0x01;                         /* version high */
+        m[5] = id;
+        m[6] = 1;                            /* baud-rate selector */
+        scs_put_be16(m, 9, 0);               /* min angle limit */
+        scs_put_be16(m, 11, 1000);           /* max angle limit */
+        m[40] = 0;                           /* torque disabled */
+        scs_put_be16(m, 42, id == SCS_ID_X ? 450 : 125);
+        scs_put_be16(m, 56, id == SCS_ID_X ? 450 : 125);
+        m[62] = 120;                         /* 12.0 V */
+        m[63] = 35;                          /* 35 C */
+        m[66] = 0;
+        scs_put_be16(m, 69, 0);
+    }
+}
+
+static void scs_send(M5ScsServoState *s, uint8_t id, uint8_t error,
+                     const uint8_t *data, uint8_t data_len)
+{
+    uint8_t out[SCS_MAX_PACKET];
+    uint8_t len = data_len + 2;
+    uint8_t sum = 0;
+    int pos = 0;
+
+    out[pos++] = 0xff;
+    out[pos++] = 0xff;
+    out[pos++] = id;
+    out[pos++] = len;
+    out[pos++] = error;
+    sum = id + len + error;
+    for (int i = 0; i < data_len; i++) {
+        out[pos++] = data[i];
+        sum += data[i];
+    }
+    out[pos++] = ~sum;
+    if (getenv("M5SW_SCS_TRACE")) {
+        fprintf(stderr, "[scs] response id=%u err=%u len=%u\n",
+                id, error, data_len);
+    }
+    esp32_uart_inject_rx(s->uart, out, pos);
+}
+
+static uint8_t *scs_mem_for(M5ScsServoState *s, uint8_t id)
+{
+    if (id != SCS_ID_X && id != SCS_ID_Y) {
+        return NULL;
+    }
+    return s->mem[id];
+}
+
+static void scs_handle_packet(M5ScsServoState *s)
+{
+    uint8_t id = s->packet[2];
+    uint8_t len = s->packet[3];
+    uint8_t inst = s->packet[4];
+    uint8_t addr = s->packet[5];
+    uint8_t data_len;
+    uint8_t *mem = scs_mem_for(s, id);
+
+    if (getenv("M5SW_SCS_TRACE")) {
+        fprintf(stderr, "[scs] packet id=%u inst=%02x len=%u addr=%u\n",
+                id, inst, len, addr);
+    }
+
+    if (inst == 0x01) { /* PING */
+        if (id != 0xfe) {
+            scs_send(s, id, 0, NULL, 0);
+        }
+        return;
+    }
+    if (inst == 0x02) { /* READ */
+        uint8_t response[SCS_MEM_SIZE];
+        data_len = s->packet[6];
+        if (!mem || data_len > sizeof(response) || addr + data_len > SCS_MEM_SIZE) {
+            return;
+        }
+        memcpy(response, mem + addr, data_len);
+        scs_send(s, id, 0, response, data_len);
+        return;
+    }
+    if (inst == 0x03 || inst == 0x04) { /* WRITE / REG_WRITE */
+        data_len = len - 3;
+        if (mem && data_len && addr + data_len <= SCS_MEM_SIZE) {
+            memcpy(mem + addr, s->packet + 6, data_len);
+            if (addr <= 43 && addr + data_len > 42) {
+                scs_put_be16(mem, 56, scs_get_be16(mem, 42));
+            }
+            if (id != 0xfe) {
+                scs_send(s, id, 0, NULL, 0);
+            }
+        }
+        return;
+    }
+    if (inst == 0x05) { /* REG_ACTION */
+        return;
+    }
+    if (inst == 0x83) { /* SYNC_WRITE */
+        data_len = s->packet[6];
+        int count = (len - 4) / (data_len + 1);
+        int pos = 7;
+        for (int i = 0; i < count; i++) {
+            uint8_t sid = s->packet[pos++];
+            uint8_t *sm = scs_mem_for(s, sid);
+            if (sm && data_len && addr + data_len <= SCS_MEM_SIZE) {
+                memcpy(sm + addr, s->packet + pos, data_len);
+                if (addr <= 43 && addr + data_len > 42) {
+                    scs_put_be16(sm, 56, scs_get_be16(sm, 42));
+                }
+            }
+            pos += data_len;
+        }
+    }
+}
+
+static void scs_uart_byte(void *opaque, uint8_t byte)
+{
+    M5ScsServoState *s = opaque;
+
+    if (s->packet_len < sizeof(s->packet)) {
+        s->packet[s->packet_len++] = byte;
+    } else {
+        s->packet_len = 0;
+        return;
+    }
+
+    if (s->packet_len == 1 && s->packet[0] != 0xff) {
+        s->packet_len = 0;
+        return;
+    }
+    if (s->packet_len == 2 && s->packet[1] != 0xff) {
+        s->packet_len = s->packet[1] == 0xff ? 1 : 0;
+        return;
+    }
+    if (s->packet_len < 4) {
+        return;
+    }
+
+    uint8_t payload_len = s->packet[3];
+    uint16_t total = payload_len + 4;
+    if (payload_len < 2 || total > sizeof(s->packet)) {
+        s->packet_len = 0;
+        return;
+    }
+    if (s->packet_len < total) {
+        return;
+    }
+
+    uint8_t sum = 0;
+    for (int i = 2; i < total - 1; i++) {
+        sum += s->packet[i];
+    }
+    if ((uint8_t)~sum == s->packet[total - 1]) {
+        scs_handle_packet(s);
+    }
+    s->packet_len = 0;
+}
+
+void m5_scs_servo_attach(DeviceState *uart)
+{
+    M5ScsServoState *s = g_new0(M5ScsServoState, 1);
+    s->uart = ESP32_UART(uart);
+    scs_init_mem(s);
+    esp32_uart_set_tx_byte_callback(s->uart, scs_uart_byte, s);
+}
diff -ruN a/hw/m5stopwatch/m5_spi_sd.c b/hw/m5stopwatch/m5_spi_sd.c
--- a/hw/m5stopwatch/m5_spi_sd.c	1970-01-01 08:00:00
+++ b/hw/m5stopwatch/m5_spi_sd.c	2026-10-21 13:29:54
@@ -0,0 +1,372 @@
+/*
+ * SPI-mode SD card protocol model backed by a raw sector image.
+ *
+ * The model implements the command/data frames used by ESP-IDF's SDSPI host:
+ * CMD0/8/16/17/24/55/58/59, ACMD41 and single-block read/write.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "m5stopwatch.h"
+
+#define SD_BLOCK_SIZE 512
+#define SD_RESP_SIZE  1024
+
+typedef enum {
+    SD_IDLE,
+    SD_COMMAND,
+    SD_RESPONSE,
+    SD_WAIT_DATA,
+    SD_WRITE_DATA,
+    SD_WRITE_CRC,
+} SdSpiMode;
+
+typedef struct M5SpiSdState {
+    FILE *image;
+    uint64_t image_size;
+    SdSpiMode mode;
+    uint8_t command[6];
+    uint8_t command_pos;
+    uint8_t response[SD_RESP_SIZE];
+    uint32_t response_pos;
+    uint32_t response_len;
+    uint32_t sector;
+    uint8_t block[SD_BLOCK_SIZE];
+    uint32_t block_pos;
+    uint8_t cid[16];
+    uint8_t csd[16];
+    uint8_t crc_pos;
+    SdSpiMode next_mode;
+    bool app_cmd;
+    bool trace;
+} M5SpiSdState;
+
+static uint8_t sd_crc7(const uint8_t *data, uint32_t size)
+{
+    uint8_t crc = 0;
+    for (uint32_t i = 0; i < size; i++) {
+        for (int bit = 7; bit >= 0; bit--) {
+            crc <<= 1;
+            if ((crc >> 7) ^ ((data[i] >> bit) & 1)) {
+                crc ^= 0x89;
+            }
+        }
+    }
+    return crc;
+}
+
+static uint16_t sd_crc16(const uint8_t *data, uint32_t size)
+{
+    uint16_t crc = 0;
+    for (uint32_t i = 0; i < size; i++) {
+        crc ^= (uint16_t)data[i] << 8;
+        for (int bit = 0; bit < 8; bit++) {
+            crc = (crc & 0x8000) ? (crc << 1) ^ 0x1021 : crc << 1;
+        }
+    }
+    return (crc >> 8) | (crc << 8);
+}
+
+static void sd_set_identity(M5SpiSdState *s, uint64_t size)
+{
+    uint32_t csize;
+    uint32_t sectsize = 63;
+    uint32_t wpsize = 255;
+
+    memset(s->cid, 0, sizeof(s->cid));
+    s->cid[0] = 0xaa;
+    s->cid[1] = 'X';
+    s->cid[2] = 'Y';
+    memcpy(&s->cid[3], "QEMU!", 5);
+    s->cid[8] = 0x01;
+    s->cid[9] = 0xde;
+    s->cid[10] = 0xad;
+    s->cid[11] = 0xbe;
+    s->cid[12] = 0xef;
+    s->cid[13] = 0x00;
+    s->cid[14] = 0x62;
+    s->cid[15] = (sd_crc7(s->cid, 15) << 1) | 1;
+
+    if (!size) {
+        size = 8 * 1024 * 1024;
+    }
+    csize = (size >> 18) - 1;
+    memset(s->csd, 0, sizeof(s->csd));
+    s->csd[0] = 0x00;
+    s->csd[1] = 0x26;
+    s->csd[3] = 0x32;
+    s->csd[4] = 0x5f;
+    s->csd[5] = 0x50 | 9;
+    s->csd[6] = 0xe0 | ((csize >> 10) & 0x03);
+    s->csd[7] = (csize >> 2) & 0xff;
+    s->csd[8] = 0x3f | ((csize << 6) & 0xc0);
+    s->csd[9] = 0xff;
+    s->csd[10] = 0x40 | 0x80 | (sectsize >> 1);
+    s->csd[11] = 0x80 | wpsize;
+    s->csd[12] = 0x92;
+    s->csd[13] = 0x60;
+    s->csd[15] = (sd_crc7(s->csd, 15) << 1) | 1;
+}
+
+static uint8_t sd_spi_transfer(void *opaque, uint8_t tx);
+
+static const M5SpiSlaveOps sd_spi_ops = {
+    .set_cs = NULL,
+    .transfer = sd_spi_transfer,
+};
+
+static void sd_set_response_lead(M5SpiSdState *s, const uint8_t *data,
+                                 uint32_t size, uint32_t lead)
+{
+    size = MIN(size, sizeof(s->response) - lead);
+    memset(s->response, 0xff, lead);
+    s->response_len = size + lead;
+    if (size) {
+        memcpy(&s->response[lead], data, size);
+    }
+    s->response_pos = 0;
+    s->next_mode = SD_IDLE;
+    s->mode = size ? SD_RESPONSE : SD_IDLE;
+}
+
+static void sd_set_response(M5SpiSdState *s, const uint8_t *data,
+                            uint32_t size)
+{
+    sd_set_response_lead(s, data, size, 1);
+}
+
+static void sd_set_read_response(M5SpiSdState *s, const uint8_t *data,
+                                 uint32_t size)
+{
+    sd_set_response_lead(s, data, size, 2);
+}
+
+static void sd_set_response_next(M5SpiSdState *s, const uint8_t *data,
+                                 uint32_t size, SdSpiMode next)
+{
+    sd_set_response(s, data, size);
+    s->next_mode = next;
+}
+
+static void sd_r1(M5SpiSdState *s, uint8_t value)
+{
+    sd_set_response(s, &value, 1);
+}
+
+static uint32_t sd_arg(const uint8_t *cmd)
+{
+    return ((uint32_t)cmd[1] << 24) | ((uint32_t)cmd[2] << 16) |
+           ((uint32_t)cmd[3] << 8) | cmd[4];
+}
+
+static void sd_execute(M5SpiSdState *s)
+{
+    uint8_t cmd = s->command[0] & 0x3f;
+    uint32_t arg = sd_arg(s->command);
+    bool app_cmd = s->app_cmd;
+    uint8_t r7[5] = { 0x01, 0x00, 0x00, 0x01, 0xaa };
+    uint8_t r3[5] = { 0x00, 0x00, 0xff, 0x80, 0x00 };
+    uint8_t read_resp[SD_BLOCK_SIZE + 4];
+
+    if (s->trace) {
+        fprintf(stderr, "[sd-spi] cmd=%u arg=%08x app=%d\n",
+                cmd, arg, s->app_cmd);
+    }
+    if (cmd != 55) {
+        s->app_cmd = false;
+    }
+    switch (cmd) {
+    case 0: /* GO_IDLE_STATE */
+        sd_r1(s, 0x01);
+        break;
+    case 1: /* SEND_OP_COND */
+        sd_r1(s, 0x00);
+        break;
+    case 8: /* SEND_IF_COND */
+        sd_set_response(s, r7, sizeof(r7));
+        break;
+    case 9:   /* SEND_CSD */
+    case 10:  /* SEND_CID */
+    {
+        uint8_t data[20];
+        const uint8_t *identity = cmd == 9 ? s->csd : s->cid;
+        uint16_t crc = sd_crc16(identity, 16);
+        data[0] = 0x00;
+        data[1] = 0xfe;
+        memcpy(&data[2], identity, 16);
+        data[18] = crc & 0xff;
+        data[19] = crc >> 8;
+        sd_set_read_response(s, data, sizeof(data));
+        break;
+    }
+    case 12: /* STOP_TRANSMISSION */
+    case 16: /* SET_BLOCKLEN */
+    case 59: /* CRC_ON_OFF */
+        sd_r1(s, 0x00);
+        break;
+    case 13: /* SEND_STATUS */
+        if (app_cmd) {
+            uint8_t status[68];
+            uint16_t crc;
+            memset(status, 0, sizeof(status));
+            status[0] = 0x00;
+            status[1] = 0xfe;
+            crc = sd_crc16(&status[2], 64);
+            status[66] = crc & 0xff;
+            status[67] = crc >> 8;
+            sd_set_read_response(s, status, sizeof(status));
+        } else {
+            uint8_t status[2] = { 0x00, 0x00 }; /* R1 + card status */
+            sd_set_response(s, status, sizeof(status));
+        }
+        break;
+    case 17: /* READ_SINGLE_BLOCK */
+        s->sector = arg / SD_BLOCK_SIZE;
+        memset(read_resp, 0xff, sizeof(read_resp));
+        read_resp[0] = 0x00;
+        read_resp[1] = 0xfe;
+        memset(s->block, 0, sizeof(s->block));
+        if (s->image) {
+            fseeko(s->image, (off_t)s->sector * SD_BLOCK_SIZE, SEEK_SET);
+            fread(s->block, 1, sizeof(s->block), s->image);
+        }
+        memcpy(&read_resp[2], s->block, sizeof(s->block));
+        {
+            uint16_t crc = sd_crc16(s->block, sizeof(s->block));
+            read_resp[SD_BLOCK_SIZE + 2] = crc & 0xff;
+            read_resp[SD_BLOCK_SIZE + 3] = crc >> 8;
+        }
+        sd_set_read_response(s, read_resp, sizeof(read_resp));
+        break;
+    case 24: /* WRITE_SINGLE_BLOCK */
+        s->sector = arg / SD_BLOCK_SIZE;
+        s->block_pos = 0;
+        s->crc_pos = 0;
+        {
+            uint8_t r1 = 0x00;
+            sd_set_response_next(s, &r1, 1, SD_WAIT_DATA);
+        }
+        break;
+    case 41: /* ACMD41 */
+        sd_r1(s, 0x00);
+        break;
+    case 51: /* ACMD51: SEND_SCR */
+        if (app_cmd) {
+            uint8_t scr[12] = {
+                0x00, 0xfe,             /* R1 + data token */
+                0x00, 0x00, 0x00, 0x00, /* SCR structure/version/data status */
+                0x00, 0x00, 0x00, 0x00, /* capability bits: 1-bit SPI */
+                0x00, 0x00,
+                0x00, 0x00,
+            };
+            uint16_t crc = sd_crc16(&scr[2], 8);
+            scr[10] = crc & 0xff;
+            scr[11] = crc >> 8;
+            sd_set_read_response(s, scr, sizeof(scr));
+        } else {
+            sd_r1(s, 0x05);
+        }
+        break;
+    case 55: /* APP_CMD */
+        s->app_cmd = true;
+        sd_r1(s, 0x01);
+        break;
+    case 58: /* READ_OCR */
+        sd_set_response(s, r3, sizeof(r3));
+        break;
+    default:
+        if (s->trace) {
+            fprintf(stderr, "[sd-spi] unsupported cmd=%u\n", cmd);
+        }
+        sd_r1(s, 0x05);
+        break;
+    }
+}
+
+static uint8_t sd_spi_transfer(void *opaque, uint8_t tx)
+{
+    M5SpiSdState *s = opaque;
+    uint8_t out = 0xff;
+    uint8_t result;
+
+    switch (s->mode) {
+    case SD_RESPONSE:
+        out = s->response[s->response_pos++];
+        if (s->response_pos >= s->response_len) {
+            s->mode = s->next_mode;
+            s->next_mode = SD_IDLE;
+            s->response_len = 0;
+            s->response_pos = 0;
+        }
+        break;
+    case SD_COMMAND:
+        s->command[s->command_pos++] = tx;
+        if (s->command_pos == sizeof(s->command)) {
+            s->command_pos = 0;
+            sd_execute(s);
+        }
+        break;
+    case SD_WAIT_DATA:
+        if (tx == 0xfe) {
+            out = 0xff;
+            s->mode = SD_WRITE_DATA;
+            s->block_pos = 0;
+        }
+        break;
+    case SD_WRITE_DATA:
+        s->block[s->block_pos++] = tx;
+        if (s->block_pos == SD_BLOCK_SIZE) {
+            s->mode = SD_WRITE_CRC;
+            s->crc_pos = 0;
+        }
+        break;
+    case SD_WRITE_CRC:
+        if (++s->crc_pos >= 2) {
+            if (s->image) {
+                fseeko(s->image, (off_t)s->sector * SD_BLOCK_SIZE, SEEK_SET);
+                fwrite(s->block, 1, sizeof(s->block), s->image);
+                fflush(s->image);
+            }
+            result = 0x05;
+            s->response[0] = result;
+            s->response_pos = 0;
+            s->response_len = 1;
+            s->next_mode = SD_IDLE;
+            s->mode = SD_RESPONSE;
+        }
+        break;
+    case SD_IDLE:
+    default:
+        if (tx == 0xff) {
+            out = 0xff;
+        } else if ((tx & 0xc0) == 0x40) {
+            s->command[0] = tx;
+            s->command_pos = 1;
+            s->mode = SD_COMMAND;
+        }
+        break;
+    }
+    if (s->trace) {
+        fprintf(stderr, "[sd-spi] tx=%02x rx=%02x mode=%d\n",
+                tx, out, s->mode);
+    }
+    return out;
+}
+
+void m5_spi_sd_attach(DeviceState *spi, int cs_pin)
+{
+    M5SpiSdState *s = g_new0(M5SpiSdState, 1);
+    const char *path = getenv("M5SW_SPI_SD_IMAGE");
+
+    s->trace = getenv("M5SW_SPI_SD_TRACE") != NULL;
+    if (path) {
+        s->image = fopen(path, "r+b");
+        if (s->image) {
+            fseeko(s->image, 0, SEEK_END);
+            s->image_size = ftello(s->image);
+            fseeko(s->image, 0, SEEK_SET);
+        }
+    }
+    sd_set_identity(s, s->image_size);
+    esp32s3_gpspi_attach_spi_slave(spi, &sd_spi_ops, s, cs_pin);
+}
