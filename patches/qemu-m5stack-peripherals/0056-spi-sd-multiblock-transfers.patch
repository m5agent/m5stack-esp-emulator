+static void sd_read_block(M5SpiSdState *s, bool first)
+{
+    uint8_t response[SD_BLOCK_SIZE + 4];
+    uint32_t prefix = first ? 2 : 1;
+    uint16_t crc;
+    memset(s->block, 0, sizeof(s->block));
+    if (!s->image || (uint64_t)s->sector * SD_BLOCK_SIZE >= s->image_size ||
+        fseeko(s->image, (off_t)s->sector * SD_BLOCK_SIZE, SEEK_SET) ||
+        fread(s->block, 1, sizeof(s->block), s->image) != SD_BLOCK_SIZE) {
+        s->multi_read = false;
+        sd_r1(s, 0x20); /* address error; do not manufacture a successful sector */
+        return;
+    }
+    response[0] = 0x00;
+    response[prefix - 1] = 0xfe;
+    memcpy(response + prefix, s->block, SD_BLOCK_SIZE);
+    crc = sd_crc16(s->block, SD_BLOCK_SIZE);
+    response[prefix + SD_BLOCK_SIZE] = crc & 0xff;
+    response[prefix + SD_BLOCK_SIZE + 1] = crc >> 8;
+    sd_set_response_lead(s, response, prefix + SD_BLOCK_SIZE + 2, first ? 2 : 1);
+    if (s->multi_read) {
+        s->sector++;
+        s->next_mode = SD_READ_NEXT;
+    }
+}
