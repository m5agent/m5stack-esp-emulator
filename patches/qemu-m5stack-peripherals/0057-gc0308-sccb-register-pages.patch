+/* GC0308 SCCB register 0xfe selects page 0/1; bit 7 resets the sensor.
+ * Page-0 register 0x00 is the read-only product ID (0x9b). The official
+ * esp32-camera GC0308 initialization table writes page-1 register 0x00,
+ * which must not overwrite the identity used on the next camera probe.
+ * This models SCCB state, not sensor image processing or optical behavior.
+ */
+static uint8_t gc0308_read_reg(M5swI2CDev *s, uint8_t reg)
+{
+    if (reg == 0xfe) {
+        return s->gc0308_page;
+    }
+    if (!s->gc0308_page && reg == 0x00) {
+        return 0x9b;
+    }
+    return s->gc0308_page ? s->gc0308_bank1[reg] : s->regs[reg];
+}
+
+static void gc0308_write_reg(M5swI2CDev *s, uint8_t reg, uint8_t value)
+{
+    if (reg == 0xfe) {
+        if (value & 0x80) {
+            memset(s->regs, 0, sizeof(s->regs));
+            memset(s->gc0308_bank1, 0, sizeof(s->gc0308_bank1));
+            s->regs[0] = 0x9b;
+            s->gc0308_page = 0;
+        } else {
+            s->gc0308_page = value & 1;
+        }
+        return;
+    }
+    if (s->gc0308_page) {
+        s->gc0308_bank1[reg] = value;
+    } else if (reg != 0x00) {
+        s->regs[reg] = value;
+    }
+}
+
