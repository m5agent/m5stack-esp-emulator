+/* A SPI user transfer may split one GDMA chain into several MS_DLEN chunks.
+ * Only a new controller START/RESTART rewinds the descriptor cursor. */
+static void gpspi_dma_start(void *opaque, GdmaPeripheral periph, int dir)
+{
+    Esp32s3GpspiState *s = opaque;
+
+    if (dir == ESP_GDMA_OUT_IDX) {
+        s->dma_reload = true;
+    }
+}
+
+static void gpspi_bind_dma(Esp32s3GpspiState *s, uint32_t periph)
+{
+    esp_gdma_set_start_callback(s->gdma, periph, ESP_GDMA_OUT_IDX,
+                                gpspi_dma_start, s);
+}
+
