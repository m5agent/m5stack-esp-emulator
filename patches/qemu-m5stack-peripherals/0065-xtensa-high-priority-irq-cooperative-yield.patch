From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Wed, 28 Oct 2026 00:00:00 +0800
Subject: [PATCH] target/xtensa: yield during high priority IRQ handoffs

Single-threaded TCG with icount assigns each vCPU a large instruction
budget between switches. The classic ESP32 DPORT handoff uses a
high-priority interrupt on the other CPU and shared SRAM start/end
flags. The sender can clear the previous completion flags and start the
next transfer before the peer handler observes them, leaving each CPU
waiting on a different flag.

Track active Xtensa level-4/5 handlers and cooperatively yield when the
handler publishes its start flag or the sender returns from the end
path. Keep the state active when a nested level-5 handler returns to
level 4, and clear it only when leaving level 4 or resetting the CPU.
Normal instruction slices, guest instructions and virtual time are
unchanged. This models the hardware inter-core ordering points without
disabling interrupts or bypassing the DPORT protocol.

Signed-off-by: m5agent <m5agent@m5stack.com>
---
 accel/tcg/tcg-accel-ops-icount.c | 28 ++++++++++++++++++++++++++++
 include/sysemu/cpu-timers.h       |  8 ++++++++
 stubs/icount.c                    | 10 ++++++++++
 target/xtensa/cpu.c               |  2 ++
 target/xtensa/exc_helper.c        |  4 ++++
 target/xtensa/helper.h            |  2 ++
 target/xtensa/op_helper.c         | 16 ++++++++++++++++
 target/xtensa/translate.c         |  4 ++++
 8 files changed, 74 insertions(+)

diff --git a/accel/tcg/tcg-accel-ops-icount.c b/accel/tcg/tcg-accel-ops-icount.c
index 9e1ae66..fcbb280 100644
--- a/accel/tcg/tcg-accel-ops-icount.c
+++ b/accel/tcg/tcg-accel-ops-icount.c
@@ -34,6 +34,34 @@
 #include "tcg-accel-ops-icount.h"
 #include "tcg-accel-ops-rr.h"
 
+static unsigned icount_high_priority_irq_cpus;
+
+void icount_note_high_priority_irq(int cpu_index, bool active)
+{
+    unsigned mask = 1U << cpu_index;
+
+    if (!icount_enabled()) {
+        return;
+    }
+    if (active) {
+        icount_high_priority_irq_cpus |= mask;
+    } else {
+        icount_high_priority_irq_cpus &= ~mask;
+    }
+}
+
+void icount_yield_for_high_priority_irq(CPUState *cpu)
+{
+    if (icount_enabled() && icount_high_priority_irq_cpus) {
+        cpu_exit(cpu);
+    }
+}
+
+bool icount_high_priority_irq_active(void)
+{
+    return icount_enabled() && icount_high_priority_irq_cpus != 0;
+}
+
 static int64_t icount_get_limit(void)
 {
     int64_t deadline;
diff --git a/include/sysemu/cpu-timers.h b/include/sysemu/cpu-timers.h
index 7bfa960..ec16be2 100644
--- a/include/sysemu/cpu-timers.h
+++ b/include/sysemu/cpu-timers.h
@@ -68,6 +68,14 @@ bool icount_configure(QemuOpts *opts, Error **errp);
 /* used by tcg vcpu thread to calc icount budget */
 int64_t icount_round(int64_t count);
 
+/*
+ * Fine-grained round-robin scheduling is required while an Xtensa
+ * high-priority interrupt handler waits on state produced by another vCPU.
+ */
+void icount_note_high_priority_irq(int cpu_index, bool active);
+void icount_yield_for_high_priority_irq(CPUState *cpu);
+bool icount_high_priority_irq_active(void);
+
 /* if the CPUs are idle, start accounting real time to virtual clock. */
 void icount_start_warp_timer(void);
 void icount_account_warp_timer(void);
diff --git a/stubs/icount.c b/stubs/icount.c
index 9f9a59f..c063730 100644
--- a/stubs/icount.c
+++ b/stubs/icount.c
@@ -18,6 +18,16 @@ int64_t icount_get_raw(void)
     abort();
     return 0;
 }
+void icount_note_high_priority_irq(int cpu_index, bool active)
+{
+}
+void icount_yield_for_high_priority_irq(CPUState *cpu)
+{
+}
+bool icount_high_priority_irq_active(void)
+{
+    return false;
+}
 void icount_start_warp_timer(void)
 {
     abort();
