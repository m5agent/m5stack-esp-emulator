 #include "exec/memory.h"
 #endif
 
 
@@ -105,6 +106,7 @@ static void xtensa_cpu_reset_hold(Object *obj, ResetType type)
         xcc->parent_phases.hold(obj, type);
     }
 
+    icount_note_high_priority_irq(cs->cpu_index, false);
     env->pc = env->config->exception_vector[EXC_RESET0 + env->static_vectors];
     env->sregs[LITBASE] &= ~1;
 #ifndef CONFIG_USER_ONLY
diff --git a/target/xtensa/exc_helper.c b/target/xtensa/exc_helper.c
index ca629f0..5e43616 100644
--- a/target/xtensa/exc_helper.c
+++ b/target/xtensa/exc_helper.c
@@ -34,6 +34,7 @@
 #include "qemu/atomic.h"
 #include "exec/exec-all.h"
 #include "hw/xtensa/xtensa_irq_diag.h"
+#include "sysemu/cpu-timers.h"
 
 void HELPER(exception)(CPUXtensaState *env, uint32_t excp)
 {
@@ -236,6 +237,9 @@ void xtensa_cpu_do_interrupt(CPUState *cs)
         xtensa_irq_diag_note_wdt_entry(
             cs->cpu_index, env->pending_irq_level
         );
+        if (env->pending_irq_level >= 4) {
+            icount_note_high_priority_irq(cs->cpu_index, true);
+        }
         qemu_log_mask(CPU_LOG_INT,
                       "%s(EXC_IRQ) level = %d, cintlevel = %d, "
                       "pc = %08x, a0 = %08x, ps = %08x, "
diff --git a/target/xtensa/helper.h b/target/xtensa/helper.h
index ad291c8..4ae1cfe 100644
--- a/target/xtensa/helper.h
+++ b/target/xtensa/helper.h
@@ -30,6 +30,8 @@
 DEF_HELPER_3(check_atomctl, void, env, i32, i32)
 DEF_HELPER_7(s32c1i_trace, void, env, i32, i32, i32, i32, i32, i32)
 DEF_HELPER_4(check_exclusive, void, env, i32, i32, i32)
+DEF_HELPER_1(high_priority_irq_return, void, env)
+DEF_HELPER_2(high_priority_irq_yield, void, env, i32)
 DEF_HELPER_3(exception_return_trace, void, env, i32, i32)
