+    gen_helper_high_priority_irq_yield(tcg_env, tcg_constant_i32(0));
     gen_helper_retw(tcg_env, cpu_R[0]);
     gen_jump(dc, tmp);
 }
@@ -2106,6 +2108,7 @@ static void translate_rfe(DisasContext *dc, const OpcodeArg arg[],
 static void translate_rfe(DisasContext *dc, const OpcodeArg arg[],
                           const uint32_t par[])
 {
+    gen_helper_high_priority_irq_return(tcg_env);
     if (getenv("M5SW_XTENSA_IRQ_TRACE")
         || getenv("M5SW_XTENSA_IRQ_RING")) {
         gen_helper_exception_return_trace(
@@ -2118,6 +2121,7 @@ static void translate_rfi(DisasContext *dc, const OpcodeArg arg[],
 static void translate_rfi(DisasContext *dc, const OpcodeArg arg[],
                           const uint32_t par[])
 {
+    gen_helper_high_priority_irq_return(tcg_env);
     if (getenv("M5SW_XTENSA_IRQ_TRACE")
         || getenv("M5SW_XTENSA_IRQ_RING")) {
         gen_helper_exception_return_trace(
