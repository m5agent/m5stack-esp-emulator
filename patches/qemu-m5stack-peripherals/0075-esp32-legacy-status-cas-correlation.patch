+static uint32_t esp32_spi_rx_prefix(const Esp32SpiTransaction *t)
+{
+    const uint8_t *bytes = (const uint8_t *)t->data;
+    uint32_t prefix = 0;
+    uint32_t length;
+
+    if (!bytes || t->data_rx_bytes <= 0) {
+        return 0;
+    }
+    length = MIN(t->data_rx_bytes, sizeof(prefix));
+    for (uint32_t i = 0; i < length; i++) {
+        prefix |= (uint32_t)bytes[i] << (i * 8);
+    }
+    return prefix;
+}
+
+static void esp32_spi_current_context(uint32_t *cpu, uint32_t *pc,
+                                      uint32_t *ps, uint32_t *irq_request)
+{
+    *cpu = 3;
+    *pc = 0;
+    *ps = 0;
+    *irq_request = 0;
+    if (current_cpu) {
+        *cpu = current_cpu->cpu_index & 3;
+        *irq_request = current_cpu->interrupt_request;
+        if (current_cpu->cc && current_cpu->cc->get_pc) {
+            *pc = current_cpu->cc->get_pc(current_cpu);
+        }
+        *ps = xtensa_cpu_get_ps(current_cpu);
+    }
