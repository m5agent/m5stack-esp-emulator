From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m5agent <329351612+m5agent@users.noreply.github.com>
Date: Thu, 29 Oct 2026 12:30:00 +0800
Subject: [PATCH] esp32: correlate legacy status and contended CAS paths

Add default-off handoff diagnostics for RDSR status bytes, the preceding
0xBB/64 transaction, cache-counter deltas, and bounded s32c1i
PC/caller/lock/owner/holder-PC outcomes. The exact-time freeze emits
fixed-size aggregates without changing Flash data, interrupt levels,
watchdog semantics or default scheduling.

A separate M5SW_XTENSA_CONTENDED_CAS_YIELD environment gate allows a
failed conditional store to exit the current TCG slice. It remains off
by default and is retained only as a negative-control experiment.

---
diff --git a/include/hw/misc/esp32_handoff_trace.h b/include/hw/misc/esp32_handoff_trace.h
--- a/include/hw/misc/esp32_handoff_trace.h
+++ b/include/hw/misc/esp32_handoff_trace.h
@@ -21,6 +21,23 @@
 #define ESP32_HANDOFF_SSI_COMMAND_TIMING_SLOTS 1024u
 #define ESP32_HANDOFF_SSI_TRANSITION_SLOTS 1024u
 #define ESP32_HANDOFF_SSI_COMMAND_PC_SLOTS 2048u
+#define ESP32_HANDOFF_SSI_STATUS_CONTEXT_SLOTS 2048u
+#define ESP32_HANDOFF_SSI_CACHE_COUNTER_COUNT 5u
+#define ESP32_HANDOFF_S32C1I_PC_SLOTS 512u
+#define ESP32_HANDOFF_S32C1I_LOCK_SLOTS 128u
+#define ESP32_HANDOFF_S32C1I_OLD_SLOTS 64u
+#define ESP32_HANDOFF_S32C1I_CALLER_SLOTS 512u
+#define ESP32_HANDOFF_S32C1I_HOLDER_SLOTS 512u
+
+typedef struct Esp32HandoffCacheSnapshot {
+    uint64_t sync_calls;
+    uint64_t sync_pages;
+    uint64_t state_updates;
+    uint64_t invalidate_calls;
+    uint64_t illegal_reads;
+    uint64_t last_sync_ns;
+} Esp32HandoffCacheSnapshot;
+
 typedef struct Esp32HandoffMetrics {
     uint64_t ssi_transactions;
     uint64_t ssi_rx_bytes;
@@ -58,6 +75,89 @@
     uint64_t ssi_command_pc_keys[ESP32_HANDOFF_SSI_COMMAND_PC_SLOTS];
     uint64_t ssi_command_pc_counts[ESP32_HANDOFF_SSI_COMMAND_PC_SLOTS];
     uint64_t ssi_command_pc_overflow;
+    uint64_t ssi_previous_addr;
+    uint64_t ssi_previous_rx_bytes;
+    uint64_t ssi_previous_rx_prefix;
+    uint64_t ssi_previous_cpu;
+    uint64_t ssi_previous_pc;
+    uint64_t ssi_previous_ps;
+    uint64_t ssi_previous_irq_request;
+    uint64_t ssi_rdsr_count;
+    uint64_t ssi_rdsr_status_counts[256];
+    uint64_t ssi_rdsr_previous_command_lo_counts[256];
+    uint64_t ssi_rdsr_previous_command_hi;
+    uint64_t ssi_rdsr_previous_rx_length_counts[
+        ESP32_HANDOFF_SSI_RX_LENGTH_BUCKETS
+    ];
+    uint64_t ssi_rdsr_gap_ns_total;
+    uint64_t ssi_rdsr_gap_ns_max;
+    uint64_t ssi_rdsr_previous_fast_read_count;
+    uint64_t ssi_rdsr_previous_fast_read_addr_min;
+    uint64_t ssi_rdsr_previous_fast_read_addr_max;
+    uint64_t ssi_rdsr_previous_fast_read_byte0_counts[256];
+    uint64_t ssi_rdsr_previous_fast_read_byte1_counts[256];
+    uint64_t ssi_rdsr_ps_intlevel_counts[16];
+    uint64_t ssi_rdsr_irq_request_counts[16];
+    uint64_t ssi_rdsr_context_keys[ESP32_HANDOFF_SSI_STATUS_CONTEXT_SLOTS];
+    uint64_t ssi_rdsr_context_counts[ESP32_HANDOFF_SSI_STATUS_CONTEXT_SLOTS];
+    uint64_t ssi_rdsr_context_overflow;
+    uint64_t ssi_rdsr_cache_delta_total[
+        ESP32_HANDOFF_SSI_CACHE_COUNTER_COUNT
+    ];
+    uint64_t ssi_rdsr_cache_delta_max[
+        ESP32_HANDOFF_SSI_CACHE_COUNTER_COUNT
+    ];
+    uint64_t ssi_rdsr_cache_delta_nonzero[
+        ESP32_HANDOFF_SSI_CACHE_COUNTER_COUNT
+    ];
+    Esp32HandoffCacheSnapshot ssi_rdsr_previous_cache;
+    bool ssi_rdsr_have_previous_cache;
+    uint64_t ssi_last_rdsr_status;
+    uint64_t ssi_last_rdsr_previous_command;
+    uint64_t ssi_last_rdsr_previous_addr;
+    uint64_t ssi_last_rdsr_previous_prefix;
+    uint64_t ssi_last_rdsr_cpu;
+    uint64_t ssi_last_rdsr_pc;
+    uint64_t ssi_last_rdsr_ps;
+    uint64_t ssi_last_rdsr_irq_request;
+    uint64_t ssi_last_rdsr_gap_ns;
+    Esp32HandoffCacheSnapshot ssi_last_rdsr_cache;
+    uint64_t s32c1i_count;
+    uint64_t s32c1i_success_count;
+    uint64_t s32c1i_contended_count;
+    uint64_t s32c1i_pc_keys[ESP32_HANDOFF_S32C1I_PC_SLOTS];
+    uint64_t s32c1i_pc_counts[ESP32_HANDOFF_S32C1I_PC_SLOTS];
+    uint64_t s32c1i_pc_successes[ESP32_HANDOFF_S32C1I_PC_SLOTS];
+    uint64_t s32c1i_pc_overflow;
+    uint32_t s32c1i_lock_keys[ESP32_HANDOFF_S32C1I_LOCK_SLOTS];
+    uint64_t s32c1i_lock_counts[ESP32_HANDOFF_S32C1I_LOCK_SLOTS];
+    uint64_t s32c1i_lock_successes[ESP32_HANDOFF_S32C1I_LOCK_SLOTS];
+    uint64_t s32c1i_lock_last_old[ESP32_HANDOFF_S32C1I_LOCK_SLOTS];
+    uint64_t s32c1i_lock_last_desired[ESP32_HANDOFF_S32C1I_LOCK_SLOTS];
+    uint64_t s32c1i_lock_overflow;
+    uint64_t s32c1i_old_keys[ESP32_HANDOFF_S32C1I_OLD_SLOTS];
+    uint64_t s32c1i_old_counts[ESP32_HANDOFF_S32C1I_OLD_SLOTS];
+    uint64_t s32c1i_old_overflow;
+    uint32_t s32c1i_caller_pcs[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint32_t s32c1i_caller_a0s[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint32_t s32c1i_caller_addrs[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint8_t s32c1i_caller_flags[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint64_t s32c1i_caller_counts[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint64_t s32c1i_caller_successes[ESP32_HANDOFF_S32C1I_CALLER_SLOTS];
+    uint64_t s32c1i_caller_overflow;
+    uint32_t s32c1i_holder_site_pcs[ESP32_HANDOFF_S32C1I_HOLDER_SLOTS];
+    uint32_t s32c1i_holder_pcs[ESP32_HANDOFF_S32C1I_HOLDER_SLOTS];
+    uint32_t s32c1i_holder_addrs[ESP32_HANDOFF_S32C1I_HOLDER_SLOTS];
+    uint8_t s32c1i_holder_cpus[ESP32_HANDOFF_S32C1I_HOLDER_SLOTS];
+    uint64_t s32c1i_holder_counts[ESP32_HANDOFF_S32C1I_HOLDER_SLOTS];
+    uint64_t s32c1i_holder_overflow;
+    uint64_t s32c1i_last_pc;
+    uint64_t s32c1i_last_addr;
+    uint64_t s32c1i_last_old;
+    uint64_t s32c1i_last_desired;
+    uint64_t s32c1i_last_cpu;
+    uint64_t s32c1i_last_success;
+    uint64_t s32c1i_last_caller;
     uint64_t crosscore_writes;
     uint32_t crosscore_levels;
     uint64_t intmatrix_levels_lo;
@@ -67,6 +167,8 @@
 
 extern Esp32HandoffMetrics esp32_handoff_metrics;
 
+void esp32_handoff_cache_snapshot(Esp32HandoffCacheSnapshot *snapshot);
+
 static inline bool esp32_handoff_trace_enabled(void)
 {
     static int enabled = -1;
diff --git a/hw/misc/esp32_dport.c b/hw/misc/esp32_dport.c
--- a/hw/misc/esp32_dport.c
+++ b/hw/misc/esp32_dport.c
@@ -68,7 +68,15 @@
 static uint64_t handoff_last_cache_sync_ns;
 Esp32HandoffMetrics esp32_handoff_metrics;
 
-
+void esp32_handoff_cache_snapshot(Esp32HandoffCacheSnapshot *snapshot)
+{
+    snapshot->sync_calls = handoff_cache_sync_calls;
+    snapshot->sync_pages = handoff_cache_sync_pages;
+    snapshot->state_updates = handoff_cache_state_updates;
+    snapshot->invalidate_calls = handoff_cache_invalidate_calls;
+    snapshot->illegal_reads = handoff_cache_illegal_reads;
+    snapshot->last_sync_ns = handoff_last_cache_sync_ns;
+}
 
 static inline bool esp32_dport_trace_enabled(void)
 {
@@ -915,6 +923,325 @@
             now_ns, esp32_handoff_metrics.ssi_command_pc_overflow);
     fprintf(stderr,
             "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi event=freeze-rdsr-count"
+            " a=%" PRIu64 " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.ssi_rdsr_count);
+    for (uint32_t status = 0; status < 256; status++) {
+        uint64_t count =
+            esp32_handoff_metrics.ssi_rdsr_status_counts[status];
+
+        if (count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-status a=%u b=%" PRIu64
+                    " c=0 d=0\n",
+                    now_ns, status, count);
+        }
+    }
+    for (uint32_t command = 0; command < 256; command++) {
+        uint64_t count = esp32_handoff_metrics
+                             .ssi_rdsr_previous_command_lo_counts[command];
+
+        if (count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-previous-command a=%u"
+                    " b=%" PRIu64 " c=0 d=0\n",
+                    now_ns, command, count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-previous-command-hi a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns,
+            esp32_handoff_metrics.ssi_rdsr_previous_command_hi);
+    for (uint32_t bucket = 0;
+         bucket < ESP32_HANDOFF_SSI_RX_LENGTH_BUCKETS; bucket++) {
+        uint64_t count = esp32_handoff_metrics
+                             .ssi_rdsr_previous_rx_length_counts[bucket];
+
+        if (count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-previous-length a=%u"
+                    " b=%" PRIu64 " c=0 d=0\n",
+                    now_ns, bucket, count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi event=freeze-rdsr-gap"
+            " a=%" PRIu64 " b=%" PRIu64 " c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.ssi_rdsr_gap_ns_total,
+            esp32_handoff_metrics.ssi_rdsr_gap_ns_max);
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-fast-read a=%" PRIu64
+            " b=%" PRIu64 " c=%" PRIu64 " d=0\n",
+            now_ns,
+            esp32_handoff_metrics.ssi_rdsr_previous_fast_read_count,
+            esp32_handoff_metrics.ssi_rdsr_previous_fast_read_addr_min,
+            esp32_handoff_metrics.ssi_rdsr_previous_fast_read_addr_max);
+    for (uint32_t value = 0; value < 256; value++) {
+        uint64_t byte0 = esp32_handoff_metrics
+                             .ssi_rdsr_previous_fast_read_byte0_counts[value];
+        uint64_t byte1 = esp32_handoff_metrics
+                             .ssi_rdsr_previous_fast_read_byte1_counts[value];
+
+        if (byte0 || byte1) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-fast-read-byte a=%u"
+                    " b=%" PRIu64 " c=%" PRIu64 " d=0\n",
+                    now_ns, value, byte0, byte1);
+        }
+    }
+    for (uint32_t level = 0; level < 16; level++) {
+        uint64_t count = esp32_handoff_metrics
+                             .ssi_rdsr_ps_intlevel_counts[level];
+        uint64_t irq_count = esp32_handoff_metrics
+                                 .ssi_rdsr_irq_request_counts[level];
+
+        if (count || irq_count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-interrupt a=%u"
+                    " b=%" PRIu64 " c=%" PRIu64 " d=0\n",
+                    now_ns, level, count, irq_count);
+        }
+    }
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_SSI_STATUS_CONTEXT_SLOTS; slot++) {
+        uint64_t encoded =
+            esp32_handoff_metrics.ssi_rdsr_context_keys[slot];
+        uint64_t count =
+            esp32_handoff_metrics.ssi_rdsr_context_counts[slot];
+
+        if (encoded && count) {
+            uint64_t key = encoded - 1;
+            uint32_t status = key >> 42;
+            uint32_t cpu = (key >> 40) & 3;
+            uint32_t pc = key & 0xffffffffu;
+
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=ssi"
+                    " event=freeze-rdsr-context a=%u b=%u"
+                    " c=%08" PRIx32 " d=%" PRIu64 "\n",
+                    now_ns, status, cpu, pc, count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-context-overflow a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.ssi_rdsr_context_overflow);
+    for (uint32_t index = 0;
+         index < ESP32_HANDOFF_SSI_CACHE_COUNTER_COUNT; index++) {
+        fprintf(stderr,
+                "[esp32-handoff] now=%" PRId64
+                " cpu=-1 pc=00000000 component=ssi"
+                " event=freeze-rdsr-cache-delta a=%u b=%" PRIu64
+                " c=%" PRIu64 " d=%" PRIu64 "\n",
+                now_ns, index,
+                esp32_handoff_metrics
+                    .ssi_rdsr_cache_delta_nonzero[index],
+                esp32_handoff_metrics.ssi_rdsr_cache_delta_total[index],
+                esp32_handoff_metrics.ssi_rdsr_cache_delta_max[index]);
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi event=freeze-rdsr-last"
+            " a=%" PRIu64 " b=%" PRIu64 " c=%" PRIu64 " d=%" PRIu64 "\n",
+            now_ns, esp32_handoff_metrics.ssi_last_rdsr_status,
+            esp32_handoff_metrics.ssi_last_rdsr_previous_command,
+            esp32_handoff_metrics.ssi_last_rdsr_previous_addr,
+            esp32_handoff_metrics.ssi_last_rdsr_previous_prefix);
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-last-context"
+            " a=%" PRIu64 " b=%" PRIu64
+            " c=%" PRIu64 " d=%08" PRIx64 "\n",
+            now_ns, esp32_handoff_metrics.ssi_last_rdsr_cpu,
+            esp32_handoff_metrics.ssi_last_rdsr_ps,
+            esp32_handoff_metrics.ssi_last_rdsr_irq_request,
+            esp32_handoff_metrics.ssi_last_rdsr_pc);
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-last-cache"
+            " a=%" PRIu64 " b=%" PRIu64
+            " c=%" PRIu64 " d=%" PRIu64 "\n",
+            now_ns, esp32_handoff_metrics.ssi_last_rdsr_gap_ns,
+            esp32_handoff_metrics.ssi_last_rdsr_cache.sync_calls,
+            esp32_handoff_metrics.ssi_last_rdsr_cache.sync_pages,
+            esp32_handoff_metrics.ssi_last_rdsr_cache.last_sync_ns);
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=ssi"
+            " event=freeze-rdsr-last-cache1"
+            " a=%" PRIu64 " b=%" PRIu64
+            " c=%" PRIu64 " d=0\n",
+            now_ns, esp32_handoff_metrics.ssi_last_rdsr_cache.state_updates,
+            esp32_handoff_metrics.ssi_last_rdsr_cache.invalidate_calls,
+            esp32_handoff_metrics.ssi_last_rdsr_cache.illegal_reads);
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=s32c1i"
+            " event=freeze-total a=%" PRIu64 " b=%" PRIu64
+            " c=%" PRIu64 " d=0\n",
+            now_ns, esp32_handoff_metrics.s32c1i_count,
+            esp32_handoff_metrics.s32c1i_success_count,
+            esp32_handoff_metrics.s32c1i_contended_count);
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_S32C1I_PC_SLOTS; slot++) {
+        uint64_t encoded = esp32_handoff_metrics.s32c1i_pc_keys[slot];
+        uint64_t count = esp32_handoff_metrics.s32c1i_pc_counts[slot];
+
+        if (encoded && count) {
+            uint64_t key = encoded - 1;
+            uint32_t success = (key >> 33) & 1;
+            uint32_t cpu = (key >> 32) & 1;
+            uint32_t pc = key & 0xffffffffu;
+
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=s32c1i"
+                    " event=freeze-pc a=%u b=%u c=%08" PRIx32
+                    " d=%" PRIu64 "\n",
+                    now_ns, cpu, success, pc, count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=s32c1i"
+            " event=freeze-pc-overflow a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.s32c1i_pc_overflow);
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_S32C1I_LOCK_SLOTS; slot++) {
+        uint32_t encoded = esp32_handoff_metrics.s32c1i_lock_keys[slot];
+        uint64_t count = esp32_handoff_metrics.s32c1i_lock_counts[slot];
+
+        if (encoded && count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=s32c1i"
+                    " event=freeze-lock a=%08" PRIx32
+                    " b=%" PRIu64 " c=%" PRIu64
+                    " d=%08" PRIx64 "\n",
+                    now_ns, encoded - 1, count,
+                    esp32_handoff_metrics.s32c1i_lock_successes[slot],
+                    esp32_handoff_metrics.s32c1i_lock_last_old[slot]);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=s32c1i"
+            " event=freeze-lock-overflow a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.s32c1i_lock_overflow);
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_S32C1I_OLD_SLOTS; slot++) {
+        uint64_t encoded = esp32_handoff_metrics.s32c1i_old_keys[slot];
+        uint64_t count = esp32_handoff_metrics.s32c1i_old_counts[slot];
+
+        if (encoded && count) {
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=-1 pc=00000000 component=s32c1i"
+                    " event=freeze-old a=%08" PRIx64
+                    " b=%" PRIu64 " c=0 d=0\n",
+                    now_ns, encoded - 1, count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=s32c1i"
+            " event=freeze-old-overflow a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.s32c1i_old_overflow);
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_S32C1I_CALLER_SLOTS; slot++) {
+        uint64_t count = esp32_handoff_metrics.s32c1i_caller_counts[slot];
+
+        if (count) {
+            uint8_t flags =
+                esp32_handoff_metrics.s32c1i_caller_flags[slot];
+
+            fprintf(stderr,
+                    "[esp32-handoff] now=%" PRId64
+                    " cpu=%u pc=%08" PRIx32 " component=s32c1i"
+                    " event=freeze-caller a=%08" PRIx32
+                    " b=%u c=%08" PRIx32 " d=%" PRIu64 "\n",
+                    now_ns, flags & 1,
+                    esp32_handoff_metrics.s32c1i_caller_a0s[slot],
+                    esp32_handoff_metrics.s32c1i_caller_pcs[slot],
+                    (flags >> 1) & 1,
+                    esp32_handoff_metrics.s32c1i_caller_addrs[slot],
+                    count);
+        }
+    }
+    fprintf(stderr,
+            "[esp32-handoff] now=%" PRId64
+            " cpu=-1 pc=00000000 component=s32c1i"
+            " event=freeze-caller-overflow a=%" PRIu64
+            " b=0 c=0 d=0\n",
+            now_ns, esp32_handoff_metrics.s32c1i_caller_overflow);
+    for (uint32_t slot = 0;
+         slot < ESP32_HANDOFF_S32C1I_HOLDER_SLOTS; slot++) {
+        uint64_t count = esp32_handoff_metrics.s32c1i_holder_counts[slot];
+
+        if (count) {
+            fprintf(stderr,
