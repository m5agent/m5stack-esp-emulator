                            MEMTXATTRS_UNSPECIFIED, &item,
                            sizeof(item)) != MEMTX_OK ||
         !s3_wifi_descriptor_valid(&item)) {
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[esp32s3-wifi] RX descriptor read failed=%08x "
