+        }
         qemu_log_mask(LOG_GUEST_ERROR,
                       "esp32s3-wifi: invalid RX descriptor %08x\n",
                       descriptor);
@@ -145,6 +159,12 @@
     }
     total = sizeof(*rx) + frame->frame_length;
     if (total > item.size) {
+        if (s->espnow_peer_trace) {
