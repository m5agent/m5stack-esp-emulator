diff --git a/hw/misc/esp32_wifi.c b/hw/misc/esp32_wifi.c
--- a/hw/misc/esp32_wifi.c
+++ b/hw/misc/esp32_wifi.c
@@ -1,7 +1,10 @@
 #include "qemu/osdep.h"
 #include "qemu/log.h"
+#include "qemu/cutils.h"
 #include "qemu/error-report.h"
 #include "qemu/guest-random.h"
+#include "qemu/main-loop.h"
+#include "qemu/sockets.h"
 #include "qapi/error.h"
 #include "sysemu/sysemu.h"
 #include "hw/hw.h"
@@ -41,6 +44,207 @@
 static void set_interrupt(Esp32WifiState *s, int e) {
     s->raw_interrupt |= e;
     qemu_set_irq(s->irq, 1);
+}
+
+static uint32_t espnow_peer_checksum(const uint8_t *data, size_t length)
+{
+    uint32_t result = 2166136261u;
+    size_t index;
+
+    for (index = 0; index < length; index++) {
+        result ^= data[index];
+        result *= 16777619u;
+    }
+    return result;
+}
+
+static void espnow_peer_trace(Esp32WifiState *s, const char *direction,
+                              const struct mac80211_frame *frame,
+                              size_t length)
+{
+    if (!s->espnow_peer_trace) {
+        return;
+    }
+    fprintf(stderr,
+            "[espnow-peer] %s local=%d remote=%d len=%zu checksum=%08x "
+            "dst=%02x:%02x:%02x:%02x:%02x:%02x "
+            "src=%02x:%02x:%02x:%02x:%02x:%02x "
+            "filter0=%02x:%02x:%02x:%02x:%02x:%02x "
+            "filter1=%02x:%02x:%02x:%02x:%02x:%02x\n",
+            direction, s->espnow_peer_local_port,
+            s->espnow_peer_remote_port, length,
+            espnow_peer_checksum((const uint8_t *)frame, length),
+            frame->receiver_address[0], frame->receiver_address[1],
+            frame->receiver_address[2], frame->receiver_address[3],
+            frame->receiver_address[4], frame->receiver_address[5],
+            frame->transmitter_address[0], frame->transmitter_address[1],
+            frame->transmitter_address[2], frame->transmitter_address[3],
+            frame->transmitter_address[4], frame->transmitter_address[5],
+            ((const uint8_t *)s->mem)[0x40],
+            ((const uint8_t *)s->mem)[0x41],
+            ((const uint8_t *)s->mem)[0x42],
+            ((const uint8_t *)s->mem)[0x43],
+            ((const uint8_t *)s->mem)[0x44],
+            ((const uint8_t *)s->mem)[0x45],
+            ((const uint8_t *)s->mem)[0x46],
+            ((const uint8_t *)s->mem)[0x47],
+            ((const uint8_t *)s->mem)[0x48],
+            ((const uint8_t *)s->mem)[0x49],
+            ((const uint8_t *)s->mem)[0x4a],
+            ((const uint8_t *)s->mem)[0x4b]);
+}
+
+static bool espnow_peer_action_frame(const struct mac80211_frame *frame,
+                                     size_t length)
+{
+    return length >= IEEE80211_HEADER_SIZE &&
+           length <= sizeof(*frame) &&
+           frame->frame_control.type == IEEE80211_TYPE_MGT &&
+           frame->frame_control.sub_type ==
+               IEEE80211_TYPE_MGT_SUBTYPE_ACTION;
+}
+
+static void espnow_peer_read(void *opaque)
+{
+    Esp32WifiState *s = opaque;
+    static const uint8_t zero_mac[6] = { 0 };
+
+    while (s->espnow_peer_fd >= 0) {
+        struct mac80211_frame frame;
+        const uint8_t *local_mac = s->macaddr;
+        ssize_t length = recv(s->espnow_peer_fd, &frame, sizeof(frame), 0);
+
+        if (length < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            return;
+        }
+        if (length < 0) {
+            if (s->espnow_peer_trace) {
+                fprintf(stderr, "[espnow-peer] receive failed: %s\n",
+                        strerror(errno));
+            }
+            return;
+        }
+        if (!espnow_peer_action_frame(&frame, (size_t)length)) {
+            continue;
+        }
+        frame.frame_length = length;
+        frame.next_frame = NULL;
+        if (!s->is_s3) {
+            const uint8_t *filter0 = (const uint8_t *)s->mem + 0x40;
+
+            if (!memcmp(filter0, zero_mac, sizeof(zero_mac))) {
+                local_mac = zero_mac;
+            }
+        }
+        if (!memcmp(frame.receiver_address, BROADCAST, 6) ||
+            !memcmp(frame.receiver_address,
+                    (uint8_t[]){0x02, 0, 0, 0, 0, 0x43}, 6)) {
+            memcpy(frame.receiver_address, local_mac, 6);
+            memcpy(frame.transmitter_address,
+                   (uint8_t[]){0x02, 0, 0, 0, 0, 0x43}, 6);
+        }
+        memcpy(frame.address_3, frame.transmitter_address, 6);
+        espnow_peer_trace(s, "RX", &frame, length);
+        Esp32_sendFrame(s, &frame, length, -42);
+    }
+}
+
+void Esp32_ESPNow_peer_realize(Esp32WifiState *s, Error **errp)
+{
+    const char *local_value = getenv("M5SW_ESPNOW_PEER_LOCAL_PORT");
+    const char *remote_value = getenv("M5SW_ESPNOW_PEER_REMOTE_PORT");
+    struct sockaddr_in local = {
+        .sin_family = AF_INET,
+        .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+    };
+    struct sockaddr_in remote = {
+        .sin_family = AF_INET,
+        .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
+    };
+    uint64_t local_port;
+    uint64_t remote_port;
+    int fd;
+
+    s->espnow_peer_fd = -1;
+    s->espnow_peer_local_port = 0;
+    s->espnow_peer_remote_port = 0;
+    s->espnow_peer_trace =
+        getenv("M5SW_ESPNOW_PEER_TRACE") != NULL;
+
+    if (!local_value && !remote_value) {
+        return;
+    }
+    if (!local_value || !remote_value) {
+        error_setg(errp,
+                   "M5SW_ESPNOW_PEER_LOCAL_PORT and "
+                   "M5SW_ESPNOW_PEER_REMOTE_PORT must be set together");
+        return;
+    }
+    if (getenv("M5SW_ESPNOW_LOOPBACK")) {
+        error_setg(errp,
+                   "M5SW_ESPNOW_LOOPBACK cannot be combined with the "
+                   "external ESP-NOW peer bridge");
+        return;
+    }
+    if (parse_uint_full(local_value, 10, &local_port) ||
+        local_port < 1024 || local_port > 65535 ||
+        parse_uint_full(remote_value, 10, &remote_port) ||
+        remote_port < 1024 || remote_port > 65535 ||
+        local_port == remote_port) {
+        error_setg(errp, "ESP-NOW peer ports must be distinct integers "
+                   "between 1024 and 65535");
+        return;
+    }
+
+    fd = socket(AF_INET, SOCK_DGRAM, 0);
+    if (fd < 0) {
+        error_setg_errno(errp, errno, "cannot create ESP-NOW peer socket");
+        return;
+    }
+    local.sin_port = htons((uint16_t)local_port);
+    remote.sin_port = htons((uint16_t)remote_port);
+    if (bind(fd, (struct sockaddr *)&local, sizeof(local)) < 0 ||
+        connect(fd, (struct sockaddr *)&remote, sizeof(remote)) < 0) {
+        error_setg_errno(errp, errno, "cannot bind ESP-NOW peer socket");
+        close(fd);
+        return;
+    }
+    qemu_socket_set_nonblock(fd);
+    s->espnow_peer_fd = fd;
+    s->espnow_peer_local_port = (int)local_port;
+    s->espnow_peer_remote_port = (int)remote_port;
+    qemu_set_fd_handler(fd, espnow_peer_read, NULL, s);
+}
+
+void Esp32_ESPNow_peer_cleanup(Esp32WifiState *s)
+{
+    if (s->espnow_peer_fd < 0) {
+        return;
+    }
+    qemu_set_fd_handler(s->espnow_peer_fd, NULL, NULL, NULL);
+    close(s->espnow_peer_fd);
+    s->espnow_peer_fd = -1;
+}
+
+void Esp32_ESPNow_peer_send(Esp32WifiState *s,
+                            struct mac80211_frame *frame)
+{
+    struct mac80211_frame forwarded;
+    ssize_t sent;
+
+    if (s->espnow_peer_fd < 0 ||
+        !espnow_peer_action_frame(frame, frame->frame_length)) {
+        return;
+    }
+    memcpy(&forwarded, frame, sizeof(forwarded));
+    memcpy(forwarded.transmitter_address, s->macaddr,
+           sizeof(forwarded.transmitter_address));
+    memcpy(forwarded.address_3, s->macaddr, sizeof(forwarded.address_3));
+    espnow_peer_trace(s, "TX", &forwarded, forwarded.frame_length);
+    sent = send(s->espnow_peer_fd, &forwarded, forwarded.frame_length, 0);
+    if (sent < 0 && s->espnow_peer_trace) {
+        fprintf(stderr, "[espnow-peer] send failed: %s\n", strerror(errno));
+    }
 }
 
 static void esp32_wifi_loopback_espnow(Esp32WifiState *s,
@@ -101,6 +305,7 @@
                 frame.next_frame=0;
                 Esp32_WLAN_handle_frame(s, &frame);
                 esp32_wifi_loopback_espnow(s, &frame);
+                Esp32_ESPNow_peer_send(s, &frame);
                 set_interrupt(s, 0x80);
             }
     }
@@ -145,6 +350,17 @@
         pkt->bssidmatch0=1;
     if(match_mac_address(frame->address_3,(uint8_t *)s->mem+0x48))
         pkt->bssidmatch1=1;
+    if(match_mac_address(frame->receiver_address,s->macaddr))
+        pkt->damatch0=1;
+    if(match_mac_address(frame->address_3,s->macaddr))
+        pkt->bssidmatch0=1;
+    if(s->espnow_peer_fd >= 0 &&
+       espnow_peer_action_frame(frame,length)) {
+        pkt->damatch0=1;
+        pkt->damatch1=1;
+        pkt->bssidmatch0=1;
+        pkt->bssidmatch1=1;
+    }
     //printf("...%x %x\n",header[3],frame->receiver_address[0]);
 
     memcpy(header+28, frame, length);
@@ -178,7 +394,13 @@
     sysbus_init_irq(sbd, &s->irq);
     memset(s->mem,0,sizeof(s->mem));
     Esp32_WLAN_setup_ap(dev, s);
-
+    Esp32_ESPNow_peer_realize(s, errp);
+
+}
+
+static void esp32_wifi_unrealize(DeviceState *dev)
+{
+    Esp32_ESPNow_peer_cleanup(ESP32_WIFI(dev));
 }
 static Property esp32_wifi_properties[] = {
     DEFINE_NIC_PROPERTIES(Esp32WifiState, conf),
@@ -206,6 +428,7 @@
     ObjectClass *oc = OBJECT_CLASS(klass);
 
     dc->realize = esp32_wifi_realize;
+    dc->unrealize = esp32_wifi_unrealize;
     set_bit(DEVICE_CATEGORY_NETWORK, dc->categories);
     dc->desc = "Esp32 WiFi";
     device_class_set_props(dc, esp32_wifi_properties);
diff --git a/hw/misc/esp32s3_wifi.c b/hw/misc/esp32s3_wifi.c
--- a/hw/misc/esp32s3_wifi.c
+++ b/hw/misc/esp32s3_wifi.c
@@ -128,16 +128,30 @@
     size_t total;
 
     if (!Esp32_WLAN_prepare_s3_rx(s, frame)) {
+        if (s->espnow_peer_trace) {
+            fprintf(stderr, "[esp32s3-wifi] RX prepare rejected\n");
+        }
         return;
     }
     if (!descriptor || !frame->frame_length ||
         frame->frame_length > 2316) {
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[esp32s3-wifi] RX invalid descriptor=%08x frame_length=%u\n",
