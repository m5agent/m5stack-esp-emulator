+static bool espnow_peer_parse_hex_key(const char *value, uint8_t key[16])
+{
+    size_t index;
+
+    if (!value || strlen(value) != 32) {
+        return false;
+    }
+    for (index = 0; index < 16; index++) {
+        unsigned int high;
+        unsigned int low;
+
+        if (sscanf(value + index * 2, "%1x%1x", &high, &low) != 2) {
+            return false;
+        }
+        key[index] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool espnow_peer_aes_ecb(const uint8_t key[16], bool encrypt,
+                                const uint8_t input[16], uint8_t output[16])
+{
+    g_autoptr(QCryptoCipher) cipher = NULL;
+    Error *error = NULL;
+    int result;
+
+    cipher = qcrypto_cipher_new(
+        QCRYPTO_CIPHER_ALGO_AES_128,
+        QCRYPTO_CIPHER_MODE_ECB,
+        key,
+        16,
+        &error
+    );
+    if (!cipher) {
+        error_report_err(error);
+        return false;
+    }
+    result = encrypt
+        ? qcrypto_cipher_encrypt(cipher, input, output, 16, &error)
+        : qcrypto_cipher_decrypt(cipher, input, output, 16, &error);
+    if (result < 0) {
+        error_report_err(error);
+        return false;
+    }
+    return true;
+}
+
+static bool espnow_peer_unwrap_lmk(Esp32WifiState *s, uint8_t lmk[16])
+{
+    return s->espnow_peer_encrypted &&
+           espnow_peer_aes_ecb(
+               s->espnow_peer_pmk, false,
+               s->espnow_peer_wrapped_lmk, lmk);
+}
+
+static bool espnow_peer_encrypt_guest_frame(Esp32WifiState *s,
+                                            struct mac80211_frame *frame)
+{
+    uint8_t key[16];
+    size_t length = frame->frame_length;
+    size_t plain_length;
+    bool success;
+
+    if (!s->espnow_peer_encrypted ||
+        !(frame->frame_control._flags & BIT(4)) ||
+        length < IEEE80211_HEADER_SIZE + 8 + 8 + 1) {
+        return false;
+    }
+    plain_length = length - IEEE80211_HEADER_SIZE - 8 - 8;
+    memmove(frame->data_and_fcs, frame->data_and_fcs + 8, plain_length);
+    frame->frame_length = IEEE80211_HEADER_SIZE + plain_length;
+    frame->frame_control._flags &= ~BIT(4);
+    if (!espnow_peer_unwrap_lmk(s, key)) {
+        return false;
+    }
+    success = Esp32_WLAN_ccmp_encrypt_payload(
+        key, frame, ++s->espnow_peer_tx_pn
+    );
+    memset(key, 0, sizeof(key));
+    return success;
+}
+
+static bool espnow_peer_ccmp_pn(const struct mac80211_frame *frame,
+                                size_t length, uint64_t *pn)
+{
+    const uint8_t *ccmp = frame->data_and_fcs;
+
+    if (!(frame->frame_control._flags & BIT(4)) ||
+        length < IEEE80211_HEADER_SIZE + 8 + 8 + 1) {
+        return false;
+    }
+    *pn = (uint64_t)ccmp[0] |
+          ((uint64_t)ccmp[1] << 8) |
+          ((uint64_t)ccmp[4] << 16) |
+          ((uint64_t)ccmp[5] << 24) |
+          ((uint64_t)ccmp[6] << 32) |
+          ((uint64_t)ccmp[7] << 40);
+    return true;
+}
+
+static bool espnow_peer_wrap_rx_envelope(struct mac80211_frame *frame,
+                                         uint64_t pn)
+{
+    uint8_t *hw = frame->data_and_fcs;
+    size_t plain_length;
+
+    if (frame->frame_length < IEEE80211_HEADER_SIZE + 1 ||
+        frame->frame_length + 16 > sizeof(*frame)) {
+        return false;
+    }
+    plain_length = frame->frame_length - IEEE80211_HEADER_SIZE;
+    memmove(hw + 8, hw, plain_length);
+    hw[0] = pn;
+    hw[1] = pn >> 8;
+    hw[2] = 0;
+    hw[3] = 0xe0;
+    hw[4] = pn >> 16;
+    hw[5] = pn >> 24;
+    hw[6] = pn >> 32;
+    hw[7] = pn >> 40;
+    memset(hw + 8 + plain_length, 0, 8);
+    frame->frame_control._flags |= BIT(4);
+    frame->frame_length = IEEE80211_HEADER_SIZE + 8 + plain_length + 8;
+    return true;
+}
