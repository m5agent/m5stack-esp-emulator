+bool Esp32_WLAN_ccmp_encrypt_payload(const uint8_t key[16],
+                                     struct mac80211_frame *frame,
+                                     uint64_t pn)
+{
+    const uint8_t *header = (const uint8_t *)frame;
+    uint8_t plain[2316];
+    uint8_t aad[22];
+    uint8_t nonce[13];
+    uint8_t *ccmp = frame->data_and_fcs;
+    size_t plain_len;
+
+    if (frame->frame_length < IEEE80211_HEADER_SIZE + 1) {
+        return false;
+    }
+    plain_len = frame->frame_length - IEEE80211_HEADER_SIZE;
+    if (plain_len > sizeof(plain) ||
+        IEEE80211_HEADER_SIZE + 8 + plain_len + 8 > sizeof(*frame)) {
+        return false;
+    }
+
+    memcpy(plain, frame->data_and_fcs, plain_len);
+    ccmp[0] = pn;
+    ccmp[1] = pn >> 8;
+    ccmp[2] = 0;
+    ccmp[3] = 0x20;
+    ccmp[4] = pn >> 16;
+    ccmp[5] = pn >> 24;
+    ccmp[6] = pn >> 32;
+    ccmp[7] = pn >> 40;
+    frame->frame_control._flags |= BIT(4);
+    ccmp_header_aad_nonce(header, ccmp, aad, nonce);
+
+    if (!aes_ccm_encrypt(
+            key, nonce, plain, plain_len, aad, sizeof(aad),
+            ccmp + 8, ccmp + 8 + plain_len)) {
+        return false;
+    }
+    frame->frame_length = IEEE80211_HEADER_SIZE + 8 + plain_len + 8;
+    return true;
+}
+
+bool Esp32_WLAN_ccmp_decrypt_payload(const uint8_t key[16],
+                                     struct mac80211_frame *frame,
+                                     size_t *length)
+{
+    const uint8_t *header = (const uint8_t *)frame;
+    const uint8_t *ccmp = frame->data_and_fcs;
+    uint8_t aad[22];
+    uint8_t nonce[13];
+    uint8_t plain[2316];
+    size_t encrypted_len;
+    size_t plain_len;
+
+    if (!(frame->frame_control._flags & BIT(4)) ||
+        *length < IEEE80211_HEADER_SIZE + 8 + 8 + 1 ||
+        *length > sizeof(*frame)) {
+        return false;
+    }
+    if (ccmp[3] & 0x40) {
+        return false;
+    }
+    encrypted_len = *length - IEEE80211_HEADER_SIZE;
+    plain_len = encrypted_len - 8 - 8;
+    if (plain_len > sizeof(plain)) {
+        return false;
+    }
+    ccmp_header_aad_nonce(header, ccmp, aad, nonce);
+    if (!aes_ccm_decrypt(
+            key, nonce, ccmp + 8, plain_len, aad, sizeof(aad),
+            ccmp + 8 + plain_len, plain)) {
+        return false;
+    }
+
+    memcpy(frame->data_and_fcs, plain, plain_len);
+    frame->frame_control._flags &= ~BIT(4);
+    frame->frame_length = IEEE80211_HEADER_SIZE + plain_len;
+    *length = frame->frame_length;
+    return true;
+}
