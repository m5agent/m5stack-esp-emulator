--- a/hw/misc/esp32_wifi.c
+++ b/hw/misc/esp32_wifi.c
@@ -106,12 +106,243 @@
     return true;
 }
 
+static uint16_t espnow_key_byte_bit(unsigned int byte)
+{
+    return (uint16_t)(1u << byte);
+}
+
+static void espnow_peer_clear_guest_key(Esp32WifiState *s)
+{
+    bool was_valid = s->espnow_peer_guest_key_valid;
+
+    s->espnow_peer_guest_key_valid = false;
+    s->espnow_peer_guest_key_slot = 0;
+    memset(s->espnow_peer_guest_lmk, 0,
+           sizeof(s->espnow_peer_guest_lmk));
+    if (s->espnow_peer_use_guest_key) {
+        s->espnow_peer_encrypted = false;
+    }
+    if (was_valid) {
+        s->espnow_peer_tx_pn = 0;
+        s->espnow_peer_rx_pn_valid = false;
+        s->espnow_peer_last_rx_pn = 0;
+        s->espnow_peer_rx_pn_bitmap = 0;
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] guest-key state=cleared\n");
+        }
+    }
+}
+
+static void espnow_peer_set_guest_key(Esp32WifiState *s,
+                                      unsigned int slot,
+                                      const uint8_t key[16])
+{
+    bool changed;
+
+    if (!s->espnow_peer_use_guest_key ||
+        slot >= ESP32_WIFI_CRYPTO_KEY_SLOTS) {
+        return;
+    }
+    changed = !s->espnow_peer_guest_key_valid ||
+              s->espnow_peer_guest_key_slot != slot ||
+              memcmp(s->espnow_peer_guest_lmk, key, 16);
+    if (changed) {
+        memset(s->espnow_peer_guest_lmk, 0,
+               sizeof(s->espnow_peer_guest_lmk));
+        memcpy(s->espnow_peer_guest_lmk, key, 16);
+        s->espnow_peer_guest_key_slot = slot;
+        s->espnow_peer_guest_key_valid = true;
+        s->espnow_peer_encrypted = true;
+        s->espnow_peer_tx_pn = 0;
+        s->espnow_peer_rx_pn_valid = false;
+        s->espnow_peer_last_rx_pn = 0;
+        s->espnow_peer_rx_pn_bitmap = 0;
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] guest-key state=ready slot=%u\n",
+                    slot);
+        }
+    }
+}
+
+static void espnow_crypto_refresh_guest_key(Esp32WifiState *s)
+{
+    uint32_t valid = s->espnow_crypto_control[0x14 / 4];
+    int slot;
+
+    if (!s->espnow_peer_use_guest_key) {
+        return;
+    }
+    if (s->espnow_peer_guest_key_valid &&
+        !(valid & (1u << s->espnow_peer_guest_key_slot))) {
+        espnow_peer_clear_guest_key(s);
+    }
+    for (slot = ESP32_WIFI_CRYPTO_KEY_SLOTS - 1; slot >= 4; slot--) {
+        if ((valid & (1u << slot)) &&
+            s->espnow_crypto_key_written[slot] == 0xffff) {
+            espnow_peer_set_guest_key(
+                s, slot, s->espnow_crypto_key_bytes[slot]);
+            return;
+        }
+    }
+}
+
+static uint64_t espnow_crypto_control_read(void *opaque, hwaddr addr,
+                                           unsigned int size)
+{
+    Esp32WifiState *s = opaque;
+
+    if (size != 4 || (addr & 3) || addr >= ESP32_WIFI_CRYPTO_CONTROL_SIZE) {
+        return 0;
+    }
+    return s->espnow_crypto_control[addr / 4];
+}
+
+static void espnow_crypto_control_write(void *opaque, hwaddr addr,
+                                        uint64_t value, unsigned int size)
+{
+    Esp32WifiState *s = opaque;
+
+    if (size != 4 || (addr & 3) || addr >= ESP32_WIFI_CRYPTO_CONTROL_SIZE) {
+        return;
+    }
+    s->espnow_crypto_control[addr / 4] = value;
+    if (addr == 0x14) {
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] guest-key control=mask value=%08x\n",
+                    (uint32_t)value);
+        }
+        espnow_crypto_refresh_guest_key(s);
+    }
+}
+
+static uint64_t espnow_crypto_key_read(void *opaque, hwaddr addr,
+                                       unsigned int size)
+{
+    Esp32WifiState *s = opaque;
+    unsigned int index;
+    uint32_t value = 0;
+
+    if ((addr >= ESP32_WIFI_CRYPTO_KEY_SIZE) ||
+        addr + size > ESP32_WIFI_CRYPTO_KEY_SIZE) {
+        return 0;
+    }
+    for (index = 0; index < size; index++) {
+        hwaddr offset = addr + index;
+        unsigned int slot = offset / ESP32_WIFI_CRYPTO_KEY_STRIDE;
+        unsigned int slot_offset = offset % ESP32_WIFI_CRYPTO_KEY_STRIDE;
+
+        if (slot < ESP32_WIFI_CRYPTO_KEY_SLOTS &&
+            slot_offset >= ESP32_WIFI_CRYPTO_KEY_OFFSET &&
+            slot_offset < ESP32_WIFI_CRYPTO_KEY_OFFSET +
+                          ESP32_WIFI_CRYPTO_KEY_LENGTH) {
+            value |=
+                (uint32_t)s->espnow_crypto_key_bytes[
+                    slot][slot_offset - ESP32_WIFI_CRYPTO_KEY_OFFSET]
+                << (index * 8);
+        }
+    }
+    return value;
+}
+
+static void espnow_crypto_key_write(void *opaque, hwaddr addr,
+                                    uint64_t value, unsigned int size)
+{
+    Esp32WifiState *s = opaque;
+    unsigned int index;
+
+    if ((addr >= ESP32_WIFI_CRYPTO_KEY_SIZE) ||
+        addr + size > ESP32_WIFI_CRYPTO_KEY_SIZE) {
+        return;
+    }
+    for (index = 0; index < size; index++) {
+        hwaddr offset = addr + index;
+        unsigned int slot = offset / ESP32_WIFI_CRYPTO_KEY_STRIDE;
+        unsigned int slot_offset = offset % ESP32_WIFI_CRYPTO_KEY_STRIDE;
+
+        if (slot >= ESP32_WIFI_CRYPTO_KEY_SLOTS ||
+            slot_offset < ESP32_WIFI_CRYPTO_KEY_OFFSET ||
+            slot_offset >= ESP32_WIFI_CRYPTO_KEY_OFFSET +
+                           ESP32_WIFI_CRYPTO_KEY_LENGTH) {
+            continue;
+        }
+        if (slot_offset == ESP32_WIFI_CRYPTO_KEY_OFFSET) {
+            s->espnow_crypto_key_written[slot] = 0;
+            if (s->espnow_peer_trace) {
+                fprintf(stderr,
+                        "[espnow-peer] guest-key state=write slot=%u\n",
+                        slot);
+            }
+        }
+        s->espnow_crypto_key_bytes[
+            slot][slot_offset - ESP32_WIFI_CRYPTO_KEY_OFFSET] =
+            (value >> (index * 8)) & 0xff;
+        s->espnow_crypto_key_written[slot] |=
+            espnow_key_byte_bit(
+                slot_offset - ESP32_WIFI_CRYPTO_KEY_OFFSET);
+        if (s->espnow_crypto_key_written[slot] == 0xffff &&
+            s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] guest-key state=bytes-ready slot=%u "
+                    "mask=%08x\n",
+                    slot, s->espnow_crypto_control[0x14 / 4]);
+        }
+    }
+    espnow_crypto_refresh_guest_key(s);
+}
+
+static const MemoryRegionOps espnow_crypto_control_ops = {
+    .read = espnow_crypto_control_read,
+    .write = espnow_crypto_control_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static const MemoryRegionOps espnow_crypto_key_ops = {
+    .read = espnow_crypto_key_read,
+    .write = espnow_crypto_key_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+void Esp32_WLAN_crypto_realize(Esp32WifiState *s, SysBusDevice *sbd)
+{
+    memset(s->espnow_crypto_control, 0,
+           sizeof(s->espnow_crypto_control));
+    memset(s->espnow_crypto_key_bytes, 0,
+           sizeof(s->espnow_crypto_key_bytes));
+    memset(s->espnow_crypto_key_written, 0,
+           sizeof(s->espnow_crypto_key_written));
+    memory_region_init_io(
+        &s->espnow_crypto_control_iomem, OBJECT(s),
+        &espnow_crypto_control_ops, s,
+        "esp32.wifi.crypto-control", ESP32_WIFI_CRYPTO_CONTROL_SIZE);
+    memory_region_init_io(
+        &s->espnow_crypto_key_iomem, OBJECT(s),
+        &espnow_crypto_key_ops, s,
+        "esp32.wifi.crypto-keys", ESP32_WIFI_CRYPTO_KEY_SIZE);
+    sysbus_init_mmio(sbd, &s->espnow_crypto_control_iomem);
+    sysbus_init_mmio(sbd, &s->espnow_crypto_key_iomem);
+}
+
 static bool espnow_peer_unwrap_lmk(Esp32WifiState *s, uint8_t lmk[16])
 {
-    return s->espnow_peer_encrypted &&
-           espnow_peer_aes_ecb(
-               s->espnow_peer_pmk, false,
-               s->espnow_peer_wrapped_lmk, lmk);
+    if (!s->espnow_peer_encrypted) {
+        return false;
+    }
+    if (s->espnow_peer_use_guest_key) {
+        if (!s->espnow_peer_guest_key_valid) {
+            return false;
+        }
+        memcpy(lmk, s->espnow_peer_guest_lmk, 16);
+        return true;
+    }
+    return espnow_peer_aes_ecb(
+        s->espnow_peer_pmk, false, s->espnow_peer_wrapped_lmk, lmk);
 }
 
