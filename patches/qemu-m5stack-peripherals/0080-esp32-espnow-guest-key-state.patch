From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Thu, 29 Oct 2026 00:00:00 +0800
Subject: [PATCH] hw/esp32: consume guest ESP-NOW controller keys

Mirror the ESP32 and ESP32-S3 WiFi crypto key store at the controller
MMIO boundary. When the external ESP-NOW bridge has no runtime-env key
fixture, select the highest active extended key slot after all 16 bytes
of guest-programmed LMK material have reached the controller. Key-slot
clear and replacement reset the active key and replay state. The bridge
still performs real CCMP/MIC before DMA delivery.

Signed-off-by: m5agent <m5agent@m5stack.com>
---
--- a/include/hw/misc/esp32_wifi.h
+++ b/include/hw/misc/esp32_wifi.h
@@ -10,6 +10,17 @@
 #define TYPE_ESP32_WIFI "misc.esp32_wifi"
 #define ESP32_WIFI(obj) OBJECT_CHECK(Esp32WifiState, (obj), TYPE_ESP32_WIFI)
 
+#define ESP32_WIFI_CRYPTO_CONTROL_BASE  0x3ff73800
+#define ESP32_WIFI_CRYPTO_KEY_BASE      0x3ff74400
+#define ESP32S3_WIFI_CRYPTO_CONTROL_BASE 0x60033800
+#define ESP32S3_WIFI_CRYPTO_KEY_BASE    0x60034400
+#define ESP32_WIFI_CRYPTO_CONTROL_SIZE  0x20
+#define ESP32_WIFI_CRYPTO_KEY_SIZE      0x3e8
+#define ESP32_WIFI_CRYPTO_KEY_SLOTS     25
+#define ESP32_WIFI_CRYPTO_KEY_STRIDE    40
+#define ESP32_WIFI_CRYPTO_KEY_OFFSET    8
+#define ESP32_WIFI_CRYPTO_KEY_LENGTH    16
+
 typedef struct dma_list_item {
     unsigned size:12;
     unsigned length:12;
@@ -42,6 +53,16 @@
     bool espnow_peer_encrypted;
     uint8_t espnow_peer_pmk[16];
     uint8_t espnow_peer_wrapped_lmk[16];
+    MemoryRegion espnow_crypto_control_iomem;
+    MemoryRegion espnow_crypto_key_iomem;
+    uint32_t espnow_crypto_control[ESP32_WIFI_CRYPTO_CONTROL_SIZE / 4];
+    uint8_t espnow_crypto_key_bytes[
+        ESP32_WIFI_CRYPTO_KEY_SLOTS][ESP32_WIFI_CRYPTO_KEY_LENGTH];
+    uint16_t espnow_crypto_key_written[ESP32_WIFI_CRYPTO_KEY_SLOTS];
+    bool espnow_peer_use_guest_key;
+    bool espnow_peer_guest_key_valid;
+    uint8_t espnow_peer_guest_key_slot;
+    uint8_t espnow_peer_guest_lmk[16];
     uint64_t espnow_peer_tx_pn;
     bool espnow_peer_rx_pn_valid;
     uint64_t espnow_peer_last_rx_pn;
@@ -100,6 +121,7 @@
 void Esp32_ESPNow_peer_realize(Esp32WifiState *s, Error **errp);
 void Esp32_ESPNow_peer_cleanup(Esp32WifiState *s);
 void Esp32_ESPNow_peer_send(Esp32WifiState *s, struct mac80211_frame *frame);
+void Esp32_WLAN_crypto_realize(Esp32WifiState *s, SysBusDevice *sbd);
 bool Esp32_WLAN_ccmp_encrypt_payload(const uint8_t key[16],
                                      struct mac80211_frame *frame,
