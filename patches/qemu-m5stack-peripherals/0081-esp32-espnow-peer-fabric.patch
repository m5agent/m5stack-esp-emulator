-static bool espnow_peer_accept_rx_pn(Esp32WifiState *s, uint64_t pn)
+static Esp32EspNowPeerReplayState *espnow_peer_replay_state(
+    Esp32WifiState *s, const uint8_t peer[6])
+{
+    Esp32EspNowPeerReplayState *free_state = NULL;
+    unsigned int index;
+
+    for (index = 0; index < ESPNOW_PEER_REPLAY_SLOTS; index++) {
+        Esp32EspNowPeerReplayState *state = &s->espnow_peer_replay[index];
+
+        if (state->valid && !memcmp(state->peer, peer, 6)) {
+            return state;
+        }
+        if (!state->valid && !free_state) {
+            free_state = state;
+        }
+    }
+    if (free_state) {
+        free_state->valid = true;
+        memcpy(free_state->peer, peer, 6);
+    }
+    return free_state;
+}
+
+static bool espnow_peer_accept_rx_pn(Esp32WifiState *s,
+                                     const uint8_t peer[6], uint64_t pn)
 {
+    Esp32EspNowPeerReplayState *state =
+        espnow_peer_replay_state(s, peer);
     uint64_t bit;
     uint64_t delta;
 
-    if (!s->espnow_peer_rx_pn_valid) {
-        s->espnow_peer_rx_pn_valid = true;
-        s->espnow_peer_last_rx_pn = pn;
-        s->espnow_peer_rx_pn_bitmap = 1;
+    if (!state) {
+        return false;
+    }
+    if (!state->rx_pn_valid) {
+        state->rx_pn_valid = true;
+        state->last_rx_pn = pn;
+        state->rx_pn_bitmap = 1;
         return true;
     }
-    if (pn > s->espnow_peer_last_rx_pn) {
-        delta = pn - s->espnow_peer_last_rx_pn;
-        s->espnow_peer_rx_pn_bitmap =
-            delta >= 64 ? 0 : s->espnow_peer_rx_pn_bitmap << delta;
-        s->espnow_peer_rx_pn_bitmap |= 1;
-        s->espnow_peer_last_rx_pn = pn;
+    if (pn > state->last_rx_pn) {
+        delta = pn - state->last_rx_pn;
+        state->rx_pn_bitmap =
+            delta >= 64 ? 0 : state->rx_pn_bitmap << delta;
+        state->rx_pn_bitmap |= 1;
+        state->last_rx_pn = pn;
         return true;
     }
-    if (s->espnow_peer_last_rx_pn - pn >= 64) {
+    if (state->last_rx_pn - pn >= 64) {
         return false;
     }
-    bit = 1ULL << (s->espnow_peer_last_rx_pn - pn);
-    if (s->espnow_peer_rx_pn_bitmap & bit) {
+    bit = 1ULL << (state->last_rx_pn - pn);
+    if (state->rx_pn_bitmap & bit) {
         return false;
     }
-    s->espnow_peer_rx_pn_bitmap |= bit;
+    state->rx_pn_bitmap |= bit;
     return true;
 }
 
