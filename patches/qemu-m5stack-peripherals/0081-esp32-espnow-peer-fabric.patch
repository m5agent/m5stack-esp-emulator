 }
 
+static bool espnow_peer_parse_hex_mac(const char *value, uint8_t mac[6])
+{
+    size_t index;
+
+    if (!value || strlen(value) != 12) {
+        return false;
+    }
+    for (index = 0; index < 6; index++) {
+        unsigned int high;
+        unsigned int low;
+
+        if (sscanf(value + index * 2, "%1x%1x", &high, &low) != 2) {
+            return false;
+        }
+        mac[index] = (high << 4) | low;
+    }
+    return true;
+}
+
 static bool espnow_peer_aes_ecb(const uint8_t key[16], bool encrypt,
                                 const uint8_t input[16], uint8_t output[16])
 {
@@ -111,6 +130,12 @@
     return (uint16_t)(1u << byte);
 }
 
+static void espnow_peer_reset_replay(Esp32WifiState *s)
+{
