From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Thu, 29 Oct 2026 00:00:00 +0800
Subject: [PATCH] hw/esp32: fail closed on ESP-NOW CCMP PN exhaustion

Prevent a protected ESP-NOW frame from reusing a 48-bit CCMP PN.
Keep per-peer-slot PN state and allow a new guest LMK installation to
restore transmission after exhaustion.

Signed-off-by: m5agent <m5agent@m5stack.com>
---
--- a/include/hw/misc/esp32_wifi.h
+++ b/include/hw/misc/esp32_wifi.h
@@ -22,6 +22,7 @@
 #define ESP32_WIFI_CRYPTO_KEY_OFFSET    8
 #define ESP32_WIFI_CRYPTO_KEY_LENGTH    16
 #define ESPNOW_PEER_REPLAY_SLOTS        8
+#define ESPNOW_PEER_CCMP_PN_MAX         0xffffffffffffULL
 
 typedef struct dma_list_item {
     unsigned size:12;
@@ -76,12 +77,20 @@
     uint8_t espnow_crypto_key_meta[
         ESP32_WIFI_CRYPTO_KEY_SLOTS][ESP32_WIFI_CRYPTO_KEY_META_LENGTH];
     uint8_t espnow_crypto_key_meta_written[ESP32_WIFI_CRYPTO_KEY_SLOTS];
+    uint8_t espnow_crypto_key_active_bytes[
+        ESP32_WIFI_CRYPTO_KEY_SLOTS][ESP32_WIFI_CRYPTO_KEY_LENGTH];
+    uint8_t espnow_crypto_key_active_meta[
+        ESP32_WIFI_CRYPTO_KEY_SLOTS][ESP32_WIFI_CRYPTO_KEY_META_LENGTH];
+    bool espnow_crypto_key_active_valid[ESP32_WIFI_CRYPTO_KEY_SLOTS];
     bool espnow_peer_use_guest_key;
     bool espnow_peer_guest_key_valid;
     uint8_t espnow_peer_guest_key_slot;
     uint8_t espnow_peer_guest_lmk[16];
     uint64_t espnow_peer_tx_pn;
+    uint64_t espnow_peer_tx_pn_seed;
     uint64_t espnow_peer_guest_tx_pn[ESP32_WIFI_CRYPTO_KEY_SLOTS];
+    bool espnow_peer_guest_tx_pn_seed_consumed[
+        ESP32_WIFI_CRYPTO_KEY_SLOTS];
     Esp32EspNowPeerReplayState
         espnow_peer_replay[ESPNOW_PEER_REPLAY_SLOTS];
     uint32_t ap_state;
--- a/hw/misc/esp32_wifi.c
+++ b/hw/misc/esp32_wifi.c
@@ -206,7 +206,6 @@
         s->espnow_peer_guest_key_valid = true;
         s->espnow_peer_encrypted = true;
         s->espnow_peer_tx_pn = 0;
-        s->espnow_peer_guest_tx_pn[slot] = 0;
         espnow_peer_reset_replay(s);
         if (s->espnow_peer_trace) {
             fprintf(stderr,
@@ -216,10 +215,46 @@
     }
 }
 
+static void espnow_peer_reconcile_guest_slot(
+    Esp32WifiState *s, unsigned int slot)
+{
+    bool changed;
+
+    if (!espnow_crypto_slot_ready(s, slot)) {
+        return;
+    }
+    changed = s->espnow_crypto_key_active_valid[slot] &&
+              (memcmp(s->espnow_crypto_key_active_meta[slot],
+                      s->espnow_crypto_key_meta[slot], 8) ||
+               memcmp(s->espnow_crypto_key_active_bytes[slot],
+                      s->espnow_crypto_key_bytes[slot], 16));
+    if (s->espnow_crypto_key_active_valid[slot] && !changed) {
+        return;
+    }
+    s->espnow_peer_guest_tx_pn[slot] =
+        s->espnow_crypto_key_active_valid[slot] ||
+        s->espnow_peer_guest_tx_pn_seed_consumed[slot]
+        ? 0 : s->espnow_peer_tx_pn_seed;
+    if (s->espnow_crypto_key_active_valid[slot]) {
+        espnow_peer_reset_replay(s);
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] guest-key state=replaced slot=%u\n",
+                    slot);
+        }
+    }
+    memcpy(s->espnow_crypto_key_active_meta[slot],
+           s->espnow_crypto_key_meta[slot], 8);
+    memcpy(s->espnow_crypto_key_active_bytes[slot],
+           s->espnow_crypto_key_bytes[slot], 16);
+    s->espnow_crypto_key_active_valid[slot] = true;
+}
+
 static void espnow_crypto_refresh_guest_key(Esp32WifiState *s)
 {
     uint32_t valid = s->espnow_crypto_control[0x14 / 4];
     int slot;
+    int active_slot = -1;
 
     if (!s->espnow_peer_use_guest_key) {
         return;
@@ -227,6 +262,9 @@
     for (slot = ESP32_WIFI_CRYPTO_KEY_SLOTS - 1; slot >= 0; slot--) {
         if (!(valid & (1u << slot))) {
             s->espnow_peer_guest_tx_pn[slot] = 0;
+            s->espnow_crypto_key_active_valid[slot] = false;
+        } else {
+            espnow_peer_reconcile_guest_slot(s, slot);
         }
     }
     if (s->espnow_peer_guest_key_valid &&
@@ -235,11 +273,15 @@
     }
     for (slot = ESP32_WIFI_CRYPTO_KEY_SLOTS - 1; slot >= 4; slot--) {
         if (espnow_crypto_slot_ready(s, slot)) {
-            espnow_peer_set_guest_key(
-                s, slot, s->espnow_crypto_key_bytes[slot]);
-            return;
+            active_slot = slot;
+            break;
         }
     }
+    if (active_slot >= 0) {
+        espnow_peer_set_guest_key(
+            s, active_slot,
+            s->espnow_crypto_key_bytes[active_slot]);
+    }
 }
 
 static uint64_t espnow_crypto_control_read(void *opaque, hwaddr addr,
@@ -327,14 +369,8 @@
         }
         if (slot_offset < ESP32_WIFI_CRYPTO_KEY_META_LENGTH) {
             if (slot_offset == 0) {
-                bool was_ready = espnow_crypto_slot_ready(s, slot);
-
                 s->espnow_crypto_key_meta_written[slot] = 0;
-                s->espnow_peer_guest_tx_pn[slot] = 0;
-                if (was_ready) {
-                    s->espnow_peer_tx_pn = 0;
-                    espnow_peer_reset_replay(s);
-                }
+                s->espnow_crypto_key_written[slot] = 0;
             }
             s->espnow_crypto_key_meta[slot][slot_offset] =
                 (value >> (index * 8)) & 0xff;
@@ -348,14 +384,7 @@
             continue;
         }
         if (slot_offset == ESP32_WIFI_CRYPTO_KEY_OFFSET) {
-            bool was_ready = espnow_crypto_slot_ready(s, slot);
-
             s->espnow_crypto_key_written[slot] = 0;
-            s->espnow_peer_guest_tx_pn[slot] = 0;
-            if (was_ready) {
-                s->espnow_peer_tx_pn = 0;
-                espnow_peer_reset_replay(s);
-            }
             if (s->espnow_peer_trace) {
                 fprintf(stderr,
                         "[espnow-peer] guest-key state=write slot=%u\n",
@@ -408,6 +437,14 @@
            sizeof(s->espnow_crypto_key_meta));
     memset(s->espnow_crypto_key_meta_written, 0,
            sizeof(s->espnow_crypto_key_meta_written));
+    memset(s->espnow_crypto_key_active_bytes, 0,
+           sizeof(s->espnow_crypto_key_active_bytes));
+    memset(s->espnow_crypto_key_active_meta, 0,
+           sizeof(s->espnow_crypto_key_active_meta));
+    memset(s->espnow_crypto_key_active_valid, 0,
+           sizeof(s->espnow_crypto_key_active_valid));
+    memset(s->espnow_peer_guest_tx_pn_seed_consumed, 0,
+           sizeof(s->espnow_peer_guest_tx_pn_seed_consumed));
     memory_region_init_io(
         &s->espnow_crypto_control_iomem, OBJECT(s),
         &espnow_crypto_control_ops, s,
@@ -457,6 +494,7 @@
     uint8_t key[16];
     size_t length = frame->frame_length;
     size_t plain_length;
+    uint64_t *pn_counter;
     uint64_t pn;
     int guest_slot;
     bool success;
@@ -478,9 +516,21 @@
         }
         return false;
     }
-    pn = guest_slot >= 0
-        ? ++s->espnow_peer_guest_tx_pn[guest_slot]
-        : ++s->espnow_peer_tx_pn;
+    if (guest_slot >= 0) {
+        pn_counter = &s->espnow_peer_guest_tx_pn[guest_slot];
+        s->espnow_peer_guest_tx_pn_seed_consumed[guest_slot] = true;
+    } else {
+        pn_counter = &s->espnow_peer_tx_pn;
+    }
+    if (*pn_counter >= ESPNOW_PEER_CCMP_PN_MAX) {
+        if (s->espnow_peer_trace) {
+            fprintf(stderr,
+                    "[espnow-peer] TX drop: CCMP PN exhausted\n");
+        }
+        memset(key, 0, sizeof(key));
+        return false;
+    }
+    pn = ++*pn_counter;
     success = Esp32_WLAN_ccmp_encrypt_payload(
         key, frame, pn
     );
@@ -737,6 +787,8 @@
 {
     const char *local_value = getenv("M5SW_ESPNOW_PEER_LOCAL_PORT");
     const char *remote_value = getenv("M5SW_ESPNOW_PEER_REMOTE_PORT");
+    const char *tx_pn_start_value =
+        getenv("M5SW_ESPNOW_PEER_TX_PN_START");
     struct sockaddr_in local = {
         .sin_family = AF_INET,
         .sin_addr.s_addr = htonl(INADDR_LOOPBACK),
@@ -747,6 +799,7 @@
     };
     uint64_t local_port;
     uint64_t remote_port;
+    uint64_t tx_pn_start = 0;
     int fd;
 
     s->espnow_peer_fd = -1;
@@ -764,6 +817,18 @@
     s->espnow_peer_tx_pn = 0;
     memset(s->espnow_peer_guest_tx_pn, 0,
            sizeof(s->espnow_peer_guest_tx_pn));
+    memset(s->espnow_peer_guest_tx_pn_seed_consumed, 0,
+           sizeof(s->espnow_peer_guest_tx_pn_seed_consumed));
+    if (tx_pn_start_value &&
+        (parse_uint_full(tx_pn_start_value, 10, &tx_pn_start) ||
+         tx_pn_start > ESPNOW_PEER_CCMP_PN_MAX)) {
+        error_setg(errp,
+                   "M5SW_ESPNOW_PEER_TX_PN_START must be a decimal "
+                   "48-bit CCMP PN");
+        return;
+    }
+    s->espnow_peer_tx_pn_seed = tx_pn_start;
+    s->espnow_peer_tx_pn = tx_pn_start;
     espnow_peer_reset_replay(s);
     memset(s->espnow_peer_pmk, 0, sizeof(s->espnow_peer_pmk));
     memset(s->espnow_peer_wrapped_lmk, 0,
@@ -909,8 +974,17 @@
            sizeof(s->espnow_crypto_key_meta));
     memset(s->espnow_crypto_key_meta_written, 0,
            sizeof(s->espnow_crypto_key_meta_written));
+    memset(s->espnow_crypto_key_active_bytes, 0,
+           sizeof(s->espnow_crypto_key_active_bytes));
+    memset(s->espnow_crypto_key_active_meta, 0,
+           sizeof(s->espnow_crypto_key_active_meta));
+    memset(s->espnow_crypto_key_active_valid, 0,
+           sizeof(s->espnow_crypto_key_active_valid));
     memset(s->espnow_peer_guest_tx_pn, 0,
            sizeof(s->espnow_peer_guest_tx_pn));
+    memset(s->espnow_peer_guest_tx_pn_seed_consumed, 0,
+           sizeof(s->espnow_peer_guest_tx_pn_seed_consumed));
+    s->espnow_peer_tx_pn_seed = 0;
 }
 
 void Esp32_ESPNow_peer_send(Esp32WifiState *s,
