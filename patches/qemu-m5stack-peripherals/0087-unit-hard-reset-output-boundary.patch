+void esp32_gpio_add_reset_listener(int pin, esp32_gpio_reset_cb cb,
+                                   void *opaque)
+{
+    if (pin < 0 || pin >= GPIO_NPINS || !cb) {
+        return;
+    }
+    if (g_reset_listener_count[pin] >= GPIO_MAX_LISTENERS) {
+        fprintf(stderr, "[gpio] reset listener overflow pin=%d\n", pin);
+        return;
+    }
+    unsigned slot = g_reset_listener_count[pin]++;
+    g_reset_listeners[pin][slot].cb = cb;
+    g_reset_listeners[pin][slot].opaque = opaque;
+}
