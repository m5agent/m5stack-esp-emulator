+static void reset_observed_outputs(M5Unit *unit)
+{
+    if (unit->kind == UNIT_RELAY) {
+        unit->previous_output = esp32_gpio_get_line(unit->yellow);
+        unit->output_transitions = 0;
+    } else if (unit->kind == UNIT_RELAY2) {
+        unit->relay2_previous[0] = esp32_gpio_get_line(unit->white);
+        unit->relay2_previous[1] = esp32_gpio_get_line(unit->yellow);
+        unit->relay2_transitions[0] = 0;
+        unit->relay2_transitions[1] = 0;
+        unit->output_transitions = 0;
+    }
+}
+
+static void output_reset(void *opaque, int pin, int level)
+{
+    M5Unit *unit = opaque;
+    (void)level;
+    if ((unit->kind == UNIT_RELAY && pin == unit->yellow) ||
+        (unit->kind == UNIT_RELAY2 &&
+         (pin == unit->white || pin == unit->yellow))) {
+        reset_observed_outputs(unit);
+    }
+}
+
+static void unit_reset(DeviceState *dev)
+{
+    reset_observed_outputs(M5_UNIT(dev));
+}
