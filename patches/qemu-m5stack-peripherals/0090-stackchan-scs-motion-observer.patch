+static void scs_get_state(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    M5ScsServoState *s = opaque;
+    scs_sync_power(s);
+    QDict *state = qdict_new();
+    QList *servos = qlist_new();
+    qdict_put_int(state, "schema_version", 1);
+    qdict_put_str(state, "source", "qemu-uart1-scs-controller");
+    qdict_put_bool(state, "powered", s->powered);
+    qdict_put_int(state, "packets", s->packets);
+    qdict_put_int(state, "rejected_packets", s->rejected_packets);
+    qdict_put_str(state, "motion_model", "command-time-position-v1");
+    qdict_put_bool(state, "pwm_motion_modelled", false);
+    for (int id = SCS_ID_X; id <= SCS_ID_Y; id++) {
+        uint8_t *m = s->mem[id];
+        QDict *servo = qdict_new();
+        bool pwm_mode = scs_pwm_mode(m);
+        unsigned pwm = pwm_mode ? scs_get_be16(m, 44) : 0;
+        qdict_put_int(servo, "id", id);
+        qdict_put_int(servo, "present_position", scs_get_be16(m, 56));
+        qdict_put_int(servo, "goal_position", scs_get_be16(m, 42));
+        qdict_put_int(servo, "torque", m[40]);
+        qdict_put_str(servo, "mode", pwm_mode ? "pwm" : "position");
+        qdict_put_bool(servo, "moving", m[66] != 0);
+        qdict_put_int(servo, "goal_time_ms", scs_get_be16(m, 44));
+        qdict_put_int(servo, "goal_speed", scs_get_be16(m, 46));
+        qdict_put_int(servo, "pwm", pwm & 0x400 ? -(int)(pwm & 0x3ff) :
+                      (int)(pwm & 0x3ff));
+        qlist_append_obj(servos, QOBJECT(servo));
+    }
+    qdict_put_obj(state, "servos", QOBJECT(servos));
+    QObject *value = QOBJECT(state);
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
 }
 
 void m5_scs_servo_attach(DeviceState *uart)
 {
     M5ScsServoState *s = g_new0(M5ScsServoState, 1);
     s->uart = ESP32_UART(uart);
+    scs_peer = s;
     scs_init_mem(s);
+    Object *observer = object_new("container");
+    object_property_add_child(qdev_get_machine(), "scs_servo", observer);
+    object_property_add(observer, "state", "any", scs_get_state, NULL, NULL, s);
+    object_unref(observer);
+    scs_sync_power(s);
     esp32_uart_set_tx_byte_callback(s->uart, scs_uart_byte, s);
 }
