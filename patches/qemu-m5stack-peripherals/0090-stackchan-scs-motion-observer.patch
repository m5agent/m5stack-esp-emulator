From: M5Stack Emulator Contributors
Subject: [PATCH] stackchan: observe timed SCS motion through the real UART peer

Keep present position separate from commanded position, apply servo rail and
torque gating, stage REG_WRITE until ACTION, and expose an atomic read-only
raw-register snapshot for browser geometry. PWM displacement and physical
speed dynamics remain outside this position-mode implementation.

diff --git a/hw/m5stopwatch/m5_scs_servo.c b/hw/m5stopwatch/m5_scs_servo.c
--- a/hw/m5stopwatch/m5_scs_servo.c
+++ b/hw/m5stopwatch/m5_scs_servo.c
@@ -1,13 +1,16 @@
 /*
- * Minimal SCS serial servo bus peer for StackChan.
+ * StackChan SCSCL UART1 peer and read-only controller observations.
+ * SPDX-License-Identifier: GPL-2.0-or-later
  *
- * The guest UART bytes are parsed as SCSCL packets. Servo ID 1/2 expose the
- * EEPROM/SRAM fields used by the UIFlow2 driver, including position, torque,
- * voltage, current and PWM-mode angle limits.
- *
- * SPDX-License-Identifier: GPL-2.0-or-later
+ * Positions are raw SCS ticks, never guest logical/NVS-calibrated angles.
+ * Position-mode movement follows the command's time in virtual milliseconds.
+ * Speed-only and PWM mechanics are not a physical servo dynamics model.
  */
 #include "qemu/osdep.h"
+#include "qemu/timer.h"
+#include "qapi/visitor.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qlist.h"
 #include "hw/char/esp32_uart.h"
 #include "m5stopwatch.h"
 
@@ -15,13 +18,28 @@
 #define SCS_MEM_SIZE 71
 #define SCS_ID_X 1
 #define SCS_ID_Y 2
+#define SCS_RAW_MAX 1000
+/* Virtual assembly start pose, pinned to StackChan-BSP e2f3b02d defaults.
+ * This does not read or overwrite the firmware's NVS calibration. */
+#define SCS_NOMINAL_X_POSITION 460
+#define SCS_NOMINAL_Y_POSITION 620
 
 typedef struct M5ScsServoState {
     ESP32UARTState *uart;
     uint8_t packet[SCS_MAX_PACKET];
     uint16_t packet_len;
     uint8_t mem[3][SCS_MEM_SIZE];
+    uint8_t pending[3][SCS_MEM_SIZE];
+    bool pending_mask[3][SCS_MEM_SIZE];
+    uint16_t origin[3];
+    int64_t started_ms[3];
+    uint16_t duration_ms[3];
+    bool powered;
+    uint64_t packets;
+    uint64_t rejected_packets;
 } M5ScsServoState;
+
+static M5ScsServoState *scs_peer;
 
 static void scs_put_be16(uint8_t *mem, int addr, uint16_t value)
 {
@@ -34,24 +52,82 @@
     return ((uint16_t)mem[addr] << 8) | mem[addr + 1];
 }
 
-static void scs_init_mem(M5ScsServoState *s)
+static bool scs_pwm_mode(const uint8_t *mem)
+{
+    return scs_get_be16(mem, 9) == 0 && scs_get_be16(mem, 11) == 0;
+}
+
+static void scs_advance(M5ScsServoState *s, int64_t now)
 {
     for (int id = SCS_ID_X; id <= SCS_ID_Y; id++) {
         uint8_t *m = s->mem[id];
-        memset(m, 0, SCS_MEM_SIZE);
-        m[3] = 0x01;                         /* version low */
-        m[4] = 0x01;                         /* version high */
+        if (!s->powered || m[40] != 1 || scs_pwm_mode(m)) {
+            s->duration_ms[id] = 0;
+            m[66] = 0;
+            continue;
+        }
+        if (s->duration_ms[id]) {
+            int64_t elapsed = MAX(0, now - s->started_ms[id]);
+            uint16_t goal = scs_get_be16(m, 42);
+            if (elapsed >= s->duration_ms[id]) {
+                scs_put_be16(m, 56, goal);
+                s->duration_ms[id] = 0;
+                m[66] = 0;
+            } else {
+                int64_t delta = (int)goal - (int)s->origin[id];
+                scs_put_be16(m, 56, s->origin[id] +
+                             delta * elapsed / s->duration_ms[id]);
+                m[66] = 1;
+            }
+        }
+    }
+}
+
+void m5_scs_servo_power_changed(bool enabled)
+{
+    M5ScsServoState *s = scs_peer;
+    if (!s || s->powered == enabled) {
+        return;
+    }
+    scs_advance(s, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+    s->powered = enabled;
+    s->packet_len = 0;
+    if (!enabled) {
+        for (int id = SCS_ID_X; id <= SCS_ID_Y; id++) {
+            uint8_t *m = s->mem[id];
+            /* Rail loss resets volatile drive state, retaining the shaft pose. */
+            m[40] = 0;
+            m[66] = 0;
+            scs_put_be16(m, 42, scs_get_be16(m, 56));
+            scs_put_be16(m, 44, 0);
+            scs_put_be16(m, 46, 0);
+            s->duration_ms[id] = 0;
+            memset(s->pending_mask[id], 0, sizeof(s->pending_mask[id]));
+        }
+    }
+}
+
+static void scs_sync_power(M5ScsServoState *s)
+{
+    m5_scs_servo_power_changed(m5sw_stackchan_servo_power_enabled());
+    scs_advance(s, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL));
+}
+
+static void scs_init_mem(M5ScsServoState *s)
+{
+    for (int id = SCS_ID_X; id <= SCS_ID_Y; id++) {
+        uint8_t *m = s->mem[id];
+        m[3] = 0x01;
+        m[4] = 0x01;
         m[5] = id;
-        m[6] = 1;                            /* baud-rate selector */
-        scs_put_be16(m, 9, 0);               /* min angle limit */
-        scs_put_be16(m, 11, 1000);           /* max angle limit */
-        m[40] = 0;                           /* torque disabled */
-        scs_put_be16(m, 42, id == SCS_ID_X ? 450 : 125);
-        scs_put_be16(m, 56, id == SCS_ID_X ? 450 : 125);
-        m[62] = 120;                         /* 12.0 V */
-        m[63] = 35;                          /* 35 C */
-        m[66] = 0;
-        scs_put_be16(m, 69, 0);
+        m[6] = 1;
+        scs_put_be16(m, 11, SCS_RAW_MAX);
+        scs_put_be16(m, 42, id == SCS_ID_X ? SCS_NOMINAL_X_POSITION :
+                      SCS_NOMINAL_Y_POSITION);
+        scs_put_be16(m, 56, id == SCS_ID_X ? SCS_NOMINAL_X_POSITION :
+                      SCS_NOMINAL_Y_POSITION);
+        m[62] = 120;
+        m[63] = 35;
     }
 }
 
