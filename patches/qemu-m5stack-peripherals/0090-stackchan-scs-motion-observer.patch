+    } else if (inst == 0x05 && len == 2) {
+        for (int sid = SCS_ID_X; sid <= SCS_ID_Y; sid++) {
+            if (id == sid || id == 0xfe) {
+                uint8_t proposed[SCS_MEM_SIZE];
