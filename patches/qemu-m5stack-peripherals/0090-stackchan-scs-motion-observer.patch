 static uint8_t *scs_mem_for(M5ScsServoState *s, uint8_t id)
 {
-    if (id != SCS_ID_X && id != SCS_ID_Y) {
-        return NULL;
-    }
-    return s->mem[id];
+    return id == SCS_ID_X || id == SCS_ID_Y ? s->mem[id] : NULL;
+}
+
+static void scs_motion_written(M5ScsServoState *s, int id)
+{
+    uint8_t *m = s->mem[id];
+    s->duration_ms[id] = 0;
+    m[66] = 0;
+    if (!s->powered || m[40] != 1 || scs_pwm_mode(m)) {
+        return;
+    }
+    uint16_t goal = scs_get_be16(m, 42);
+    goal = CLAMP(goal, scs_get_be16(m, 9), scs_get_be16(m, 11));
+    scs_put_be16(m, 42, goal);
+    uint16_t present = scs_get_be16(m, 56);
+    if (goal == present) {
+        return;
+    }
+    s->duration_ms[id] = scs_get_be16(m, 44);
+    if (!s->duration_ms[id]) {
+        scs_put_be16(m, 56, goal);
+    } else {
+        s->origin[id] = present;
+        s->started_ms[id] = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+        m[66] = 1;
+    }
+}
+
+static bool scs_valid_registers(const uint8_t *mem)
+{
+    return mem[40] <= 2 && scs_get_be16(mem, 42) <= SCS_RAW_MAX &&
+           scs_get_be16(mem, 9) <= scs_get_be16(mem, 11) &&
+           scs_get_be16(mem, 11) <= SCS_RAW_MAX;
+}
+
+static bool scs_write(M5ScsServoState *s, int id, uint8_t addr,
+                      const uint8_t *data, unsigned count, bool deferred)
+{
+    uint8_t *m = scs_mem_for(s, id);
+    uint8_t proposed[SCS_MEM_SIZE];
+    /* Do not allow guests to forge present-position/telemetry registers. */
+    if (!m || !count || addr < 5 || (unsigned)addr + count > 49) {
+        return false;
+    }
+    memcpy(proposed, m, sizeof(proposed));
+    if (deferred) {
+        for (int reg = 5; reg < 49; reg++) {
+            if (s->pending_mask[id][reg]) {
+                proposed[reg] = s->pending[id][reg];
+            }
+        }
+    }
+    memcpy(proposed + addr, data, count);
+    if (!scs_valid_registers(proposed)) {
+        return false;
+    }
+    if (deferred) {
+        memcpy(s->pending[id] + addr, data, count);
+        memset(s->pending_mask[id] + addr, 1, count);
+    } else {
+        memcpy(m + addr, data, count);
+        /* Unrelated EEPROM/lock writes do not restart an in-flight move. */
+        if (addr < 48 && (unsigned)addr + count > 40) {
+            scs_motion_written(s, id);
+        }
+    }
+    return true;
 }
 
