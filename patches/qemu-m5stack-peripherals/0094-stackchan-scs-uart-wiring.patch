+/* StackChan's internal bus is UART1 on TX6/RX7 (ESP32-S3 signal15).
+ * A UART register write alone does not establish the board's GPIO wiring.
+ * Inverted or disconnected routes cannot deliver a packet to the peer.
+ */
+static bool scs_tx_connected(void)
+{
+    return esp32_gpio_matrix_out_signal(6, true) == 15;
+}
+
+static bool scs_rx_connected(void)
+{
+    return esp32_gpio_matrix_in_pin(15, true) == 7;
+}
