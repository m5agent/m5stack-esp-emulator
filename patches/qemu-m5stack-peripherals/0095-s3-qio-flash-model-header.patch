         MemoryRegion *mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&ss->jtag), 0);
         memory_region_add_subregion_overlap(sys_mem, DR_REG_USB_SERIAL_JTAG_BASE, mr, 0);
     }
 
     /* SPI1 controller (SPI Flash) */
     {
         ss->spi1.xts_aes = &ss->xts_aes;
+        if (blk) {
