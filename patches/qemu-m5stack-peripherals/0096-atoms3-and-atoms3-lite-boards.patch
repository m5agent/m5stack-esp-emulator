+/* Original C123 AtomS3: ESP32-S3FN8 (QFN56), 8 MiB Flash, no PSRAM. */
+static void m5atoms3_machine_init(MachineState *machine)
+{
+    m5_board = M5_BOARD_ATOMS3;
+    esp32s3_machine_init(machine);
+}
