+    .instance_size = sizeof(Esp32s3MachineState),
+    .class_init = m5atoms3_machine_class_init,
+};
+
+static void m5atoms3_machine_type_init(void)
+{
+    type_register_static(&m5atoms3_info);
+}
+
+type_init(m5atoms3_machine_type_init);
