+static void m5atoms3_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "M5Stack AtomS3 C123 (ESP32-S3FN8, GC9107 128x128, MPU6886)";
+    mc->init = m5atoms3_machine_init;
+    mc->max_cpus = 2;
+    mc->default_cpus = 2;
+    mc->default_ram_size = 0;
+    mc->fixup_ram_size = esp32s3_fixup_ram_size;
+}
