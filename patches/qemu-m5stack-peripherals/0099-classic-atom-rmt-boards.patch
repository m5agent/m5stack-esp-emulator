+/* Classic ESP32 Atom Lite/Matrix board wiring. GPL-2.0-or-later. */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "hw/xtensa/esp32.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "ui/console.h"
+#include "ui/input.h"
+#include "m5stopwatch.h"
+#include "m5_unit_runtime.h"
+
+typedef struct M5AtomClassicDisplay {
+    M5Unit *io;
+    QemuConsole *console;
+    QEMUTimer *timer;
+    unsigned side;
+} M5AtomClassicDisplay;
+
+static void m5atomclassic_update(void *opaque)
+{
+    M5AtomClassicDisplay *s = opaque;
+    DisplaySurface *surface = qemu_console_surface(s->console);
+
+    if (!surface || surface_bits_per_pixel(surface) != 32 ||
+        surface_width(surface) != s->side || surface_height(surface) != s->side) {
+        surface = qemu_create_displaysurface(s->side, s->side);
+        dpy_gfx_replace_surface(s->console, surface);
+    }
+    uint32_t *pixels = (uint32_t *)surface_data(surface);
+    unsigned stride = surface_stride(surface) / sizeof(uint32_t);
+
+    /* Diagnostic LED surface: pixels are the actual RMT-decoded chain, not
+     * a firmware framebuffer. It exposes all 25 LEDs in wire order. */
+    for (unsigned y = 0; y < s->side; y++) {
+        for (unsigned x = 0; x < s->side; x++) {
+            pixels[y * stride + x] = 0xff000000u |
+                m5_unit_gpio_rgb_value(s->io, y * s->side + x);
+        }
+    }
+    dpy_gfx_update(s->console, 0, 0, s->side, s->side);
+}
+
+static void m5atomclassic_refresh(void *opaque)
+{
+    M5AtomClassicDisplay *s = opaque;
+
+    m5atomclassic_update(s);
+    timer_mod(s->timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 16);
+}
+
+static const GraphicHwOps m5atomclassic_graphics = {
+    .gfx_update = m5atomclassic_update,
+};
+
+static void m5atomclassic_input(DeviceState *dev, QemuConsole *console,
+                              InputEvent *event)
+{
+    if (event->type == INPUT_EVENT_KIND_KEY) {
+        InputKeyEvent *key = event->u.key.data;
+        int qcode = qemu_input_key_value_to_qcode(key->key);
+
+        if (qcode == Q_KEY_CODE_A || qcode == Q_KEY_CODE_1 ||
+            qcode == Q_KEY_CODE_SPC) {
+            object_property_set_bool(OBJECT(dev), "pressed", key->down,
+                                     &error_abort);
+        }
+    }
+}
+
+static QemuInputHandler m5atomclassic_input_handler = {
+    .name = "M5Atom classic button",
+    .mask = INPUT_EVENT_MASK_KEY,
+    .event = m5atomclassic_input,
+};
+
+void m5atomclassic_board_init(Esp32SocState *s)
+{
+    bool matrix = m5_board != M5_BOARD_ATOM_LITE;
+    I2CBus *bus = (I2CBus *)qdev_get_child_bus(DEVICE(&s->i2c[0]), "i2c");
+
+    esp32_i2c_set_bus(DEVICE(&s->i2c[0]), bus);
+    esp32_i2c_set_bus(DEVICE(&s->i2c[1]), bus);
+    if (matrix) {
+        const char *imu_model = m5_board == M5_BOARD_ATOM_MATRIX_V11
+            ? "bmi270" : "mpu6886";
+        DeviceState *imu = qdev_new(TYPE_M5SW_I2C_DEV);
+
+        qdev_prop_set_string(imu, "model", imu_model);
+        qdev_prop_set_uint8(imu, "address", 0x68);
+        object_property_add_child(qdev_get_machine(), imu_model, OBJECT(imu));
+        qdev_realize_and_unref(imu, (BusState *)bus, &error_fatal);
+        m5stopwatch_soft_i2c_init_pins(bus, 25, 21);
+    }
+
+    M5Unit *io = M5_UNIT(qdev_new(TYPE_M5_UNIT));
+
+    io->kind = UNIT_GPIO;
+    io->unit_id = g_strdup("key");
+    io->s3 = false;
+    io->yellow = 27;
+    io->white = 39;
+    io->onboard_led_count = matrix ? 25 : 1;
+    object_property_add_child(qdev_get_machine(), "onboard_io", OBJECT(io));
+    qdev_realize_and_unref(DEVICE(io), NULL, &error_fatal);
+    m5_unit_gpio_initial_complete(io);
+
+    M5AtomClassicDisplay *display = g_new0(M5AtomClassicDisplay, 1);
+
+    display->io = io;
+    display->side = matrix ? 5 : 1;
+    display->console = graphic_console_init(DEVICE(io), 0,
+                                            &m5atomclassic_graphics, display);
+    qemu_console_resize(display->console, display->side, display->side);
+    display->timer = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                  m5atomclassic_refresh, display);
+    timer_mod(display->timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 16);
+    QemuInputHandlerState *handler = qemu_input_handler_register(
+        DEVICE(io), &m5atomclassic_input_handler);
+
+    qemu_input_handler_activate(handler);
+    m5_unit_runtime_init(false);
+    m5_unit_classic_adc_init(get_system_memory());
+}
