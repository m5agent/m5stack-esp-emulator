 }
 
+/* These are independent PMIC state machines, driven by the board PWRON
+ * switch and real guest I2C writes. No UIFlow/Python or frontend policy is
+ * involved. Time belongs to the paused/resumed virtual board, not JS timers.
+ * M5Unified 8530f537: AXP2101 10h.0; AXP192 32h.7; M5PM1 0Ch=A1.
+ */
+static void pm1_release_gpio(M5swI2CDev *s, uint8_t keep)
+{
+    for (unsigned pin = 0; pin < 5; pin++) {
+        unsigned reg = pin < 4 ? 0x16 : 0x17;
+        unsigned shift = pin < 4 ? pin * 2 : 0;
+
+        if (keep & BIT(pin)) {
+            continue;
+        }
+        s->regs[0x10] &= ~BIT(pin); /* input */
+        s->regs[0x11] &= ~BIT(pin);
+        s->regs[0x13] |= BIT(pin);  /* default open-drain */
+        s->regs[reg] &= ~(3 << shift); /* ordinary GPIO function */
+        reg = pin < 4 ? 0x14 : 0x15;
+        s->regs[reg] &= ~(3 << shift); /* no pulls */
+    }
+}
+
+static void pmic_power_off(M5swI2CDev *s, const char *source)
+{
+    if (!s->power_enabled) {
+        return;
+    }
+    s->power_enabled = false;
+    s->shutdown_requests++;
+    timer_del(s->power_key_timer);
+    if (s->model == M_PM1) {
+        uint8_t hold = s->regs[0x07];
+
+        s->regs[0x06] &= ~(BIT(1) | BIT(4)); /* SoC DCDC and LED off. */
+        if (!(hold & BIT(5))) {
+            s->regs[0x06] &= ~BIT(2); /* LDO may keep RTC/IMU powered. */
+        }
+        if (!(hold & BIT(6))) {
+            s->regs[0x06] &= ~BIT(3); /* Optional retained 5V boost. */
+        }
+        pm1_release_gpio(s, hold & 0x1f);
+    }
+    fprintf(stderr, "[m5-power] model=%s action=off source=%s virtual_ns=%" PRId64 "\n",
+            s->model_name, source, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+}
+
+static void pmic_reset_request(M5swI2CDev *s, const char *source)
+{
+    s->reset_requests++;
+    s->pm1_clicks = 0;
+    s->power_key_down = s->power_key_long = false;
+    s->download_requested = false;
+    timer_del(s->power_key_timer);
+    if (s->model == M_PM1) {
+        /* PM1 reset releases its GPIO functions, not its charging supply. */
+        s->regs[0x07] = 0;
+        pm1_release_gpio(s, 0);
+        s->regs[0x06] = 0x16 | (s->regs[0x06] & 1);
+        s->pm1_pa_enabled = false;
+        memset(&s->regs[0x40], 0, 3);
+        s->regs[0x48] &= ~1;
+    }
+    fprintf(stderr, "[m5-power] model=%s action=reset source=%s virtual_ns=%" PRId64 "\n",
+            s->model_name, source, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+}
+
+static int64_t pmic_key_long_ns(M5swI2CDev *s)
+{
+    unsigned setting = s->model == M_PM1 ? (s->regs[0x49] >> 3) & 3
+                       : s->model == M_AXP2101 ? (s->regs[0x27] >> 4) & 3
+                       : (s->regs[0x36] >> 4) & 3;
+    return s->model == M_PM1 ? (setting + 1) * NANOSECONDS_PER_SECOND
+                            : (1000 + setting * 500) * SCALE_MS;
+}
+
+static bool pmic_key_off_enabled(M5swI2CDev *s)
+{
+    return s->model == M_AXP2101 ? (s->regs[0x22] & BIT(1)) != 0
+           : s->model == M_AXP192 && (s->regs[0x36] & BIT(3));
+}
+
+static int64_t pmic_key_off_ns(M5swI2CDev *s)
+{
+    unsigned setting = s->model == M_AXP2101 ? (s->regs[0x27] >> 2) & 3
+                                           : s->regs[0x36] & 3;
+    return (4 + setting * 2) * NANOSECONDS_PER_SECOND;
+}
+
+static int64_t pm1_double_ns(M5swI2CDev *s)
+{
+    return (125 << ((s->regs[0x49] >> 5) & 3)) * SCALE_MS;
+}
+
+static void pmic_key_rearm(M5swI2CDev *s)
+{
+    int64_t deadline = INT64_MAX;
+
+    if (s->power_enabled && s->power_key_down) {
+        if (!s->power_key_long) {
+            deadline = s->power_key_down_ns + pmic_key_long_ns(s);
+        }
+        if (pmic_key_off_enabled(s)) {
+            deadline = MIN(deadline, s->power_key_down_ns + pmic_key_off_ns(s));
+        }
+        if (s->model == M_AXP2101 && (s->regs[0x10] & BIT(2))) {
+            deadline = MIN(deadline, s->power_key_down_ns + 16 * NANOSECONDS_PER_SECOND);
+        }
+    } else if (s->power_enabled && s->model == M_PM1 && s->pm1_clicks) {
+        deadline = s->power_key_release_ns + pm1_double_ns(s);
+    }
+    if (deadline == INT64_MAX) {
+        timer_del(s->power_key_timer);
+    } else {
+        timer_mod(s->power_key_timer,
+                  MAX(deadline, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)));
+    }
+}
+
+static void pmic_download_request(M5swI2CDev *s, const char *source)
+{
+    /* The PM1 requests download, but the SoC currently has no dynamic boot
+     * strap sampler. Retain that observable model gap rather than reset into
+     * ordinary Flash and claim that the ROM downloader was entered.
+     */
+    s->download_requests++;
+    s->download_requested = true;
+    s->pm1_clicks = 0;
+    fprintf(stderr, "[m5-power] model=%s action=download-requested source=%s "
+            "runtime_model_gap=dynamic-boot-strap\n", s->model_name, source);
+}
+
+static void pmic_key_tick(void *opaque)
+{
+    M5swI2CDev *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!s->power_enabled) {
+        return;
+    }
+    if (s->power_key_down) {
+        int64_t held = now - s->power_key_down_ns;
+
+        if (!s->power_key_long && held >= pmic_key_long_ns(s)) {
+            s->power_key_long = true;
+            if (s->model == M_AXP2101) {
+                s->regs[0x49] |= BIT(2); /* long; short is bit 3 */
+            } else if (s->model == M_AXP192) {
+                s->regs[0x46] |= BIT(0);
+            } else if (!(s->regs[0x49] & BIT(7))) {
+                pmic_download_request(s, "button-long");
+            }
+        }
+        if (pmic_key_off_enabled(s) && held >= pmic_key_off_ns(s)) {
+            if (s->model == M_AXP2101 && (s->regs[0x22] & 1)) {
+                pmic_reset_request(s, "button-offlevel-restart");
+            } else {
+                pmic_power_off(s, "button-offlevel");
+            }
+            return;
+        }
+        if (s->model == M_AXP2101 && (s->regs[0x10] & BIT(2))
+            && held >= 16 * NANOSECONDS_PER_SECOND) {
+            pmic_power_off(s, "button-16s");
+            return;
+        }
+    } else if (s->model == M_PM1 && s->pm1_clicks) {
+        s->pm1_clicks = 0;
+        if (s->regs[0x49] & 1) {
+            s->regs[0x42] |= BIT(0); /* disabled reset becomes click IRQ */
+        } else {
+            pmic_reset_request(s, "button-single");
+            return;
+        }
+    }
+    pmic_key_rearm(s);
+}
+
+static void pmic_key_event(M5swI2CDev *s, bool down)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!s || !s->power_enabled || s->power_key_down == down) {
+        return; /* Keyboard autorepeat must not restart the PMIC deadline. */
+    }
+    if (!down) {
+        /* Account for a deadline at this exact input-sync boundary. */
+        pmic_key_tick(s);
+        if (!s->power_enabled || !s->power_key_down) {
+            return;
+        }
+    }
+    s->power_key_down = down;
+    if (s->model == M_PM1) {
+        s->regs[0x48] = (s->regs[0x48] & ~1) | down;
+    }
+    if (down) {
+        s->power_key_down_ns = now;
+        s->power_key_long = false;
+        if (s->model == M_PM1) {
+            s->regs[0x48] |= 0x80;
+        }
+    } else if (!s->power_key_long) {
+        if (s->model == M_AXP2101) {
+            s->regs[0x49] |= BIT(3);
+        } else if (s->model == M_AXP192) {
+            s->regs[0x46] |= BIT(1);
+        } else {
+            int64_t single = (125 << ((s->regs[0x49] >> 1) & 3)) * SCALE_MS;
+
+            if (now - s->power_key_down_ns <= single) {
+                if (s->pm1_clicks && now - s->power_key_release_ns <= pm1_double_ns(s)) {
+                    s->pm1_clicks = 0;
+                    if (s->regs[0x4a] & 1) {
+                        s->regs[0x42] |= BIT(2);
+                    } else {
+                        pmic_power_off(s, "button-double");
+                    }
+                } else {
+                    s->pm1_clicks = 1;
+                    s->power_key_release_ns = now;
+                }
+            }
+        }
+    } else {
+        s->pm1_clicks = 0;
+    }
+    pmic_key_rearm(s);
+}
+
+/* Return true only for a chip-native power/control register. The I2C
+ * controller still owns address decoding, ACKs and pointer advancement.
+ */
+static bool pmic_write_power_register(M5swI2CDev *s, uint8_t r, uint8_t data)
+{
+    if (s->model == M_PM1 && r == 0x06) {
+        s->regs[r] = data & 0x1f;
+        if (!(data & BIT(1))) {
+            pmic_power_off(s, "pwr-cfg-dcdc-disable");
+        }
+    } else if (s->model == M_PM1 && r == 0x0c) {
+        if (data == 0xa1) {
+            pmic_power_off(s, "sys-cmd");
+        } else if (data == 0xa2) {
+            pmic_reset_request(s, "sys-cmd");
+        } else if (data == 0xa3) {
+            pmic_download_request(s, "sys-cmd");
+        }
+    } else if (s->model == M_AXP2101 && r == 0x10) {
+        s->regs[r] = data & ~3; /* self-clearing off/reset commands */
+        if (data & BIT(0)) {
+            pmic_power_off(s, "reg10-bit0");
+        } else if (data & BIT(1)) {
+            pmic_reset_request(s, "reg10-bit1");
+        }
+        pmic_key_rearm(s);
+    } else if (s->model == M_AXP192 && r == 0x32 && (data & BIT(7))) {
+        s->regs[r] = data & ~BIT(7);
+        pmic_power_off(s, "reg32-bit7");
+    } else if ((s->model == M_AXP192 && r == 0x46)
+               || (s->model == M_AXP2101 && r == 0x49)) {
+        s->regs[r] &= ~data; /* AXP status is write-one-to-clear. */
+    } else if ((s->model == M_PM1 && (r == 0x49 || r == 0x4a))
+               || (s->model == M_AXP2101 && (r == 0x22 || r == 0x27))
+               || (s->model == M_AXP192 && r == 0x36)) {
+        s->regs[r] = data;
+        pmic_key_rearm(s);
+    } else {
+        return false;
+    }
+    return true;
+}
