+
+/* StackChan BSP's zero-based PY32 pin 0 is UIFlow's G1: VM_EN.
+ * Resolve its actual driver and configured pulls. An input's default 0x3fff
+ * readback is not evidence of an externally powered servo rail.
+ */
+bool m5sw_stackchan_servo_power_enabled(void)
+{
+    M5swI2CDev *s = g_stackchan_ioe1;
+    bool output, high, open_drain;
+
+    if (!s) {
+        return false;
+    }
+    output = s->regs[0x03] & 1;
+    high = s->regs[0x05] & 1;
+    open_drain = s->regs[0x13] & 1;
+    if (output && (!open_drain || !high)) {
+        return high;
+    }
+    /* Input/open-drain release needs a real, unopposed pull-up. */
+    return (s->regs[0x09] & 1) && !(s->regs[0x0b] & 1);
+}
+
+static void stackchan_power_update(M5swI2CDev *s)
+{
+    if (s == g_stackchan_ioe1) {
+        m5_scs_servo_power_changed(m5sw_stackchan_servo_power_enabled());
+    }
 }
 
 static void m5ioe1_set_input_bits(M5swI2CDev *s, int64_t value)
