+static void dev_unrealize(DeviceState *dev)
+{
+    M5swI2CDev *s = M5SW_I2C_DEV(dev);
+
+    if (s->power_key_timer) {
+        timer_free(s->power_key_timer);
+        s->power_key_timer = NULL;
+    }
+    if (g_pm1 == s) {
+        g_pm1 = NULL;
+    }
+    if (g_axp192 == s) {
+        g_axp192 = NULL;
+    }
+    if (g_axp2101 == s) {
+        g_axp2101 = NULL;
+    }
+    if (g_stackchan_ioe1 == s) {
+        g_stackchan_ioe1 = NULL;
+        m5_scs_servo_power_changed(false);
+    }
+}
