 #include "qemu/osdep.h"
 #include "exec/address-spaces.h"
 #include "hw/xtensa/esp32.h"
+#include "hw/gpio/esp32_gpio.h"
 #include "hw/qdev-properties.h"
 #include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "sysemu/runstate.h"
 #include "m5stopwatch.h"
+
+/* Q4/Q7 discrete power retention, not a fictitious I2C PMIC. The default
+ * fixture has USB attached. D21 bypasses the battery switch on real Plus2:
+ * HOLD low alone must not cut USB power. Battery-only tests explicitly remove
+ * that external supply through /machine/power-hold usb-present.
+ */
+#define TYPE_M5STICKCPLUS2_HOLD "m5stickcplus2-power-hold"
+OBJECT_DECLARE_SIMPLE_TYPE(M5StickCPlus2Hold, M5STICKCPLUS2_HOLD)
+
+struct M5StickCPlus2Hold {
+    DeviceState parent_obj;
+    Esp32GpioPadObserver *observer;
+    bool usb_present, armed, known, high, low_driven, powered;
+    int64_t shutdown_requests;
+};
+
+static void plus2_hold_update(M5StickCPlus2Hold *s)
+{
+    if (s->powered && s->armed && s->low_driven && !s->usb_present) {
+        s->powered = false;
+        s->shutdown_requests++;
+        fprintf(stderr, "[m5-power] model=stickc-plus2 action=off "
+                "source=GPIO4-HOLD usb_present=0\n");
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_GUEST_SHUTDOWN);
+    }
+}
+
+static void plus2_hold_observe(void *opaque, const Esp32GpioPadEvent *event)
+{
+    M5StickCPlus2Hold *s = opaque;
+    const Esp32GpioPadSnapshot *pad = &event->after;
+    bool driven = pad->known && !pad->conflict && pad->drive_known
+                  && pad->oe_known && pad->oe;
+
+    s->known = pad->known && !pad->conflict;
+    s->high = pad->level;
+    s->low_driven = driven && !pad->drive_level;
+    if (driven && pad->drive_level) {
+        s->armed = true;
+    }
+    /* GPIO reset, floating input, and the ordinary GPIO35 button are not a
+     * software power-off command. Require the actual held-high -> driven-low
+     * GPIO4 path; the whole VM must not stop merely because a key was held.
+     */
+    plus2_hold_update(s);
+}
+
+static void plus2_get_bool(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    visit_type_bool(v, name, opaque, errp);
+}
+
+static void plus2_set_usb(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    M5StickCPlus2Hold *s = M5STICKCPLUS2_HOLD(obj);
+    bool value;
+
+    if (visit_type_bool(v, name, &value, errp)) {
+        s->usb_present = value;
+        plus2_hold_update(s);
+    }
+}
+
+static void plus2_get_count(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    visit_type_int64(v, name, opaque, errp);
+}
+
+static void plus2_hold_init(Object *obj)
+{
+    M5StickCPlus2Hold *s = M5STICKCPLUS2_HOLD(obj);
+
+    s->usb_present = s->powered = true;
+    object_property_add(obj, "usb-present", "bool", plus2_get_bool,
+                        plus2_set_usb, NULL, &s->usb_present);
+    object_property_add(obj, "hold-armed", "bool", plus2_get_bool,
+                        NULL, NULL, &s->armed);
+    object_property_add(obj, "hold-known", "bool", plus2_get_bool,
+                        NULL, NULL, &s->known);
+    object_property_add(obj, "hold-high", "bool", plus2_get_bool,
+                        NULL, NULL, &s->high);
+    object_property_add(obj, "powered", "bool", plus2_get_bool,
+                        NULL, NULL, &s->powered);
+    object_property_add(obj, "shutdown-requests", "int", plus2_get_count,
+                        NULL, NULL, &s->shutdown_requests);
+}
+
+static void plus2_hold_realize(DeviceState *dev, Error **errp)
+{
+    M5StickCPlus2Hold *s = M5STICKCPLUS2_HOLD(dev);
+    Esp32GpioPadSnapshot initial;
+
+    s->observer = esp32_gpio_observe_pad(esp32_gpio_get_controller(false), 4,
+                                        plus2_hold_observe, s, &initial, errp);
+    if (s->observer) {
+        s->known = initial.known && !initial.conflict;
+        s->high = initial.level;
+    }
+}
+
+static void plus2_hold_unrealize(DeviceState *dev)
+{
+    M5StickCPlus2Hold *s = M5STICKCPLUS2_HOLD(dev);
+
+    esp32_gpio_unobserve_pad(s->observer);
+    s->observer = NULL;
+}
+
+static void plus2_hold_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = plus2_hold_realize;
+    dc->unrealize = plus2_hold_unrealize;
+}
+
+static const TypeInfo plus2_hold_info = {
+    .name = TYPE_M5STICKCPLUS2_HOLD,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(M5StickCPlus2Hold),
+    .instance_init = plus2_hold_init,
+    .class_init = plus2_hold_class_init,
+};
+
+static void plus2_hold_register(void)
+{
+    type_register_static(&plus2_hold_info);
+}
+type_init(plus2_hold_register)
 
