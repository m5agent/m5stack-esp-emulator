diff --git a/hw/char/esp32s3_uart.c b/hw/char/esp32s3_uart.c
--- a/hw/char/esp32s3_uart.c
+++ b/hw/char/esp32s3_uart.c
@@ -59,7 +59,19 @@
              * register, poke that register instead */
