@@ -53,6 +53,7 @@ xtensa_ss.add(when: 'CONFIG_XTENSA_ESP32S3', if_true: files(
   '../m5stopwatch/m5atoms3lite.c',
   '../m5stopwatch/m5atoms3u.c',
