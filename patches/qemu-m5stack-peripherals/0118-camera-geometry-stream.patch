From 42e2b4a950dbd27da5a601d1541b7b67f606fa11 Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Mon, 2 Nov 2026 17:55:11 +0800
Subject: [PATCH] hw/m5stopwatch: AtomS3R-CAM sensor geometry and frame
 streaming

esp32-camera configures the GC0308 DVP output size through the sensor
window (page 0 0x09-0x0c) and subsample (page 1 0x54/0x56-0x59) registers in
CONFIG_GC_SENSOR_SUBSAMPLE_MODE.  The LCD_CAM model previously used a fixed
board-attached QVGA geometry, so any other framesize requested by the guest
produced a mismatched frame length and either a truncated or a missing
capture.

Decode the window/subsample register pair in the GC0308 model, require an
exact integer inverse, and publish the result to the bound LCD_CAM device.
LCD_CAM latches the geometry at the next CAM_START, so a partially written
register set cannot change a running frame.  The AtomS3R-CAM board binds its
GC0308 device to the LCD_CAM instance; other boards keep their existing
fixed geometry.

Also advance the synthetic scene one grid row per frame in addition to the
4-phase color band.  Frame seed 0 (the static default scene) keeps the
original pattern and digests unchanged, while consecutive frames now stay
distinct for multi-frame streaming through the existing QOM
"auto-increment" frame counter.

Verified: camera.init()/capture() return coherent frames for QQVGA 160x120,
240x240, QVGA 320x240, CIF 400x296 and VGA 640x480, each matching the
host-side reconstruction of the deterministic DVP waveform; five consecutive
QVGA captures are distinct and each matches a reconstructed scene frame.
---
 hw/m5stopwatch/m5_lcd_cam.c    | 34 +++++++++++-
 hw/m5stopwatch/m5atoms3rcam.c  | 11 ++--
 hw/m5stopwatch/m5stopwatch.h   |  5 ++
 hw/m5stopwatch/m5sw_i2c_devs.c | 99 ++++++++++++++++++++++++++++++++++
 4 files changed, 145 insertions(+), 4 deletions(-)

diff --git a/hw/m5stopwatch/m5_lcd_cam.c b/hw/m5stopwatch/m5_lcd_cam.c
index aaaed74..abedeb6 100644
--- a/hw/m5stopwatch/m5_lcd_cam.c
+++ b/hw/m5stopwatch/m5_lcd_cam.c
@@ -41,6 +41,11 @@ struct M5LcdCamState {
     uint32_t int_raw;
     uint32_t width;
     uint32_t height;
+    /* GC0308 window/subsample geometry reported by the sensor model. Latched
+     * at the next CAM_START so a partially written register set cannot change
+     * the DMA frame geometry while the guest is configuring the sensor. */
+    uint32_t sensor_width;
+    uint32_t sensor_height;
     uint32_t frame_seed;
     bool frame_auto_increment;
     uint32_t frame_offset;
@@ -77,7 +82,11 @@ static uint16_t camera_pattern_pixel(M5LcdCamState *s, uint32_t pixel)
     } else {
         r = 35; g = 105; b = 235;
     }
-    if ((x % 40) < 2 || (y % 40) < 2) {
+    /* The 4-phase color band alone repeats every four frames.  Advance the
+     * white grid one row per frame as well so consecutive frames of the
+     * synthetic scene stay distinct; frame_seed 0 (the default static scene)
+     * keeps the original pattern unchanged. */
+    if ((x % 40) < 2 || ((y + s->frame_seed) % 40) < 2) {
         r = g = b = 245;
     }
     return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
@@ -266,6 +275,12 @@ static void lcd_cam_write(void *opaque, hwaddr addr, uint64_t value,
             timer_del(s->capture_timer);
         }
         if (rising) {
+            /* A GC0308 window/subsample update configures the DVP output
+             * geometry before CAM_START; apply it to this capture run. */
+            if (s->sensor_width >= 8 && s->sensor_height >= 8) {
+                s->width = s->sensor_width;
+                s->height = s->sensor_height;
+            }
             s->frame_bytes = MAX(2u, s->width * s->height * 2);
             s->chunk_len = (v & 0xffff) + 1;
             s->chunks_left = (s->frame_bytes + s->chunk_len - 1)
@@ -383,3 +398,20 @@ void m5_lcd_cam_attach(DeviceState *dev, ESPGdmaState *gdma,
         s->frame_data_size = MIN(size, UINT32_MAX);
     }
 }
+
+/*
+ * Report the DVP output geometry derived from the GC0308 window (0x09-0x0c)
+ * and subsample (page 1 0x54/0x56-0x59) registers.  The value is latched at
+ * the next CAM_START; it does not change a running frame.
+ */
+void m5_lcd_cam_set_sensor_geometry(DeviceState *dev, uint32_t width,
+                                    uint32_t height)
+{
+    M5LcdCamState *s = M5_LCD_CAM(dev);
+
+    if (width < 8 || width > 4096 || height < 8 || height > 4096) {
+        return;
+    }
+    s->sensor_width = width;
+    s->sensor_height = height;
+}
diff --git a/hw/m5stopwatch/m5atoms3rcam.c b/hw/m5stopwatch/m5atoms3rcam.c
index 3b51a79..e74becd 100644
--- a/hw/m5stopwatch/m5atoms3rcam.c
+++ b/hw/m5stopwatch/m5atoms3rcam.c
@@ -58,12 +58,16 @@ void m5atoms3rcam_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
         { "bmi270", 0x68 },
         { "gc0308", 0x21 },
     };
+    DeviceState *gc0308 = NULL;
     for (int i = 0; i < ARRAY_SIZE(devs); i++) {
         DeviceState *d = qdev_new(TYPE_M5SW_I2C_DEV);
         qdev_prop_set_string(d, "model", devs[i].model);
         qdev_prop_set_uint8(d, "address", devs[i].addr);
         object_property_add_child(qdev_get_machine(), devs[i].model, OBJECT(d));
         qdev_realize_and_unref(d, (BusState *)bus, &error_fatal);
+        if (!strcmp(devs[i].model, "gc0308")) {
+            gc0308 = d;
+        }
     }
     m5stopwatch_soft_i2c_init(bus);
     /* Camera SCCB is bit-banged on SDA GPIO12 / SCL GPIO9 and those pads are
@@ -101,9 +105,8 @@ void m5atoms3rcam_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
     esp32s3_gpspi_set_dc_pin(spi, 42);
 
     DeviceState *cam = qdev_new(TYPE_M5_LCD_CAM);
-    /* GC0308 DVP output geometry.  The AtomS3R-CAM esp32-camera module
-     * defaults to FRAMESIZE_QVGA (320x240 RGB565), which is what the LCD_CAM
-     * DMA descriptors are sized for. */
+    /* Default DVP geometry until the GC0308 publishes the window/subsample
+     * configuration written by esp32-camera set_framesize(). */
     m5_lcd_cam_attach(cam, gdma, 320, 240);
     sysbus_realize_and_unref(SYS_BUS_DEVICE(cam), &error_fatal);
     memory_region_add_subregion_overlap(
@@ -112,4 +115,6 @@ void m5atoms3rcam_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
     sysbus_connect_irq(
         SYS_BUS_DEVICE(cam), 0,
         qdev_get_gpio_in(intmatrix, ETS_LCD_CAM_INTR_SOURCE));
+    /* Camera capture geometry follows the sensor's configured output size. */
+    m5sw_gc0308_bind_lcd_cam(gc0308, cam);
 }
diff --git a/hw/m5stopwatch/m5stopwatch.h b/hw/m5stopwatch/m5stopwatch.h
index 9bceeff..8dfa2c0 100644
--- a/hw/m5stopwatch/m5stopwatch.h
+++ b/hw/m5stopwatch/m5stopwatch.h
@@ -116,6 +116,11 @@ void m5_epd_panel_write(M5EpdPanelState *s, const uint8_t *buf, uint32_t len,
                         bool command_phase);
 void m5_lcd_cam_attach(DeviceState *dev, struct ESPGdmaState *gdma,
                        uint32_t width, uint32_t height);
+/* Publish the DVP output geometry decoded from GC0308 window/subsample
+ * registers; LCD_CAM latches it at the next CAM_START. */
+void m5_lcd_cam_set_sensor_geometry(DeviceState *dev, uint32_t width,
+                                    uint32_t height);
+void m5sw_gc0308_bind_lcd_cam(DeviceState *sensor, DeviceState *lcd_cam);
 void m5_i2s_attach(DeviceState *dev, struct ESPGdmaState *gdma, uint32_t port);
 void m5_i2s_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
                        struct ESPGdmaState *gdma);
diff --git a/hw/m5stopwatch/m5sw_i2c_devs.c b/hw/m5stopwatch/m5sw_i2c_devs.c
index e0049fc..9cebab5 100644
--- a/hw/m5stopwatch/m5sw_i2c_devs.c
+++ b/hw/m5stopwatch/m5sw_i2c_devs.c
@@ -57,6 +57,8 @@ typedef struct M5swI2CDev {
     uint8_t regs[256];
     uint8_t gc0308_page;
     uint8_t gc0308_bank1[256];
+    /* GC0308 DVP output geometry sink (the AtomS3R-CAM LCD_CAM device). */
+    DeviceState *gc0308_lcd_cam;
     uint8_t ptr;
     bool ptr_set;          /* first byte of a write = register address */
     int64_t rtc_base_seconds; /* host epoch captured at device realize */
@@ -140,6 +142,81 @@ typedef struct M5swI2CDev {
  * which must not overwrite the identity used on the next camera probe.
  * This models SCCB state, not sensor image processing or optical behavior.
  */
+static void gc0308_notify_geometry(M5swI2CDev *s);
+
+/* GC0308 set_framesize() encodes the DVP output geometry in two places:
+ *   page 0: 0x09/0x0a = window height + 8, 0x0b/0x0c = window width + 8
+ *   page 1: 0x54, 0x56-0x59 select the on-sensor subsample ratio
+ * The output resolution is window * ratio (see sensors/gc0308.c
+ * set_framesize(), CONFIG_GC_SENSOR_SUBSAMPLE_MODE). */
+struct gc0308_subsample_cfg {
+    uint8_t r54, r56, r57, r58, r59;
+    uint32_t numerator, denominator;
+};
+
+static bool gc0308_output_geometry(M5swI2CDev *s, uint32_t *width,
+                                   uint32_t *height)
+{
+    static const struct gc0308_subsample_cfg cfgs[] = {
+        { 0x55, 0x00, 0x00, 0x00, 0x00, 84,  420 },  /* 1/5 */
+        { 0x44, 0x00, 0x00, 0x00, 0x00, 105, 420 },  /* 1/4 */
+        { 0x33, 0x00, 0x00, 0x00, 0x00, 140, 420 },  /* 1/3 */
+        { 0x22, 0x00, 0x00, 0x00, 0x00, 210, 420 },  /* 1/2 */
+        { 0x77, 0x02, 0x46, 0x02, 0x46, 240, 420 },  /* 4/7 */
+        { 0x55, 0x02, 0x04, 0x02, 0x04, 252, 420 },  /* 3/5 */
+        { 0x33, 0x02, 0x00, 0x02, 0x00, 280, 420 },  /* 2/3 */
+        { 0x11, 0x00, 0x00, 0x00, 0x00, 420, 420 },  /* 1/1 */
+    };
+    uint32_t win_w = ((uint32_t)s->regs[0x0b] << 8) | s->regs[0x0c];
+    uint32_t win_h = ((uint32_t)s->regs[0x09] << 8) | s->regs[0x0a];
+    uint32_t out_w, out_h;
+
+    if (win_w <= 8 || win_h <= 8) {
+        return false;
+    }
+    win_w -= 8;
+    win_h -= 8;
+    for (size_t i = 0; i < ARRAY_SIZE(cfgs); i++) {
+        const struct gc0308_subsample_cfg *cfg = &cfgs[i];
+
+        if (s->gc0308_bank1[0x54] != cfg->r54 ||
+            s->gc0308_bank1[0x56] != cfg->r56 ||
+            s->gc0308_bank1[0x57] != cfg->r57 ||
+            s->gc0308_bank1[0x58] != cfg->r58 ||
+            s->gc0308_bank1[0x59] != cfg->r59) {
+            continue;
+        }
+        /* Require an exact inverse so a transient/mixed register state is
+         * never published as a known geometry. */
+        if ((win_w * cfg->numerator) % cfg->denominator ||
+            (win_h * cfg->numerator) % cfg->denominator) {
+            return false;
+        }
+        out_w = win_w * cfg->numerator / cfg->denominator;
+        out_h = win_h * cfg->numerator / cfg->denominator;
+        if (out_w < 8 || out_w > 4096 || out_h < 8 || out_h > 4096) {
+            return false;
+        }
+        *width = out_w;
+        *height = out_h;
+        return true;
+    }
+    return false;
+}
+
+static void gc0308_notify_geometry(M5swI2CDev *s)
+{
+    uint32_t width, height;
+
+    if (s->gc0308_lcd_cam == NULL) {
+        return;
+    }
+    if (!gc0308_output_geometry(s, &width, &height)) {
+        return;
+    }
+    m5_lcd_cam_set_sensor_geometry(s->gc0308_lcd_cam, width, height);
+}
+
 static uint8_t gc0308_read_reg(M5swI2CDev *s, uint8_t reg)
 {
     if (reg == 0xfe) {
@@ -166,13 +243,35 @@ static void gc0308_write_reg(M5swI2CDev *s, uint8_t reg, uint8_t value)
     }
     if (s->gc0308_page) {
         s->gc0308_bank1[reg] = value;
+        if (reg == 0x54 || (reg >= 0x56 && reg <= 0x59)) {
+            gc0308_notify_geometry(s);
+        }
     } else if (reg != 0x00) {
         s->regs[reg] = value;
+        if (reg >= 0x09 && reg <= 0x0c) {
+            gc0308_notify_geometry(s);
+        }
     }
 }
 
 OBJECT_DECLARE_SIMPLE_TYPE(M5swI2CDev, M5SW_I2C_DEV)
 
+/*
+ * Attach the LCD_CAM device that consumes this GC0308's DVP output. The
+ * sensor model publishes the geometry decoded from the window/subsample
+ * registers; the LCD_CAM latches it at CAM_START.
+ */
+void m5sw_gc0308_bind_lcd_cam(DeviceState *sensor, DeviceState *lcd_cam)
+{
+    M5swI2CDev *s = M5SW_I2C_DEV(sensor);
+
+    if (s == NULL || s->model != M_GC0308) {
+        return;
+    }
+    s->gc0308_lcd_cam = lcd_cam;
+    gc0308_notify_geometry(s);
+}
+
 typedef struct M5swIP2315 {
     DeviceState parent_obj;
     bool charging;
