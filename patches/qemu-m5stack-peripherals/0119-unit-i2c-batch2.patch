@@ -556,6 +571,8 @@ static void scalar_set(Object *obj, Visitor *v, const char *name, void *opaque,
     M5UnitControl *s = opaque;
     int64_t value, lo = 0, hi = 255;
     if (!visit_type_int64(v, name, &value, errp)) { return; }
+    if (!strcmp(name, "adc-raw")) { lo = 0; hi = 0xffffffffLL; }
+    if (!strcmp(name, "weight-fw")) { lo = 0; hi = 255; }
