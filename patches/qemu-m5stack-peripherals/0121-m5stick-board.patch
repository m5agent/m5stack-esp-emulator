     M5_BOARD_BASIC_V27,
     M5_BOARD_ATOMU,
     M5_BOARD_ATOM_ECHO,
+    M5_BOARD_M5STICK,
 } M5Board;
 
 extern M5Board m5_board;
@@ -214,6 +215,7 @@ void m5atomclassic_board_init(struct Esp32SocState *s);
 void m5atomu_board_init(struct Esp32SocState *s);
 void m5atomecho_board_init(struct Esp32SocState *s);
 void m5basic_board_init(struct Esp32SocState *s);
+void m5stick_board_init(struct Esp32SocState *s);
 
 /* Session-scoped external Units; hardware transactions stay in C. */
 void m5_unit_runtime_init(bool s3);
diff --git a/hw/m5stopwatch/m5sw_i2c_devs.c b/hw/m5stopwatch/m5sw_i2c_devs.c
index e0049fc..7da6799 100644
--- a/hw/m5stopwatch/m5sw_i2c_devs.c
+++ b/hw/m5stopwatch/m5sw_i2c_devs.c
@@ -25,6 +25,7 @@ enum {
     M_BMI270,
     M_BMM150,
     M_MPU6886,
+    M_MPU9250,
     M_RX8130,
     M_PCF8563,
     M_ES8311,
@@ -1178,6 +1179,31 @@ static uint8_t dev_read_reg(M5swI2CDev *s, uint8_t r)
             return (r & 1) ? raw >> 8 : raw & 0xff;
         }
         break;
