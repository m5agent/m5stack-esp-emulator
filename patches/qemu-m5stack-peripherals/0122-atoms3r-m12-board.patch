+/* C126-M12 AtomS3R-M12: AtomS3R controller plus an OV3660 M12 DVP camera. */
+static void m5atoms3rm12_machine_init(MachineState *machine)
+{
+    m5_board = M5_BOARD_ATOMS3R_M12;
+    esp32s3_machine_init(machine);
+}
+
+static void m5atoms3rm12_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "M5Stack AtomS3R-M12 C126-M12 (ESP32-S3-PICO-1-N8R8, GC9107, OV3660)";
+    mc->init = m5atoms3rm12_machine_init;
+    mc->max_cpus = 2;
+    mc->default_cpus = 2;
+    /* ESP32-S3-PICO-1-N8R8: 8 MiB in-package octal PSRAM; esp32-camera
+     * allocates its frame buffers with MALLOC_CAP_SPIRAM. */
+    mc->default_ram_size = 8 * MiB;
+    mc->fixup_ram_size = esp32s3_fixup_ram_size;
+}
+
+static const TypeInfo m5atoms3rm12_info = {
+    .name = MACHINE_TYPE_NAME("m5atoms3rm12"),
+    .parent = TYPE_ESP32S3_MACHINE,
+    .instance_size = sizeof(Esp32s3MachineState),
+    .class_init = m5atoms3rm12_machine_class_init,
+};
+
+static void m5atoms3rm12_machine_type_init(void)
+{
+    type_register_static(&m5atoms3rm12_info);
+}
+
+type_init(m5atoms3rm12_machine_type_init);
