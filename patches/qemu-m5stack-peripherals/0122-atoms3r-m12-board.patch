 typedef struct M5swIP2315 {
     DeviceState parent_obj;
     bool charging;
@@ -1522,6 +1597,9 @@ static int dev_event(I2CSlave *i2c, enum i2c_event ev)
         s->st25_mode = 0;
         s->st25_read_space_b = false;
         s->bq_ctrl_byte_index = 0;
+        if (s->model == M_OV3660) {
+            s->ov3660_addr_bytes = 0;
+        }
     } else if (ev == I2C_START_RECV) {
         s->read_start = s->ptr;
         s->ina3221_read_index = 0;
@@ -1545,6 +1623,14 @@ static uint8_t dev_recv(I2CSlave *i2c)
 {
     M5swI2CDev *s = M5SW_I2C_DEV(i2c);
     s->read_bytes++;
+    if (s->model == M_OV3660) {
+        uint8_t v = ov3660_read_reg(s, s->ov3660_ptr);
+        if (s->trace) {
+            qemu_log("[ov3660] rd16 %04x -> %02x\n", s->ov3660_ptr, v);
+        }
+        s->ov3660_ptr++;
+        return v;
+    }
     if (s->model == M_INA3221) {
         uint16_t value = ina3221_reg16(s, s->read_start);
         uint8_t raw = s->ina3221_read_index & 1
@@ -1574,6 +1660,24 @@ static int dev_send(I2CSlave *i2c, uint8_t data)
 {
     M5swI2CDev *s = M5SW_I2C_DEV(i2c);
     s->written_bytes++;
+    if (s->model == M_OV3660) {
+        if (s->ov3660_addr_bytes == 0) {
+            s->ov3660_ptr = (uint16_t)data << 8;
+            s->ov3660_addr_bytes = 1;
+            return 0;
+        }
+        if (s->ov3660_addr_bytes == 1) {
+            s->ov3660_ptr |= data;
+            s->ov3660_addr_bytes = 2;
+            s->ov3660_ptr_valid = true;
+            return 0;
+        }
+        if (s->trace) {
+            qemu_log("[ov3660] wr16 %04x <- %02x\n", s->ov3660_ptr, data);
+        }
+        ov3660_write_reg(s, s->ov3660_ptr, data);
+        return 0;
+    }
     if (s->model == M_ST25R3916) {
         if (s->trace) {
             qemu_log("[st25r3916] tx mode=%u data=%02x\n",
@@ -2457,6 +2561,11 @@ static void dev_realize(DeviceState *dev, Error **errp)
     } else if (!strcmp(m, "gc0308")) {
         s->model = M_GC0308;
         s->regs[0x00] = 0x9B;
+    } else if (!strcmp(m, "ov3660")) {
+        s->model = M_OV3660;
+        s->ov3660_regs = g_malloc0(OV3660_REG_SPACE);
+        s->ov3660_addr_bytes = 0;
+        s->ov3660_ptr_valid = false;
     } else if (!strcmp(m, "m5ioe1_v4")) {
         s->model = M_IOE1;
         s->regs[0x00] = 0x34;
@@ -2525,6 +2634,10 @@ static void dev_unrealize(DeviceState *dev)
 {
     M5swI2CDev *s = M5SW_I2C_DEV(dev);
 
+    if (s->ov3660_regs) {
+        g_free(s->ov3660_regs);
+        s->ov3660_regs = NULL;
+    }
     if (s->power_key_timer) {
         timer_free(s->power_key_timer);
         s->power_key_timer = NULL;
diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
index 59d1dad..218cc79 100644
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -1553,6 +1553,40 @@ static void m5atoms3rcam_machine_type_init(void)
 
