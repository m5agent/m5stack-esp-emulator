 };
 
 typedef struct M5swI2CDev {
@@ -59,6 +60,12 @@ typedef struct M5swI2CDev {
     uint8_t gc0308_bank1[256];
     /* GC0308 DVP output geometry sink (the AtomS3R-CAM LCD_CAM device). */
     DeviceState *gc0308_lcd_cam;
+    /* OV3660 (AtomS3R-M12) uses a 16-bit SCCB register address space. */
+    uint8_t *ov3660_regs;
+    uint16_t ov3660_ptr;
+    uint8_t ov3660_addr_bytes;
+    bool ov3660_ptr_valid;
+    DeviceState *ov3660_lcd_cam;
     uint8_t ptr;
     bool ptr_set;          /* first byte of a write = register address */
     int64_t rtc_base_seconds; /* host epoch captured at device realize */
@@ -272,6 +279,74 @@ void m5sw_gc0308_bind_lcd_cam(DeviceState *sensor, DeviceState *lcd_cam)
     gc0308_notify_geometry(s);
 }
 
+/*
+ * OV3660 SCCB model.  esp32-camera talks to this sensor with 16-bit register
+ * addresses (SCCB_Read16/Write16): a write transaction is address byte,
+ * register high, register low, data; a read transaction first writes the two
+ * register address bytes and then performs a separate read transaction.
+ * PID 0x3660 lives in read-only registers 0x300A/0x300B.  The DVP output
+ * geometry is published from the 0x3808-0x380b output-size registers which
+ * set_framesize() writes through write_addr_reg().
+ */
+#define OV3660_REG_SPACE 0x10000
+#define OV3660_PID_HIGH  0x36
+#define OV3660_PID_LOW   0x60
+
+static void ov3660_notify_geometry(M5swI2CDev *s);
+
+static uint8_t ov3660_read_reg(M5swI2CDev *s, uint16_t reg)
+{
+    if (reg == 0x300A) {
+        return OV3660_PID_HIGH;
+    }
+    if (reg == 0x300B) {
+        return OV3660_PID_LOW;
+    }
+    return s->ov3660_regs ? s->ov3660_regs[reg] : 0;
+}
+
+static void ov3660_write_reg(M5swI2CDev *s, uint16_t reg, uint8_t value)
+{
+    if (s->ov3660_regs == NULL) {
+        return;
+    }
+    if (reg == 0x3008 && (value & 0x80)) {
+        /* Software reset: volatile register state returns to defaults while
+         * the read-only PID stays 0x3660. */
+        memset(s->ov3660_regs, 0, OV3660_REG_SPACE);
+    }
+    s->ov3660_regs[reg] = value;
+    if (reg >= 0x3808 && reg <= 0x380B) {
+        ov3660_notify_geometry(s);
+    }
+}
+
+static void ov3660_notify_geometry(M5swI2CDev *s)
+{
+    uint32_t width, height;
+
+    if (s->ov3660_lcd_cam == NULL || s->ov3660_regs == NULL) {
+        return;
+    }
+    width = ((uint32_t)s->ov3660_regs[0x3808] << 8) | s->ov3660_regs[0x3809];
+    height = ((uint32_t)s->ov3660_regs[0x380A] << 8) | s->ov3660_regs[0x380B];
+    if (width < 8 || width > 4096 || height < 8 || height > 4096) {
+        return;
+    }
+    m5_lcd_cam_set_sensor_geometry(s->ov3660_lcd_cam, width, height);
+}
+
+void m5sw_ov3660_bind_lcd_cam(DeviceState *sensor, DeviceState *lcd_cam)
+{
+    M5swI2CDev *s = M5SW_I2C_DEV(sensor);
+
+    if (s == NULL || s->model != M_OV3660) {
+        return;
+    }
+    s->ov3660_lcd_cam = lcd_cam;
+    ov3660_notify_geometry(s);
+}
