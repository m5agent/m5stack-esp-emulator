+        case 0x0200:   /* CMD_SYS_PING */
+            count = 1;
+            words[0] = 0x0000;
+            break;
+        case 0x0204:   /* CMD_SYS_STATUS */
+            count = 2;
+            words[0] = 0x0000;
+            words[1] = 0x0000;
+            break;
+        default:
