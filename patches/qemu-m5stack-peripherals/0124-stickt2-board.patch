+static void lepton_set_response(M5swI2CDev *s, const uint16_t *words,
+                                unsigned count)
+{
+    lepton_reg_set(s, LEPTON_CCI_ADDR_DATA_LEN, count * 2);
+    for (unsigned i = 0; i < count; i++) {
+        lepton_reg_set(s, LEPTON_CCI_ADDR_DATA + i * 2, words[i]);
