 hw/m5stopwatch/m5_lepton.c     | 388 +++++++++++++++++++++++++++++++++
 hw/m5stopwatch/m5stickt2.c     |  96 ++++++++
 hw/m5stopwatch/m5stopwatch.h   |   5 +
 hw/m5stopwatch/m5sw_i2c_devs.c | 205 +++++++++++++++++
 hw/ssi/esp32_spi.c             |  34 ++-
 hw/xtensa/esp32.c              |  37 ++++
 hw/xtensa/meson.build          |   2 +
 include/hw/ssi/esp32_spi.h     |   9 +
 9 files changed, 795 insertions(+), 3 deletions(-)
 create mode 100644 hw/m5stopwatch/m5_lepton.c
 create mode 100644 hw/m5stopwatch/m5stickt2.c

diff --git a/hw/char/esp32_uart.c b/hw/char/esp32_uart.c
index ada504e..8d8510d 100644
--- a/hw/char/esp32_uart.c
+++ b/hw/char/esp32_uart.c
@@ -37,7 +37,12 @@ void esp32_uart_update_irq(ESP32UARTState *s)
 
     uint32_t tx_empty_raw = (fifo8_num_used(&s->tx_fifo) <= s->tx_empty_threshold);
     uint32_t rx_full_raw = (fifo8_num_used(&s->rx_fifo) >= s->rx_full_threshold);
-    uint32_t tx_done_raw = (fifo8_num_used(&s->tx_fifo) == 0);
+    /* TX_DONE is latched when a transmission drains the FIFO and is
+     * acknowledged through INT_CLR; deriving it from the FIFO level leaves a
+     * permanently asserted level interrupt for drivers that enable it
+     * (Arduino-ESP32 1.0.4 uartBegin does exactly that). */
+    uint32_t tx_done_raw = FIELD_EX32(s->reg[R_UART_INT_RAW],
+                                      UART_INT_RAW, TX_DONE);
     uint32_t rxfifo_tout_raw = (s->rxfifo_tout) ? 1 : 0;
 
     uint32_t int_raw = s->reg[R_UART_INT_RAW];
@@ -51,6 +56,13 @@ void esp32_uart_update_irq(ESP32UARTState *s)
     irq = int_st != 0;
     s->reg[R_UART_INT_ST] = int_st;
 
+    if (getenv("M5SW_UART_IRQ_TRACE") && irq) {
+        static unsigned trace_count;
+        if (trace_count++ < 40) {
+            fprintf(stderr, "[uart-irq] raw=%08x ena=%08x st=%08x\n",
+                    s->reg[R_UART_INT_RAW], s->reg[R_UART_INT_ENA], int_st);
+        }
+    }
     qemu_set_irq(s->irq, irq);
 }
 
@@ -154,6 +166,7 @@ static void uart_write(void *opaque, hwaddr addr,
 
     case A_UART_INT_CLR:
         s->reg[R_UART_INT_ST] &= ~((uint32_t) value);
+        s->reg[R_UART_INT_RAW] &= ~((uint32_t) value);
         s->reg[addr / 4] = value;
         if (value & R_UART_INT_CLR_RXFIFO_TOUT_MASK) {
             s->rxfifo_tout = false;
@@ -231,6 +244,9 @@ static gboolean uart_transmit(void *do_not_use, GIOCondition cond, void *opaque)
     /* drain the fifo instantly, if the char device backend is not connected */
     if (!qemu_chr_fe_backend_open(&s->chr)) {
         fifo8_reset(&s->tx_fifo);
+        s->reg[R_UART_INT_RAW] = FIELD_DP32(s->reg[R_UART_INT_RAW],
+                                            UART_INT_RAW, TX_DONE, 1);
+        esp32_uart_update_irq(s);
         return FALSE;
     }
 
@@ -246,6 +262,10 @@ static gboolean uart_transmit(void *do_not_use, GIOCondition cond, void *opaque)
         }
     }
 
+    if (fifo8_num_used(&s->tx_fifo) == 0) {
+        s->reg[R_UART_INT_RAW] = FIELD_DP32(s->reg[R_UART_INT_RAW],
+                                            UART_INT_RAW, TX_DONE, 1);
+    }
     esp32_uart_update_irq(s);
 
     return FALSE;
diff --git a/hw/m5stopwatch/m5_lepton.c b/hw/m5stopwatch/m5_lepton.c
new file mode 100644
index 0000000..58bee63
--- /dev/null
+++ b/hw/m5stopwatch/m5_lepton.c
@@ -0,0 +1,388 @@
+/*
+ * FLIR Lepton 3.0 thermal camera model (VoSPI video + VSYNC + reset).
+ *
+ * The official M5-StickT example (examples/M5StickT_Lepton_opensource_v1)
+ * clocks 164-byte VoSPI packets out of the sensor on HSPI, reads one packet
+ * per video line-half, and expects:
+ *   - packet byte 0: high nibble = segment number (1..4), low nibble 0x0 for
+ *     a valid packet (0xF marks the discard packets the driver skips),
+ *   - packet byte 1: packet number 0..59 inside the segment,
+ *   - packet bytes 2..3: CRC word (the example reads and ignores it; the
+ *     model writes 0 and this is documented as an unvalidated field),
+ *   - packet bytes 4..163: 80 big-endian 16-bit raw pixel values.
+ * The example's getRawValues() waits for a VSYNC rising edge on GPIO38
+ * before reading each segment, so this model resets its packet pointer and
+ * pulses VSYNC at every segment boundary (4 segments per 160x120 frame).
+ *
+ * Data plane: a deterministic synthetic thermal fixture is generated inside
+ * the model from `frame-seed`; the host-side oracle rebuilds the same field
+ * from that seed.  No frame or register content is injected by the host: the
+ * QOM properties only select the fixture seed and whether it advances once
+ * per frame, like the camera sensor models in this tree.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "hw/sysbus.h"
+#include "qapi/error.h"
+#include "hw/qdev-properties.h"
+#include "hw/ssi/esp32_spi.h"
+#include "m5stopwatch.h"
+
+#define LEPTON_WIDTH 160
+#define LEPTON_HEIGHT 120
+#define LEPTON_SEGMENTS 4
+#define LEPTON_PACKETS_PER_SEGMENT 60
+#define LEPTON_PACKET_BYTES 164
+#define LEPTON_PIXELS_PER_PACKET 80
+#define LEPTON_ROWS_PER_SEGMENT 30
+
+typedef struct M5LeptonState {
+    DeviceState parent_obj;
+
+    QEMUTimer *segment_timer;
+    QEMUTimer *vsync_timer;
+    uint32_t vsync_width_us;
+    uint32_t cs_pin;
+    uint32_t vsync_pin;
+    uint32_t reset_pin;
+    uint32_t segment_interval_us;
+
+    uint32_t frame_seed;
+    uint32_t base_frame_seed;
+    bool auto_increment;
+
+    uint8_t segment;   /* 1..4, next segment to serve */
+    uint8_t packet;    /* 0..59, next packet inside the segment */
+    uint8_t packet_buf[LEPTON_PACKET_BYTES];
+    int packet_offset; /* bytes already served from packet_buf, -1 = idle */
+    int cs_level;
+    bool trace;
+
+    uint32_t frames_started;
+    uint32_t segments_started;
+    uint32_t segments_served;
+    uint32_t packets_served;
+    uint32_t vsyncs;
+    uint32_t bytes_this_packet;
+    uint16_t frame[LEPTON_WIDTH * LEPTON_HEIGHT];
+    char frame_digest[65];
+} M5LeptonState;
+
+#define TYPE_M5_LEPTON "m5.lepton"
+#define M5_LEPTON(obj) \
+    OBJECT_CHECK(M5LeptonState, (obj), TYPE_M5_LEPTON)
+#define M5_LEPTON_CLASS(klass) \
+    OBJECT_CLASS_CHECK(M5LeptonClass, (klass), TYPE_M5_LEPTON)
+
+typedef struct M5LeptonClass {
+    DeviceClass parent_class;
+} M5LeptonClass;
+
+static uint16_t lepton_fixture_raw(int x, int y, uint32_t seed)
+{
+    /* Deterministic LWIR-like field: slow gradient, two warm blocks and one
+     * cool block.  Values stay in 16-bit raw counts and never hit 0 (the
+     * guest treats a 0 pixel as a failed packet). */
+    int warm_x = 12 + (int)((seed * 13u) % 96u);
+    int warm_y = 10 + (int)((seed * 7u) % 64u);
+    uint32_t value = 5200u + (uint32_t)((x * 19 + y * 31 + (int)(seed * 337u)) % 2600);
+
+    if (x >= warm_x && x < warm_x + 40 && y >= warm_y && y < warm_y + 30) {
+        value += 2600u;
+    }
+    if (x >= 118 && x < 150 && y >= 88 && y < 114) {
+        value = 4300u + (seed * 11u) % 600u;
+    }
+    if (value == 0) {
+        value = 1;
+    }
+    return (uint16_t)value;
+}
+
+static void lepton_build_frame(M5LeptonState *s, uint32_t seed)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    s->frame_seed = seed;
+    for (int y = 0; y < LEPTON_HEIGHT; y++) {
+        for (int x = 0; x < LEPTON_WIDTH; x++) {
+            uint16_t raw = lepton_fixture_raw(x, y, seed);
+            s->frame[y * LEPTON_WIDTH + x] = raw;
+        }
+    }
+    g_checksum_update(checksum, (const guchar *)s->frame, sizeof(s->frame));
+    g_strlcpy(s->frame_digest, g_checksum_get_string(checksum),
+              sizeof(s->frame_digest));
+    if (s->trace) {
+        qemu_log("[lepton] frame seed=%u digest=%s\n", seed, s->frame_digest);
+    }
+}
+
+static void lepton_build_packet(M5LeptonState *s)
+{
+    int segment = s->segment;
+    int line = s->packet;
+    int row = (segment - 1) * LEPTON_ROWS_PER_SEGMENT + (line >> 1);
+    int half = line & 1;
+
+    s->packet_buf[0] = (uint8_t)(segment << 4);
+    s->packet_buf[1] = (uint8_t)line;
+    s->packet_buf[2] = 0;
+    s->packet_buf[3] = 0;
+    for (int col = 0; col < LEPTON_PIXELS_PER_PACKET; col++) {
+        uint16_t raw = s->frame[row * LEPTON_WIDTH + half * 80 + col];
+        s->packet_buf[4 + col * 2] = raw >> 8;
+        s->packet_buf[5 + col * 2] = raw & 0xff;
+    }
+}
+
+static uint8_t lepton_spi_transfer(void *opaque, uint8_t tx)
+{
+    M5LeptonState *s = M5_LEPTON(opaque);
+
+    if (s->cs_level != 0) {
+        return 0xff;
+    }
+    if (s->packet_offset < 0 || s->packet_offset >= LEPTON_PACKET_BYTES) {
+        if (s->packet >= LEPTON_PACKETS_PER_SEGMENT) {
+            /* Segment already consumed; wait for the next VSYNC. */
+            return 0xff;
+        }
+        lepton_build_packet(s);
+        s->packet_offset = 0;
+        s->packets_served++;
+        if (s->trace) {
+            qemu_log("[lepton] serve seg=%u line=%u hdr=%02x%02x%02x%02x\n",
+                     s->segment, s->packet, s->packet_buf[0],
+                     s->packet_buf[1], s->packet_buf[2], s->packet_buf[3]);
+        }
+    }
+    uint8_t value = s->packet_buf[s->packet_offset];
+    s->bytes_this_packet++;
+    s->packet_offset++;
+    if (s->packet_offset == LEPTON_PACKET_BYTES) {
+        s->bytes_this_packet = 0;
+        s->packet_offset = -1;
+        s->packet++;
+        if (s->packet >= LEPTON_PACKETS_PER_SEGMENT) {
+            /* VoSPI is a continuous stream: the sensor advances to the next
+             * segment after 60 packets regardless of the VSYNC timer, which
+             * only provides the reference pulse. */
+            s->segments_served++;
+            s->packet = 0;
+            if (s->segment >= LEPTON_SEGMENTS) {
+                if (s->auto_increment) {
+                    s->base_frame_seed++;
+                }
+                s->frames_started++;
+                lepton_build_frame(s, s->base_frame_seed);
+                s->segment = 1;
+            } else {
+                s->segment++;
+            }
+        }
+    }
+    return value;
+}
+
+static void lepton_set_cs(void *opaque, int level);
+
+static const M5SpiSlaveOps lepton_spi_ops = {
+    .set_cs = lepton_set_cs,
+    .transfer = lepton_spi_transfer,
+};
+
+static void lepton_set_cs(void *opaque, int level)
+{
+    M5LeptonState *s = M5_LEPTON(opaque);
+
+    s->cs_level = level;
+    if (s->trace) {
+        qemu_log("[lepton] cs level=%d\n", level);
+    }
+}
+
+static void m5_lepton_cs_line(void *opaque, int pin, int level)
+{
+    lepton_set_cs(opaque, level);
+}
+
+static void m5_lepton_vsync_end(void *opaque)
+{
+    M5LeptonState *s = M5_LEPTON(opaque);
+
+    esp32_gpio_set_input(s->vsync_pin, 1);
+}
+
+static void m5_lepton_vsync_pulse(M5LeptonState *s)
+{
+    /* Drive a real low pulse so both interrupt-driven and polling guests can
+     * observe the rising edge; a zero-width pulse would be invisible to a
+     * CPU that polls the GPIO input register. */
+    esp32_gpio_set_input(s->vsync_pin, 0);
+    timer_mod(s->vsync_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (uint64_t)s->vsync_width_us * 1000);
+    s->vsyncs++;
+}
+
+static void lepton_segment_tick(void *opaque)
+{
+    M5LeptonState *s = M5_LEPTON(opaque);
+
+    m5_lepton_vsync_pulse(s);
+    if (s->trace) {
+        qemu_log("[lepton] vsync pulse segment=%u frames=%u\n",
+                 s->segment, s->frames_started);
+    }
+    timer_mod(s->segment_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (uint64_t)s->segment_interval_us * 1000);
+}
+
+static void lepton_reset_line(void *opaque, int pin, int level)
+{
+    M5LeptonState *s = M5_LEPTON(opaque);
+
+    if (s->trace) {
+        qemu_log("[lepton] reset pin=%d level=%d\n", pin, level);
+    }
+    if (level == 0) {
+        /* Sensor held in reset: restart the stream at segment 1 of the
+         * configured seed frame. */
+        s->segment = 1;
+        s->packet = 0;
+        s->packet_offset = -1;
+        s->base_frame_seed = s->frame_seed;
+        lepton_build_frame(s, s->base_frame_seed);
+    }
+}
+
+static void m5_lepton_realize(DeviceState *dev, Error **errp)
+{
+    M5LeptonState *s = M5_LEPTON(dev);
+
+    s->trace = getenv("M5SW_LEPTON_TRACE") != NULL;
+    s->cs_level = 1;
+    s->packet_offset = -1;
+    s->packet = 0;
+    s->segment = 1;
+    s->base_frame_seed = s->frame_seed;
+    lepton_build_frame(s, s->frame_seed);
+
+    esp32_gpio_set_input(s->vsync_pin, 1);
+    esp32_gpio_add_out_listener(s->cs_pin, m5_lepton_cs_line, s);
+    esp32_gpio_add_out_listener(s->reset_pin, lepton_reset_line, s);
+
+    s->vsync_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                  (QEMUTimerCB *)m5_lepton_vsync_end, s);
+    s->segment_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                    (QEMUTimerCB *)lepton_segment_tick, s);
+    timer_mod(s->segment_timer,
+              qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+              (uint64_t)s->segment_interval_us * 1000);
+}
+
+static void m5_lepton_unrealize(DeviceState *dev)
+{
+    M5LeptonState *s = M5_LEPTON(dev);
+
+    if (s->segment_timer) {
+        timer_del(s->segment_timer);
+        timer_free(s->segment_timer);
+        s->segment_timer = NULL;
+    }
+    if (s->vsync_timer) {
+        timer_del(s->vsync_timer);
+        timer_free(s->vsync_timer);
+        s->vsync_timer = NULL;
+    }
+}
+
+static char *lepton_frame_digest_get(Object *obj, Error **errp)
+{
+    return g_strdup(M5_LEPTON(obj)->frame_digest);
+}
+
+static bool lepton_auto_increment_get(Object *obj, Error **errp)
+{
+    return M5_LEPTON(obj)->auto_increment;
+}
+
+static void lepton_auto_increment_set(Object *obj, bool value, Error **errp)
+{
+    M5_LEPTON(obj)->auto_increment = value;
+}
+
+static void m5_lepton_instance_init(Object *obj)
+{
+    M5LeptonState *s = M5_LEPTON(obj);
+
+    /* One segment per 30 ms virtual time: the official example reads each
+     * 60-packet segment in roughly 4 ms at 20 MHz SPI, leaving headroom for
+     * QEMU's SPI transaction overhead. */
+    s->segment_interval_us = 30000;
+    s->vsync_width_us = 1000;
+    s->base_frame_seed = 0;
+    s->auto_increment = true;
+    object_property_add_uint32_ptr(obj, "frame-seed", &s->frame_seed,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "cs-pin", &s->cs_pin,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "vsync-pin", &s->vsync_pin,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "reset-pin", &s->reset_pin,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "segment-interval-us",
+                                   &s->segment_interval_us,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "vsync-width-us", &s->vsync_width_us,
+                                   OBJ_PROP_FLAG_READWRITE);
+    object_property_add_uint32_ptr(obj, "frames-started", &s->frames_started,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "segments-started", &s->segments_started,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "segments-served", &s->segments_served,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "packets-served", &s->packets_served,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_uint32_ptr(obj, "vsyncs", &s->vsyncs,
+                                   OBJ_PROP_FLAG_READ);
+    object_property_add_bool(obj, "auto-increment",
+                             lepton_auto_increment_get,
+                             lepton_auto_increment_set);
+    object_property_add_str(obj, "frame-digest", lepton_frame_digest_get, NULL);
+}
+
+static void m5_lepton_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = m5_lepton_realize;
+    dc->unrealize = m5_lepton_unrealize;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static const TypeInfo m5_lepton_info = {
+    .name = TYPE_M5_LEPTON,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(M5LeptonState),
+    .instance_init = m5_lepton_instance_init,
+    .class_init = m5_lepton_class_init,
+};
+
+static void m5_lepton_register(void)
+{
+    type_register_static(&m5_lepton_info);
+}
+type_init(m5_lepton_register)
+
+void m5_lepton_attach_spi(DeviceState *dev, DeviceState *spi)
+{
+    esp32_spi_attach_spi_slave(spi, &lepton_spi_ops, M5_LEPTON(dev),
+                               M5_LEPTON(dev)->cs_pin);
+}
diff --git a/hw/m5stopwatch/m5stickt2.c b/hw/m5stopwatch/m5stickt2.c
new file mode 100644
index 0000000..265feaf
--- /dev/null
+++ b/hw/m5stopwatch/m5stickt2.c
@@ -0,0 +1,96 @@
+/*
+ * M5StickT2 (K016-T2) board wiring.
+ *
+ * ESP32-PICO-D4, 4 MiB flash, no PSRAM; 1.14" 240x135 ST7789 IPS on
+ * VSPI/SPI3 (MOSI G15, SCK G13, CS G5, DC G23, RST G18); AXP192 (0x34),
+ * PCF8563 (0x51) and MPU6886 (0x68) on the G21/G22 I2C bus; two GPIO
+ * buttons G37/G39; SPM1423 PDM microphone on G0 (CLK) / G34 (DATA); Grove
+ * port G32/G33.
+ *
+ * Thermal camera: FLIR Lepton 3.0 (160x120, 25 MHz input clock) whose CCI
+ * control interface is I2C address 0x2A on the same G21/G22 bus and whose
+ * VoSPI video stream is read from HSPI/SPI2 (SCK G2, MISO G25, MOSI G34 is
+ * not used for VoSPI) with CS on G0, VSYNC on G38 and RESET on G26.  The
+ * official M5-StickT example uses this exact wiring
+ * (examples/M5StickT_Lepton_opensource_v1/M5StickT_Lepton_opensource_v1.ino
+ * and src/utility/In_eSPI_Setup.h pin defines).
+ *
+ * The onboard "rotary encoder" listed by some product pages does not appear
+ * in the official example; the example talks to an external encoder at I2C
+ * 0x30 on the same G21/G22 bus (ENCODER_ADDR, registers 0x00/0x10/0x20).
+ * The model follows the example and keeps the encoder QOM-injectable.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "hw/xtensa/esp32.h"
+#include "hw/qdev-properties.h"
+#include "qapi/error.h"
+#include "m5stopwatch.h"
+
+void m5stickt2_board_init(Esp32SocState *s)
+{
+    I2CBus *bus = (I2CBus *)qdev_get_child_bus(DEVICE(&s->i2c[0]), "i2c");
+    static const struct {
+        const char *model;
+        uint8_t address;
+    } devices[] = {
+        { "axp192", 0x34 },
+        { "pcf8563", 0x51 },
+        { "mpu6886", 0x68 },
+        { "lepton", 0x2a },
+        { "encoder", 0x30 },
+    };
+
+    /* Both controller blocks may be routed to the GPIO21/22 board bus. */
+    esp32_i2c_set_bus(DEVICE(&s->i2c[0]), bus);
+    esp32_i2c_set_bus(DEVICE(&s->i2c[1]), bus);
+    for (unsigned i = 0; i < ARRAY_SIZE(devices); i++) {
+        DeviceState *dev = qdev_new(TYPE_M5SW_I2C_DEV);
+
+        qdev_prop_set_string(dev, "model", devices[i].model);
+        qdev_prop_set_uint8(dev, "address", devices[i].address);
+        object_property_add_child(qdev_get_machine(),
+                                  strcmp(devices[i].model, "lepton") == 0
+                                      ? "lepton-cci" : devices[i].model,
+                                  OBJECT(dev));
+        qdev_realize_and_unref(dev, (BusState *)bus, &error_fatal);
+    }
+    m5stopwatch_soft_i2c_init_pins(bus, 21, 22);
+
+    /* Buttons A/B are active-low with external pull-ups. */
+    esp32_gpio_set_input(37, 1);
+    esp32_gpio_set_input(39, 1);
+
+    DeviceState *panel = qdev_new(TYPE_M5_SPI_PANEL);
+
+    qdev_prop_set_uint32(panel, "mem-width", 240);
+    qdev_prop_set_uint32(panel, "mem-height", 320);
+    qdev_prop_set_uint32(panel, "vis-width", 135);
+    qdev_prop_set_uint32(panel, "vis-height", 240);
+    qdev_prop_set_uint32(panel, "offset-x", 52);
+    qdev_prop_set_uint32(panel, "offset-y", 40);
+    qdev_prop_set_uint32(panel, "read-id", 0x00000085);
+    qdev_prop_set_uint32(panel, "key-a-pin", 37);
+    qdev_prop_set_uint32(panel, "key-b-pin", 39);
+    qdev_prop_set_bit(panel, "immediate-update", true);
+    qdev_prop_set_bit(panel, "invert", true);
+    object_property_add_child(qdev_get_machine(), "m5-panel", OBJECT(panel));
+    qdev_realize_and_unref(panel, NULL, &error_fatal);
+
+    /* ST7789 135x240 on VSPI/SPI3, MOSI G15 / SCK G13 / CS G5 / DC G23. */
+    esp32_spi_attach_m5_panel(DEVICE(&s->spi[3]), panel, 23);
+
+    /* FLIR Lepton 3.0 VoSPI on HSPI/SPI2, CS G0, VSYNC G38, RESET G26. */
+    DeviceState *lepton = qdev_new(TYPE_M5_LEPTON);
+    qdev_prop_set_uint32(lepton, "cs-pin", 0);
+    qdev_prop_set_uint32(lepton, "vsync-pin", 38);
+    qdev_prop_set_uint32(lepton, "reset-pin", 26);
+    object_property_add_child(qdev_get_machine(), "lepton", OBJECT(lepton));
+    qdev_realize_and_unref(lepton, NULL, &error_fatal);
+    m5_lepton_attach_spi(lepton, DEVICE(&s->spi[2]));
+
+    m5_unit_runtime_init(false);
+    m5_unit_classic_adc_init(get_system_memory());
+}
