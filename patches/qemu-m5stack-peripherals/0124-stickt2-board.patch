+static uint16_t lepton_reg_get(M5swI2CDev *s, uint16_t addr)
+{
+    if (!s->lepton_regs || addr >= LEPTON_CCI_WORDS * 2) {
+        return 0;
+    }
+    return s->lepton_regs[addr >> 1];
+}
+
+static void lepton_reg_set(M5swI2CDev *s, uint16_t addr, uint16_t value)
+{
+    if (s->lepton_regs && addr < LEPTON_CCI_WORDS * 2) {
+        s->lepton_regs[addr >> 1] = value;
+    }
+}
