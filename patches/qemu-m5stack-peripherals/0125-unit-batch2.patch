+static void dac_voltage_get(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    /* Driver default vdd=5.0 V (the product page only states 0..3.3 V output;
