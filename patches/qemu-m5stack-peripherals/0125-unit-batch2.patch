+static void u64_get(Object *obj, Visitor *v, const char *name, void *opaque,
+                    Error **errp)
+{
+    uint64_t value = *(uint64_t *)opaque;
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static void dac_raw_get(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    double value = s->dac_raw;
+    visit_type_number(v, name, &value, errp);
+}
+
+static void dac_raw_set(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    double value;
+    if (!visit_type_number(v, name, &value, errp)) { return; }
+    if (!isfinite(value) || value < 0 || value > 4095 || trunc(value) != value) {
+        error_setg(errp, "dac-raw requires an integer in [0,4095]");
+        return;
+    }
+    if (s->dac_raw != (uint16_t)value) { input_changed(s); }
+    s->dac_raw = (uint16_t)value;
