+static void watering_output_changed(void *opaque, int pin, int level)
+{
+    GPIOUnit *g = opaque;
+    if (pin != g->unit->yellow) { return; }
+    level = !!level;
+    if (g->pump_level != level) {
+        g->pump_level = level;
+        g->pump_transitions++;
+        g->unit->output_transitions++;
+    }
+}
+
+static void watering_output_reset(void *opaque, int pin, int level)
+{
+    GPIOUnit *g = opaque;
+    (void)level;
+    if (pin != g->unit->yellow) { return; }
+    g->pump_level = esp32_gpio_get_line(g->unit->yellow);
+    g->pump_transitions = 0;
+}
+
+static void pump_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool value = g->pump_level;
+    visit_type_bool(v, name, &value, errp);
+}
+
