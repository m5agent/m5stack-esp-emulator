 hw/m5stopwatch/m5_unit_i2c_controls.c | 106 +++++++++++-
 hw/m5stopwatch/m5_unit_i2c_sensors.c  | 226 +++++++++++++++++++++++++-
 3 files changed, 390 insertions(+), 6 deletions(-)

