+static void sensor_u64_get(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    uint64_t value = *(uint64_t *)opaque;
+    visit_type_uint64(v, name, &value, errp);
+}
+
+static void sensor_i64_get(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    int64_t value = *(int64_t *)opaque;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static unsigned ads_config_rate(uint8_t config)
+{
+    switch (config & 0x0c) {
+    case 0x0c: return 16;  /* 15 SPS */
+    case 0x08: return 15;  /* 30 SPS */
+    case 0x04: return 14;  /* 60 SPS */
+    default:   return 12;  /* 240 SPS */
+    }
+}
+
+static unsigned ads_config_gain(uint8_t config)
+{
+    return 1u << (config & 0x03);
+}
+
+static int16_t ads1110_raw(M5UnitSensor *s)
+{
+    /* Official driver: voltage = raw * 2.048 / 2**(mini_code-1) / gain / (100/610).
+     * Invert it so the guest's own conversion reproduces the fixture voltage. */
+    double raw = s->values[0] / 1000.0 * (1u << (ads_config_rate(s->command) - 1))
+                 * ads_config_gain(s->command) * (100.0 / 610.0) / 2.048;
+    long value = lround(raw);
+    if (value < -32768) { value = -32768; }
+    if (value > 32767) { value = 32767; }
+    return (int16_t)value;
+}
+
+static void add_i64(M5UnitSensor *s, const char *name, int64_t *value)
+{
+    object_property_add(OBJECT(s->unit), name, "int", sensor_i64_get, NULL, NULL, value);
+}
+
+static void add_u64(M5UnitSensor *s, const char *name, uint64_t *value)
+{
+    object_property_add(OBJECT(s->unit), name, "uint64", sensor_u64_get, NULL, NULL, value);
+}
+
+static void ads_raw_get(Object *obj, Visitor *v, const char *name,
+                        void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value = ads1110_raw(s);
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void ads_config_get(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value = s->command;
+    visit_type_int64(v, name, &value, errp);
+}
+
+/* Fixed synthetic-but-valid BMP280 calibration coefficients (the datasheet
+ * example set); they are NOT a real device calibration. Compensation formulas
+ * are taken verbatim from the executable driver so guest and model share the
+ * same integer math. */
+static const int32_t bmp_t1 = 27504, bmp_t2 = 26435, bmp_t3 = -1000;
+static const int32_t bmp_p1 = 36477, bmp_p2 = -10685, bmp_p3 = 3024;
+static const int32_t bmp_p4 = 2855, bmp_p5 = 140, bmp_p6 = -7;
+static const int32_t bmp_p7 = 15500, bmp_p8 = -14600, bmp_p9 = 6000;
+
+static int64_t py_floordiv(int64_t a, int64_t b)
+{
+    int64_t q = a / b;
+    if ((a % b) && ((a < 0) != (b < 0))) { q--; }
+    return q;
+}
+
+static int64_t bmp_t_fine(int32_t t_raw)
+{
+    int64_t var1 = (((t_raw >> 3) - (bmp_t1 << 1)) * (int64_t)bmp_t2) >> 11;
+    int64_t d = (int64_t)(t_raw >> 4) - bmp_t1;
+    int64_t var2 = (((d * d) >> 12) * (int64_t)bmp_t3) >> 14;
+    return var1 + var2;
+}
+
+static int32_t bmp_temperature_raw(double temperature_c)
+{
+    int32_t lo = 0, hi = 1048575;
+    while (lo < hi) {
+        int32_t mid = lo + (hi - lo) / 2;
+        double value = ((bmp_t_fine(mid) * 5 + 128) >> 8) / 100.0;
+        if (value < temperature_c) { lo = mid + 1; } else { hi = mid; }
+    }
+    return lo;
+}
+
+static double bmp_pressure_value(int32_t p_raw, int64_t t_fine)
+{
+    int64_t var1 = t_fine - 128000;
+    int64_t var2 = var1 * var1 * bmp_p6;
+    var2 += (var1 * bmp_p5) << 17;
+    var2 += (int64_t)bmp_p4 << 35;
+    var1 = ((var1 * var1 * bmp_p3) >> 8) + ((var1 * bmp_p2) << 12);
+    var1 = ((((int64_t)1 << 47) + var1) * bmp_p1) >> 33;
+    if (var1 == 0) { return 0; }
+    int64_t p = 1048576 - p_raw;
+    p = py_floordiv(((p << 31) - var2) * 3125, var1);
+    int64_t v1 = ((int64_t)bmp_p9 * (p >> 13) * (p >> 13)) >> 25;
+    int64_t v2 = ((int64_t)bmp_p8 * p) >> 19;
+    p = ((p + v1 + v2) >> 8) + ((int64_t)bmp_p7 << 4);
+    return p / 256.0;
+}
+
+static int32_t bmp_pressure_raw(double pressure_pa, int64_t t_fine)
+{
+    int32_t lo = 0, hi = 1048575;
+    while (lo < hi) {
