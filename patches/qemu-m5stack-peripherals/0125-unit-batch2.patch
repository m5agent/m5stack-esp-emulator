+
+static uint8_t dac_read_byte(M5UnitControl *s, unsigned pos)
+{
+    /* Fixed status byte with bit7 (EEPROM ready) set: enough for the driver's
+     * polling loop; the other POR/status bits are not modeled. */
+    if (pos == 0) { return 0x80; }
+    if (pos == 1) { return (s->dac_raw >> 4) & 0xff; }
+    return (s->dac_raw & 0x0f) << 4;
+}
+
 static void snapshot_registers(M5UnitControl *s)
 {
     memcpy(s->read_snapshot, s->regs, 256);
@@ -1244,6 +1311,28 @@ static int control_send(I2CSlave *dev, uint8_t value)
         }
         return 0;
     }
+    if (s->kind == CONTROL_DAC) {
+        unsigned pos = s->write_pos++;
+        if (pos == 0) {
+            s->dac_write_eeprom = (value & 0xf0) == 0x60;
+            if ((value & 0xf0) != 0x00 && !s->dac_write_eeprom) { return 1; }
+            s->dac_write_tmp = (value & 0x0f) << 8;
+            return 0;
+        }
+        if (pos == 1) {
+            s->dac_write_byte1 = value;
+            if (!s->dac_write_eeprom) { s->dac_raw = s->dac_write_tmp | value; }
+            return 0;
+        }
+        if (pos == 2 && s->dac_write_eeprom) {
+            uint16_t value12 = ((s->dac_write_byte1 << 4) | (value >> 4)) & 0x0fff;
+            s->dac_raw = value12;
+            s->dac_eeprom = value12;
+            s->dac_eeprom_writes++;
+            return 0;
+        }
+        return 1;
+    }
     if (s->write_pos++ == 0) {
         s->pointer = s->write_base = value; s->memory_request = true;
         memset(s->led_write, 0, sizeof(s->led_write)); return 0;
