+    s->regs[0][0x9e] = (uint16_t)bmp_p9; s->regs[0][0x9f] = (uint16_t)bmp_p9 >> 8;
+    s->regs[0][0xd0] = 0x58;  /* BMP280 chip id */
+    s->bmp_refreshed = false;
+}
