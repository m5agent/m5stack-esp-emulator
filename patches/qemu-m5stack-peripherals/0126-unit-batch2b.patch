+
+/* U001 ENV-I DHT12 half: 5-byte frame decoded by driver/dht12.py as
+ * humidity=b0+b1*0.1, temperature=b2+(b3&0x7f)*0.1 with sign in b2 bit7 and
+ * checksum=(b0+b1+b2+b3)&0xff. Values are quantized to the driver's 0.1 units. */
+static void dht12_frame(M5UnitSensor *s, uint8_t out[5])
+{
+    double humidity = s->values[1], temperature = s->values[0];
+    int humidity_int, humidity_dec, temperature_int, temperature_dec;
+
+    humidity = CLAMP(humidity, 0.0, 100.0);
+    humidity_int = (int)floor(humidity);
+    humidity_dec = (int)lround((humidity - humidity_int) * 10.0);
+    if (humidity_dec > 9) { humidity_dec = 9; }
+
+    temperature = CLAMP(temperature, -40.0, 120.0);
+    bool negative = temperature < 0;
+    double magnitude = fabs(temperature);
+    temperature_int = (int)floor(magnitude);
+    temperature_dec = (int)lround((magnitude - temperature_int) * 10.0);
+    if (temperature_dec > 9) { temperature_dec = 9; }
+    if (temperature_int > 127) { temperature_int = 127; }
+
+    out[0] = humidity_int;
+    out[1] = humidity_dec;
+    out[2] = temperature_int | (negative ? 0x80 : 0);
+    out[3] = temperature_dec;
+    out[4] = (out[0] + out[1] + out[2] + out[3]) & 0xff;
+}
+
+/* U086 AMeter ADS1115 half. Driver formula:
+ * current = resolution(gain) * calibration_factor * conversion * -1 with
+ * resolution = mV-per-LSB(gain) / 0.05 and factor 1.0 from the synthetic EEPROM
+ * record. The conversion count is inverse-derived from the current-a fixture so
+ * the guest's own math reproduces it. */
+static int16_t ameter_raw(M5UnitSensor *s)
+{
+    static const double mv_lsb[6] = { 0.1875, 0.125, 0.0625, 0.03125, 0.015625, 0.007813 };
+    unsigned gain = ((unsigned)s->command >> 9) & 7;
+    double resolution;
+    long raw;
+
+    if (gain > 5) { gain = 5; }
+    resolution = mv_lsb[gain] / 0.05;
+    raw = lround(-s->values[0] / resolution);
+    if (raw < -32768) { raw = -32768; }
+    if (raw > 32767) { raw = 32767; }
+    return (int16_t)raw;
+}
+
+static void ameter_raw_get(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value = ameter_raw(s);
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void ameter_config_get(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    /* OS bit reads 1 = conversion complete; the model has no conversion timer. */
+    int64_t value = (int64_t)((uint16_t)s->command | 0x8000);
+    visit_type_int64(v, name, &value, errp);
+}
+
+/* Synthetic factory calibration record: gain byte + expect/real big-endian
+ * pairs + XOR of the first five bytes. expect==real keeps factor 1.0; this is
+ * NOT a real factory calibration. */
+static void ameter_fill_eeprom(M5UnitSensor *s)
+{
+    for (unsigned gain = 0; gain < 6; gain++) {
+        uint8_t *r = s->regs[0] + 208 + gain * 16;
+        r[0] = gain;
+        r[1] = 0x03; r[2] = 0xe8;   /* expect = 1000 */
+        r[3] = 0x03; r[4] = 0xe8;   /* real   = 1000 */
+        r[5] = r[0] ^ r[1] ^ r[2] ^ r[3] ^ r[4];
+    }
