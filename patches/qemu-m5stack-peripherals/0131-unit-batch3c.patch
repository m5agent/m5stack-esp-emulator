+        object_property_add(o, "echo-level", "bool", bool_get, NULL, NULL, g);
     }
     if (!strcmp(id, "rgb") || !strcmp(id, "key")) {
         g->leds = unit->onboard_led_count ? unit->onboard_led_count :
diff --git a/hw/m5stopwatch/m5_unit_i2c_controls.c b/hw/m5stopwatch/m5_unit_i2c_controls.c
index fad82b3..e9c2205 100644
--- a/hw/m5stopwatch/m5_unit_i2c_controls.c
+++ b/hw/m5stopwatch/m5_unit_i2c_controls.c
@@ -38,7 +38,7 @@ typedef enum {
     CONTROL_JOYSTICK2, CONTROL_SERVO8, CONTROL_SERVO8_HAT,
     CONTROL_RELAY4, CONTROL_WEIGHT,
     CONTROL_NCIR2, CONTROL_EXTIO2, CONTROL_HBRIDGE,
-    CONTROL_DAC, CONTROL_EXTENCODER, CONTROL_ACSSR,
+    CONTROL_DAC, CONTROL_EXTENCODER, CONTROL_ACSSR, CONTROL_PBHUB,
 } ControlKind;
 
 typedef struct M5UnitControl {
@@ -126,6 +126,21 @@ typedef struct M5UnitControl {
     uint64_t acssr_transitions;
     int64_t acssr_led_rgb;
     int64_t acssr_fw;
+    /* U041 PbHub (0x61): six channels live in one 256-byte command space, not
+     * on separate bus addresses. The official driver always talks to 0x61 and
+     * passes channel_base|offset as the register byte; bases are
+     * 0x40/0x50/0x60/0x70/0x80/0xA0 and offsets 0x00..0x0B. RGB wire bytes are
+     * GRB because the task anchors the master driver's color_grb conversion;
+     * the snapshot's big-endian order stays UNRESOLVED. */
+    bool pb_digital_in[6], pb_digital_out[6];
+    uint16_t pb_analog_in[6];
+    uint8_t pb_pwm_out[6];
+    uint16_t pb_rgb_num[6];
+    uint8_t pb_rgb_color[6][3];   /* wire GRB */
+    uint8_t pb_rgb_brightness[6];
+    uint8_t pb_rgb_mode, pb_fw;
+    uint8_t pb_write_buf[8];
+    uint64_t pb_writes;
 } M5UnitControl;
 OBJECT_DECLARE_SIMPLE_TYPE(M5UnitControl, M5_UNIT_CONTROL)
 
@@ -773,6 +788,112 @@ out:
     qobject_unref(value);
 }
 
+static const uint8_t pbhub_bases[6] = {0x40, 0x50, 0x60, 0x70, 0x80, 0xA0};
+
+static int pbhub_channel(uint8_t reg, uint8_t *offset)
+{
+    for (unsigned i = 0; i < 6; i++) {
+        if (reg >= pbhub_bases[i] && reg <= pbhub_bases[i] + 0x0b) {
+            *offset = reg - pbhub_bases[i];
+            return (int)i;
+        }
+    }
+    return -1;
+}
+
+static QList *pbhub_bool_list(const bool values[6])
+{
+    QList *list = qlist_new();
+    for (unsigned i = 0; i < 6; i++) { qlist_append_bool(list, values[i]); }
+    return list;
+}
+
+static QList *pbhub_int_list(const int64_t values[6])
+{
+    QList *list = qlist_new();
+    for (unsigned i = 0; i < 6; i++) { qlist_append_int(list, values[i]); }
+    return list;
+}
+
+static void pbhub_any_get(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    QList *list;
+    if (!strcmp(name, "digital-inputs")) {
+        list = pbhub_bool_list(s->pb_digital_in);
+    } else if (!strcmp(name, "digital-outputs")) {
+        list = pbhub_bool_list(s->pb_digital_out);
+    } else if (!strcmp(name, "analog-inputs")) {
+        int64_t values[6];
+        for (unsigned i = 0; i < 6; i++) { values[i] = s->pb_analog_in[i]; }
+        list = pbhub_int_list(values);
+    } else if (!strcmp(name, "pwm-outputs")) {
+        int64_t values[6];
+        for (unsigned i = 0; i < 6; i++) { values[i] = s->pb_pwm_out[i]; }
+        list = pbhub_int_list(values);
+    } else {  /* rgb-frames: last committed RGB per channel */
+        int64_t values[6];
+        for (unsigned i = 0; i < 6; i++) {
+            const uint8_t *g = s->pb_rgb_color[i];
+            values[i] = ((int64_t)g[1] << 16) | ((int64_t)g[0] << 8) | g[2];
+        }
+        list = pbhub_int_list(values);
+    }
+    QObject *value = QOBJECT(list);
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
+}
+
+static void pbhub_any_set(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    QObject *value = NULL;
+    if (!visit_type_any(v, name, &value, errp)) { return; }
+    QList *list = qobject_to(QList, value);
+    if (!list || qlist_size(list) != 6) {
+        error_setg(errp, "%s requires exactly 6 items", name);
+        qobject_unref(value);
+        return;
+    }
+    const QListEntry *entry;
+    unsigned i = 0;
+    bool bool_values[6];
+    int64_t int_values[6];
+    QLIST_FOREACH_ENTRY(list, entry) {
+        QObject *item = qlist_entry_obj(entry);
+        if (!strcmp(name, "digital-inputs")) {
+            QBool *b = qobject_to(QBool, item);
+            if (!b) { error_setg(errp, "digital-inputs items must be bool"); goto out; }
+            bool_values[i] = qbool_get_bool(b);
+        } else {
+            QNum *n = qobject_to(QNum, item);
+            if (!n || !qnum_get_try_int(n, &int_values[i]) ||
+                int_values[i] < 0 || int_values[i] > 1023) {
+                error_setg(errp, "analog-inputs items must be int 0..1023"); goto out;
+            }
+        }
+        i++;
+    }
+    if (!strcmp(name, "digital-inputs")) {
+        memcpy(s->pb_digital_in, bool_values, sizeof(s->pb_digital_in));
+    } else {
+        for (i = 0; i < 6; i++) { s->pb_analog_in[i] = (uint16_t)int_values[i]; }
+    }
+    input_changed(s);
+out:
+    qobject_unref(value);
+}
+
+static void pbhub_scalar_get(Object *obj, Visitor *v, const char *name,
+                             void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = !strcmp(name, "rgb-mode") ? s->pb_rgb_mode : s->pb_fw;
+    visit_type_int64(v, name, &value, errp);
+}
+
 static void string_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
 {
     M5UnitControl *s = opaque;
@@ -1285,6 +1406,31 @@ static void snapshot_registers(M5UnitControl *s)
         s->read_snapshot[0x00] = s->acssr_relay_raw;
         s->read_snapshot[0xfe] = s->acssr_fw;
         s->read_snapshot[0xff] = I2C_SLAVE(s)->address;
+    } else if (s->kind == CONTROL_PBHUB) {
+        uint8_t cmd_offset = 0;
+        int channel = pbhub_channel(s->pointer, &cmd_offset);
+        if (channel >= 0) {
+            unsigned index = (unsigned)channel;
+            if (cmd_offset == 0x04) {
+                s->read_snapshot[s->pointer] = s->pb_digital_in[index] ? 1 : 0;
+            } else if (cmd_offset == 0x05) {
+                s->read_snapshot[s->pointer] = s->pb_digital_in[index] ? 1 : 0;
+            } else if (cmd_offset == 0x06) {
+                s->read_snapshot[s->pointer] = s->pb_analog_in[index] & 0xff;
+                s->read_snapshot[s->pointer + 1] = s->pb_analog_in[index] >> 8;
+            } else if (cmd_offset == 0x08) {
+                s->read_snapshot[s->pointer] = s->pb_rgb_num[index] & 0xff;
+                s->read_snapshot[s->pointer + 1] = s->pb_rgb_num[index] >> 8;
+            } else if (cmd_offset == 0x0b) {
+                s->read_snapshot[s->pointer] = s->pb_rgb_brightness[index];
+            }
+        } else if (s->pointer == 0xfa) {
+            s->read_snapshot[0xfa] = s->pb_rgb_mode;
+        } else if (s->pointer == 0xfe) {
+            s->read_snapshot[0xfe] = s->pb_fw;
+        } else if (s->pointer == 0xff) {
+            s->read_snapshot[0xff] = I2C_SLAVE(s)->address;
+        }
     }
 }
 
@@ -1378,7 +1524,63 @@ static int control_send(I2CSlave *dev, uint8_t value)
         memset(s->led_write, 0, sizeof(s->led_write)); return 0;
     }
     uint8_t reg = s->pointer;
-    if (s->kind == CONTROL_EXTENCODER) {
+    if (s->kind == CONTROL_PBHUB) {
+        unsigned offset = s->write_pos - 2;  /* write_pos was incremented for this byte */
+        uint8_t cmd_offset = 0;
+        int channel = pbhub_channel(s->write_base, &cmd_offset);
+        if (channel >= 0) {
+            unsigned index = (unsigned)channel;
+            if (cmd_offset == 0x00 || cmd_offset == 0x01) {
+                if (offset) { return 1; }
+                s->pb_digital_out[index] = value != 0;
+            } else if (cmd_offset == 0x02 || cmd_offset == 0x03) {
+                if (offset) { return 1; }
+                s->pb_pwm_out[index] = value;
+            } else if (cmd_offset == 0x08) {
+                if (offset > 1) { return 1; }
+                s->pb_rgb_num[index] = offset == 0 ? value : (s->pb_rgb_num[index] & 0x00ff) | (value << 8);
+            } else if (cmd_offset == 0x09) {
+                if (offset < 5) { s->pb_write_buf[offset] = value; return 0; }
+                if (offset > 5) { return 1; }
+                uint16_t pos = s->pb_write_buf[0] | (s->pb_write_buf[1] << 8);
+                if (pos < 75) {
+                    s->pb_rgb_color[index][0] = s->pb_write_buf[3];  /* G */
+                    s->pb_rgb_color[index][1] = s->pb_write_buf[2];  /* R */
+                    s->pb_rgb_color[index][2] = s->pb_write_buf[4];  /* B */
+                }
+            } else if (cmd_offset == 0x0a) {
+                if (offset < 7) { s->pb_write_buf[offset] = value; return 0; }
+                if (offset > 7) { return 1; }
+                uint16_t begin = s->pb_write_buf[0] | (s->pb_write_buf[1] << 8);
+                uint16_t count = s->pb_write_buf[2] | (s->pb_write_buf[3] << 8);
+                for (unsigned n = 0; n < count && begin + n < 75; n++) {
+                    s->pb_rgb_color[index][0] = s->pb_write_buf[5];  /* G */
+                    s->pb_rgb_color[index][1] = s->pb_write_buf[4];  /* R */
+                    s->pb_rgb_color[index][2] = s->pb_write_buf[6];  /* B */
+                }
+            } else if (cmd_offset == 0x0b) {
+                if (offset) { return 1; }
+                s->pb_rgb_brightness[index] = value;
+            } else {
+                return 1;  /* reads-only channel commands reject writes */
+            }
+        } else if (s->write_base == 0xfa) {
+            if (offset) { return 1; }
+            s->pb_rgb_mode = value;
+        } else if (s->write_base == 0xff) {
+            BusChild *child;
+            if (offset || value < 0x61 || value > 0x68) { return 1; }
+            QTAILQ_FOREACH(child, &BUS(s->unit->bus)->children, sibling) {
+                I2CSlave *other = I2C_SLAVE(child->child);
+                if (other != dev && other->address == value) { return 1; }
+            }
+            i2c_slave_set_address(dev, value);
+        } else {
+            return 1;
+        }
+        s->pb_writes++;
+        s->pointer++;
+    } else if (s->kind == CONTROL_EXTENCODER) {
         unsigned offset = s->write_pos - 2;  /* write_pos was already incremented for this byte */
         uint8_t base = s->write_base;
         if (base == 0x30) {
@@ -1719,7 +1921,7 @@ bool m5_unit_controls_supported(const char *unit_id)
         "joystick-v11", "encoder", "8encoder", "cardkb", "rfid2", "scroll",
         "joystick2", "8servos", "servo8-hat", "4relay", "weight-i2c",
         "ncir2", "extio2", "hbridge", "dac", "joystick",
-        "extencoder", "acssr",
+        "extencoder", "acssr", "pbhub",
     };
     for (unsigned i = 0; i < G_N_ELEMENTS(ids); i++) { if (!strcmp(unit_id, ids[i])) { return true; } }
     return false;
@@ -1822,6 +2024,31 @@ void m5_unit_controls_realize(M5Unit *unit, Error **errp)
         object_property_add(OBJECT(s->unit), "led-rgb", "int",
                             acssr_led_rgb_get, NULL, NULL, s);
         add_control_int_fixture(s, "fw-version", &s->acssr_fw, 0, 255, true);
+    } else if (!strcmp(unit->unit_id, "pbhub")) {
+        s->kind = CONTROL_PBHUB; address = 0x61;
+        s->pb_fw = 1;  /* synthetic firmware fixture */
+        for (unsigned i = 0; i < 6; i++) {
+            s->pb_digital_in[i] = false;
+            s->pb_digital_out[i] = false;
+            s->pb_analog_in[i] = 0;
+            s->pb_pwm_out[i] = 0;
+            s->pb_rgb_num[i] = 0;
+            s->pb_rgb_brightness[i] = 0;
+        }
