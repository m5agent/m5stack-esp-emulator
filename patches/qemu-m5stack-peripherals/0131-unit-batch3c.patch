+static void ultra_echo_end(void *opaque)
+{
+    GPIOUnit *g = opaque;
+    esp32_gpio_set_input(g->unit->white, 0);
+    g->ultra_echo_high = false;
+}
+
+static void ultra_pad_event(void *opaque, const Esp32GpioPadEvent *event)
+{
+    GPIOUnit *g = opaque;
+    const Esp32GpioPadSnapshot *before = &event->before, *after = &event->after;
+    if (after->pin != (unsigned)g->unit->yellow || after->s3 != g->unit->s3) {
+        return;
+    }
+    if (!before->known || !after->known || before->conflict || after->conflict ||
+        before->controller_generation != after->controller_generation) {
+        return;
+    }
+    if (before->level == after->level) { return; }
+    if (after->level) {
+        g->ultra_triggers++;
+        return;
+    }
+    /* The guest finishes its 10us trigger pulse with a high->low edge; start the
+     * echo high now and schedule the falling edge after the round-trip width. */
+    if (g->ultra_distance_mm >= 20 && g->ultra_distance_mm <= 4500) {
+        int pulse_us = g->ultra_distance_mm * 582 / 100;
+        g->ultra_pulse_us = pulse_us;
+        esp32_gpio_set_input(g->unit->white, 1);
+        g->ultra_echo_high = true;
+        timer_mod_ns(g->ultra_timer,
+                     qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + (int64_t)pulse_us * 1000);
+    } else {
+        g->ultra_timeouts++;
+    }
+}
+
+static void ultra_pulse_get(Object *o, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    GPIOUnit *g = opaque;
+    int64_t value = g->ultra_distance_mm >= 20 && g->ultra_distance_mm <= 4500
+        ? g->ultra_distance_mm * 582 / 100 : 0;
+    visit_type_int64(v, name, &value, errp);
+}
