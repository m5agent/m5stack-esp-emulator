+/* U001-D SHT4x: the driver writes one command byte and then reads a 6-byte
+ * frame whose two 2-byte words are each followed by a CRC8. SHT4x measure
+ * commands are 0xFD/0xF6/0xE0 (no heater) and the heated variants; 0x89 reads
+ * the 32-bit serial and 0x94 is a soft reset. The snapshot driver getters are
+ * broken, so the model returns the datasheet/driver frame layout and the host
+ * must pin the fixed master driver SHA. */
+static bool sht4x_measure_command(uint8_t cmd)
+{
+    switch (cmd) {
+    case 0xfd: case 0xf6: case 0xe0:
+    case 0x39: case 0x32: case 0x2f: case 0x24: case 0x1e: case 0x15:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void sht4x_build_response(M5UnitSensor *s)
+{
+    s->response_len = 0;
+    if (sht4x_measure_command(s->sht4x_cmd)) {
+        double humidity = CLAMP(s->values[1], 0.0, 100.0);
+        double temperature = CLAMP(s->values[0], -40.0, 125.0);
+        uint16_t t_raw = (uint16_t)CLAMP(lround((temperature + 45.0) / 175.0 * 65535.0), 0, 65535);
+        uint16_t rh_raw = (uint16_t)CLAMP(lround((humidity + 6.0) / 125.0 * 65535.0), 0, 65535);
+        response_word(s, 0, t_raw);
+        response_word(s, 1, rh_raw);
+        s->samples++;
+    } else if (s->sht4x_cmd == 0x89) {
+        response_word(s, 0, (uint16_t)((uint64_t)s->sht4x_serial >> 16));
+        response_word(s, 1, (uint16_t)s->sht4x_serial);
+    }
+}
+
+/* U103 SCD4x: 2-byte commands, response words with CRC8, and set-arg commands
+ * that append a 2-byte value + CRC to the command write. */
+static bool scd40_arg_command(uint16_t cmd)
+{
+    return cmd == 0x241d || cmd == 0x2427 || cmd == 0xe000 ||
+           cmd == 0x362f || cmd == 0x2416;
+}
+
+static void scd40_apply_command(M5UnitSensor *s)
+{
+    switch (s->command) {
+    case 0x21b1: case 0x21ac:  /* start periodic / low-power periodic */
+        s->scd40_periodic = true;
+        s->scd40_data_ready = true;
+        break;
+    case 0x3f86:              /* stop periodic */
+        s->scd40_periodic = false;
+        s->scd40_data_ready = false;
+        break;
+    case 0x3646: case 0x3632: /* reinit / factory reset -> idle */
+        s->scd40_periodic = false;
+        s->scd40_data_ready = false;
+        s->scd40_temp_offset = 0;
+        s->scd40_altitude = 0;
+        break;
+    case 0x219d: case 0x2196: /* single-shot measurement */
+        s->scd40_data_ready = true;
+        break;
+    default:
+        break;
+    }
+}
+
+static bool scd40_response_command(uint16_t cmd)
+{
+    switch (cmd) {
+    case 0xe4b8: case 0xec05: case 0x2318: case 0x2322:
+    case 0x3682: case 0x3639: case 0x2313:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void scd40_build_response(M5UnitSensor *s)
+{
+    s->response_len = 0;
+    if (!scd40_response_command(s->command)) { return; }
+    switch (s->command) {
+    case 0xe4b8:  /* data ready: low 11 bits non-zero when ready */
+        response_word(s, 0, s->scd40_data_ready ? 0x0001 : 0x0000);
+        break;
+    case 0xec05: {  /* measurement: CO2, temperature raw, humidity raw */
+        double humidity = CLAMP(s->values[2], 0.0, 100.0);
+        double temperature = CLAMP(s->values[1], -10.0, 60.0);
+        uint16_t t_raw = (uint16_t)CLAMP(lround((temperature + 45.0) / 175.0 * 65535.0), 0, 65535);
+        uint16_t rh_raw = (uint16_t)CLAMP(lround(humidity / 100.0 * 65535.0), 0, 65535);
+        response_word(s, 0, (uint16_t)CLAMP(s->values[0], 0, 65535));
+        response_word(s, 1, t_raw);
+        response_word(s, 2, rh_raw);
+        s->scd40_reads++;
+        s->samples++;
+        break;
+    }
+    case 0x2318: response_word(s, 0, (uint16_t)CLAMP(s->scd40_temp_offset, 0, 65535)); break;
+    case 0x2322: response_word(s, 0, (uint16_t)CLAMP(s->scd40_altitude, 0, 65535)); break;
+    case 0x3682:
+        response_word(s, 0, (uint16_t)((uint64_t)s->scd40_serial >> 16));
+        response_word(s, 1, (uint16_t)s->scd40_serial);
+        break;
+    case 0x3639: response_word(s, 0, 0x0000); break;
+    case 0x2313: response_word(s, 0, 0x0000); break;
+    default: break;
+    }
+}
