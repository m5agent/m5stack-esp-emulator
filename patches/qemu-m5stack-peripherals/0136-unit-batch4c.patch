+/* U105 DDS (AD9833) register readback for the currently selected words. */
+static void dds_snapshot(M5UnitControl *s)
+{
+    uint8_t *r = s->read_snapshot;
+    memset(r, 0, 256);
+    r[0x20] = 0x80 | (uint8_t)(s->dds_mode & 0x0f);
+    r[0x21] = (uint8_t)s->dds_ctrl;
