+/* ---- U030 Weight (HX711 bit-pulse) ---- */
+static bool gpio_uart_rx_device_for_white(GPIOUnit *g, DeviceState **uart_out)
+{
+    for (unsigned n = 0; n < 3; n++) {
+        if (esp32_gpio_matrix_in_pin(uart_signal[n], true) == g->unit->white) {
+            DeviceState *uart = m5soc_get_uart_device(n);
+            if (uart) { *uart_out = uart; return true; }
+        }
+    }
+    return false;
+}
+
+static void hx_finish_conversion(GPIOUnit *g)
+{
+    g->hx_conversions++;
+    g->hx_in_frame = false;
+    g->hx_bit = g->hx_extra = 0;
+    g->hx_ready = false;
+    esp32_gpio_set_input(g->unit->white, 1);  /* DAT high: next conversion pending */
+    timer_mod_ns(g->hx_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INT64_C(100000000));
+}
+
+static void hx_ready_cb(void *opaque)
+{
+    GPIOUnit *g = opaque;
+    g->hx_ready = true;
+    esp32_gpio_set_input(g->unit->white, 0);  /* DAT low: conversion ready */
+}
+
+static void hx_pad_event(void *opaque, const Esp32GpioPadEvent *event)
+{
+    GPIOUnit *g = opaque;
+    const Esp32GpioPadSnapshot *before = &event->before, *after = &event->after;
+    if (after->pin != (unsigned)g->unit->yellow || after->s3 != g->unit->s3) { return; }
+    if (!before->known || !after->known || before->conflict || after->conflict ||
+        before->controller_generation != after->controller_generation) { return; }
+    if (before->level == after->level || after->level != 0) { return; }
+    if (!g->hx_ready) { return; }
+    if (!g->hx_in_frame) { g->hx_in_frame = true; g->hx_bit = g->hx_extra = 0; }
+    if (g->hx_bit < 24) {
+        bool bit = ((uint64_t)g->hx_raw >> (23 - g->hx_bit)) & 1;
+        g->hx_bit++;
+        esp32_gpio_set_input(g->unit->white, bit);
+    } else {
+        g->hx_extra++;
+        unsigned gain = g->hx_channel == 2 ? 3 : g->hx_channel == 3 ? 2 : 1;
+        if (g->hx_extra >= gain) { hx_finish_conversion(g); }
+    }
+}
+
+static void hx_int_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    int64_t value = !strcmp(name, "adc-raw") ? g->hx_raw : g->hx_channel;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void hx_int_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    if (!strcmp(name, "adc-raw")) {
+        if (value < -8388608 || value > 8388607) {
+            error_setg(errp, "adc-raw requires a signed 24-bit value"); return;
+        }
+        g->hx_raw = value;
+    } else {
+        if (value < 1 || value > 3) { error_setg(errp, "channel requires 1..3"); return; }
+        g->hx_channel = value;
+    }
+    g->unit->input_events++;
+}
+
+static void hx_weight_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    double value = (double)g->hx_raw;
+    visit_type_number(v, name, &value, errp);
+}
+
+static void hx_ready_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool value = g->hx_ready && !g->hx_in_frame;
+    visit_type_bool(v, name, &value, errp);
+}
+
+/* ---- U032 GPS / U107 UHF-RFID (UART fixtures) ---- */
+static char *hex_chunk(const char *text, unsigned *offset)
+{
+    if (!text || !*text) { return NULL; }
+    const char *start = text + *offset;
+    while (*start == ';' || *start == ' ' || *start == '\n' || *start == '\r') { start++; }
+    if (!*start) { *offset = 0; start = text; while (*start == ' ' || *start == ';') { start++; } }
+    const char *end = start;
+    while (*end && *end != ';') { end++; }
+    *offset = (unsigned)(end - text) + (*end == ';' ? 1 : 0);
+    if (*offset >= strlen(text)) { *offset = 0; }
+    return g_strndup(start, end - start);
+}
+
+static unsigned parse_hex_bytes(const char *text, uint8_t *out, unsigned capacity)
+{
+    unsigned count = 0;
+    int hi = -1;
+    for (const char *p = text; *p && count < capacity; p++) {
+        if (*p == ' ' || *p == '\t' || *p == '\n' || *p == '\r') { continue; }
+        int digit = g_ascii_xdigit_value(*p);
+        if (digit < 0) { return count; }
+        if (hi < 0) { hi = digit; }
+        else { out[count++] = (uint8_t)((hi << 4) | digit); hi = -1; }
+    }
+    return count;
+}
+
+static void gps_timer_cb(void *opaque)
+{
+    GPIOUnit *g = opaque;
+    timer_mod_ns(g->gps_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INT64_C(50000000));
+    if (!g->gps_lines || !*g->gps_lines) { return; }
+    /* Advance to the next non-empty ';'-separated sentence fixture. */
+    char *line = NULL;
+    for (unsigned attempts = 0; attempts < 64; attempts++) {
+        const char *start = g->gps_lines + g->gps_line_index;
+        while (*start == ';' || *start == ' ' || *start == '\n' || *start == '\r') { start++; }
+        if (!*start) { g->gps_line_index = 0; continue; }
+        const char *end = start;
+        while (*end && *end != ';' && *end != '\n') { end++; }
+        line = g_strndup(start, end - start);
+        g->gps_line_index = (unsigned)(end - g->gps_lines);
+        if (*end == ';' || *end == '\n') { g->gps_line_index++; }
+        if (*line) { break; }
+        g_free(line); line = NULL;
+    }
+    if (!line) { return; }
+    DeviceState *uart = NULL;
+    if (gpio_uart_rx_device_for_white(g, &uart)) {
+        size_t len = strlen(line);
+        uint8_t *frame = g_malloc(len + 2);
+        memcpy(frame, line, len); frame[len] = '\r'; frame[len + 1] = '\n';
+        if (len + 2 <= fifo8_num_free(&ESP32_UART(uart)->rx_fifo)) {
+            esp32_uart_inject_rx(ESP32_UART(uart), frame, len + 2);
+            g->unit->read_bytes += len + 2;
+            g->gps_injected++;
+        }
+        g_free(frame);
+    }
+    g_free(line);
+}
+
+static void uhf_inject_response(GPIOUnit *g)
+{
+    if (!g->uhf_responses || !*g->uhf_responses) { return; }
+    unsigned offset = g->uhf_response_offset;
+    char *chunk = hex_chunk(g->uhf_responses, &offset);
+    g->uhf_response_offset = offset;
+    if (!chunk) { return; }
+    uint8_t frame[1024];
+    unsigned count = parse_hex_bytes(chunk, frame, sizeof(frame));
+    g_free(chunk);
+    if (!count) { return; }
+    DeviceState *uart = NULL;
+    if (gpio_uart_rx_device_for_white(g, &uart) &&
+        count <= fifo8_num_free(&ESP32_UART(uart)->rx_fifo)) {
+        esp32_uart_inject_rx(ESP32_UART(uart), frame, count);
+        g->unit->read_bytes += count;
+        g->uhf_frames_injected++;
+    }
+}
+
+static void gps_lines_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = g_strdup(g->gps_lines ? g->gps_lines : "");
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void gps_lines_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    g_free(g->gps_lines);
+    g->gps_lines = value;
+    g->gps_line_index = 0;
+    g->unit->input_events++;
+}
+
+static void uhf_responses_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = g_strdup(g->uhf_responses ? g->uhf_responses : "");
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void uhf_responses_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    g_free(g->uhf_responses);
+    g->uhf_responses = value;
+    g->uhf_response_offset = 0;
+    g->unit->input_events++;
+}
