+        g->gps_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, gps_timer_cb, g);
+        timer_mod_ns(g->gps_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INT64_C(50000000));
+        object_property_add(o, "nmea-lines", "str", gps_lines_get, gps_lines_set, NULL, g);
