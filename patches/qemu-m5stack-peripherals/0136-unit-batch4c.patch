+        uint8_t *p = r + 0x30 + i * 4;
+        p[0] = (uint8_t)((f >> 24) & 0x3f) | (i ? 0xc0 : 0x80);
+        p[1] = (uint8_t)(f >> 16); p[2] = (uint8_t)(f >> 8); p[3] = (uint8_t)f;
