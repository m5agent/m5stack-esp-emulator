 static void put_le32(uint8_t *p, uint32_t value);
 
+static float le_float(const uint8_t *p)
+{
+    union { uint32_t u; float f; } v;
+    v.u = (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+          ((uint32_t)p[3] << 24);
+    return v.f;
+}
+
+static void put_le_float(uint8_t *p, double value)
+{
+    union { uint32_t u; float f; } v;
+    v.f = (float)value;
+    put_le32(p, v.u);
+}
+
+static void put_ascii_fixed(uint8_t *p, unsigned width, const char *fmt, double value)
+{
+    char tmp[32];
+    g_snprintf(tmp, sizeof(tmp), fmt, value);
+    size_t n = strlen(tmp);
+    if (n > width) { n = width; }
+    memset(p, ' ', width);
+    memcpy(p + width - n, tmp, n);
+}
+
+/* U181 BLDC Driver register readback. All values are derived from the same
+ * fixture; the frequency relation is a synthetic rpm/60 convention because the
+ * real pole-pair/electrical-frequency relation is not documented. */
+static void bldc_snapshot(M5UnitControl *s)
+{
+    uint8_t *r = s->read_snapshot;
+    memset(r, 0, 256);
+    r[0x00] = (uint8_t)s->bl_mode;
+    s->bl_pwm = CLAMP(s->bl_pwm, 0, 2047);
+    r[0x10] = (uint8_t)s->bl_pwm; r[0x11] = (uint8_t)(s->bl_pwm >> 8);
+    double rpm = s->bl_rpm;
+    double freq = rpm / 60.0;
+    put_le_float(r + 0x20, rpm);
+    put_le_float(r + 0x30, freq);
+    put_le_float(r + 0x40, rpm);
+    put_le32(r + 0x50, (uint32_t)s->bl_pid[0]);
+    put_le32(r + 0x54, (uint32_t)s->bl_pid[1]);
+    put_le32(r + 0x58, (uint32_t)s->bl_pid[2]);
+    r[0x60] = (uint8_t)s->bl_direction;
+    r[0x70] = (uint8_t)s->bl_motor_model;
+    r[0x71] = (uint8_t)s->bl_pole_pairs;
+    r[0x80] = (uint8_t)s->bl_status;
+    int32_t rpm_i = (int32_t)lround(rpm);
+    put_le32(r + 0x90, (uint32_t)rpm_i);
+    put_le32(r + 0xa0, (uint32_t)lround(freq));
+    put_ascii_fixed(r + 0xb0, 16, "%.2f", rpm);
+    put_ascii_fixed(r + 0xc0, 16, "%.2f", freq);
+    put_le32(r + 0xd0, (uint32_t)rpm_i);
