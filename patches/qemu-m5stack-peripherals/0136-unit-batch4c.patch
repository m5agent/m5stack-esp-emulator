+        uint8_t *q = r + 0x34 + i * 2;
+        q[0] = (uint8_t)((ph >> 8) & 0x0f) | (i ? 0xc0 : 0x80);
+        q[1] = (uint8_t)ph;
+    }
+    r[0xfe] = (uint8_t)s->dds_fw;
+    r[0xff] = I2C_SLAVE(s)->address;
+}
