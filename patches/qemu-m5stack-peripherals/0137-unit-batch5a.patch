+    if (s->kind == US_ANGLE8) {
+        uint8_t reg = (uint8_t)s->pointer;
+        if (reg <= 0x0f) {
+            int16_t raw = (int16_t)CLAMP(s->angle8_adc12[reg / 2], 0, 4095);
