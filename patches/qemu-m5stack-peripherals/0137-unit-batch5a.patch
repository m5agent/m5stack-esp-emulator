+static QList *int64_list(const int64_t *values, unsigned count)
+{
+    QList *list = qlist_new();
+    for (unsigned i = 0; i < count; i++) { qlist_append_int(list, values[i]); }
+    return list;
+}
+
+static void angle8_any_get(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    QList *list = !strcmp(name, "led-rgb") ? int64_list(s->angle8_rgb, 9) :
+                  !strcmp(name, "adc8-raw") ? int64_list(s->angle8_adc8, 8) :
+                  int64_list(s->angle8_adc12, 8);
+    QObject *value = QOBJECT(list);
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
+}
+
+static void angle8_any_set(Object *obj, Visitor *v, const char *name,
+                           void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    QObject *value = NULL;
+    if (!visit_type_any(v, name, &value, errp)) { return; }
+    QList *list = qobject_to(QList, value);
+    unsigned count = !strcmp(name, "adc8-raw") ? 8 : 8;
+    int64_t maximum = !strcmp(name, "adc8-raw") ? 255 : 4095;
+    if (!list || qlist_size(list) != count) {
+        error_setg(errp, "%s requires exactly %u items", name, count);
+        qobject_unref(value); return;
+    }
+    int64_t values[8];
+    unsigned i = 0;
+    const QListEntry *entry;
+    QLIST_FOREACH_ENTRY(list, entry) {
+        QNum *n = qobject_to(QNum, qlist_entry_obj(entry));
+        if (!n || !qnum_get_try_int(n, &values[i]) || values[i] < 0 || values[i] > maximum) {
+            error_setg(errp, "%s items must be int 0..%lld", name, (long long)maximum);
+            qobject_unref(value); return;
+        }
+        i++;
+    }
+    if (!strcmp(name, "adc8-raw")) {
+        memcpy(s->angle8_adc8, values, sizeof(s->angle8_adc8));
+    } else {
+        memcpy(s->angle8_adc12, values, sizeof(s->angle8_adc12));
+    }
+    s->unit->input_events++;
+    qobject_unref(value);
+}
+
+static void angle8_switch_get(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    bool value = s->angle8_switch != 0;
+    visit_type_bool(v, name, &value, errp);
+}
+
+static void angle8_switch_set(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    bool value;
+    if (!visit_type_bool(v, name, &value, errp)) { return; }
+    s->angle8_switch = value;
+    s->unit->input_events++;
+}
+
+static void kmeter_ascii(double value, char out[9])
+{
+    memset(out, ' ', 8);
+    char tmp[16];
+    g_snprintf(tmp, sizeof(tmp), "%.2f", fabs(value));
+    size_t n = strlen(tmp);
+    if (n > 8) { n = 8; }
+    memcpy(out, tmp, n);
+    out[8] = 0;
+}
