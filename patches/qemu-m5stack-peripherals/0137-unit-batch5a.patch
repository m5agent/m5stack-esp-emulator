+        if (reg >= 0x10 && reg <= 0x17) { return (uint8_t)CLAMP(s->angle8_adc8[reg - 0x10], 0, 255); }
+        if (reg == 0x20) { return s->angle8_switch ? 1 : 0; }
+        if (reg >= 0x30 && reg <= 0x53) { return s->regs[0][reg]; }
+        if (reg == 0xfe) { return (uint8_t)s->angle8_fw; }
+        if (reg == 0xff) { return I2C_SLAVE(s)->address; }
+        return 0xff;
+    }
+    if (s->kind == US_KMETER) {
+        uint8_t reg = (uint8_t)s->pointer;
+        if (reg == 0x00 || reg == 0x04 || reg == 0x10 || reg == 0x14) {
+            bool internal = (reg & 0x10) != 0;
+            bool fahr = (reg & 0x04) != 0;
+            double c = internal ? s->kmeter_internal_c : s->kmeter_tc_c;
+            int32_t raw = (int32_t)llround((fahr ? c * 9.0 / 5.0 + 32.0 : c) * 100.0);
+            uint8_t bytes[4] = { raw, raw >> 8, raw >> 16, raw >> 24 };
+            return pos < 4 ? bytes[pos] : 0xff;
+        }
+        if (reg == 0x20) { return s->kmeter_ready ? 0 : 1; }
+        if (reg >= 0x30 && reg <= 0x68) {
+            bool internal = reg >= 0x50;
+            bool fahr = (reg & 0x10) != 0;
+            double c = internal ? s->kmeter_internal_c : s->kmeter_tc_c;
+            double v = fahr ? c * 9.0 / 5.0 + 32.0 : c;
+            char text[9];
+            kmeter_ascii(v, text);
+            if (pos == 0) { return v < 0 ? '-' : '+'; }
+            if (pos <= 8) { return (uint8_t)text[pos - 1]; }
+            return 0xff;
+        }
+        if (reg == 0xfe) { return (uint8_t)s->kmeter_fw; }
+        if (reg == 0xff) { return I2C_SLAVE(s)->address; }
+        return 0xff;
+    }
