diff --git a/hw/m5stopwatch/m5_unit_i2c_sensors.c b/hw/m5stopwatch/m5_unit_i2c_sensors.c
index b1d3490..1127d93 100644
--- a/hw/m5stopwatch/m5_unit_i2c_sensors.c
+++ b/hw/m5stopwatch/m5_unit_i2c_sensors.c
@@ -27,6 +27,7 @@ typedef enum {
     US_DLIGHT, US_ACCEL, US_ADS1110, US_BMP280,
     US_DHT12, US_ADS1115, US_AMETER_EEPROM, US_AIN420, US_PAJ7620,
     US_SHT4X, US_SCD40, US_VL53L1X, US_ACMEASURE, US_ADS1115_VMETER, US_ADS1100, US_ANGLE8, US_KMETER,
+    US_RTC8563, US_STHS34PF80,
 } UnitSensorKind;
 
 typedef struct M5UnitSensor {
@@ -124,6 +125,16 @@ typedef struct M5UnitSensor {
     double kmeter_tc_c, kmeter_internal_c;
     bool kmeter_ready;
     int64_t kmeter_fw;
+    /* U126 RTC (0x51, HYM8563/PCF8563): BCD calendar register file. The model
+     * advances seconds from the QEMU virtual clock when running; crystal
+     * accuracy/battery backup/alarm IRQ physics are NOT modeled. */
+    int64_t rtc_base;
+    bool rtc_running, rtc_have_base;
+    /* U185 TMOS PIR (0x5A, STHS34PF80): register + embedded page file. IR
+     * optics/thermal physics are NOT modeled; raw values are synthetic. */
+    double tmos_tobject_c, tmos_tambient_c;
+    bool tmos_presence, tmos_motion, tmos_shock;
+    int64_t tmos_gain_mode, tmos_odr;
 } M5UnitSensor;
 OBJECT_DECLARE_SIMPLE_TYPE(M5UnitSensor, M5_UNIT_SENSOR)
 
@@ -1172,6 +1183,77 @@ static void kmeter_ascii(double value, char out[9])
     out[8] = 0;
 }
 
+static uint8_t bcd_enc(unsigned value) { return (uint8_t)(((value / 10) << 4) | (value % 10)); }
+static unsigned bcd_dec(uint8_t value) { return (value >> 4) * 10 + (value & 0x0f); }
+
+/* U126 RTC refresh: fill 0x02..0x08 BCD from base epoch + virtual time. */
+static void rtc8563_refresh(M5UnitSensor *s)
+{
+    int64_t base = s->rtc_have_base ? s->rtc_base : INT64_C(1767225600);
+    if (!s->rtc_have_base) { s->rtc_base = base; s->rtc_have_base = true; }
+    int64_t seconds = s->rtc_running ? base + now_ns() / INT64_C(1000000000) : base;
+    time_t stamp = (time_t)seconds;
+    struct tm tm;
+    gmtime_r(&stamp, &tm);
+    s->regs[0][0x02] = bcd_enc(tm.tm_sec);
+    s->regs[0][0x03] = bcd_enc(tm.tm_min);
+    s->regs[0][0x04] = bcd_enc(tm.tm_hour);
+    s->regs[0][0x05] = bcd_enc(tm.tm_mday);
+    s->regs[0][0x06] = bcd_enc(tm.tm_wday);
+    s->regs[0][0x07] = bcd_enc(tm.tm_mon + 1) | (tm.tm_year + 1900 >= 2100 ? 0x80 : 0);
+    s->regs[0][0x08] = bcd_enc((tm.tm_year + 1900) % 100);
+}
+
+/* U185 TMOS data registers: synthetic raw = round(celsius * 100). */
+static void sths34pf80_refresh(M5UnitSensor *s)
+{
+    int16_t tobject = (int16_t)CLAMP(llround(s->tmos_tobject_c * 100.0), -32768, 32767);
+    int16_t tambient = (int16_t)CLAMP(llround(s->tmos_tambient_c * 100.0), -32768, 32767);
+    s->regs[0][0x0f] = 0xd3;  /* WHOAMI */
+    le16(s->regs[0] + 0x26, (uint16_t)tobject);
+    le16(s->regs[0] + 0x28, (uint16_t)tambient);
+    le16(s->regs[0] + 0x38, (uint16_t)tobject);
+    le16(s->regs[0] + 0x3a, s->tmos_presence ? 1 : 0);
+    le16(s->regs[0] + 0x3c, s->tmos_motion ? 1 : 0);
+    le16(s->regs[0] + 0x3e, s->tmos_shock ? 1 : 0);
+    s->regs[0][0x23] = (s->tmos_presence ? 0x01 : 0) | (s->tmos_motion ? 0x02 : 0) |
+                       (s->tmos_shock ? 0x04 : 0);
+    s->regs[0][0x25] = s->regs[0][0x23];
+}
+
+static void rtc_time_get(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value;
+    if (s->rtc_running) {
+        value = (s->rtc_have_base ? s->rtc_base : INT64_C(1767225600)) +
+                now_ns() / INT64_C(1000000000);
+    } else {
+        struct tm tm = {0};
+        tm.tm_sec = bcd_dec(s->regs[0][0x02]);
+        tm.tm_min = bcd_dec(s->regs[0][0x03]);
+        tm.tm_hour = bcd_dec(s->regs[0][0x04]);
+        tm.tm_mday = bcd_dec(s->regs[0][0x05]);
+        tm.tm_mon = bcd_dec(s->regs[0][0x07] & 0x7f) - 1;
+        tm.tm_year = bcd_dec(s->regs[0][0x08]) + 100;
+        value = (int64_t)timegm(&tm);
+    }
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void rtc_time_set(Object *obj, Visitor *v, const char *name,
+                         void *opaque, Error **errp)
