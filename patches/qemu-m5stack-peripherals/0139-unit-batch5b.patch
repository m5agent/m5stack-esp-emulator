+static void at_inject_next(GPIOUnit *g)
+{
+    if (!g->at_responses || !*g->at_responses) { return; }
+    unsigned offset = g->at_offset;
+    char *chunk = hex_chunk(g->at_responses, &offset);
+    g->at_offset = offset;
+    if (!chunk) { return; }
+    uint8_t frame[512];
+    unsigned count = parse_hex_bytes(chunk, frame, sizeof(frame));
+    g_free(chunk);
+    if (!count) { return; }
+    DeviceState *uart = NULL;
+    if (gpio_uart_rx_device_for_white(g, &uart) &&
+        count <= fifo8_num_free(&ESP32_UART(uart)->rx_fifo)) {
+        esp32_uart_inject_rx(ESP32_UART(uart), frame, count);
+        g->unit->read_bytes += count;
+        g->at_frames_injected++;
+    }
+}
+
+static void at_idle_cb(void *opaque)
+{
+    GPIOUnit *g = opaque;
+    if (!g->at_len) { return; }
+    g->at_frames_sent++;
+    at_inject_next(g);
+    g->at_len = 0;
+}
+
+static void at_arm_idle(GPIOUnit *g)
+{
+    unsigned delay = !strcmp(g->unit->unit_id, "zigbee") ? 8 : 5;
+    timer_mod_ns(g->at_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                 (int64_t)delay * 1000000);
+}
+
+static void lora_respond(GPIOUnit *g)
+{
+    /* 0xC1 read-config: 3-byte request -> 11-byte response (header + 8-byte
+     * config mirror). 0xC0 write-config: 11-byte frame mirrored back for the
+     * driver's same-length readback check. Other bytes fall back to the
+     * generic idle-time fixture response. */
+    if (g->at_len == 3 && g->at_buf[0] == 0xc1) {
+        uint8_t frame[11] = {0xc1, 0x00, 0x08};
+        memcpy(frame + 3, g->lora_config, 8);
+        DeviceState *uart = NULL;
+        if (gpio_uart_rx_device_for_white(g, &uart)) {
+            esp32_uart_inject_rx(ESP32_UART(uart), frame, sizeof(frame));
+            g->unit->read_bytes += sizeof(frame);
+            g->at_frames_injected++;
+        }
+        g->at_frames_sent++;
+        g->at_len = 0;
+    } else if (g->at_len == 11 && g->at_buf[0] == 0xc0) {
+        memcpy(g->lora_config, g->at_buf + 3, 8);
+        DeviceState *uart = NULL;
+        if (gpio_uart_rx_device_for_white(g, &uart)) {
+            esp32_uart_inject_rx(ESP32_UART(uart), g->at_buf, 11);
+            g->unit->read_bytes += 11;
+            g->at_frames_injected++;
+        }
+        g->at_frames_sent++;
+        g->at_len = 0;
+    }
+}
+
+static void at_responses_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = g_strdup(g->at_responses ? g->at_responses : "");
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void at_responses_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    g_free(g->at_responses);
+    g->at_responses = value;
+    g->at_offset = 0;
+    g->unit->input_events++;
+}
+
+static void lora_config_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char text[17];
+    for (unsigned i = 0; i < 8; i++) { sprintf(text + i * 2, "%02x", g->lora_config[i]); }
+    text[16] = 0;
+    char *value = g_strdup(text);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
