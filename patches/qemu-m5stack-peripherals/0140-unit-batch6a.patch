 } M5UnitSensor;
 OBJECT_DECLARE_SIMPLE_TYPE(M5UnitSensor, M5_UNIT_SENSOR)
 
@@ -1254,6 +1265,82 @@ static void rtc_time_set(Object *obj, Visitor *v, const char *name,
     s->unit->input_events++;
 }
 
+/* U095 MPU6886: refresh the accel/gyro/temperature data registers from the
+ * fixtures using the driver's scale factors (16384/8192/4096/2048 LSB/g and
+ * 131/62.5/32.8/16.4 LSB/dps; temperature = raw/326.8 + 25). */
+static void mpu6886_refresh(M5UnitSensor *s)
+{
+    uint8_t accel_cfg = s->regs[0][0x1c] & 0x18;
+    uint8_t gyro_cfg = s->regs[0][0x1b] & 0x18;
+    double accel_so = accel_cfg == 0x08 ? 8192.0 : accel_cfg == 0x10 ? 4096.0 :
+                      accel_cfg == 0x18 ? 2048.0 : 16384.0;
+    double gyro_so = gyro_cfg == 0x08 ? 62.5 : gyro_cfg == 0x10 ? 32.8 :
+                     gyro_cfg == 0x18 ? 16.4 : 131.0;
+    for (unsigned i = 0; i < 3; i++) {
+        int16_t a = (int16_t)CLAMP(llround(s->values[i] * accel_so), -32768, 32767);
+        int16_t g = (int16_t)CLAMP(llround(s->values[3 + i] * gyro_so), -32768, 32767);
+        be16(s->regs[0] + 0x3b + i * 2, (uint16_t)a);
+        be16(s->regs[0] + 0x43 + i * 2, (uint16_t)g);
+    }
+    int16_t temp = (int16_t)CLAMP(llround((s->values[6] - 25.0) * 326.8), -32768, 32767);
+    be16(s->regs[0] + 0x41, (uint16_t)temp);
+    s->regs[0][0x75] = 0x19;  /* MPU6886 WHO_AM_I */
+}
+
+/* U169 BME688: WHOAMI/variant plus synthetic 17-byte field data starting at
+ * 0x1D. Encodings are model-side conventions; the guest compensation path is
+ * NOT asserted (BME68x calibration inverse NOT modeled). */
+static void bme68x_refresh(M5UnitSensor *s)
+{
+    uint8_t *r = s->regs[0];
+    r[0xd0] = 0x61;
+    r[0xf0] = (uint8_t)(s->bme_variant & 0x03);
+    r[0x1d] = s->bme_ready ? 0x80 : 0x00;
+    r[0x1e] = 1;
+    uint32_t press = (uint32_t)CLAMP(llround(s->values[2] * 16.0), 0, 0xffffff);
+    uint32_t temp = (uint32_t)CLAMP(llround((s->values[0] + 40.0) * 16.0), 0, 0xffffff);
+    uint16_t hum = (uint16_t)CLAMP(llround(s->values[1] / 100.0 * 65535.0), 0, 65535);
+    r[0x1f] = press >> 16; r[0x20] = press >> 8; r[0x21] = press;
+    r[0x22] = temp >> 16; r[0x23] = temp >> 8; r[0x24] = temp;
+    r[0x25] = hum >> 8; r[0x26] = hum;
+}
+
+static void mpu_accel_range_set(Object *obj, Visitor *v, const char *name,
+                                void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    uint8_t bits = value == 2 ? 0x00 : value == 4 ? 0x08 : value == 8 ? 0x10 :
+                   value == 16 ? 0x18 : 0xff;
+    if (bits == 0xff) { error_setg(errp, "accel-range must be 2, 4, 8 or 16 g"); return; }
+    s->regs[0][0x1c] = (uint8_t)((s->regs[0][0x1c] & ~0x18) | bits);
+    s->mpu_accel_fs = value;
+    s->unit->input_events++;
+}
+
+static void mpu_gyro_range_set(Object *obj, Visitor *v, const char *name,
+                               void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    uint8_t bits = value == 250 ? 0x00 : value == 500 ? 0x08 : value == 1000 ? 0x10 :
+                   value == 2000 ? 0x18 : 0xff;
+    if (bits == 0xff) { error_setg(errp, "gyro-range must be 250/500/1000/2000 dps"); return; }
+    s->regs[0][0x1b] = (uint8_t)((s->regs[0][0x1b] & ~0x18) | bits);
+    s->mpu_gyro_fs = value;
+    s->unit->input_events++;
+}
+
+static void mpu_range_get(Object *obj, Visitor *v, const char *name,
+                          void *opaque, Error **errp)
+{
+    M5UnitSensor *s = opaque;
+    int64_t value = !strcmp(name, "accel-range") ? s->mpu_accel_fs : s->mpu_gyro_fs;
+    visit_type_int64(v, name, &value, errp);
+}
+
 static int sensor_send(I2CSlave *dev, uint8_t data)
 {
     M5UnitSensor *s = M5_UNIT_SENSOR(dev);
@@ -1550,6 +1637,21 @@ static int sensor_send(I2CSlave *dev, uint8_t data)
         s->pointer++;
         return 0;
     }
+    if (s->kind == US_MPU6886) {
+        if (pos == 0) { s->pointer = data; return 0; }
+        s->regs[0][(uint8_t)s->pointer] = data;
+        s->pointer++;
+        return 0;
+    }
+    if (s->kind == US_BME68X) {
+        if (pos == 0) { s->pointer = data; return 0; }
+        uint8_t reg = (uint8_t)s->pointer;
+        if (reg == 0xe0 && data == 0xb6) { s->bme_ready = false; return 0; }
+        s->regs[0][reg] = data;
+        if (reg == 0x74) { s->bme_ready = true; }
+        s->pointer++;
+        return 0;
+    }
     if (!pos) {
         if (s->kind == US_COLOR && data == 0xe6) {
             s->regs[0][0x13] &= ~0x10; return 0;
@@ -1685,6 +1787,16 @@ static uint8_t sensor_recv(I2CSlave *dev)
         if (reg == 0xff) { return I2C_SLAVE(s)->address; }
         return 0xff;
     }
+    if (s->kind == US_MPU6886) {
+        if (pos == 0) { mpu6886_refresh(s); }
+        uint16_t reg = s->pointer + pos;
+        return reg <= 0xff ? s->regs[0][reg] : 0xff;
+    }
+    if (s->kind == US_BME68X) {
+        if (pos == 0) { bme68x_refresh(s); }
+        uint16_t reg = s->pointer + pos;
+        return reg <= 0xff ? s->regs[0][reg] : 0xff;
+    }
     if (s->kind == US_RTC8563) {
