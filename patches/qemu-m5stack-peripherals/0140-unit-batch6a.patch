 typedef struct M5UnitSensor {
@@ -135,6 +135,17 @@ typedef struct M5UnitSensor {
     double tmos_tobject_c, tmos_tambient_c;
     bool tmos_presence, tmos_motion, tmos_shock;
     int64_t tmos_gain_mode, tmos_odr;
+    /* U095 Mini IMU (0x68, MPU6886): accel/gyro/temperature register file with
+     * the board-level MPU6886 register semantics; real motion/vibration/temp
+     * physics are NOT modeled. */
+    double mpu_accel[3], mpu_gyro[3], mpu_temp;
+    int64_t mpu_accel_fs, mpu_gyro_fs, mpu_whoami;
+    /* U169 ENV-Pro (0x169/BME688): minimal register machine with synthetic
+     * field bytes. Guest compensation decode is NOT asserted because the
+     * BME68x compensation inverse is not modeled; gas/IAQ/heater NOT RUN. */
+    double bme_temp, bme_hum, bme_press, bme_gas;
+    bool bme_ready;
