+                return 0;
+            }
+            return 1;
+        }
+        if (offset) { return 1; }
+        switch (reg) {
+        case 0x50: s->miniscale_resets++; return 0;
+        case 0x80: s->miniscale_lpf = value != 0; return 0;
+        case 0x81: s->miniscale_avg = (int8_t)value; return 0;
+        case 0x82: s->miniscale_ema = (int8_t)value; return 0;
