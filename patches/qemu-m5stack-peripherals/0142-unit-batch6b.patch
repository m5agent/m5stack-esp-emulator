+/* ATECC608B CRC16: poly 0x8005, init 0, refin/refout (ATECC variant). */
+static uint16_t atecc_crc16(const uint8_t *data, unsigned length)
+{
+    uint16_t crc = 0;
+    for (unsigned i = 0; i < length; i++) {
+        crc ^= data[i];
+        for (unsigned b = 0; b < 8; b++) {
+            crc = (crc & 1) ? ((crc >> 1) ^ 0x8005) : (crc >> 1);
+        }
+    }
+    return crc;
+}
+
+/* Build a deterministic ATECC response: [len][data...][crcL][crcH]. */
+static void atecc_respond(M5UnitSensor *s, const uint8_t *data, unsigned len)
+{
+    s->ecc_resp[0] = (uint8_t)len;
+    memcpy(s->ecc_resp + 1, data, len);
+    uint16_t crc = atecc_crc16(s->ecc_resp, len + 1);
+    s->ecc_resp[len + 1] = (uint8_t)crc;
+    s->ecc_resp[len + 2] = (uint8_t)(crc >> 8);
+    s->ecc_resp_len = len + 3;
+    s->ecc_resp_pos = 0;
+}
+
+/* Fixed, non-secret test vectors only. */
+static const uint8_t ecc_random_vector[32] = {
+    0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f,
+    0x20,0x21,0x22,0x23,0x24,0x25,0x26,0x27,0x28,0x29,0x2a,0x2b,0x2c,0x2d,0x2e,0x2f };
+static const uint8_t ecc_sha_vector[32] = {
+    0xaa,0xbb,0xcc,0xdd,0x01,0x02,0x03,0x04,0x05,0x06,0x07,0x08,0x09,0x0a,0x0b,0x0c,
+    0x0d,0x0e,0x0f,0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,0x18,0x19,0x1a,0x1b,0x1c };
+static const uint8_t ecc_pubkey_vector[64] = {
+    0x30,0x31,0x32,0x33,0x34,0x35,0x36,0x37,0x38,0x39,0x3a,0x3b,0x3c,0x3d,0x3e,0x3f,
+    0x40,0x41,0x42,0x43,0x44,0x45,0x46,0x47,0x48,0x49,0x4a,0x4b,0x4c,0x4d,0x4e,0x4f,
+    0x50,0x51,0x52,0x53,0x54,0x55,0x56,0x57,0x58,0x59,0x5a,0x5b,0x5c,0x5d,0x5e,0x5f,
+    0x60,0x61,0x62,0x63,0x64,0x65,0x66,0x67,0x68,0x69,0x6a,0x6b,0x6c,0x6d,0x6e,0x6f };
+static const uint8_t ecc_sign_vector[64] = {
+    0x70,0x71,0x72,0x73,0x74,0x75,0x76,0x77,0x78,0x79,0x7a,0x7b,0x7c,0x7d,0x7e,0x7f,
+    0x80,0x81,0x82,0x83,0x84,0x85,0x86,0x87,0x88,0x89,0x8a,0x8b,0x8c,0x8d,0x8e,0x8f,
+    0x90,0x91,0x92,0x93,0x94,0x95,0x96,0x97,0x98,0x99,0x9a,0x9b,0x9c,0x9d,0x9e,0x9f,
+    0xa0,0xa1,0xa2,0xa3,0xa4,0xa5,0xa6,0xa7,0xa8,0xa9,0xaa,0xab,0xac,0xad,0xae,0xaf };
+
+static void atecc_build_response(M5UnitSensor *s)
+{
+    uint8_t opcode = s->ecc_cmd_len >= 3 ? s->ecc_cmd[2] : 0;
+    switch (opcode) {
+    case 0x30: {  /* INFO: revision (4) / unique serial (9) fixtures */
+        uint8_t param = s->ecc_cmd_len >= 4 ? s->ecc_cmd[3] : 0;
+        if (param == 0x00) {
+            uint8_t data[4] = { 0x00, 0x00, (uint8_t)(s->ecc_revision >> 8), (uint8_t)s->ecc_revision };
+            atecc_respond(s, data, 4);
+        } else {
+            uint8_t data[9];
+            for (unsigned i = 0; i < 9; i++) { data[i] = (uint8_t)s->ecc_serial[i]; }
+            atecc_respond(s, data, 9);
+        }
+        break;
+    }
+    case 0x1b: atecc_respond(s, ecc_random_vector, 32); break;  /* RANDOM */
+    case 0x47: atecc_respond(s, ecc_sha_vector, 32); break;     /* SHA */
+    case 0x40: atecc_respond(s, ecc_pubkey_vector, 64); break;  /* GEN_KEY */
+    case 0x41: atecc_respond(s, ecc_sign_vector, 64); break;    /* SIGN */
+    case 0x16: atecc_respond(s, ecc_random_vector, 32); break;  /* NONCE fixture */
+    default: {
+        uint8_t data[4] = { 0x00, 0x00, 0x00, 0x00 };
+        atecc_respond(s, data, 4);
+        break;
+    }
+    }
+}
+
+static void thermal2_fill_raw(M5UnitSensor *s)
+{
+    s->regs[0][0x00] = s->thermal2_button ? 0x01 : 0x00;
+    s->regs[0][0x01] = (uint8_t)s->thermal2_alarm_status;
+    s->regs[0][0x04] = 0x40; s->regs[0][0x05] = 0x64;
+    s->regs[0][0x06] = 1; s->regs[0][0x07] = 0;
+    s->regs[0][0x08] = I2C_SLAVE(s)->address;
+    s->regs[0][0x09] = (uint8_t)~I2C_SLAVE(s)->address;
+    s->regs[0][0x0a] = (uint8_t)s->thermal2_refresh_rate;
+    s->regs[0][0x70] = (uint8_t)(int16_t)CLAMP(llround((s->thermal2_median_c + 64) * 128), -32768, 32767);
+    s->regs[0][0x71] = (uint8_t)(((int16_t)CLAMP(llround((s->thermal2_median_c + 64) * 128), -32768, 32767)) >> 8);
+    s->regs[0][0x72] = (uint8_t)(int16_t)CLAMP(llround((s->thermal2_avg_c + 64) * 128), -32768, 32767);
+    s->regs[0][0x73] = (uint8_t)(((int16_t)CLAMP(llround((s->thermal2_avg_c + 64) * 128), -32768, 32767)) >> 8);
+    s->regs[0][0x74] = (uint8_t)(int16_t)CLAMP(llround(s->thermal2_diff_c * 128), -32768, 32767);
+    s->regs[0][0x75] = (uint8_t)(((int16_t)CLAMP(llround(s->thermal2_diff_c * 128), -32768, 32767)) >> 8);
+    s->regs[0][0x6e] = 0; s->regs[0][0x6f] = 0;
+    s->regs[0][0xfe] = (uint8_t)s->thermal2_fw;
+    s->regs[0][0xff] = I2C_SLAVE(s)->address;
+}
+
+static unsigned qr_count(void)
+{
+    return 0;
+}
