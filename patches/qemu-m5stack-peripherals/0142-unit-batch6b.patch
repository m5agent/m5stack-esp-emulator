+        if (pos == 0) { s->pointer = data; return 0; }
+        s->regs[0][(uint8_t)s->pointer] = data;
+        s->pointer++;
+        return 0;
+    }
+    if (s->kind == US_QRCODE) {
+        if (pos == 0) { s->command = data; return 0; }
+        if (pos == 1) {
+            s->pointer = ((uint16_t)s->command) | (data << 8);
+            s->command = s->pointer;
+            return 0;
+        }
+        uint16_t addr = s->command + (pos - 2);
+        if (addr == 0x0000) { s->qr_status = data ? 1 : 0; return 0; }
+        if (addr == 0x0010) { s->qr_status = data & 0x03; return 0; }
+        if (addr == 0x0030) { s->qr_trigger_mode = data & 0x01; return 0; }
+        if (addr <= 0xff) { s->regs[0][addr] = data; }
+        return 0;
+    }
     if (!pos) {
         if (s->kind == US_COLOR && data == 0xe6) {
             s->regs[0][0x13] &= ~0x10; return 0;
@@ -1801,6 +1941,40 @@ static uint8_t sensor_recv(I2CSlave *dev)
         if (reg == 0xff) { return I2C_SLAVE(s)->address; }
         return 0xff;
     }
+    if (s->kind == US_ATECC608B) {
+        if (pos == 0) {
+            atecc_build_response(s);
+        }
+        return s->ecc_resp_pos < s->ecc_resp_len ? s->ecc_resp[s->ecc_resp_pos++] : 0xff;
+    }
+    if (s->kind == US_THERMAL2) {
+        if (pos == 0) { thermal2_fill_raw(s); }
+        uint16_t reg = s->pointer + pos;
+        /* Temperature array 0x80..0x37F: raw LE16 = (temp*128 + 8192). */
+        if (reg >= 0x80 && reg < 0x380) {
+            unsigned index = (reg - 0x80) / 2;
+            unsigned lane = (reg - 0x80) & 1;
+            double temp = s->thermal2_median_c + (double)(index % 32) * 0.25;
+            int16_t raw = (int16_t)CLAMP(llround(temp * 128.0 + 8192.0), 0, 65535);
+            return lane ? (uint8_t)((uint16_t)raw >> 8) : (uint8_t)((uint16_t)raw & 0xff);
+        }
+        return reg <= 0xff ? s->regs[0][reg] : 0xff;
+    }
+    if (s->kind == US_QRCODE) {
+        uint16_t addr = s->command + pos;
+        if (addr == 0x0010) { return s->qr_status & 0xff; }
+        if (addr == 0x0020) { return (uint8_t)(s->qr_data_len & 0xff); }
+        if (addr == 0x0021) { return (uint8_t)((s->qr_data_len >> 8) & 0xff); }
+        if (addr == 0x0030) { return (uint8_t)s->qr_trigger_mode; }
+        if (addr == 0x0040) { return (uint8_t)s->qr_button; }
+        if (addr == 0x00fe) { return (uint8_t)s->qr_fw; }
+        if (addr == 0x00ff) { return I2C_SLAVE(s)->address; }
+        if (addr >= 0x1000 && addr < 0x1200) {
+            unsigned i = addr - 0x1000;
+            return i < s->qr_data_len && s->qr_data ? (uint8_t)s->qr_data[i] : 0xff;
+        }
+        return 0xff;
+    }
     if (s->kind == US_MPU6886) {
         if (pos == 0) { mpu6886_refresh(s); }
         uint16_t reg = s->pointer + pos;
@@ -2007,7 +2181,7 @@ bool m5_unit_sensor_supported(const char *id)
         "ultrasonic-i2c", "thermal", "dlight", "accel", "adc-v11", "bps",
