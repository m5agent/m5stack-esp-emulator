From a07fb596f3505118ba03dfc9715e175278bd5efb Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5agentdeMac-mini.local>
Date: Tue, 3 Nov 2026 00:16:10 +0800
Subject: [PATCH] hw/m5stopwatch: add Unit batch-7 first five data planes

Implement the first five batch-7 Unit data planes on top of the 22-layer
canonical chain (75f1d24 + 0120-0129, 0131, 0134, 0136, 0130, 0133, 0135,
0132, 0137, 0138, 0139, 0140, 0141). No guest/Device Service evidence is
recorded; all five stay planned and the reused register machines keep their
existing NOT RUN boundaries.

- mini-tof-90 (U196): alias of the existing US_TOF VL53L0X register file at
  0x29; the 90-degree mounting orientation does not change the protocol.
  0x29 conflicts with tof/tof4m/color (one Unit per bus); optics/ranging
  accuracy are NOT RUN.
- hbridge-v11 (U160-V11): alias of the existing 0x20 STM32F030 HBridge model;
  v1.1 only adds the 0x30 float32 VIN current, already modelled through the
  vin-current-a fixture. Motor electrical behaviour and INA199 protection are
  NOT RUN; 0x20 conflicts with hbridge U160.
- cardkb-original (U035): alias of the existing 0x5F single-byte key-register
  CardKB model; the MEGA8A/MEGA328P version difference does not change the
  frozen host driver protocol. Key-matrix/RGB LED mechanics are NOT RUN;
  0x5F conflicts with cardkb U035-B.
- env-ii (U001-B): new SHT30 slave at 0x44 plus the existing BMP280 0x76 model
  on the ENV dual-slave attach path. SHT30 implements 2-byte commands, the
  0x2C10 measure response with CRC8 poly 0x31 and the 0xF32D status word;
  sensor accuracy/real physics are NOT RUN. 0x44 conflicts with env/env-iv and
  0x76 with bps/env/env-iv.
- mini-bps-v11 (U090-B): DEFERRED, not implemented. The product page + official
  I2C index say QMP6988 @0x56 while the frozen driver defaults to @0x70 and
  env-iii also uses 0x70; the address cannot be confirmed from the available
  evidence, so the QEMU model is intentionally absent and the catalog/profile
  entry documents the unresolved address as a blocker.

Offline QOM smoke (S3 m5atoms3r, no guest firmware) attaches the four
implemented units and checks property registration, reset/read-write fixtures
and the dual ENV-II slave addresses: 22/22 PASS. The smoke does NOT cover I2C
byte semantics (SHT30 measure frames, VL53L0X range reads), key injection
timing or motor current physics; those still need guest evidence.
---
 hw/m5stopwatch/m5_unit_i2c_controls.c | 16 ++++--
 hw/m5stopwatch/m5_unit_i2c_sensors.c  | 78 ++++++++++++++++++++++++++-
 2 files changed, 88 insertions(+), 6 deletions(-)

diff --git a/hw/m5stopwatch/m5_unit_i2c_controls.c b/hw/m5stopwatch/m5_unit_i2c_controls.c
index 6746773..2d31dbf 100644
--- a/hw/m5stopwatch/m5_unit_i2c_controls.c
+++ b/hw/m5stopwatch/m5_unit_i2c_controls.c
@@ -2464,8 +2464,8 @@ bool m5_unit_controls_supported(const char *unit_id)
     static const char *const ids[] = {
         "joystick-v11", "encoder", "8encoder", "cardkb", "rfid2", "scroll",
         "joystick2", "8servos", "servo8-hat", "4relay", "weight-i2c",
-        "ncir2", "extio2", "hbridge", "dac", "joystick",
-        "extencoder", "acssr", "pbhub", "pbhub-v11", "bldc-driver", "dds", "rfid", "extio", "dac2", "scales", "pahub-v20", "mini-scales",
+        "ncir2", "extio2", "hbridge", "hbridge-v11", "dac", "joystick",
+        "cardkb-original", "extencoder", "acssr", "pbhub", "pbhub-v11", "bldc-driver", "dds", "rfid", "extio", "dac2", "scales", "pahub-v20", "mini-scales",
     };
     for (unsigned i = 0; i < G_N_ELEMENTS(ids); i++) { if (!strcmp(unit_id, ids[i])) { return true; } }
     return false;
@@ -2668,7 +2668,11 @@ void m5_unit_controls_realize(M5Unit *unit, Error **errp)
         object_property_add(OBJECT(s->unit), "servo-angles", "any", extio2_array_get, NULL, NULL, s);
         object_property_add(OBJECT(s->unit), "servo-pulses", "any", extio2_array_get, NULL, NULL, s);
         object_property_add(OBJECT(s->unit), "rgb-leds", "any", extio2_array_get, NULL, NULL, s);
-    } else if (!strcmp(unit->unit_id, "hbridge")) {
+    } else if (!strcmp(unit->unit_id, "hbridge") ||
+               !strcmp(unit->unit_id, "hbridge-v11")) {
+        /* U160 HBridge and U160-V11 share the 0x20 STM32F030 register file;
+         * v1.1 only adds the 0x30 float32 VIN current, which this model
+         * already exposes through the vin-current-a fixture. */
         s->kind = CONTROL_HBRIDGE; address = 0x20;
         s->hbridge_adc_mv = 0; s->hbridge_vin_a = 0; s->hbridge_fw = 1;
         add_control_number(s, "adc-mv", &s->hbridge_adc_mv, 0, 0, 3300, true, false);
@@ -2676,7 +2680,11 @@ void m5_unit_controls_realize(M5Unit *unit, Error **errp)
         object_property_add(OBJECT(s->unit), "direction", "int", hbridge_direction_get, NULL, NULL, s);
         object_property_add(OBJECT(s->unit), "pwm-duty-pct", "number", hbridge_duty_get, NULL, NULL, s);
         object_property_add(OBJECT(s->unit), "pwm-frequency-hz", "int", hbridge_freq_get, NULL, NULL, s);
-    } else if (!strcmp(unit->unit_id, "cardkb")) {
+    } else if (!strcmp(unit->unit_id, "cardkb") ||
+               !strcmp(unit->unit_id, "cardkb-original")) {
+        /* U035-B cardkb and U035 original share the 0x5F single-byte key
+         * register path; the MEGA8A/MEGA328P MCU difference does not change
+         * the frozen host driver protocol. */
         s->kind = CONTROL_CARDKB; address = 0x5f;
         add_int(s, "keycode", true); add_array(s, "keys", true);
         add_array(s, "key-ids", false);
diff --git a/hw/m5stopwatch/m5_unit_i2c_sensors.c b/hw/m5stopwatch/m5_unit_i2c_sensors.c
index 7985c45..c98cba5 100644
--- a/hw/m5stopwatch/m5_unit_i2c_sensors.c
+++ b/hw/m5stopwatch/m5_unit_i2c_sensors.c
@@ -26,7 +26,7 @@ typedef enum {
     US_COLOR, US_TOF, US_NCIR, US_HEART, US_TVOC, US_SONIC, US_THERMAL,
     US_DLIGHT, US_ACCEL, US_ADS1110, US_BMP280,
     US_DHT12, US_ADS1115, US_AMETER_EEPROM, US_AIN420, US_PAJ7620,
-    US_SHT4X, US_SCD40, US_VL53L1X, US_ACMEASURE, US_ADS1115_VMETER, US_ADS1100, US_ANGLE8, US_KMETER,
+    US_SHT4X, US_SHT30, US_SCD40, US_VL53L1X, US_ACMEASURE, US_ADS1115_VMETER, US_ADS1100, US_ANGLE8, US_KMETER,
     US_RTC8563, US_STHS34PF80, US_MPU6886, US_BME68X,
 } UnitSensorKind;
 
@@ -93,6 +93,11 @@ typedef struct M5UnitSensor {
      * driver for guest assertions. */
     uint8_t sht4x_cmd;
     int64_t sht4x_serial;
+    /* U001-B ENV-II SHT30 (0x44): 2-byte big-endian commands; measure
+     * commands return 6 bytes (T word + CRC8, RH word + CRC8). This is a
+     * different protocol from the SHT4x single-byte command model. */
+    uint16_t sht30_command;
+    bool sht30_measure_pending;
     /* U103 CO2 SCD40/SCD41 0x62: 2-byte big-endian commands; responses are
      * 2-byte words each followed by CRC8. Settable-argument commands carry a
      * 2-byte value + CRC in the same write transaction. */
@@ -457,6 +462,41 @@ static void sht4x_build_response(M5UnitSensor *s)
     }
 }
 
+/* U001-B ENV-II SHT30: SHT3x 2-byte big-endian command set. Only the
+ * documented sequences used by the frozen driver are modelled: measurement
+ * (0x2400..0x2416/0x2C06..0x2C10), status 0xF32D, reset 0x30A2 and the
+ * heater enable/disable commands (no read payload). */
+static bool sht30_measure_command(uint16_t cmd)
+{
+    switch (cmd) {
+    case 0x2400: case 0x2406: case 0x2409: case 0x240b: case 0x2416:
+    case 0x2c06: case 0x2c0d: case 0x2c10:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static void sht30_build_response(M5UnitSensor *s)
+{
+    s->response_len = 0;
+    if (s->sht30_measure_pending) {
+        double humidity = CLAMP(s->values[1], 0.0, 100.0);
+        double temperature = CLAMP(s->values[0], -40.0, 125.0);
+        uint16_t t_raw = (uint16_t)CLAMP(lround((temperature + 45.0) / 175.0 * 65535.0), 0, 65535);
+        uint16_t rh_raw = (uint16_t)CLAMP(lround(humidity / 100.0 * 65535.0), 0, 65535);
+        response_word(s, 0, t_raw);
+        response_word(s, 1, rh_raw);
+        s->samples++;
+        s->sht30_measure_pending = false;
+    } else if (s->sht30_command == 0xf32d) {
+        /* Status register: bit 0 ready, bit 4 heater; both idle/ready here. */
+        be16(s->response, 0x0000);
+        s->response[2] = crc8(s->response, 2, 0x31, 0xff);
+        s->response_len = 3;
+    }
+}
+
 /* U103 SCD4x: 2-byte commands, response words with CRC8, and set-arg commands
  * that append a 2-byte value + CRC to the command write. */
 static bool scd40_arg_command(uint16_t cmd)
@@ -1426,6 +1466,15 @@ static int sensor_send(I2CSlave *dev, uint8_t data)
         s->sht4x_cmd = data;
         return 0;
     }
+    if (s->kind == US_SHT30) {
+        /* SHT3x accepts a 2-byte big-endian command per write transaction. */
+        if (pos == 0) { s->sht30_command = (uint16_t)data << 8; s->response_len = 0; return 0; }
+        if (pos != 1) { return 1; }
+        s->sht30_command = (s->sht30_command & 0xff00) | data;
+        s->sht30_measure_pending = sht30_measure_command(s->sht30_command);
+        s->response_len = 0;
+        return 0;
+    }
     if (s->kind == US_SCD40) {
         /* 2-byte big-endian command, plus optional 2-byte value + CRC for
          * set-argument commands (0x241D/0x2427/0xE000/0x362F/0x2416). */
@@ -1868,6 +1917,10 @@ static uint8_t sensor_recv(I2CSlave *dev)
         if (pos == 0) { sht4x_build_response(s); }
         return pos < s->response_len ? s->response[pos] : 0xff;
     }
+    if (s->kind == US_SHT30) {
+        if (pos == 0) { sht30_build_response(s); }
+        return pos < s->response_len ? s->response[pos] : 0xff;
+    }
     if (s->kind == US_SCD40) {
         if (pos == 0) { scd40_build_response(s); }
         return pos < s->response_len ? s->response[pos] : 0xff;
@@ -2007,6 +2060,7 @@ bool m5_unit_sensor_supported(const char *id)
         "ultrasonic-i2c", "thermal", "dlight", "accel", "adc-v11", "bps",
         "env", "ameter", "ain4-20ma", "gesture", "env-iv", "co2", "co2l", "tof4m",
         "ac-measure", "vmeter", "adc", "8angle", "kmeter-iso-v11", "rtc", "tmos-pir",
+        "mini-tof-90", "env-ii",
         "mini-imu", "env-pro" };
     for (unsigned i = 0; i < G_N_ELEMENTS(ids); i++) {
         if (!strcmp(id, ids[i])) { return true; }
@@ -2065,6 +2119,24 @@ void m5_unit_sensor_realize(M5Unit *u, Error **errp)
         add_number(b, "pressure-pa", 1, 101325, 30000, 110000, false);
         sensor_attach_one(u, "bmp280", b, 0x76);
         return;
+    } else if (!strcmp(u->unit_id, "env-ii")) {
+        /* U001-B ENV-II: SHT30 0x44 (temperature/humidity) + BMP280 0x76 on
+         * one Grove pair, same dual-slave attach as ENV-I/IV. */
+        M5UnitSensor *st = sensor_device(u);
+        st->kind = US_SHT30;
+        st->values[0] = 25; st->values[1] = 50;
+        add_number(st, "temperature-c", 0, 25, -40, 125, false);
+        add_number(st, "humidity-pct", 1, 50, 0, 100, false);
+        sensor_attach_one(u, "sht30", st, 0x44);
+
+        M5UnitSensor *bp = sensor_device(u);
+        bp->kind = US_BMP280;
+        bp->values[0] = 25;  /* BMP280's own temperature is not exposed on ENV-II */
+        bp->regs[0][0xd0] = 0x58;
+        bmp280_fill_calibration(bp);
+        add_number(bp, "pressure-pa", 1, 101325, 30000, 110000, false);
+        sensor_attach_one(u, "bmp280", bp, 0x76);
+        return;
     }
 
     M5UnitSensor *s = sensor_device(u);
@@ -2076,7 +2148,9 @@ void m5_unit_sensor_realize(M5Unit *u, Error **errp)
         add_number(s, "red-raw", 1, 400, 0, 65535, true);
         add_number(s, "green-raw", 2, 300, 0, 65535, true);
         add_number(s, "blue-raw", 3, 200, 0, 65535, true);
-    } else if (!strcmp(u->unit_id, "tof")) {
+    } else if (!strcmp(u->unit_id, "tof") || !strcmp(u->unit_id, "mini-tof-90")) {
+        /* U010 tof and U196 Mini ToF-90 both alias VL53L0X; the 90-degree
+         * mounting orientation does not change the protocol. */
         s->kind = US_TOF; address = 0x29; tof_reset(s);
         add_number(s, "distance-mm", 0, 1000, 30, 2000, true);
     } else if (!strcmp(u->unit_id, "ncir")) {
