+/* U085 CAN / U179 Mini CAN: observe frames on the board's m5-canbus and expose
+ * a QOM inject-hex fixture that sends one frame onto the same bus. Frame
+ * direction/filtering/bit timing and external transceiver behavior are NOT
+ * modeled; the counters are bus-level observation only. */
+static bool m5_unit_can_can_receive(CanBusClientState *client)
+{
+    return true;
+}
+
+static void can_format_frame(char out[32], uint32_t id, const uint8_t *data, unsigned len)
+{
+    size_t used = (size_t)snprintf(out, 32, "%x#", id);
+    for (unsigned i = 0; i < len && used + 2 < 32; i++) {
+        used += (size_t)snprintf(out + used, 32 - used, "%02x", data[i]);
+    }
+}
+
+static ssize_t m5_unit_can_receive(CanBusClientState *client,
+                                   const struct qemu_can_frame *frames,
+                                   size_t frames_cnt)
+{
+    GPIOUnit *g = container_of(client, GPIOUnit, can_client);
+    if (!frames_cnt) { return 0; }
+    const struct qemu_can_frame *frame = &frames[0];
+    uint32_t id = frame->can_id & QEMU_CAN_EFF_MASK;
+    unsigned len = frame->can_dlc > 8 ? 8 : frame->can_dlc;
+    g->can_frames_observed++;
+    can_format_frame(g->can_last_frame_hex, id, frame->data, len);
+    return frames_cnt;
+}
+
+static CanBusClientInfo m5_unit_can_info = {
+    .can_receive = m5_unit_can_can_receive,
+    .receive = m5_unit_can_receive,
+};
+
+static void can_last_hex_get(Object *o, Visitor *v, const char *name,
+                             void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = g_strdup(g->can_last_frame_hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void can_inject_get(Object *o, Visitor *v, const char *name,
+                           void *op, Error **errp)
+{
+    char *value = g_strdup("");
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void can_inject_set(Object *o, Visitor *v, const char *name,
+                           void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    char *sep = strchr(value, '#');
+    if (!sep) { sep = strchr(value, ':'); }
+    if (!sep) {
+        error_setg(errp, "inject-hex must be <id>#<data-hex>");
+        g_free(value); return;
+    }
+    *sep = 0;
+    char *end = NULL;
+    unsigned long id = strtoul(value, &end, 16);
+    if (end == value || *end || id > QEMU_CAN_EFF_MASK) {
+        error_setg(errp, "inject-hex has an invalid CAN id");
+        g_free(value); return;
+    }
+    const char *data_hex = sep + 1;
+    size_t n = strlen(data_hex);
+    if (n > 16 || n % 2 || strspn(data_hex, "0123456789abcdefABCDEF") != n) {
+        error_setg(errp, "inject-hex data must be 0..8 bytes of hex");
+        g_free(value); return;
+    }
+    struct qemu_can_frame frame = { .can_id = (qemu_canid_t)id, .can_dlc = (uint8_t)(n / 2) };
+    for (size_t i = 0; i < n / 2; i++) {
+        char byte[] = {data_hex[i * 2], data_hex[i * 2 + 1], 0};
+        frame.data[i] = (uint8_t)strtoul(byte, NULL, 16);
+    }
+    can_bus_client_send(&g->can_client, &frame, 1);
+    g->can_injected_frames++;
+    g_free(value);
+}
