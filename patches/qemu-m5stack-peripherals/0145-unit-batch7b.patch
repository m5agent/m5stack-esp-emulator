+/* U171 Mini IMU-Pro: BMI270 data registers are synthetic fixture bytes. Accel
+ * uses 2048 LSB/g and gyro 16.4 LSB/dps as fixed demo scaling; the guest's
+ * configured ranges are NOT used by this planned model. BMM150 is exposed as a
+ * simple 16-bit aux window at 0x04..0x09 (raw = uT * 16); the full BMI270 aux
+ * command sequence is NOT modeled. */
+static void bmi270_refresh(M5UnitSensor *s)
+{
+    uint8_t *r = s->regs[0];
+    r[0x00] = 0x24;  /* BMI270 WHO_AM_I */
+    for (unsigned i = 0; i < 3; i++) {
+        int16_t a = (int16_t)CLAMP(llround(s->values[i] * 2048.0), -32768, 32767);
+        int16_t g = (int16_t)CLAMP(llround(s->values[3 + i] * 16.4), -32768, 32767);
+        int16_t m = (int16_t)CLAMP(llround(s->values[6 + i] * 16.0), -32768, 32767);
+        le16(r + 0x0c + i * 2, (uint16_t)a);
+        le16(r + 0x12 + i * 2, (uint16_t)g);
+        le16(r + 0x04 + i * 2, (uint16_t)m);
+    }
+    int16_t temp = (int16_t)CLAMP(llround((s->values[9] - 25.0) * 512.0), -32768, 32767);
+    be16(r + 0x20, (uint16_t)temp);
+}
