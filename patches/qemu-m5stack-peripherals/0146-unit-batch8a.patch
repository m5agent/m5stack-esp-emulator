+
 static void gps_lines_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
 {
     GPIOUnit *g = op;
@@ -1595,7 +1621,7 @@ void m5_unit_gpio_realize(M5Unit *unit, bool s3, Error **errp)
     }
     if (!s3 && (!strcmp(unit->unit_id, "ir") || !strcmp(unit->unit_id, "rs485") ||
                 !strcmp(unit->unit_id, "rs485-iso") || !strcmp(unit->unit_id, "midi") ||
-                !strcmp(unit->unit_id, "gps") || !strcmp(unit->unit_id, "uhf-rfid") ||
+                gpio_gps_unit(unit->unit_id) || !strcmp(unit->unit_id, "uhf-rfid") ||
                 !strcmp(unit->unit_id, "lora-e220-433") ||
                 !strcmp(unit->unit_id, "zigbee") || !strcmp(unit->unit_id, "nbiot2") ||
                 !strcmp(unit->unit_id, "synth") ||
@@ -1727,13 +1753,17 @@ void m5_unit_gpio_realize(M5Unit *unit, bool s3, Error **errp)
         object_property_add(o, "weight-g", "number", hx_weight_get, NULL, NULL, g);
         object_property_add(o, "conversions", "uint64", count_get, NULL, NULL, &g->hx_conversions);
         object_property_add(o, "ready-level", "bool", hx_ready_get, NULL, NULL, g);
-    } else if (!strcmp(id, "gps")) {
+    } else if (gpio_gps_unit(id)) {
+        /* U032 GPS (9600 frozen driver) and U032-V11/U190 AT6668 (115200 page):
+         * same NMEA path; the baud fixture keeps the conflict UNRESOLVED. */
+        g->gps_baud = 9600;
         g->gps_lines = g_strdup("$GNGGA,024423.000,2242.10772,N,11348.64472,E,1,14,1.2,52.1,M,0.0,M,,*48");
         g->gps_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, gps_timer_cb, g);
         timer_mod_ns(g->gps_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + INT64_C(50000000));
