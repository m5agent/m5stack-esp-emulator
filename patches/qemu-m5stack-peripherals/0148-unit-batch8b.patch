+    uint64_t disp_commands, disp_data_bytes, disp_pixels;
 } M5UnitControl;
 OBJECT_DECLARE_SIMPLE_TYPE(M5UnitControl, M5_UNIT_CONTROL)
 
@@ -1934,9 +1958,172 @@ static void pahub_dip_set(Object *obj, Visitor *v, const char *name, void *opaqu
     s->unit->input_events++;
 }
 
+
+/* ==== U119/U166/U158-B shared OLED display command slave (batch8b, 0148) ==== */
+static void disp_fb_store(M5UnitControl *s, uint8_t value)
+{
+    unsigned page_bytes = s->disp_page_bytes;
+    if (!s->disp_fb || !page_bytes || s->disp_page >= s->disp_height / 8) { return; }
+    unsigned offset = s->disp_page * page_bytes + (s->disp_col % page_bytes);
+    s->disp_fb[offset] = value;
+    s->disp_pixels++;
+    if (++s->disp_col >= page_bytes) {
+        s->disp_col = 0;
+        if (s->disp_page + 1 < s->disp_height / 8) { s->disp_page++; }
+    }
+}
+
+static void disp_apply_param(M5UnitControl *s)
+{
+    switch (s->disp_cmd_buf[0]) {
+    case 0x81: s->disp_contrast = s->disp_param[0]; break;
+    case 0xdc: s->disp_start_line = s->disp_param[0] & 0x7f; break;
+    case 0x21: s->disp_col = s->disp_param[0]; break;
+    case 0x22: s->disp_page = s->disp_param[0] & 0x07; break;
+    default: break;  /* mux/offset/clock/precharge/com/vcom/memory-mode */
+    }
+}
+
+static void disp_parse_command(M5UnitControl *s)
+{
+    if (!s->disp_cmd_len) { return; }
+    uint8_t cmd = s->disp_cmd_buf[0];
+    s->disp_commands++;
+    switch (cmd) {
+    case 0x81: case 0x20: case 0xa8: case 0xd3: case 0xd5: case 0xd9:
+    case 0xda: case 0xdb: case 0xdc:
+        s->disp_pending = 1; s->disp_param_len = 0;
+        break;
+    case 0x21: case 0x22:
+        s->disp_pending = 2; s->disp_param_len = 0;
+        break;
+    case 0xae: s->disp_display_on = 0; break;
+    case 0xaf: s->disp_display_on = 1; break;
+    case 0xa6: s->disp_inverse = 0; break;
+    case 0xa7: s->disp_inverse = 1; break;
+    case 0x00: case 0x01: case 0x02: case 0x03: case 0x04: case 0x05:
+    case 0x06: case 0x07: case 0x08: case 0x09: case 0x0a: case 0x0b:
+    case 0x0c: case 0x0d: case 0x0e: case 0x0f:
+        s->disp_col = (s->disp_col & 0xf0) | cmd;
+        break;
+    case 0x10: case 0x11: case 0x12: case 0x13: case 0x14: case 0x15:
+    case 0x16: case 0x17: case 0x18: case 0x19: case 0x1a: case 0x1b:
+    case 0x1c: case 0x1d: case 0x1e: case 0x1f:
+        s->disp_col = (s->disp_col & 0x0f) | ((cmd & 0x0f) << 4);
+        break;
+    case 0xb0: case 0xb1: case 0xb2: case 0xb3: case 0xb4: case 0xb5:
+    case 0xb6: case 0xb7:
+        s->disp_page = cmd & 0x07;
+        break;
+    default: break;
+    }
+    unsigned copy = MIN(s->disp_cmd_len, sizeof(s->disp_last));
+    memcpy(s->disp_last, s->disp_cmd_buf, copy);
+    s->disp_last_len = copy;
+    s->disp_cmd_len = 0;
+}
+
+static void disp_consume_command_byte(M5UnitControl *s, uint8_t value)
+{
+    if (s->disp_pending) {
+        if (s->disp_param_len < sizeof(s->disp_param)) { s->disp_param[s->disp_param_len] = value; }
+        s->disp_param_len++;
+        if (s->disp_param_len >= s->disp_pending) {
+            disp_apply_param(s);
+            s->disp_pending = 0;
+            s->disp_param_len = 0;
+        }
+        return;
+    }
+    if (s->disp_cmd_len < sizeof(s->disp_cmd_buf)) { s->disp_cmd_buf[s->disp_cmd_len] = value; }
+    s->disp_cmd_len++;
+    disp_parse_command(s);
+}
+
+static void disp_consume_byte(M5UnitControl *s, uint8_t value)
+{
+    if (!s->disp_ctrl_seen) {
+        s->disp_ctrl_seen = true;
+        s->disp_ctrl = value;
+        if (value == 0x00 || value == 0x40) { s->disp_in_data = value == 0x40; return; }
+        /* Lenient fallback for a driver that omits the control byte. */
+        s->disp_in_data = false;
+    }
+    if (s->disp_in_data) {
+        s->disp_data_bytes++;
+        disp_fb_store(s, value);
+    } else {
+        disp_consume_command_byte(s, value);
+    }
+}
+
+static uint32_t disp_fb_crc(M5UnitControl *s)
+{
+    uint32_t crc = 0xffffffffu;
+    size_t bytes = (size_t)s->disp_width * s->disp_height / 8u;
+    for (size_t i = 0; i < bytes; i++) {
+        crc ^= s->disp_fb[i];
+        for (unsigned k = 0; k < 8; k++) { crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1))); }
+    }
+    return ~crc;
+}
+
+static void disp_fb_hex_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    size_t bytes = (size_t)s->disp_width * s->disp_height / 8u;
+    char *hex = g_malloc(bytes * 2 + 1);
+    for (size_t i = 0; i < bytes; i++) { g_snprintf(hex + i * 2, 3, "%02x", s->disp_fb[i]); }
+    hex[bytes * 2] = 0;
+    char *value = g_strdup(hex);
+    g_free(hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void disp_controller_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    static const char *const names[] = {"sh1107", "ssd1315", "ssd1309"};
+    char *value = g_strdup(names[s->disp_controller]);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void disp_last_hex_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    char hex[sizeof(s->disp_last) * 2 + 1];
+    for (unsigned i = 0; i < s->disp_last_len; i++) { g_snprintf(hex + i * 2, 3, "%02x", s->disp_last[i]); }
+    hex[s->disp_last_len * 2] = 0;
+    char *value = g_strdup(hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void disp_fb_crc_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = disp_fb_crc(s);
+    visit_type_int64(v, name, &value, errp);
+}
+
 static int control_event(I2CSlave *dev, enum i2c_event event)
 {
     M5UnitControl *s = M5_UNIT_CONTROL(dev);
+    if (s->kind == CONTROL_UNIT_DISPLAY) {
+        if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
+            s->unit->transactions++; s->write_pos = 0; s->reading = false;
+            s->disp_ctrl_seen = false; s->disp_in_data = false;
+            s->disp_cmd_len = 0; s->disp_pending = 0; s->disp_param_len = 0;
+            s->disp_last_len = 0;
+        } else if (event == I2C_START_RECV) {
+            s->unit->transactions++; s->read_pos = 0; s->reading = true;
+        } else if (event == I2C_FINISH) {
+            s->reading = false;
+        }
+        return 0;
+    }
     if (s->kind == CONTROL_UNIT_LCD) {
         if (event == I2C_START_SEND || event == I2C_START_SEND_ASYNC) {
             s->unit->transactions++; s->write_pos = 0; s->reading = false;
@@ -1989,6 +2176,10 @@ static int control_send(I2CSlave *dev, uint8_t value)
 {
     M5UnitControl *s = M5_UNIT_CONTROL(dev);
     s->unit->written_bytes++;
+    if (s->kind == CONTROL_UNIT_DISPLAY) {
+        disp_consume_byte(s, value);
+        return 0;
+    }
     if (s->kind == CONTROL_UNIT_LCD) {
         /* Command byte first, then per-command payload until STOP. WRITE_RAW/
          * DRAWPIXEL payloads can be a whole frame, so the small command log is
@@ -2561,6 +2752,9 @@ static uint8_t control_recv(I2CSlave *dev)
 {
     M5UnitControl *s = M5_UNIT_CONTROL(dev);
     s->unit->read_bytes++;
+    if (s->kind == CONTROL_UNIT_DISPLAY) {
+        return 0xff;  /* the monochrome display Units are write-only on I2C */
+    }
     if (s->kind == CONTROL_UNIT_LCD) {
         return s->lcd_read_pos < s->lcd_read_len ? s->lcd_read_buf[s->lcd_read_pos++] : 0x00;
     }
@@ -2702,6 +2896,7 @@ bool m5_unit_controls_supported(const char *unit_id)
         "joystick2", "8servos", "servo8-hat", "4relay", "weight-i2c",
