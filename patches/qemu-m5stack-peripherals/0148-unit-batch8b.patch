     I2CSlave parent_obj;
     M5Unit *unit;
@@ -210,6 +217,23 @@ typedef struct M5UnitControl {
     uint16_t lcd_x0, lcd_y0, lcd_x1, lcd_y1, lcd_cx, lcd_cy;
