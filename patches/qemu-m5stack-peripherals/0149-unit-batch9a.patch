             event == I2C_START_RECV) {
@@ -2204,6 +2351,24 @@ static int control_send(I2CSlave *dev, uint8_t value)
         }
         return 0;
     }
+    if (s->kind == CONTROL_UNIT_GLASS) {
+        /* SSD1309 I2C framing: first byte is the control byte 0x00 (commands)
+         * or 0x40 (GDDRAM data); the rest of the transaction is that stream. */
+        if (s->write_pos == 0) {
+            s->glass_control = value;
+            s->write_pos = 1;
+            return 0;
+        }
+        s->write_pos++;
+        if (s->glass_control == 0x40) {
+            s->glass_fb[s->glass_page * 128 + s->glass_col] = value;
+            s->glass_data_bytes++;
+            s->glass_col = (s->glass_col + 1) & 0x7f;
+        } else if (s->glass_control == 0x00) {
+            glass_stream_command(s, value);
+        }
+        return 0;
+    }
     if (s->kind == CONTROL_PAHUB) {
         /* Direct 1-byte channel-mask write; no register pointer phase. */
         s->pahub_mask = value;
@@ -2758,6 +2923,10 @@ static uint8_t control_recv(I2CSlave *dev)
     if (s->kind == CONTROL_UNIT_LCD) {
         return s->lcd_read_pos < s->lcd_read_len ? s->lcd_read_buf[s->lcd_read_pos++] : 0x00;
     }
+    if (s->kind == CONTROL_UNIT_GLASS) {
+        /* SSD1309 is write-only on this Unit; reads return the idle ACK byte. */
+        return 0x00;
+    }
     if (s->kind == CONTROL_PAHUB) {
         return s->pahub_mask;
     }
@@ -2895,7 +3064,7 @@ bool m5_unit_controls_supported(const char *unit_id)
         "joystick-v11", "encoder", "8encoder", "cardkb", "rfid2", "scroll",
         "joystick2", "8servos", "servo8-hat", "4relay", "weight-i2c",
         "ncir2", "extio2", "hbridge", "hbridge-v11", "dac", "joystick",
-        "cardkb-original", "extencoder", "acssr", "pbhub", "pbhub-v11", "bldc-driver", "dds", "rfid", "extio", "dac2", "scales", "pahub-v20", "pahub-v21", "mini-scales", "lcd",
+        "cardkb-original", "extencoder", "acssr", "pbhub", "pbhub-v11", "bldc-driver", "dds", "rfid", "extio", "dac2", "scales", "pahub-v20", "pahub-v21", "mini-scales", "lcd", "glass",
