+/* ---- U114 RF433T / U113 RF433R (GPIO bitstream observation, driver gap) ---- */
+static void rf433_tx_output_changed(void *opaque, int pin, int level)
+{
+    GPIOUnit *g = opaque;
+    if (pin != g->unit->yellow) { return; }
+    level = !!level;
+    g->rf433_tx_bits++;
+    g->unit->output_transitions++;
+    if (g->rf433_tx_level != level) {
+        g->rf433_tx_edges++;
+        g->rf433_tx_level = level;
+    }
+    if (g->rf433_tx_bits_len < sizeof(g->rf433_tx_bits_text) - 1) {
+        g->rf433_tx_bits_text[g->rf433_tx_bits_len++] = level ? '1' : '0';
+        g->rf433_tx_bits_text[g->rf433_tx_bits_len] = 0;
+    }
+}
+
+static void rf433_tx_output_reset(void *opaque, int pin, int level)
+{
+    GPIOUnit *g = opaque;
+    (void)level;
+    if (pin != g->unit->yellow) { return; }
+    g->rf433_tx_level = esp32_gpio_get_line(g->unit->yellow);
+    g->rf433_tx_edges = 0;
+    g->rf433_tx_bits = 0;
+    g->rf433_tx_bits_len = 0;
+    g->rf433_tx_bits_text[0] = 0;
+}
