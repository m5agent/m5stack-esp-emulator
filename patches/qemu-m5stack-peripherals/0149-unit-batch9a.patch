+    g_free(value);
+}
+
+static void rf433_rx_level_get(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool value = g->rf433_rx_level;
+    visit_type_bool(v, name, &value, errp);
+}
+
+static void rf433_rx_level_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool value;
+    if (!visit_type_bool(v, name, &value, errp)) { return; }
+    g->rf433_rx_level = value;
