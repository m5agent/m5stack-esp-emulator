+}
+
+static void rf433_rx_rate_set(Object *o, Visitor *v, const char *name, void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    if (value < 300 || value > 10000) { error_setg(errp, "sample-rate must be 300..10000 Hz"); return; }
