+/* U158 Unit Glass: minimal SSD1309 control/command/data model. Only the
+ * controller-visible display register state and GDDRAM are modelled; the
+ * transparent-OLED optics and the STM32 button/buzzer behavior are NOT RUN. */
+static uint32_t glass_fb_crc(M5UnitControl *s)
+{
+    uint32_t crc = 0xffffffffu;
+    for (size_t i = 0; i < sizeof(s->glass_fb); i++) {
+        crc ^= s->glass_fb[i];
+        for (unsigned k = 0; k < 8; k++) { crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1))); }
+    }
+    return ~crc;
+}
+
+static void glass_apply(M5UnitControl *s, uint8_t cmd)
+{
+    switch (cmd) {
+    case 0xae: s->glass_display_on = false; break;
+    case 0xaf: s->glass_display_on = true; break;
+    case 0x81: if (s->glass_arg_len >= 1) { s->glass_contrast = s->glass_args[0]; } break;
+    case 0x20: break;  /* memory addressing mode: only horizontal-page mode used */
+    case 0x21: if (s->glass_arg_len >= 1) { s->glass_col = s->glass_args[0] & 0x7f; } break;
+    case 0x22: if (s->glass_arg_len >= 1) { s->glass_page = s->glass_args[0] & 0x07; } break;
+    case 0x40: case 0x41: case 0x42: case 0x43:
+    case 0x44: case 0x45: case 0x46: case 0x47:
+    case 0x48: case 0x49: case 0x4a: case 0x4b:
+    case 0x4c: case 0x4d: case 0x4e: case 0x4f:
+    case 0x50: case 0x51: case 0x52: case 0x53:
+    case 0x54: case 0x55: case 0x56: case 0x57:
+    case 0x58: case 0x59: case 0x5a: case 0x5b:
+    case 0x5c: case 0x5d: case 0x5e: case 0x5f:
+        break;  /* display start line: no optical model */
+    default:
+        if (cmd >= 0xb0 && cmd <= 0xb7) { s->glass_page = cmd & 0x07; }
+        else if (cmd <= 0x0f) { s->glass_col = (s->glass_col & 0xf0) | cmd; }
+        else if (cmd >= 0x10 && cmd <= 0x1f) { s->glass_col = ((cmd & 0x0f) << 4) | (s->glass_col & 0x0f); }
+        /* remaining SSD1309 configuration commands (MUX/offset/COM/charge pump/
+         * segment remap/contrast timing) keep their controller-visible bytes in
+         * command-hex only; no electrical/optical behavior is modeled. */
+        break;
+    }
+}
+
+static void glass_stream_command(M5UnitControl *s, uint8_t value)
+{
+    if (s->glass_cmd_len < sizeof(s->glass_cmd)) { s->glass_cmd[s->glass_cmd_len++] = value; }
+    if (s->glass_arg_len < s->glass_arg_need) {
+        if (s->glass_arg_len < sizeof(s->glass_args)) { s->glass_args[s->glass_arg_len] = value; }
+        s->glass_arg_len++;
+        if (s->glass_arg_len == s->glass_arg_need) { glass_apply(s, s->glass_pending); }
+        return;
+    }
+    s->glass_pending = value;
+    s->glass_arg_len = 0;
+    switch (value) {
+    case 0x81: s->glass_arg_need = 1; break;
+    case 0x20: s->glass_arg_need = 1; break;
+    case 0x21: case 0x22: s->glass_arg_need = 2; break;
+    default: s->glass_arg_need = 0; break;
+    }
+    s->glass_commands++;
+    if (s->glass_arg_need == 0) { glass_apply(s, value); }
+}
+
+static void glass_cmd_hex_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    char hex[sizeof(s->glass_cmd) * 2 + 1];
+    for (unsigned i = 0; i < s->glass_cmd_len; i++) { g_snprintf(hex + i * 2, 3, "%02x", s->glass_cmd[i]); }
+    hex[s->glass_cmd_len * 2] = 0;
+    char *value = g_strdup(hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void glass_fb_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    char hex[9];
+    g_snprintf(hex, sizeof(hex), "%08x", glass_fb_crc(s));
+    char *value = g_strdup(hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void glass_buttons_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = s->glass_buttons_fixture;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void glass_buttons_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    if (value < 0 || value > 3) { error_setg(errp, "button-states must be a 2-bit mask"); return; }
+    s->glass_buttons_fixture = value;
+    s->unit->input_events++;
+}
+
+static void glass_buzzer_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    char *value = g_strdup(s->glass_buzzer_hex);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void glass_buzzer_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    if (strlen(value) > sizeof(s->glass_buzzer_hex) - 1) {
+        g_free(value); error_setg(errp, "buzzer-hex is limited to 16 hex chars"); return;
+    }
+    g_strlcpy(s->glass_buzzer_hex, value, sizeof(s->glass_buzzer_hex));
+    g_free(value);
+    s->unit->input_events++;
+}
+
 static int control_event(I2CSlave *dev, enum i2c_event event)
 {
     M5UnitControl *s = M5_UNIT_CONTROL(dev);
@@ -2147,6 +2282,18 @@ static int control_event(I2CSlave *dev, enum i2c_event event)
         }
