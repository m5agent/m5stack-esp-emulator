From 2f8e4a6c1d3b5e7f9a0b2c4d6e8f1a3b5c7d9e1f Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Tue, 3 Nov 2026 02:20:00 +0800
Subject: [PATCH] hw/m5stopwatch: fix batch-7 UART responder capture/injection

Fix the batch-7 UART evidence gaps found by guest/Device Service evidence.
Base: canonical 75f1d24 + 28-layer canonical chain through 0147 (incl. 0143
batch7 A and 0145 batch7 B).

- The 0145 batch-7 UART ids (catm, catm-gnss, lorawan-cn470) were added to the
  TX-capture condition but not to the generic idle-time responder body, so the
  captured bytes never armed the fixture timer: frames-sent/frames-injected
  stayed 0 and the frozen CATM/CATM-GNSS/LoRaWAN drivers timed out on every AT
  command. Extend the responder body with the three ids.
- gpio_uart_rx_device_for_white() only looked up the UART through the guest's
  GPIO-matrix RX route. The frozen ASR650x wrapper creates UART(1, tx, rx) and
  calls init() in a way that the responder's RX lookup did not see, so injected
  fixture bytes never reached the guest RX FIFO (frames-injected 0). Add a
  fallback that reuses the UART whose TX signal is routed to the Unit yellow pin;
  the fixture is still injected into the real UART RX FIFO.

No model protocol decode is added: the UART units remain byte-layer fixture
responders, with SIM7080G/GNSS/LoRaWAN AT semantics and RF/cellular behavior
left unresolved/NOT RUN.
--- a/hw/m5stopwatch/m5_unit_gpio.c
+++ b/hw/m5stopwatch/m5_unit_gpio.c
@@ -1028,7 +1028,13 @@
                            !strcmp(g->unit->unit_id, "nbiot2") ||
                            !strcmp(g->unit->unit_id, "uwb") ||
                            !strcmp(g->unit->unit_id, "dmx") ||
-                           !strcmp(g->unit->unit_id, "finger")) {
+                           !strcmp(g->unit->unit_id, "finger") ||
+                           !strcmp(g->unit->unit_id, "catm") ||
+                           !strcmp(g->unit->unit_id, "catm-gnss") ||
+                           !strcmp(g->unit->unit_id, "lorawan-cn470")) {
+                    /* Batch-7 UART units use the same idle-time fixture
+                     * responder as nbiot2; the 0145 list update registered the
+                     * unit ids but this capture body was missed. */
                     if (g->at_len < sizeof(g->at_buf)) { g->at_buf[g->at_len++] = byte; }
                     at_arm_idle(g);
                 }
@@ -1173,6 +1179,16 @@
             DeviceState *uart = m5soc_get_uart_device(n);
             if (uart) { *uart_out = uart; return true; }
         }
+    }
+    /* Fallback for frozen drivers that create/init their UART without the
+     * GPIO-matrix RX route seen by the responder (e.g. the ASR650x wrapper):
+     * reuse the UART whose TX signal is routed to this Unit's yellow pin. The
+     * fixture is still injected into the real UART RX FIFO. */
+    for (unsigned n = 0; n < 3; n++) {
+        if (esp32_gpio_matrix_out_signal(g->unit->yellow, true) == uart_signal[n]) {
+            DeviceState *uart = m5soc_get_uart_device(n);
+            if (uart) { *uart_out = uart; return true; }
+        }
     }
     return false;
 }
