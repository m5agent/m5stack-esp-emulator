         "neohex", "hex", "lora-e220-433", "zigbee", "nbiot2",
-        "catm", "catm-gnss", "lorawan-cn470", "can", "mini-can",
+        "catm", "catm-gnss", "lorawan-cn470", "lorawan-as923", "lorawan-eu868",
