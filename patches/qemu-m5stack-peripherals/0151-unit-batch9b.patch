                 !strcmp(unit->unit_id, "lora-e220-920") ||
                 !strcmp(unit->unit_id, "lorawan-us915") ||
@@ -1976,7 +1987,9 @@ void m5_unit_gpio_realize(M5Unit *unit, bool s3, Error **errp)
                !strcmp(id, "nbiot2") || !strcmp(id, "uwb") ||
                !strcmp(id, "dmx") || !strcmp(id, "finger") ||
                !strcmp(id, "catm") || !strcmp(id, "catm-gnss") ||
-               !strcmp(id, "lorawan-cn470") || !strcmp(id, "nbiot-cn") ||
+               !strcmp(id, "lorawan-cn470") || !strcmp(id, "lorawan-as923") ||
+               !strcmp(id, "lorawan-eu868") || !strcmp(id, "audioplayer") ||
+               !strcmp(id, "fingerprint2") || !strcmp(id, "nbiot-cn") ||
                !strcmp(id, "lora-e220-920") || !strcmp(id, "lorawan-us915")) {
         g->at_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, at_idle_cb, g);
         object_property_add(o, "responses-hex", "str", at_responses_get,
