From e5a4bb83d4a088742c68dd99cdb53fc2aa32ce81 Mon Sep 17 00:00:00 2001
From: m5agent <m5agent@m5stack.com>
Date: Tue, 3 Nov 2026 03:38:43 +0800
Subject: [PATCH] hw/m5stopwatch: fix Unit LCD read-after-command transaction

The frozen reference-firmware LCDUnit init writes READ_ID/READ_BUFCOUNT as one
I2C transaction and reads the response in a separate transaction. The 0146
model cleared lcd_cmd_buf when the write transaction FINISHed, so the read
phase fell back to a zero-length response and the guest driver aborted with
OSError("LCD Unit init failed"). Keep using the last-command log for the read
phase; the LCD session then passes READ_ID and the subsequent framebuffer
commands.

Base in the reconciled canonical order is the 33-layer chain through 0152
(canonical 75f1d24 plus 0120-0129, 0131, 0134, 0136, 0130, 0133, 0135, 0132,
0137, 0138, 0139, 0140, 0141, 0142, 0143, 0144, 0145, 0146, 0147, 0148, 0149,
0150, 0151 and 0152); this is the 34th layer after 0120 and it applies at the
chain end.
---
 hw/m5stopwatch/m5_unit_i2c_controls.c | 22 +++++++++++++---------
 1 file changed, 13 insertions(+), 9 deletions(-)

diff --git a/hw/m5stopwatch/m5_unit_i2c_controls.c b/hw/m5stopwatch/m5_unit_i2c_controls.c
index 13c9421..9af8b1a 100644
--- a/hw/m5stopwatch/m5_unit_i2c_controls.c
+++ b/hw/m5stopwatch/m5_unit_i2c_controls.c
@@ -2266,15 +2266,19 @@ static int control_event(I2CSlave *dev, enum i2c_event event)
         } else if (event == I2C_START_RECV) {
             s->unit->transactions++; s->read_pos = 0; s->reading = true;
             s->lcd_read_len = s->lcd_read_pos = 0;
-            if (s->lcd_cmd_len >= 1) {
-                uint8_t cmd = s->lcd_cmd_buf[0];
-                if (cmd == 0x04) {
-                    memcpy(s->lcd_read_buf, s->lcd_read_id, 4);
-                    s->lcd_read_len = 4;
-                } else if (cmd == 0x09) {
-                    put_le32(s->lcd_read_buf, (uint32_t)s->lcd_bufcount);
-                    s->lcd_read_len = 4;
-                }
+            /* READ_ID/READ_BUFCOUNT arrive as a command write followed by a
+             * separate read transaction. The command buffer is cleared when the
+             * write FINISHes, so fall back to the last-command log; otherwise
+             * the read phase always returned 0x00 and the frozen driver's
+             * LCDUnit init failed with OSError("LCD Unit init failed"). */
+            uint8_t cmd = s->lcd_cmd_len >= 1 ? s->lcd_cmd_buf[0] :
+                          (s->lcd_last_len >= 1 ? s->lcd_last[0] : 0);
+            if (cmd == 0x04) {
+                memcpy(s->lcd_read_buf, s->lcd_read_id, 4);
+                s->lcd_read_len = 4;
+            } else if (cmd == 0x09) {
+                put_le32(s->lcd_read_buf, (uint32_t)s->lcd_bufcount);
+                s->lcd_read_len = 4;
             }
         } else if (event == I2C_FINISH) {
             if (s->reading) { s->reading = false; }
-- 
