 } M5UnitControl;
 OBJECT_DECLARE_SIMPLE_TYPE(M5UnitControl, M5_UNIT_CONTROL)
 
@@ -1635,6 +1665,13 @@ static void scales_fw_get(Object *obj, Visitor *v, const char *name,
     visit_type_int64(v, name, &value, errp);
 }
 
+static void byteunit_refresh(M5UnitControl *s);
+static void step16_refresh(M5UnitControl *s);
+static void timerpwr_refresh(M5UnitControl *s);
+static void mq_refresh(M5UnitControl *s);
+static void servos8_refresh(M5UnitControl *s);
+static void cardkb2_refresh(M5UnitControl *s);
+
 static void snapshot_registers(M5UnitControl *s)
 {
     memcpy(s->read_snapshot, s->regs, 256);
@@ -1815,6 +1852,12 @@ static void snapshot_registers(M5UnitControl *s)
         r[0xfe] = 1;
         r[0xff] = I2C_SLAVE(s)->address;
     }
+    if (s->kind == CONTROL_BYTEUNIT) { byteunit_refresh(s); }
+    else if (s->kind == CONTROL_STEP16) { step16_refresh(s); }
+    else if (s->kind == CONTROL_TIMERPWR) { timerpwr_refresh(s); }
+    else if (s->kind == CONTROL_MQ) { mq_refresh(s); }
+    else if (s->kind == CONTROL_SERVOS8V2) { servos8_refresh(s); }
+    else if (s->kind == CONTROL_CARDKB2) { cardkb2_refresh(s); }
 }
 
 /* U120 Unit LCD: minimal ST7789V2 I2C command model. The framebuffer is
@@ -2250,6 +2293,376 @@ static void glass_buzzer_set(Object *obj, Visitor *v, const char *name, void *op
     s->unit->input_events++;
 }
 
+
+/* ===== batch12a driver-gap Unit models (patch 0157) ===== */
+static void put_le16(uint8_t *p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
+static void put_le32v(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+static uint8_t nib_hex_digit(char c)
+{
+    if (c >= '0' && c <= '9') { return (uint8_t)(c - '0'); }
+    if (c >= 'a' && c <= 'f') { return (uint8_t)(c - 'a' + 10); }
+    if (c >= 'A' && c <= 'F') { return (uint8_t)(c - 'A' + 10); }
+    return 0;
+}
+static unsigned parse_hex_bytes(const char *text, uint8_t *out, unsigned max)
+{
+    unsigned n = 0;
+    while (text[0] && text[1] && n < max) {
+        out[n++] = (uint8_t)((nib_hex_digit(text[0]) << 4) | nib_hex_digit(text[1]));
+        text += 2;
+        while (*text == ' ' || *text == ',' || *text == ':') { text++; }
+    }
+    return n;
+}
+static void format_hex(char *out, const uint8_t *data, unsigned n)
+{
+    for (unsigned i = 0; i < n; i++) { g_snprintf(out + i * 2, 3, "%02x", data[i]); }
+    out[n * 2] = 0;
+}
+
+typedef struct ControlHex {
+    M5UnitControl *s;
+    uint8_t *data;
+    unsigned len;
+} ControlHex;
+
+static void control_hex_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ControlHex *h = opaque;
+    char *text = g_malloc(h->len * 2 + 1);
+    format_hex(text, h->data, h->len);
+    char *value = g_strdup(text);
+    g_free(text);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void control_hex_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ControlHex *h = opaque;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    memset(h->data, 0, h->len);
+    parse_hex_bytes(value, h->data, h->len);
+    h->s->unit->input_events++;
+    g_free(value);
+}
+
+static void control_hex_release(Object *obj, const char *name, void *opaque) { g_free(opaque); }
+
+static void add_control_hex(M5UnitControl *s, const char *name, uint8_t *data, unsigned len)
+{
+    ControlHex *h = g_new0(ControlHex, 1);
+    *h = (ControlHex){ s, data, len };
+    object_property_add(OBJECT(s->unit), name, "str", control_hex_get,
+                        control_hex_set, control_hex_release, h);
+}
+
+typedef struct ControlTime {
+    M5UnitControl *s;
+    int64_t *hms;
+} ControlTime;
+
+static void control_time_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ControlTime *t = opaque;
+    char text[8];
+    g_snprintf(text, sizeof(text), "%02d:%02d", (int)t->hms[0], (int)t->hms[1]);
+    char *value = g_strdup(text);
+    visit_type_str(v, name, &value, errp);
+    g_free(value);
+}
+
+static void control_time_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    ControlTime *t = opaque;
+    char *value = NULL;
+    if (!visit_type_str(v, name, &value, errp)) { return; }
+    unsigned h = 0, m = 0, s = 0;
+    int matched = sscanf(value, "%u:%u:%u", &h, &m, &s);
+    if (matched < 2 || h > 23 || m > 59 || s > 59) {
+        error_setg(errp, "%s must be HH:MM[:SS]", name);
+        g_free(value); return;
+    }
+    t->hms[0] = h; t->hms[1] = m; t->hms[2] = s;
+    t->s->unit->input_events++;
+    g_free(value);
+}
+
+static void control_time_release(Object *obj, const char *name, void *opaque) { g_free(opaque); }
+
+static void add_control_time(M5UnitControl *s, const char *name, int64_t *hms)
+{
+    ControlTime *t = g_new0(ControlTime, 1);
+    *t = (ControlTime){ s, hms };
+    object_property_add(OBJECT(s->unit), name, "str", control_time_get,
+                        control_time_set, control_time_release, t);
+}
+
+static void byteunit_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x00] = (uint8_t)s->bu_bitmap;
+    for (unsigned i = 0; i < 8; i++) { s->regs[0x60 + i] = (s->bu_bitmap >> i) & 1; }
+    for (unsigned i = 0; i < 9; i++) { s->regs[0x10 + i] = (uint8_t)s->bu_brightness; }
+    s->regs[0x19] = (uint8_t)s->bu_led_mode;
+    for (unsigned n = 0; n < 9; n++) {
+        unsigned base = 0x20 + (n / 4) * 0x10 + (n % 4) * 4;
+        s->regs[base] = s->bu_rgb[n][2];      /* B */
+        s->regs[base + 1] = s->bu_rgb[n][1];  /* G */
+        s->regs[base + 2] = s->bu_rgb[n][0];  /* R */
+    }
+    s->regs[0xf1] = s->bu_irq_enable ? 1 : 0;
+    s->regs[0xfe] = (uint8_t)s->bu_fw;
+    s->regs[0xff] = I2C_SLAVE(s)->address;
+}
+
+static void byteunit_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    if (reg < 0x10) { return; }
+    if (reg <= 0x18) { s->bu_brightness = value; return; }
+    if (reg == 0x19) { s->bu_led_mode = value; return; }
+    for (unsigned n = 0; n < 9; n++) {
+        unsigned base = 0x20 + (n / 4) * 0x10 + (n % 4) * 4;
+        if (reg == base) { s->bu_rgb[n][2] = value; return; }
+        if (reg == base + 1) { s->bu_rgb[n][1] = value; return; }
+        if (reg == base + 2) { s->bu_rgb[n][0] = value; return; }
+        if (reg == base + 3) { return; }
+    }
+    if (reg >= 0x70 && reg <= 0xaf) { return; }
+    if (reg == 0xf0) { if (value == 1) { s->bu_saves++; } return; }
+    if (reg == 0xf1) { s->bu_irq_enable = value != 0; if (value) { s->bu_irq_count++; } return; }
+    if (reg == 0xff) { if (value >= 1 && value <= 0x77) { i2c_slave_set_address(I2C_SLAVE(s), value); } return; }
+}
+
+static void step16_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x00] = (uint8_t)s->step_pos & 0x0f;
+    s->regs[0x10] = (uint8_t)s->step_led_cfg;
+    s->regs[0x20] = (uint8_t)s->step_led_bri;
+    s->regs[0x30] = (uint8_t)s->step_dir;
+    s->regs[0x40] = s->step_rgb_power ? 1 : 0;
+    s->regs[0x41] = (uint8_t)s->step_rgb_bri;
+    s->regs[0x50] = (uint8_t)(s->step_rgb_word >> 16);
+    s->regs[0x51] = (uint8_t)(s->step_rgb_word >> 8);
+    s->regs[0x52] = (uint8_t)s->step_rgb_word;
+    s->regs[0xfe] = (uint8_t)s->step_fw;
+    s->regs[0xff] = I2C_SLAVE(s)->address;
+}
+
+static void step16_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    switch (reg) {
+    case 0x10: s->step_led_cfg = value; break;
+    case 0x20: s->step_led_bri = value; break;
+    case 0x30: s->step_dir = value & 1; break;
+    case 0x40: s->step_rgb_power = value & 1; break;
+    case 0x41: s->step_rgb_bri = value; break;
+    case 0x50: s->step_rgb_word = (s->step_rgb_word & 0x00ffff) | ((int64_t)value << 16); break;
+    case 0x51: s->step_rgb_word = (s->step_rgb_word & 0xff00ff) | ((int64_t)value << 8); break;
+    case 0x52: s->step_rgb_word = (s->step_rgb_word & 0xffff00) | value; break;
+    case 0xf0: if (value == 1 || value == 2) { s->step_saves++; } break;
+    case 0xff: if (value >= 0x08 && value <= 0x77) { i2c_slave_set_address(I2C_SLAVE(s), value); } break;
+    default: break;
+    }
+}
+
+static void timerpwr_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x00] = s->tp_grove_out ? 1 : 0;
+    s->regs[0x01] = (uint8_t)s->tp_backlight;
+    s->regs[0x10] = 0; s->regs[0x11] = 0;   /* button A/B read 0 (not pressed) */
+    s->regs[0x20] = (uint8_t)s->tp_trigger;
+    s->regs[0x21] = (uint8_t)s->tp_trigger;
+    for (unsigned i = 0; i < 3; i++) {
+        s->regs[0x30 + i] = (uint8_t)s->tp_sched_on[i];
+        s->regs[0x80 + i] = (uint8_t)s->tp_sched_off[i];
+    }
+    s->regs[0x41] = (uint8_t)(s->tp_cycle != 0);
+    put_le32v(s->regs + 0x60, (uint32_t)llround(s->tp_usb_v * 100.0));
+    put_le32v(s->regs + 0x64, (uint32_t)llround(s->tp_usb_i * 100.0));
+    put_le32v(s->regs + 0x68, (uint32_t)llround(s->tp_grove_v * 100.0));
+    put_le32v(s->regs + 0x6c, (uint32_t)llround(s->tp_grove_i * 100.0));
+    put_le32v(s->regs + 0x70, (uint32_t)llround(s->tp_battery_mv / 10.0));
+    put_le32v(s->regs + 0x74, (uint32_t)llround(s->tp_battery_i_ma * 100.0));
+    s->regs[0x90] = s->tp_charging ? 1 : 0;
+    s->regs[0xfe] = (uint8_t)s->tp_fw;
+    s->regs[0xff] = I2C_SLAVE(s)->address;
+}
+
+static void timerpwr_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    switch (reg) {
+    case 0x00: s->tp_grove_out = value != 0; break;
+    case 0x01: s->tp_backlight = value; break;
+    case 0x20: case 0x21: s->tp_trigger = value; break;
+    case 0x30: case 0x31: case 0x32: s->tp_sched_on[reg - 0x30] = value; break;
+    case 0x40: if (value) { s->tp_power_state = 0; } break;  /* sleep command */
+    case 0x41: s->tp_cycle = value != 0; break;
+    case 0x80: case 0x81: case 0x82: s->tp_sched_off[reg - 0x80] = value; break;
+    case 0xf0: if (value == 1) { s->tp_saves++; } break;
+    case 0xff: if (value >= 0x08 && value <= 0x77) { i2c_slave_set_address(I2C_SLAVE(s), value); } break;
+    default: break;
+    }
+}
+
+static void mq_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    unsigned ref = s->mq_ref_mv > 1 ? (unsigned)llround(s->mq_ref_mv) : 1100;
+    unsigned adc12 = (unsigned)CLAMP(llround(s->mq_sensor_mv * 4095.0 / ref), 0, 4095);
+    unsigned ntc12 = (unsigned)CLAMP(llround(s->mq_ntc_mv * 4095.0 / ref), 0, 4095);
+    s->regs[0x00] = (uint8_t)s->mq_mode;
+    s->regs[0x01] = (uint8_t)s->mq_led;
+    s->regs[0x10] = (uint8_t)s->mq_heat_hi;
+    s->regs[0x11] = (uint8_t)s->mq_heat_lo;
+    s->regs[0x20] = (uint8_t)(adc12 >> 4);
+    put_le16(s->regs + 0x30, (uint16_t)adc12);
+    /* Driver semantics (unit/mq.py get_valid_tags returns read == 1) are used
+     * here; the protocol PDF says 0 = valid (conflict recorded as a blocker). */
+    s->regs[0x40] = s->mq_valid ? 1 : 0;
+    s->regs[0x50] = (uint8_t)(ntc12 >> 4);
+    put_le16(s->regs + 0x60, (uint16_t)ntc12);
+    put_le16(s->regs + 0x70, (uint16_t)CLAMP(s->mq_ntc_ohm, 0, 65535));
+    put_le16(s->regs + 0x80, (uint16_t)ref);
+    put_le16(s->regs + 0x82, (uint16_t)CLAMP(llround(s->mq_sensor_mv), 0, 65535));
+    put_le16(s->regs + 0x84, (uint16_t)CLAMP(llround(s->mq_ntc_mv), 0, 65535));
+    s->regs[0xfe] = (uint8_t)s->mq_fw;
+    s->regs[0xff] = I2C_SLAVE(s)->address;
+}
+
+static void mq_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    switch (reg) {
+    case 0x00: s->mq_mode = value; break;
+    case 0x01: s->mq_led = value & 1; break;
+    case 0x10: s->mq_heat_hi = value; break;
+    case 0x11: s->mq_heat_lo = value; break;
+    case 0xff: if (value >= 0x08 && value <= 0x77) { i2c_slave_set_address(I2C_SLAVE(s), value); } break;
+    default: break;
+    }
+}
+
+static void servos8_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    unsigned addr = 0x25 + (unsigned)(s->sv_rotary % 16);
+    for (unsigned i = 0; i < 8; i++) {
+        s->regs[0x00 + i] = s->sv_modes[i];
+        s->regs[0x10 + i] = s->sv_pull[i];
+        s->regs[0x20 + i] = s->sv_inputs[i];
+        s->regs[0x30 + i] = s->sv_outputs[i];
+        put_le16(s->regs + 0x40 + i * 2, (uint16_t)(s->sv_adc[i * 2] | (s->sv_adc[i * 2 + 1] << 8)));
+        s->regs[0x50 + i] = s->sv_servo[i];
+        s->regs[0x70 + i] = s->sv_pwm[i];
+    }
+    for (unsigned i = 0; i < 16; i++) { memcpy(s->regs + 0x80 + i * 4, s->sv_rgb[i], 4); }
+    for (unsigned i = 0; i < 2; i++) {
+        put_le16(s->regs + 0xd0 + i * 2, (uint16_t)(s->sv_tfreq[i][0] | (s->sv_tfreq[i][1] << 8)));
+    }
+    for (unsigned i = 0; i < 12; i++) { s->regs[0xe0 + i] = s->sv_uid[i]; }
+    put_le16(s->regs + 0xf0, (uint16_t)CLAMP(llround(s->sv_ref_mv), 0, 65535));
+    put_le16(s->regs + 0xf2, (uint16_t)CLAMP(llround(s->sv_grove_mv), 0, 65535));
+    put_le16(s->regs + 0xf4, (uint16_t)CLAMP(llround(s->sv_dc_mv), 0, 65535));
+    put_le16(s->regs + 0xf6, (uint16_t)CLAMP(llround(s->sv_ma), 0, 65535));
+    s->regs[0xfe] = (uint8_t)s->sv_fw;
+    s->regs[0xff] = (uint8_t)addr;
+}
+
+static void servos8_decode(M5UnitControl *s)
+{
+    for (unsigned i = 0; i < 8; i++) {
+        s->sv_modes[i] = s->regs[0x00 + i];
+        s->sv_pull[i] = s->regs[0x10 + i];
+        s->sv_outputs[i] = s->regs[0x30 + i];
+        s->sv_servo[i] = s->regs[0x50 + i];
+        s->sv_pwm[i] = s->regs[0x70 + i];
+    }
+    for (unsigned i = 0; i < 16; i++) { memcpy(s->sv_rgb[i], s->regs + 0x80 + i * 4, 4); }
+    for (unsigned i = 0; i < 2; i++) {
+        s->sv_tfreq[i][0] = s->regs[0xd0 + i * 2];
+        s->sv_tfreq[i][1] = s->regs[0xd0 + i * 2 + 1];
+    }
+}
+
+static void servos8_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    if (reg < 0xfe) { s->regs[reg] = value; }
+    if ((reg >= 0x20 && reg <= 0x27)) { s->sv_inputs[reg - 0x20] = value; }
+    if (reg >= 0x80 && reg <= 0xbf) { servos8_decode(s); }
+    if (reg == 0xff) {
+        if (value >= 0x25 && value <= 0x34) {
+            s->sv_rotary = value - 0x25;
+            i2c_slave_set_address(I2C_SLAVE(s), value);
+        }
+        return;
+    }
+    if (reg >= 0x00 && reg <= 0xd3) { servos8_decode(s); }
+    if (reg == 0xf0) { s->sv_rotary = s->sv_rotary; }
+}
+
+static void cardkb2_refresh(M5UnitControl *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->regs[0x00] = s->kbd_key;
+    s->regs[0xfe] = (uint8_t)s->kbd_fw;
+    s->regs[0xf1] = (uint8_t)s->kbd_fw;
+    s->regs[0xff] = I2C_SLAVE(s)->address;
+}
+
+static void cardkb2_write(M5UnitControl *s, unsigned reg, uint8_t value)
+{
+    if (reg == 0xf0) { if (value == 1) { s->kbd_events++; } return; }
+    if (reg == 0xff) { if (value >= 0x08 && value <= 0x77) { i2c_slave_set_address(I2C_SLAVE(s), value); } return; }
+}
+
+static void sv_rotary_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = s->sv_rotary;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void sv_rotary_set(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value;
+    if (!visit_type_int64(v, name, &value, errp)) { return; }
+    if (value < 0 || value > 15) { error_setg(errp, "rotary must be 0..15"); return; }
+    s->sv_rotary = value;
+    i2c_slave_set_address(I2C_SLAVE(s), (uint8_t)(0x25 + value));
+    s->unit->input_events++;
+}
+
+static double mq_adc12_value(M5UnitControl *s)
+{
+    double ref = s->mq_ref_mv > 1.0 ? s->mq_ref_mv : 1100.0;
+    return CLAMP(s->mq_sensor_mv * 4095.0 / ref, 0.0, 4095.0);
+}
+
+static void mq_adc8_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = (int64_t)(mq_adc12_value(s) / 16.0);
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void mq_adc12_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = (int64_t)mq_adc12_value(s);
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void mq_valid_raw_get(Object *obj, Visitor *v, const char *name, void *opaque, Error **errp)
+{
+    M5UnitControl *s = opaque;
+    int64_t value = s->mq_valid ? 1 : 0;
+    visit_type_int64(v, name, &value, errp);
+}
