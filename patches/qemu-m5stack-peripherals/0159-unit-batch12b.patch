+        return;
+    case 0x41:
+        if (len >= 8) {
+            for (unsigned i = 0; i < 8; i++) { g->chain_outputs[i] = d[i] ? 1 : 0; }
+        }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x42:
+        out[0] = 1;
+        out[1] = len ? g->chain_outputs[d[0] & 7] : 0;
