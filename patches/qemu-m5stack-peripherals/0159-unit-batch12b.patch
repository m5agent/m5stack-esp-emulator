+/* --- Chain/Cat1 QOM array and scalar properties ------------------------- */
+
+static void chain_array_get(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool bus = !strcmp(g->unit->unit_id, "chainbus");
+    QList *list = qlist_new();
+    if (!strcmp(name, "channel-modes")) {
+        for (unsigned i = 0; i < 8; i++) { qlist_append_int(list, g->chain_modes[i]); }
+    } else if (!strcmp(name, "servo-angles")) {
+        for (unsigned i = 0; i < 8; i++) { qlist_append_int(list, g->chain_angles[i]); }
+    } else if (!strcmp(name, "adc-values")) {
+        unsigned count = bus ? 4 : 8;
+        for (unsigned i = 0; i < count; i++) { qlist_append_int(list, g->chain_adc[i]); }
+    } else if (!strcmp(name, "rgb-leds")) {
+        for (unsigned i = 0; i < 8; i++) { qlist_append_int(list, g->chain_rgb[i]); }
+    } else if (!strcmp(name, "gpio-levels")) {
+        for (unsigned i = 0; i < 2; i++) { qlist_append_bool(list, g->chain_gpio_in[i]); }
+    } else if (!strcmp(name, "link-devices")) {
+        qlist_append_str(list, chain_uid_hex(g));
+    }
+    QObject *value = QOBJECT(list);
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
+}
+
+static void chain_array_set(Object *o, Visitor *v, const char *name,
+                            void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    bool bus = !strcmp(g->unit->unit_id, "chainbus");
+    QObject *value = NULL;
+    if (!visit_type_any(v, name, &value, errp)) { return; }
+    QList *list = qobject_to(QList, value);
+    unsigned count = list ? qlist_size(list) : 0;
+    bool ok = list != NULL;
+    if (!strcmp(name, "channel-modes")) {
+        ok = ok && count == 8;
+        if (ok) {
+            unsigned i = 0;
+            const QListEntry *e;
+            QLIST_FOREACH_ENTRY(list, e) {
+                QNum *n = qobject_to(QNum, qlist_entry_obj(e));
+                int64_t mode;
+                if (!n || !qnum_get_try_int(n, &mode) || mode < 0 || mode > 5) {
+                    ok = false;
+                    break;
+                }
+                g->chain_modes[i++] = (uint8_t)mode;
+            }
+        }
+    } else if (!strcmp(name, "gpio-levels")) {
+        ok = ok && count == 2;
+        if (ok) {
+            const QListEntry *e;
+            unsigned i = 0;
+            QLIST_FOREACH_ENTRY(list, e) {
+                QBool *b = qobject_to(QBool, qlist_entry_obj(e));
+                if (!b) { ok = false; break; }
+                g->chain_gpio_in[i++] = qbool_get_bool(b);
+            }
+        }
+    } else if (!strcmp(name, "adc-values")) {
+        unsigned expected = bus ? 4 : 8;
+        ok = ok && count == expected;
+        if (ok) {
+            const QListEntry *e;
+            unsigned i = 0;
+            QLIST_FOREACH_ENTRY(list, e) {
+                QNum *n = qobject_to(QNum, qlist_entry_obj(e));
+                int64_t adc;
+                if (!n || !qnum_get_try_int(n, &adc) || adc < 0 || adc > 4095) {
+                    ok = false;
+                    break;
+                }
+                g->chain_adc[i] = (uint16_t)adc;
+                i++;
+            }
+        }
+    } else {
+        ok = false;
+    }
+    if (!ok) {
+        error_setg(errp, "%s has an unsupported shape or value", name);
+    } else {
+        g->unit->input_events++;
+    }
+    qobject_unref(value);
+}
+
+static void chain_current_get(Object *o, Visitor *v, const char *name,
+                              void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    double value = g->chain_current_ma;
+    visit_type_number(v, name, &value, errp);
+}
+
+static void chain_current_set(Object *o, Visitor *v, const char *name,
+                              void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    double value;
+    if (!visit_type_number(v, name, &value, errp)) { return; }
+    if (!isfinite(value) || value < 0 || value > 5000) {
+        error_setg(errp, "current-ma requires 0..5000 mA");
+        return;
+    }
+    g->chain_current_ma = value;
+    g->unit->input_events++;
+}
+
+static void chain_int_get(Object *o, Visitor *v, const char *name,
+                          void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    int64_t value = !strcmp(name, "version") ? g->chain_version : g->chain_i2c_addr;
+    visit_type_int64(v, name, &value, errp);
+}
+
+static void chain_uid_get(Object *o, Visitor *v, const char *name,
+                          void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *text = g_strdup(chain_uid_hex(g));
+    visit_type_str(v, name, &text, errp);
+    g_free(text);
+}
+
+static void chain_uid_set(Object *o, Visitor *v, const char *name,
+                          void *op, Error **errp)
+{
+    GPIOUnit *g = op;
+    char *text = NULL;
+    if (!visit_type_str(v, name, &text, errp)) { return; }
+    size_t len = strlen(text);
+    bool valid = (len == 8 || len == 16 || len == 24);
+    for (size_t i = 0; valid && i < len; i++) {
+        valid = g_ascii_xdigit_value(text[i]) >= 0;
+    }
+    if (!valid) {
+        error_setg(errp, "chain-uid requires 8/16/24 hexadecimal digits");
+        g_free(text);
+        return;
+    }
+    g_free(g->chain_uid);
+    g->chain_uid = text;
+    g->unit->input_events++;
+}
