+/* Batch-12b I2C sensor helpers: U231 BMM350 (0x14) and U200 INA226 (0x41).
+ * Register maps come from Bosch BST-BMM350-DS001-27 Table 8 and TI SBOS547C
+ * Table 7-1; values are inverse-derived from explicit host fixtures and do not
+ * model magnetic/heading physics, OTP calibration or electrical accuracy. */
+static uint32_t bmm_mag_raw(M5UnitSensor *s, unsigned axis)
+{
+    double scale = axis == 2 ? 0.007174964 : 0.007069979;
+    long raw = lround(s->values[axis] / scale);
+    if (raw < -8388608L) { raw = -8388608L; }
+    if (raw > 8388607L) { raw = 8388607L; }
+    return (uint32_t)raw & 0xffffffu;
+}
+
+static uint32_t bmm_temp_raw(M5UnitSensor *s)
+{
+    long raw = lround((s->values[3] + 25.49) / 0.000981282);
+    if (raw < -8388608L) { raw = -8388608L; }
+    if (raw > 8388607L) { raw = 8388607L; }
+    return (uint32_t)raw & 0xffffffu;
+}
