+    }
+    case 0xa3: {
+        uint16_t ma = (uint16_t)CLAMP(llround(g->chain_current_ma), 0, 65535);
+        out[0] = (uint8_t)(ma & 0xff);
+        out[1] = (uint8_t)(ma >> 8);
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    }
+    default:
+        return;
+    }
+}
+
+static uint8_t chainbus_work_status(int64_t status)
+{
+    return status >= 0 && status <= 5 ? (uint8_t)status : 0;
+}
+
+/* Unit ChainBus (U212) command subset from the official protocol PDF V1. */
+static void chain_handle_bus(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                             const uint8_t *d, unsigned len)
+{
+    uint8_t out[32] = {0};
+    switch (cmd) {
+    case 0x10:
+        chain_emit_status(g, index, cmd, (len && d[0] <= 1) ? 1 : 0);
+        return;
+    case 0x11:
+    case 0x12:
+    case 0x13:
+    case 0x14:
+        /* No downstream I2C device/register is modeled; fail closed instead of
+         * fabricating forwarded bytes (Operation_status 0 = failed). */
+        chain_emit_status(g, index, cmd, 0);
+        return;
+    case 0x15:
+        out[0] = 1;
+        out[1] = 0;
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x20:
+        if (len >= 4) {
+            g->chain_rgb[0] = ((uint32_t)d[1] << 16) |
+                              ((uint32_t)d[2] << 8) | d[3];
+        }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x21:
+        out[0] = 1;
+        out[1] = (uint8_t)(g->chain_rgb[0] >> 16);
+        out[2] = (uint8_t)(g->chain_rgb[0] >> 8);
+        out[3] = (uint8_t)g->chain_rgb[0];
+        chain_emit(g, index, cmd, out, 4);
+        return;
+    case 0x22:
+        if (len && d[0] <= 100) { g->chain_brightness = d[0]; }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x23:
+        out[0] = g->chain_brightness;
+        chain_emit(g, index, cmd, out, 1);
+        return;
+    case 0x30:
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x31:
+        if (len >= 2 && d[0] >= 1 && d[0] <= 2) {
+            g->chain_gpio_out[d[0] - 1] = d[1] ? 1 : 0;
+        }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x32:
+        out[0] = 1;
+        if (len && d[0] >= 1 && d[0] <= 2) {
+            out[1] = (uint8_t)g->chain_gpio_out[d[0] - 1];
+        }
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x40:
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x41:
+        out[0] = 1;
+        if (len && d[0] >= 1 && d[0] <= 2) {
+            out[1] = g->chain_gpio_in[d[0] - 1] ? 1 : 0;
+        }
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x50:
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x60:
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x61: {
+        unsigned channel = (len && d[0] >= 1 && d[0] <= 4) ? (unsigned)d[0] - 1 : 0;
+        uint16_t value = g->chain_adc[channel];
+        out[0] = 1;
+        out[1] = (uint8_t)(value & 0xff);
+        out[2] = (uint8_t)(value >> 8);
+        chain_emit(g, index, cmd, out, 3);
+        return;
+    }
+    case 0x70:
+        out[0] = chainbus_work_status(g->chain_work_status[0]);
+        out[1] = chainbus_work_status(g->chain_work_status[1]);
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    default:
+        return;
+    }
+}
+
+static void chain_handle_frame(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                               const uint8_t *d, unsigned len)
+{
+    bool servos = !strcmp(g->unit->unit_id, "8servos2-chain");
+    uint16_t device_type = servos ? 0x000c : 0x0006;
+    if (chain_handle_common(g, index, cmd, d, len, device_type)) { return; }
+    if (servos) { chain_handle_servos(g, index, cmd, d, len); }
+    else { chain_handle_bus(g, index, cmd, d, len); }
+}
+
+static void chain_process(GPIOUnit *g)
+{
+    while (g->chain_len >= 9) {
+        if (g->chain_buf[0] != 0xaa || g->chain_buf[1] != 0x55) {
+            memmove(g->chain_buf, g->chain_buf + 1, --g->chain_len);
+            continue;
+        }
+        unsigned length = g->chain_buf[2] | ((unsigned)g->chain_buf[3] << 8);
+        unsigned total = length + 6;
+        if (length < 4 || total > sizeof(g->chain_buf)) {
+            g->chain_len = 0;
+            return;
+        }
+        if (g->chain_len < total) { return; }
+        if (g->chain_buf[total - 2] != 0x55 || g->chain_buf[total - 1] != 0xaa) {
+            memmove(g->chain_buf, g->chain_buf + 1, --g->chain_len);
+            continue;
+        }
+        uint8_t index = g->chain_buf[4], cmd = g->chain_buf[5];
+        unsigned dlen = length - 3;
+        uint8_t crc = (uint8_t)(index + cmd);
+        for (unsigned i = 0; i < dlen; i++) {
+            crc = (uint8_t)(crc + g->chain_buf[6 + i]);
+        }
+        if (crc == g->chain_buf[6 + dlen]) {
+            g->chain_frames_sent++;
+            chain_handle_frame(g, index, cmd, g->chain_buf + 6, dlen);
+        }
+        memmove(g->chain_buf, g->chain_buf + total, g->chain_len - total);
+        g->chain_len -= total;
+    }
+}
+
+static void cat1_inject_text(GPIOUnit *g, const char *text)
+{
+    DeviceState *uart = NULL;
+    unsigned len = strlen(text);
+    if (!len || !gpio_uart_rx_device_for_white(g, &uart)) { return; }
+    if (len <= fifo8_num_free(&ESP32_UART(uart)->rx_fifo)) {
+        esp32_uart_inject_rx(ESP32_UART(uart), (const uint8_t *)text, len);
+        g->unit->read_bytes += len;
+        g->at_frames_injected++;
+    }
+}
+
+/* U204 Cat1-CN (ML307R-DL) minimal AT responder. Only the control-plane byte
+ * layer is modeled; identity strings are synthetic fixtures and cellular
+ * RF/SIM/PDP/network/TLS behavior is NOT RUN. */
+static void cat1_respond(GPIOUnit *g)
+{
+    char cmd[128];
+    unsigned n = g->at_len < sizeof(cmd) - 1 ? (unsigned)g->at_len : sizeof(cmd) - 1;
+    memcpy(cmd, g->at_buf, n);
+    cmd[n] = 0;
+    while (n && (cmd[n - 1] == '\r' || cmd[n - 1] == '\n' || cmd[n - 1] == ' ')) {
+        cmd[--n] = 0;
+    }
+    if (!*cmd) { g->at_len = 0; return; }
+    if (!strcmp(cmd, "AT") || !strncmp(cmd, "ATE", 3)) {
+        cat1_inject_text(g, "\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CPIN?")) {
+        cat1_inject_text(g, "\r\n+CPIN: READY\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CREG?")) {
+        cat1_inject_text(g, "\r\n+CREG: 0,1\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CEREG?")) {
+        cat1_inject_text(g, "\r\n+CEREG: 0,1\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CSQ")) {
+        cat1_inject_text(g, "\r\n+CSQ: 99,99\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CGATT?")) {
+        cat1_inject_text(g, "\r\n+CGATT: 1\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CGMM")) {
+        cat1_inject_text(g, "\r\nML307R-DL\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CGMI")) {
+        cat1_inject_text(g, "\r\nOneMO\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CGSN")) {
+        cat1_inject_text(g, "\r\n862000000000000\r\n\r\nOK\r\n");
+    } else if (!strcmp(cmd, "AT+CIMI")) {
+        cat1_inject_text(g, "\r\n460000000000000\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MIPCALL", 10)) {
+        cat1_inject_text(g, "\r\n+MIPCALL: 1,1\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MIPOPEN", 10)) {
+        cat1_inject_text(g, "\r\n+MIPOPEN: 0,0\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MIPSEND", 10)) {
+        cat1_inject_text(g, "\r\n+MIPSEND: 0,0\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MIPCLOSE", 11)) {
+        cat1_inject_text(g, "\r\n+MIPCLOSE: 0,0\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MIPRD", 8)) {
+        cat1_inject_text(g, "\r\n+MIPRD: 0,0,0\r\n\r\nOK\r\n");
+    } else if (!strncmp(cmd, "AT+MDNSGIP", 10)) {
+        cat1_inject_text(g, "\r\n+MDNSGIP: 1,1,\"127.0.0.1\"\r\n\r\nOK\r\n");
+    } else {
+        cat1_inject_text(g, "\r\nERROR\r\n");
+    }
+    g->at_frames_sent++;
+    g->at_len = 0;
+}
