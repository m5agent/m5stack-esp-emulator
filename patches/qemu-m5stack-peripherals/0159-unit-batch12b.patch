+                          (len >= 2 && d[0] < 8 && d[1] <= 5) ? 1 : 0);
+        return;
+    case 0x11:
+        if (len >= 8) {
+            for (unsigned i = 0; i < 8; i++) {
+                if (d[i] <= 5) { g->chain_modes[i] = d[i]; }
+            }
+        }
+        chain_emit_status(g, index, cmd, len >= 8 ? 1 : 0);
+        return;
+    case 0x12:
+        out[0] = 1;
+        out[1] = len ? g->chain_modes[d[0] & 7] : 0;
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x13:
+        memcpy(out, g->chain_modes, 8);
+        chain_emit(g, index, cmd, out, 8);
+        return;
+    case 0x30:
+        if (len >= 2 && d[0] < 8 && d[1] <= 2) { g->chain_pull[d[0]] = d[1]; }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x31:
+        if (len >= 8) {
+            for (unsigned i = 0; i < 8; i++) {
+                if (d[i] <= 2) { g->chain_pull[i] = d[i]; }
+            }
+        }
+        chain_emit_status(g, index, cmd, 1);
+        return;
+    case 0x32:
+        out[0] = 1;
+        out[1] = len ? g->chain_pull[d[0] & 7] : 0;
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x33:
+        memcpy(out, g->chain_pull, 8);
+        chain_emit(g, index, cmd, out, 8);
+        return;
+    case 0x34:
+        out[0] = 1;
+        out[1] = len ? (g->chain_gpio_in[d[0] & 1] ? 1 : 0) : 0;
+        chain_emit(g, index, cmd, out, 2);
+        return;
+    case 0x35:
+        for (unsigned i = 0; i < 8; i++) {
+            out[i] = g->chain_gpio_in[i & 1] ? 1 : 0;
