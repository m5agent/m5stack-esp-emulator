+/* --- Batch-12b Chain (U223/U212) and Cat1-CN (U204) UART responders ---- */
+
+static bool chain_is_unit(const char *unit_id)
+{
+    return !strcmp(unit_id, "8servos2-chain") || !strcmp(unit_id, "chainbus");
+}
+
+static const char *chain_uid_hex(GPIOUnit *g)
+{
+    return g->chain_uid ? g->chain_uid : "0000000000000000";
+}
+
+static void chain_uid_bytes(GPIOUnit *g, uint8_t *out, unsigned count)
+{
+    const char *hex = chain_uid_hex(g);
+    size_t len = strlen(hex);
+    memset(out, 0, count);
+    for (unsigned i = 0; i < count; i++) {
+        unsigned byte = 0;
+        for (unsigned j = 0; j < 2; j++) {
+            size_t k = i * 2 + j;
+            int digit = k < len ? g_ascii_xdigit_value(hex[k]) : -1;
+            byte = (byte << 4) | (digit >= 0 ? (unsigned)digit : 0);
+        }
+        out[i] = (uint8_t)byte;
+    }
+}
+
+static void chain_inject(GPIOUnit *g, const uint8_t *data, unsigned len)
+{
+    DeviceState *uart = NULL;
+    if (!len || !gpio_uart_rx_device_for_white(g, &uart)) { return; }
+    if (len <= fifo8_num_free(&ESP32_UART(uart)->rx_fifo)) {
+        esp32_uart_inject_rx(ESP32_UART(uart), data, len);
+        g->unit->read_bytes += len;
+        g->chain_frames_injected++;
+    }
+}
+
+static void chain_emit(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                       const uint8_t *data, unsigned len)
+{
+    uint8_t frame[300];
+    unsigned total = len + 9;
+    uint8_t crc = (uint8_t)(index + cmd);
+    if (total > sizeof(frame)) { return; }
+    frame[0] = 0xaa;
+    frame[1] = 0x55;
+    frame[2] = (uint8_t)(len + 3);
+    frame[3] = (uint8_t)((len + 3) >> 8);
+    frame[4] = index;
+    frame[5] = cmd;
+    for (unsigned i = 0; i < len; i++) {
+        frame[6 + i] = data[i];
+        crc = (uint8_t)(crc + data[i]);
+    }
+    frame[6 + len] = crc;
+    frame[7 + len] = 0x55;
+    frame[8 + len] = 0xaa;
+    chain_inject(g, frame, total);
+}
+
+static void chain_emit_status(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                              uint8_t status)
+{
+    chain_emit(g, index, cmd, &status, 1);
+}
+
+/* Common device-info commands shared by U223/U212 (0xF8-0xFE). */
+static bool chain_handle_common(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                                const uint8_t *d, unsigned len,
+                                uint16_t device_type)
+{
+    uint8_t out[16] = {0};
+    switch (cmd) {
+    case 0xf8: {
+        uint8_t uid[12];
+        unsigned count = (len && d[0] == 1) ? 12 : 4;
+        chain_uid_bytes(g, uid, 12);
+        out[0] = 1;
+        memcpy(out + 1, uid, count);
+        chain_emit(g, index, cmd, out, 1 + count);
+        return true;
+    }
+    case 0xf9:
+        out[0] = 1;  /* bootloader version fixture */
+        chain_emit(g, index, cmd, out, 1);
+        return true;
+    case 0xfa:
+        out[0] = (uint8_t)g->chain_version;
+        chain_emit(g, index, cmd, out, 1);
+        return true;
+    case 0xfb:
+        out[0] = (uint8_t)(device_type & 0xff);
+        out[1] = (uint8_t)(device_type >> 8);
+        chain_emit(g, index, cmd, out, 2);
+        return true;
+    case 0xfc:
+        return true;  /* enumeration request is device-initiated, no response */
+    case 0xfd:
+        g->chain_heartbeats++;
+        chain_emit(g, index, cmd, NULL, 0);
+        return true;
+    case 0xfe:
+        out[0] = 1;  /* one cascaded device in this model */
+        chain_emit(g, 0xff, cmd, out, 1);
+        return true;
+    default:
+        return false;
+    }
+}
+
+/* Unit 8Servos2-Chain (U223) command subset from docs protocol V1. */
+static void chain_handle_servos(GPIOUnit *g, uint8_t index, uint8_t cmd,
+                                const uint8_t *d, unsigned len)
+{
+    uint8_t out[32] = {0};
+    switch (cmd) {
+    case 0x10:
+        if (len >= 2 && d[0] < 8 && d[1] <= 5) { g->chain_modes[d[0]] = d[1]; }
