+    if (!s->ina_calibration || s->ina_shunt_ohm <= 0) { return 0.0; }
+    return 0.00512 / ((double)s->ina_calibration * s->ina_shunt_ohm);
+}
+
+static int16_t ina_shunt_raw(M5UnitSensor *s)
+{
+    return ina_clamp16(lround(s->values[1] * s->ina_shunt_ohm / 2.5e-6));
+}
+
+static uint16_t ina_bus_raw(M5UnitSensor *s)
+{
+    long raw = lround(s->values[0] / 1.25e-3);
+    if (raw < 0) { raw = 0; }
+    if (raw > 0x7fff) { raw = 0x7fff; }
+    return (uint16_t)raw;
+}
