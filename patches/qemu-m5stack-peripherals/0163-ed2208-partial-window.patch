+                s->window_x1 = (p[2] << 8) | p[3];
+                s->window_y0 = (p[4] << 8) | p[5];
+                s->window_y1 = (p[6] << 8) | p[7];
+                s->window_valid = p[8] == 1
+                    && s->window_x0 <= s->window_x1
+                    && s->window_y0 <= s->window_y1
+                    && s->window_x1 < s->native_w
+                    && s->window_y1 < s->native_h;
+                if (getenv("M5SW_EPD_TRACE")) {
