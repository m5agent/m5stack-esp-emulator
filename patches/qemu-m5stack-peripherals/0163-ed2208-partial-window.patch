+             * A7 additionally enters deep sleep. Waveform timing is outside
+             * this functional framebuffer model, just as for legacy 0x12. */
+            if (b == 0xa5 || b == 0xa7) {
+                m5_epd_refresh(s);
+            }
+            continue;
+        }
+        if (s->color && s->cmd == 0x83) {
