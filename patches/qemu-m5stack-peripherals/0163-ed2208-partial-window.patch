+static void m5_epd_refresh(M5EpdPanelState *s)
+{
+    s->dirty = true;
+    if (s->color && getenv("M5SW_EPD_TRACE")) {
+        uint32_t sample = s->window_y0 * (s->native_w / 2)
+            + s->window_x0 / 2;
+        fprintf(stderr, "[m5epd-refresh] cmd=%02x bytes=%u x=%u..%u y=%u..%u first=%02x\n",
+                s->cmd, s->data_index,
+                s->window_x0, s->window_x1, s->window_y0, s->window_y1,
+                sample < s->packed_size ? s->packed[sample] : 0xff);
+    }
+}
