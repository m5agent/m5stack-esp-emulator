diff --git a/hw/m5stopwatch/m5cardputeradv.c b/hw/m5stopwatch/m5cardputeradv.c
index 7561cca..6ae88b2 100644
--- a/hw/m5stopwatch/m5cardputeradv.c
+++ b/hw/m5stopwatch/m5cardputeradv.c
@@ -100,8 +100,12 @@ void m5cardputeradv_board_init(MemoryRegion *sys_mem, DeviceState *intmatrix,
     esp32s3_gpspi_set_dc_pin(sd_spi, 34);
     esp32s3_gpspi_set_panel_cs_pin(sd_spi, 37);
     m5_spi_sd_attach(sd_spi, 12);
-    m5_st25r3916_spi_attach(spi, 6, 4);
-    m5_st25r3916_spi_attach(sd_spi, 6, 4);
-    m5_cc1101_spi_attach(spi, 5, 15);
-    m5_cc1101_spi_attach(sd_spi, 5, 15);
+    /* Cap CC1101 adds both chips on the external connector. A bare
+     * Cardputer ADV has neither device on G5/G6. */
+    if (g_strcmp0(getenv("M5SW_CARDPUTER_ADV_CAP_CC1101"), "1") == 0) {
+        m5_st25r3916_spi_attach(spi, 6, 4);
+        m5_st25r3916_spi_attach(sd_spi, 6, 4);
+        m5_cc1101_spi_attach(spi, 5, 15);
+        m5_cc1101_spi_attach(sd_spi, 5, 15);
+    }
 }
