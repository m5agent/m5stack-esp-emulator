diff --git a/hw/m5stopwatch/esp32s3_gpspi.c b/hw/m5stopwatch/esp32s3_gpspi.c
index ef6cd68..7819979 100644
--- a/hw/m5stopwatch/esp32s3_gpspi.c
+++ b/hw/m5stopwatch/esp32s3_gpspi.c
@@ -554,6 +554,14 @@ void esp32s3_gpspi_set_panel_cs_pin(DeviceState *dev, int pin)
 void esp32s3_gpspi_attach_spi_slave(DeviceState *dev,
                                     const M5SpiSlaveOps *ops,
                                     void *opaque, int cs_pin)
+{
+    esp32_gpio_set_input(cs_pin, 1);
+    esp32s3_gpspi_attach_spi_slave_passive_cs(dev, ops, opaque, cs_pin);
+}
+
+void esp32s3_gpspi_attach_spi_slave_passive_cs(DeviceState *dev,
+                                               const M5SpiSlaveOps *ops,
+                                               void *opaque, int cs_pin)
 {
     Esp32s3GpspiState *s = ESP32S3_GPSPI(dev);
     int index = s->slave_count++;
@@ -564,7 +572,8 @@ void esp32s3_gpspi_attach_spi_slave(DeviceState *dev,
     s->slaves[index].cs_pin = cs_pin;
     s->slaves[index].cs_level = 1;
     s->slaves[index].gdma_periph = -1;
-    esp32_gpio_set_input(cs_pin, 1);
+    /* The Cap schematic connects CS directly to a slave input. Register an
+     * observer without driving the guest's pin from the slave. */
     esp32_gpio_add_out_listener(cs_pin, gpspi_cs_line, s);
 }
 
diff --git a/hw/m5stopwatch/m5_cc1101_spi.c b/hw/m5stopwatch/m5_cc1101_spi.c
index a7369a5..aa536c3 100644
--- a/hw/m5stopwatch/m5_cc1101_spi.c
+++ b/hw/m5stopwatch/m5_cc1101_spi.c
@@ -238,7 +238,7 @@ void m5_cc1101_spi_attach(DeviceState *spi, int cs_pin, int gdo0_pin)
     s->gdo0_pin = gdo0_pin;
     s->rx_timer = timer_new_ms(QEMU_CLOCK_REALTIME, cc1101_rx_timer, s);
     cc1101_reset(s);
-    esp32s3_gpspi_attach_spi_slave(spi, &cc1101_ops, s, cs_pin);
+    esp32s3_gpspi_attach_spi_slave_passive_cs(spi, &cc1101_ops, s, cs_pin);
     esp32_gpio_set_input(gdo0_pin, 0);
     esp32_gpio_force_line(gdo0_pin, 0);
 }
