+/* The StickS3 updater switches the PM1 from its normal address to an
+ * I2C bootloader. Keep the app bank separate from the live PM1 registers.
+ */
+enum {
+    PM1_IAP_ADDR = 0x54,
+    PM1_IAP_APP_BASE = 0x08001000,
+    PM1_IAP_APP_SIZE = 0x5000,
+    PM1_IAP_PAGE_SIZE = 128,
+    PM1_IAP_HEADER_SIZE = 8,
+    PM1_IAP_WREN_WRITE = 0x06,
+    PM1_IAP_RUN = 0x77,
+};
