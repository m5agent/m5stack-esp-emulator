+/* PM1 app images carry a little-endian STM32 CRC word after the
+ * program/padding. Input is consumed as big-endian words, CRC polynomial
+ * 0x04c11db7, initial value 0xffffffff, no reflection or final XOR.
+ */
+static bool pm1_iap_image_valid(const M5PM1Iap *iap)
+{
+    uint32_t crc = UINT32_MAX;
+    uint32_t size = sizeof(iap->app) - sizeof(crc);
+
+    if (iap->bytes_written != sizeof(iap->app)) {
+        return false;
+    }
+    for (unsigned i = 0; i < size; i++) {
+        crc ^= (uint32_t)iap->app[i] << 24;
+        for (unsigned bit = 0; bit < 8; bit++) {
+            crc = (crc << 1) ^ ((crc & BIT(31)) ? 0x04c11db7 : 0);
+        }
+    }
+    return crc == ldl_le_p(iap->app + size);
+}
+
+static int pm1_iap_send(M5PM1Iap *iap, uint8_t data)
+{
+    if (iap->rejected || iap->frame_size == sizeof(iap->frame)) {
+        goto nack;
+    }
+    if (iap->frame_size == 0) {
+        if (data == PM1_IAP_RUN &&
+            (!iap->write_enabled || !pm1_iap_image_valid(iap))) {
+            iap->run_rejections++;
+            goto nack;
+        }
+        if (data != PM1_IAP_WREN_WRITE && data != PM1_IAP_RUN) {
+            goto nack;
+        }
+    } else if (!iap->write_enabled || iap->frame[0] != PM1_IAP_WREN_WRITE) {
+        goto nack;
+    }
+    iap->frame[iap->frame_size++] = data;
+    if (iap->frame_size >= PM1_IAP_HEADER_SIZE) {
+        uint32_t address = ldl_be_p(iap->frame + 1);
+        unsigned length = lduw_be_p(iap->frame + 5);
+
+        if (address != PM1_IAP_APP_BASE + iap->bytes_written ||
+            !length || length > PM1_IAP_PAGE_SIZE || iap->frame[7] != 0xff ||
+            length > PM1_IAP_APP_SIZE - iap->bytes_written ||
+            iap->frame_size > PM1_IAP_HEADER_SIZE + length) {
+            goto nack;
+        }
+    }
+    return 0;
+
+nack:
+    iap->rejected = true;
+    return -1;
+}
+
+static void pm1_iap_finish(I2CSlave *slave, M5PM1Iap *iap)
+{
+    if (iap->rejected || !iap->frame_size) {
+        return;
+    }
+    if (iap->frame_size == 1 && iap->frame[0] == PM1_IAP_WREN_WRITE) {
+        iap->write_enabled = true;
+        iap->bytes_written = 0;
+        memset(iap->app, 0xff, sizeof(iap->app));
+        g_clear_pointer(&iap->app_sha256, g_free);
+    } else if (iap->frame_size == 1 && iap->frame[0] == PM1_IAP_RUN) {
+        iap->active = iap->write_enabled = false;
+        iap->upgrades++;
+        iap->app_sha256 = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                                                    iap->app, sizeof(iap->app));
+        i2c_slave_set_address(slave, iap->app_address);
+    } else if (iap->frame_size >= PM1_IAP_HEADER_SIZE) {
+        unsigned length = lduw_be_p(iap->frame + 5);
+
+        if (iap->frame_size == PM1_IAP_HEADER_SIZE + length) {
+            memcpy(iap->app + iap->bytes_written,
+                   iap->frame + PM1_IAP_HEADER_SIZE, length);
+            iap->bytes_written += length;
+        }
+    }
+}
+
 static int dev_event(I2CSlave *i2c, enum i2c_event ev)
 {
     M5swI2CDev *s = M5SW_I2C_DEV(i2c);
+    M5PM1Iap *iap = s->pm1_iap;
+
+    if (iap && iap->active) {
+        switch (ev) {
+        case I2C_START_SEND:
+            iap->frame_size = 0;
+            iap->rejected = false;
+            break;
+        case I2C_START_RECV:
+            return -1;
+        case I2C_FINISH:
+            pm1_iap_finish(i2c, iap);
+            iap->frame_size = 0;
+            break;
+        default:
+            break;
+        }
+        return 0;
+    }
+    if (iap) {
+        if (ev == I2C_START_SEND) {
+            iap->enter_pending = false;
+        } else if (ev == I2C_FINISH && iap->enter_pending) {
+            iap->enter_pending = false;
+            iap->active = true;
+            iap->app_address = i2c->address;
+            i2c_slave_set_address(i2c, PM1_IAP_ADDR);
+        }
+    }
     if (ev == I2C_START_SEND || ev == I2C_START_RECV) {
         s->transactions++;
     }
