+    uint8_t app_address;
+    bool active, enter_pending, write_enabled, rejected;
+    unsigned frame_size;
+    uint8_t frame[PM1_IAP_HEADER_SIZE + PM1_IAP_PAGE_SIZE];
+    uint8_t app[PM1_IAP_APP_SIZE];
+    int64_t bytes_written, upgrades, run_rejections;
+    char *app_sha256;
+} M5PM1Iap;
 
