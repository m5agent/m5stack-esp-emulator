diff --git a/hw/xtensa/esp32s3_usb_otg.c b/hw/xtensa/esp32s3_usb_otg.c
new file mode 100644
index 0000000..9f6aec8
--- /dev/null
+++ b/hw/xtensa/esp32s3_usb_otg.c
@@ -0,0 +1,622 @@
+/*
+ * ESP32-S3 USB OTG full-speed device controller.
+ *
+ * Register layout and reset values follow ESP32-S3 TRM, chapter USB
+ * On-The-Go, and esp-idf esp32s3/register/soc/usb_reg.h. The virtual
+ * host submits USB packets. The guest DCD owns all descriptors,
+ * endpoint configuration and transfer buffers.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/bitops.h"
+#include "qemu/bswap.h"
+#include "qemu/module.h"
+#include "hw/irq.h"
+#include "hw/sysbus.h"
+#include "sysemu/dma.h"
+
+#define TYPE_ESP32S3_USB_OTG "esp32s3.usb-otg"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32s3UsbOtg, ESP32S3_USB_OTG)
+
+enum {
+    GOTGCTL = 0x000, GOTGINT = 0x004, GAHBCFG = 0x008, GUSBCFG = 0x00c,
+    GRSTCTL = 0x010, GINTSTS = 0x014, GINTMSK = 0x018,
+    GRXSTSR = 0x01c, GRXSTSP = 0x020, GRXFSIZ = 0x024, GNPTXFSIZ = 0x028,
+    GSNPSID = 0x040, GHWCFG1 = 0x044, GHWCFG2 = 0x048,
+    GHWCFG3 = 0x04c, GHWCFG4 = 0x050, GDFIFOCFG = 0x05c,
+    DIEPTXF1 = 0x104,
+    DCFG = 0x800, DCTL = 0x804, DSTS = 0x808, DIEPMSK = 0x810,
+    DOEPMSK = 0x814, DAINT = 0x818, DAINTMSK = 0x81c,
+    DIEPEMPMSK = 0x834, DIEP_BASE = 0x900, DOEP_BASE = 0xb00,
+    PCGCCTL = 0xe00, FIFO_BASE = 0x1000, FIFO_STRIDE = 0x1000,
+
+    EP_COUNT = 7, FS_PACKET = 64, EP_STRIDE = 0x20,
+    EP_CTL = 0, EP_INT = 8, EP_SIZE = 0x10, EP_DMA = 0x14, EP_FIFO = 0x18,
+    EP_XFRC = BIT(0), EP_DISABLED = BIT(1), EP_AHBERR = BIT(2),
+    EP_SETUP = BIT(3), EP_IN_NAK = BIT(6), EP_TXFE = BIT(7),
+    EP_STALL = BIT(21), EP_CNAK = BIT(26), EP_SNAK = BIT(27),
+    EP_DISABLE = BIT(30), EP_ENABLE = BIT(31),
+    EP_NAK = BIT(17), EP_XFER_MASK = 0x7ffff, EP_PKTCNT_MASK = 0x1ff80000,
+    IRQ_RX = BIT(4), IRQ_OUT_NAK = BIT(7), IRQ_RESET = BIT(12),
+    IRQ_ENUM = BIT(13), IRQ_IN = BIT(18), IRQ_OUT = BIT(19),
+    USB_DMA = BIT(5), USB_GINT = BIT(0), FORCE_DEVICE = BIT(30),
+    SOFT_DISCONNECT = BIT(1), SET_OUT_NAK = BIT(9), CLEAR_OUT_NAK = BIT(10),
+    RESET_CORE = BIT(0), FLUSH_RX = BIT(4), FLUSH_TX = BIT(5), AHB_IDLE = BIT(31),
+};
+
+typedef struct UsbEndpoint {
+    uint32_t ctl;
+    uint32_t intr;
+    uint32_t size;
+    uint32_t dma;
+    uint8_t fifo[FS_PACKET];
+    unsigned fifo_bytes;
+} UsbEndpoint;
+
+struct Esp32s3UsbOtg {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    qemu_irq irq;
+    uint32_t regs[PCGCCTL / 4 + 1];
+    UsbEndpoint in[EP_COUNT];
+    UsbEndpoint out[EP_COUNT];
+    uint8_t rx[FS_PACKET];
+    unsigned rx_pos;
+    unsigned rx_len;
+    unsigned rx_phase;
+    unsigned rx_ep;
+    bool rx_setup;
+    bool rx_complete;
+    bool clock_enabled;
+    bool reset_asserted;
+    bool out_nak;
+    bool bus_reset_seen;
+    char response[6 + 2 * FS_PACKET];
+};
+
+#define REG(s, n) ((s)->regs[(n) / 4])
+
+static bool powered(Esp32s3UsbOtg *s)
+{
+    return s->clock_enabled && !s->reset_asserted;
+}
+
+static bool connected(Esp32s3UsbOtg *s)
+{
+    return powered(s) && (REG(s, GUSBCFG) & FORCE_DEVICE) &&
+           !(REG(s, DCTL) & SOFT_DISCONNECT);
+}
+
+static bool uses_dma(Esp32s3UsbOtg *s)
+{
+    return (REG(s, GAHBCFG) & USB_DMA) != 0;
+}
+
+static uint32_t in_irq(Esp32s3UsbOtg *s, unsigned ep)
+{
+    UsbEndpoint *e = &s->in[ep];
+    uint32_t status = e->intr;
+
+    if (!uses_dma(s) && (e->ctl & EP_ENABLE) && !e->fifo_bytes &&
+        (e->size & EP_XFER_MASK)) {
+        status |= EP_TXFE;
+    }
+    return status;
+}
+
+static uint32_t daint(Esp32s3UsbOtg *s)
+{
+    uint32_t status = 0;
+    for (unsigned ep = 0; ep < EP_COUNT; ep++) {
+        uint32_t in_mask = REG(s, DIEPMSK);
+        if (REG(s, DIEPEMPMSK) & BIT(ep)) {
+            in_mask |= EP_TXFE;
+        }
+        if (in_irq(s, ep) & in_mask) {
+            status |= BIT(ep);
+        }
+        if (s->out[ep].intr & REG(s, DOEPMSK)) {
+            status |= BIT(16 + ep);
+        }
+    }
+    return status;
+}
+
+static uint32_t gintsts(Esp32s3UsbOtg *s)
+{
+    uint32_t status = REG(s, GINTSTS);
+    uint32_t ep_irqs = daint(s) & REG(s, DAINTMSK);
+    if (s->rx_phase) {
+        status |= IRQ_RX;
+    }
+    if (s->out_nak) {
+        status |= IRQ_OUT_NAK;
+    }
+    if (ep_irqs & 0x7f) {
+        status |= IRQ_IN;
+    }
+    if (ep_irqs & (0x7f << 16)) {
+        status |= IRQ_OUT;
+    }
+    return status;
+}
+
+static void update_irq(Esp32s3UsbOtg *s)
+{
+    qemu_set_irq(s->irq, powered(s) && (REG(s, GAHBCFG) & USB_GINT) &&
+                 (gintsts(s) & REG(s, GINTMSK)));
+}
+
+static void clear_endpoints(Esp32s3UsbOtg *s)
+{
+    memset(s->in, 0, sizeof(s->in));
+    memset(s->out, 0, sizeof(s->out));
+    s->rx_phase = 0;
+    s->rx_pos = s->rx_len = 0;
+    s->out_nak = false;
+}
+
+static void reset_registers(Esp32s3UsbOtg *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    clear_endpoints(s);
+    REG(s, GUSBCFG) = 0x1440;
+    REG(s, GRXFSIZ) = 0x100;
+    REG(s, GNPTXFSIZ) = 0x01000100;
+    REG(s, DCFG) = 0x08100000;
+    REG(s, DCTL) = 0x2000 | SOFT_DISCONNECT;
+    REG(s, DSTS) = 0x2;
+    s->bus_reset_seen = false;
+    strcpy(s->response, "DETACHED");
+    update_irq(s);
+}
+
+static void usb_clock(void *opaque, int line, int level)
+{
+    Esp32s3UsbOtg *s = opaque;
+    s->clock_enabled = level;
+    update_irq(s);
+}
+
+static void usb_reset(void *opaque, int line, int level)
+{
+    Esp32s3UsbOtg *s = opaque;
+    s->reset_asserted = level;
+    if (level) {
+        reset_registers(s);
+    }
+    update_irq(s);
+}
+
+static UsbEndpoint *endpoint(Esp32s3UsbOtg *s, hwaddr offset,
+                             bool *in, unsigned *ep)
+{
+    unsigned base;
+
+    if (offset >= DIEP_BASE && offset < DIEP_BASE + EP_COUNT * EP_STRIDE) {
+        *in = true;
+        base = DIEP_BASE;
+    } else if (offset >= DOEP_BASE && offset < DOEP_BASE + EP_COUNT * EP_STRIDE) {
+        *in = false;
+        base = DOEP_BASE;
+    } else {
+        return NULL;
+    }
+    *ep = (offset - base) / EP_STRIDE;
+    return *in ? &s->in[*ep] : &s->out[*ep];
+}
+
+static uint32_t rx_status(Esp32s3UsbOtg *s, bool pop)
+{
+    uint32_t status;
+    if (s->rx_phase == 1) {
+        status = ((s->rx_setup ? 6 : 2) << 17) | (s->rx_len << 4) | s->rx_ep;
+        if (pop) {
+            s->rx_phase = s->rx_complete ? 2 : 0;
+        }
+    } else if (s->rx_phase == 2) {
+        status = ((s->rx_setup ? 4 : 3) << 17) | s->rx_ep;
+        if (pop) {
+            s->rx_phase = 0;
+            s->out[s->rx_ep].intr |= s->rx_setup ? EP_SETUP : EP_XFRC;
+        }
+    } else {
+        return 0;
+    }
+    if (pop) {
+        update_irq(s);
+    }
+    return status;
+}
+
+static uint64_t usb_read(void *opaque, hwaddr offset, unsigned size)
+{
+    Esp32s3UsbOtg *s = opaque;
+    bool in;
+    unsigned ep;
+    UsbEndpoint *e;
+
+    if (!powered(s)) {
+        return 0;
+    }
+    e = endpoint(s, offset, &in, &ep);
+    if (e) {
+        switch (offset & (EP_STRIDE - 1)) {
+        case EP_CTL: return e->ctl;
+        case EP_INT: return in ? in_irq(s, ep) : e->intr;
+        case EP_SIZE: return e->size;
+        case EP_DMA: return e->dma;
+        case EP_FIFO: return in ? (FS_PACKET - e->fifo_bytes) / 4 : 0;
+        }
+        return 0;
+    }
+    if (offset >= FIFO_BASE && offset < FIFO_BASE + FIFO_STRIDE) {
+        uint8_t word[4] = {0};
+        for (unsigned i = 0; i < sizeof(word) && s->rx_pos < s->rx_len; i++) {
+            word[i] = s->rx[s->rx_pos++];
+        }
+        return ldl_le_p(word);
+    }
+    switch (offset) {
+    case GRSTCTL: return AHB_IDLE;
+    case GSNPSID: return 0x4f54400a;
+    case GHWCFG1: return 0;
+    case GHWCFG2: return 0x224dd930;
+    case GHWCFG3: return 0x010004b5;
+    case GHWCFG4: return 0xd3f0a030;
+    case GINTSTS: return gintsts(s);
+    case DAINT: return daint(s);
+    case GRXSTSR:
+    case GRXSTSP: return rx_status(s, offset == GRXSTSP);
+    default: return offset <= PCGCCTL ? REG(s, offset) : 0;
+    }
+}
+
+static void write_ep_control(UsbEndpoint *e, bool in, uint32_t value)
+{
+    uint32_t commands = EP_CNAK | EP_SNAK | BIT(28) | BIT(29) | EP_DISABLE;
+    uint32_t nak = e->ctl & EP_NAK;
+
+    if (value & EP_CNAK) {
+        nak = 0;
+    }
+    if (value & EP_SNAK) {
+        nak = EP_NAK;
+        if (in) {
+            e->intr |= EP_IN_NAK;
+        }
+    }
+    e->ctl = (value & ~(commands | EP_NAK)) | nak;
+    if (value & EP_DISABLE) {
+        e->ctl &= ~EP_ENABLE;
+        e->intr |= EP_DISABLED;
+    }
+}
+
+static void usb_write(void *opaque, hwaddr offset, uint64_t value, unsigned size)
+{
+    Esp32s3UsbOtg *s = opaque;
+    bool in;
+    unsigned ep;
+    UsbEndpoint *e;
+
+    if (!powered(s)) {
+        return;
+    }
+    e = endpoint(s, offset, &in, &ep);
+    if (e) {
+        switch (offset & (EP_STRIDE - 1)) {
+        case EP_CTL: write_ep_control(e, in, value); break;
+        case EP_INT: e->intr &= ~value; break;
+        case EP_SIZE: e->size = value; break;
+        case EP_DMA: e->dma = value; break;
+        }
+    } else if (offset >= FIFO_BASE) {
+        ep = (offset - FIFO_BASE) / FIFO_STRIDE;
+        if (ep < EP_COUNT && !uses_dma(s)) {
+            e = &s->in[ep];
+            if (e->fifo_bytes + 4 <= sizeof(e->fifo)) {
+                stl_le_p(e->fifo + e->fifo_bytes, value);
+                e->fifo_bytes += 4;
+            }
+        }
+    } else {
+        switch (offset) {
+        case GRSTCTL:
+            if (value & RESET_CORE) {
+                clear_endpoints(s);
+                REG(s, GINTSTS) = REG(s, GOTGINT) = 0;
+            }
+            if (value & FLUSH_RX) {
+                s->rx_phase = s->rx_pos = s->rx_len = 0;
+            }
+            if (value & FLUSH_TX) {
+                unsigned fifo = (value >> 6) & 0x1f;
+                for (ep = 0; ep < EP_COUNT; ep++) {
+                    if (fifo == ep || fifo == 0x10) {
+                        s->in[ep].fifo_bytes = 0;
+                    }
+                }
+            }
+            break;
+        case GOTGINT:
+        case GINTSTS:
+            REG(s, offset) &= ~value;
+            break;
+        case DCTL:
+            if (value & SET_OUT_NAK) {
+                s->out_nak = true;
+            }
+            if (value & CLEAR_OUT_NAK) {
+                s->out_nak = false;
+            }
+            REG(s, DCTL) = value & ~(SET_OUT_NAK | CLEAR_OUT_NAK);
+            if (value & SOFT_DISCONNECT) {
+                s->bus_reset_seen = false;
+            }
+            break;
+        case GOTGCTL: case GAHBCFG: case GUSBCFG: case GINTMSK:
+        case GRXFSIZ: case GNPTXFSIZ: case GDFIFOCFG:
+        case DCFG: case DIEPMSK: case DOEPMSK: case DAINTMSK:
+        case DIEPEMPMSK: case PCGCCTL:
+            REG(s, offset) = value;
+            break;
+        default:
+            if (offset >= DIEPTXF1 && offset < DIEPTXF1 + (EP_COUNT - 1) * 4) {
+                REG(s, offset) = value;
+            }
+            break;
+        }
+    }
+    update_irq(s);
+}
+
+static const MemoryRegionOps usb_ops = {
+    .read = usb_read,
+    .write = usb_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+    .impl = { .min_access_size = 4, .max_access_size = 4 },
+};
+
+static unsigned max_packet(UsbEndpoint *ep, unsigned n)
+{
+    static const unsigned ep0_sizes[] = { 64, 32, 16, 8 };
+    return n ? MIN(FS_PACKET, ep->ctl & 0x7ff) : ep0_sizes[ep->ctl & 3];
+}
+
+static bool consume_packet(UsbEndpoint *ep, unsigned count, bool short_packet)
+{
+    unsigned remaining = (ep->size & EP_XFER_MASK) - count;
+    unsigned packets = (ep->size & EP_PKTCNT_MASK) >> 19;
+
+    packets -= packets != 0;
+    ep->size = (ep->size & ~(EP_XFER_MASK | EP_PKTCNT_MASK)) |
+               remaining | (packets << 19);
+    if (remaining && packets && !short_packet) {
+        return false;
+    }
+    ep->ctl &= ~EP_ENABLE;
+    return true;
+}
+
+static void host_in(Esp32s3UsbOtg *s, unsigned n)
+{
+    UsbEndpoint *e = &s->in[n];
+    unsigned mps = max_packet(e, n);
+    unsigned count = MIN(e->size & EP_XFER_MASK, mps);
+    uint8_t bytes[FS_PACKET];
+
+    if (e->ctl & EP_STALL) {
+        strcpy(s->response, "STALL");
+        return;
+    }
+    if (!mps || !(e->ctl & EP_ENABLE) || (e->ctl & EP_NAK) ||
+        (!uses_dma(s) && e->fifo_bytes < count)) {
+        strcpy(s->response, "NAK");
+        return;
+    }
+    if (uses_dma(s)) {
+        if (count && dma_memory_read(&address_space_memory, e->dma, bytes,
+                                     count, MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            e->intr |= EP_AHBERR;
+            strcpy(s->response, "ERROR");
+            return;
+        }
+        e->dma += count;
+    } else {
+        memcpy(bytes, e->fifo, count);
+        e->fifo_bytes = 0;
+    }
+    if (consume_packet(e, count, false)) {
+        e->intr |= EP_XFRC;
+    }
+    strcpy(s->response, "DATA:");
+    for (unsigned i = 0; i < count; i++) {
+        snprintf(s->response + 5 + 2 * i, 3, "%02x", bytes[i]);
+    }
+}
+
+static void host_out(Esp32s3UsbOtg *s, unsigned n, const uint8_t *bytes,
+                     unsigned count, bool setup)
+{
+    UsbEndpoint *e = &s->out[n];
+    unsigned mps = max_packet(e, n);
+    bool dma = uses_dma(s);
+    bool complete;
+
+    if (!setup && (e->ctl & EP_STALL)) {
+        strcpy(s->response, "STALL");
+        return;
+    }
+    if ((!setup && (s->out_nak || (e->ctl & EP_NAK) ||
+                    (dma && n == 0 && (e->size & (3u << 29))))) ||
+        ((!setup || dma) && !(e->ctl & EP_ENABLE)) ||
+        (!dma && (s->rx_phase || s->rx_pos < s->rx_len))) {
+        strcpy(s->response, "NAK");
+        return;
+    }
+    if (!mps || count > mps ||
+        ((!setup || dma) && count > (e->size & EP_XFER_MASK))) {
+        strcpy(s->response, "NAK");
+        return;
+    }
+    if (setup) {
+        e->ctl &= ~EP_STALL;
+        s->in[0].ctl &= ~(EP_ENABLE | EP_STALL);
+        s->in[0].fifo_bytes = 0;
+    }
+    if (dma) {
+        if (count && dma_memory_write(&address_space_memory, e->dma, bytes,
+                                      count, MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            e->intr |= EP_AHBERR;
+            strcpy(s->response, "ERROR");
+            return;
+        }
+        e->dma += count;
+    }
+    complete = setup || consume_packet(e, count, count < mps);
+    if (setup && dma) {
+        e->ctl &= ~EP_ENABLE;
+    }
+    if (dma) {
+        if (complete) {
+            e->intr |= setup ? EP_SETUP : EP_XFRC;
+        }
+    } else {
+        s->rx_len = count;
+        s->rx_pos = 0;
+        s->rx_phase = 1;
+        s->rx_ep = n;
+        s->rx_setup = setup;
+        s->rx_complete = complete;
+        memcpy(s->rx, bytes, count);
+    }
+    strcpy(s->response, "ACK");
+}
+
+static char *host_response(Object *obj, Error **errp)
+{
+    Esp32s3UsbOtg *s = ESP32S3_USB_OTG(obj);
+    return g_strdup(s->response);
+}
+
+static char *host_state(Object *obj, Error **errp)
+{
+    Esp32s3UsbOtg *s = ESP32S3_USB_OTG(obj);
+    return g_strdup_printf("%s address=%u mode=%s",
+                           connected(s) ? "attached" : "detached",
+                           (REG(s, DCFG) >> 4) & 0x7f,
+                           uses_dma(s) ? "buffer-dma" : "fifo");
+}
+
+static void host_packet(Object *obj, const char *value, Error **errp)
+{
+    Esp32s3UsbOtg *s = ESP32S3_USB_OTG(obj);
+    if (strlen(value) > sizeof("out 0 ") - 1 + 2 * FS_PACKET) {
+        error_setg(errp, "USB host packet exceeds the full-speed data bound");
+        return;
+    }
+    g_auto(GStrv) words = g_strsplit(value, " ", 4);
+    unsigned argc = g_strv_length(words);
+    bool reset = argc == 1 && !strcmp(words[0], "reset");
+    bool setup = argc == 2 && !strcmp(words[0], "setup");
+    bool in = argc == 2 && !strcmp(words[0], "in");
+    bool out = (argc == 2 || argc == 3) && !strcmp(words[0], "out");
+    uint8_t data[FS_PACKET];
+    unsigned n = 0, count = 0;
+
+    if (in || out) {
+        if (words[1][0] < '0' || words[1][0] >= '0' + EP_COUNT || words[1][1]) {
+            error_setg(errp, "USB endpoint must be 0 through %u", EP_COUNT - 1);
+            return;
+        }
+        n = words[1][0] - '0';
+    }
+    if (setup || (out && argc == 3)) {
+        const char *payload = words[setup ? 1 : 2];
+        size_t len = strlen(payload);
+        if (len > 2 * FS_PACKET || len % 2 || (setup && len != 16)) {
+            error_setg(errp, "invalid USB packet length");
+            return;
+        }
+        count = len / 2;
+        for (unsigned i = 0; i < count; i++) {
+            int hi = g_ascii_xdigit_value(payload[2 * i]);
+            int lo = g_ascii_xdigit_value(payload[2 * i + 1]);
+            if (hi < 0 || lo < 0) {
+                error_setg(errp, "USB payload must be hexadecimal");
+                return;
+            }
+            data[i] = (hi << 4) | lo;
+        }
+    }
+    if (!reset && !setup && !in && !out) {
+        error_setg(errp, "USB packet must be reset, setup HEX, in EP or out EP [HEX]");
+        return;
+    }
+    if (!connected(s)) {
+        strcpy(s->response, "DETACHED");
+        return;
+    }
+    if (reset) {
+        clear_endpoints(s);
+        REG(s, DCFG) &= ~(0x7f << 4);
+        REG(s, GINTSTS) = IRQ_RESET | IRQ_ENUM;
+        REG(s, DSTS) = 0x6; /* Enumerated on the dedicated 48 MHz FS PHY. */
+        s->bus_reset_seen = true;
+        strcpy(s->response, "ACK");
+    } else if (!s->bus_reset_seen) {
+        strcpy(s->response, "NAK");
+    } else if (in) {
+        host_in(s, n);
+    } else {
+        host_out(s, n, data, count, setup);
+    }
+    update_irq(s);
+}
+
+static void usb_instance_init(Object *obj)
+{
+    Esp32s3UsbOtg *s = ESP32S3_USB_OTG(obj);
+    DeviceState *dev = DEVICE(obj);
+    SysBusDevice *bus = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &usb_ops, s, TYPE_ESP32S3_USB_OTG,
+                          FIFO_BASE + EP_COUNT * FIFO_STRIDE);
+    sysbus_init_mmio(bus, &s->mmio);
+    sysbus_init_irq(bus, &s->irq);
+    qdev_init_gpio_in_named(dev, usb_clock, "clock-enabled", 1);
+    qdev_init_gpio_in_named(dev, usb_reset, "reset-asserted", 1);
+    object_property_add_str(obj, "host-packet", NULL, host_packet);
+    object_property_add_str(obj, "host-response", host_response, NULL);
+    object_property_add_str(obj, "host-state", host_state, NULL);
+}
+
+static void usb_device_reset(DeviceState *dev)
+{
+    reset_registers(ESP32S3_USB_OTG(dev));
+}
+
+static void usb_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    dc->user_creatable = false;
+    device_class_set_legacy_reset(dc, usb_device_reset);
+}
+
+static const TypeInfo usb_type = {
+    .name = TYPE_ESP32S3_USB_OTG,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32s3UsbOtg),
+    .instance_init = usb_instance_init,
+    .class_init = usb_class_init,
+};
+
+static void usb_register(void)
+{
+    type_register_static(&usb_type);
+}
+type_init(usb_register)
