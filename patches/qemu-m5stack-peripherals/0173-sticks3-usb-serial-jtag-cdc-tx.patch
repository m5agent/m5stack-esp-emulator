 };
 
 static void esp32c3_jtag_reset_hold(Object *obj, ResetType type)
 {
-    (void) obj;
-    (void) type;
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(obj);
+
+    s->int_raw = IRQ_IN_EMPTY;
+    s->int_enable = 0;
+    s->conf = PAD_ENABLE | DP_PULLUP;
+    s->frame = 0;
+    s->tx_len = 0;
+    s->committed = false;
+    esp32c3_jtag_update_irq(s);
+    if (s->host_frame) {
+        timer_mod(s->host_frame, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
+    }
 }
 
 static void esp32c3_jtag_realize(DeviceState *dev, Error **errp)
 {
-    (void) dev;
-    (void) errp;
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(dev);
+    if (qemu_chr_fe_backend_connected(&s->chr)) {
+        s->host_frame = timer_new_ms(QEMU_CLOCK_VIRTUAL,
+                                     esp32c3_jtag_host_frame, s);
+    }
+    esp32c3_jtag_reset_hold(OBJECT(dev), RESET_TYPE_COLD);
+}
+
+static void esp32c3_jtag_unrealize(DeviceState *dev)
+{
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(dev);
+    if (s->host_frame) {
+        timer_free(s->host_frame);
+        s->host_frame = NULL;
+    }
 }
 
