+#include "hw/qdev-properties-system.h"
 #include "hw/sysbus.h"
 #include "hw/misc/esp32c3_jtag.h"
 
 
+/*
+ * Fixed USB Serial/JTAG CDC IN endpoint, distinct from USB OTG.
+ * Off without an explicit virtual host chardev.
+ */
+enum {
+    EP1 = 0x00,
+    EP1_CONF = 0x04,
+    INT_RAW = 0x08,
+    INT_STATUS = 0x0c,
+    INT_ENABLE = 0x10,
+    INT_CLEAR = 0x14,
+    CONF0 = 0x18,
+    FRAME_NUM = 0x24,
+
+    WR_DONE = BIT(0),
+    IN_DATA_FREE = BIT(1),
+    IRQ_SOF = BIT(1),
+    IRQ_IN_EMPTY = BIT(3),
+    PHY_EXTERNAL = BIT(0),
+    PAD_PULL_OVERRIDE = BIT(8),
+    DP_PULLUP = BIT(9),
+    PAD_ENABLE = BIT(14),
+};
+
+static void esp32c3_jtag_update_irq(ESP32C3UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_enable) != 0);
+}
+
+static bool esp32c3_jtag_host_attached(ESP32C3UsbJtagState *s)
+{
+    return (s->conf & PAD_ENABLE) && !(s->conf & PHY_EXTERNAL) &&
+           (!(s->conf & PAD_PULL_OVERRIDE) || (s->conf & DP_PULLUP));
+}
+
+static void esp32c3_jtag_host_frame(void *opaque)
+{
+    ESP32C3UsbJtagState *s = opaque;
+
+    if (esp32c3_jtag_host_attached(s)) {
+        s->frame = (s->frame + 1) & 0x7ff;
+        s->int_raw |= IRQ_SOF;
+        if (s->committed) {
+            int done = s->tx_len ? qemu_chr_fe_write(&s->chr, s->tx, s->tx_len) : 0;
+            if (done > 0) {
+                s->tx_bytes += done;
+                s->tx_len -= done;
+                memmove(s->tx, s->tx + done, s->tx_len);
+            }
+            if (!s->tx_len) {
+                s->tx_packets++;
+                s->committed = false;
+                s->int_raw |= IRQ_IN_EMPTY;
+            }
+        }
+    }
+    esp32c3_jtag_update_irq(s);
+    timer_mod(s->host_frame, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) + 1);
+}
+
 static uint64_t esp32c3_jtag_read(void *opaque, hwaddr addr, unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
-    return 0;
+
+    if (!s->host_frame) {
+        return 0;
+    }
+    switch (addr) {
+    case EP1_CONF:
+        return !s->committed && s->tx_len < sizeof(s->tx) ? IN_DATA_FREE : 0;
+    case INT_RAW:
+        return s->int_raw;
+    case INT_STATUS:
+        return s->int_raw & s->int_enable;
+    case INT_ENABLE:
+        return s->int_enable;
+    case CONF0:
+        return s->conf;
+    case FRAME_NUM:
+        return s->frame;
+    default:
+        return 0;
+    }
 }
 
-static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
+
+    if (!s->host_frame) {
+        return;
+    }
+    switch (addr) {
+    case EP1:
+        if (!s->committed && s->tx_len < sizeof(s->tx)) {
+            s->tx[s->tx_len++] = value;
+        }
+        break;
+    case EP1_CONF:
+        if (value & WR_DONE) {
+            s->committed = true;
+            s->int_raw &= ~IRQ_IN_EMPTY;
+        }
+        break;
+    case INT_ENABLE:
+        s->int_enable = value & (IRQ_SOF | IRQ_IN_EMPTY);
+        break;
+    case INT_CLEAR:
+        s->int_raw &= ~value;
+        break;
+    case CONF0:
+        s->conf = value & 0x1ffff;
+        break;
+    }
+    esp32c3_jtag_update_irq(s);
 }
 
 static const MemoryRegionOps esp32c3_jtag_ops = {
-    .read =  esp32c3_jtag_read,
+    .read = esp32c3_jtag_read,
