+/* A host-controlled, local fixture accepts one complete MPDU, including FCS. */
+static void s3_wifi_raw_rx(Object *obj, const char *hex, Error **errp)
+{
+    Esp32WifiState *s = ESP32S3_WIFI(obj);
+    struct mac80211_frame frame = { 0 };
+    uint8_t *bytes = (uint8_t *)&frame;
+    const size_t max = sizeof(s->s3_raw_tx_bytes);
+    size_t hexlen = strnlen(hex, 2 * max + 1);
+    size_t len = hexlen / 2;
+    unsigned type, subtype;
+
+    if (hexlen % 2 || len < IEEE80211_HEADER_SIZE + 4 || len > max) {
+        error_setg(errp, "raw RX requires 28 to 2316 hex-encoded MPDU bytes");
+        return;
+    }
+    for (size_t i = 0; i < len; i++) {
+        int hi = g_ascii_xdigit_value(hex[2 * i]);
+        int lo = g_ascii_xdigit_value(hex[2 * i + 1]);
+        if (hi < 0 || lo < 0) {
+            error_setg(errp, "raw RX contains invalid hex");
+            return;
+        }
+        bytes[i] = (hi << 4) | lo;
+    }
+    type = (bytes[0] >> 2) & 3;
+    subtype = bytes[0] >> 4;
+    if ((bytes[0] & 3) || (bytes[1] & 0xc0) || (bytes[1] & 3) == 3 ||
+        (type == IEEE80211_TYPE_MGT && (bytes[1] & 3)) ||
+        (type != IEEE80211_TYPE_MGT &&
+         (type != IEEE80211_TYPE_DATA || subtype != 0))) {
+        error_setg(errp, "raw RX requires unprotected three-address "
+                   "management or non-QoS data");
+        return;
+    }
+    if (ldl_le_p(bytes + len - 4) != crc32(0, bytes, len - 4)) {
+        error_setg(errp, "raw RX FCS does not match the MPDU");
+        return;
+    }
+    if (!s->radio_enabled || s->wlan_closed || !s->dma_inlink_ptr ||
+        (s->raw_interrupt & S3_DMA_RX_COMPLETE)) {
+        error_setg(errp, "raw RX radio or DMA is not ready");
+        return;
+    }
+    frame.frame_length = len;
+    if (!s3_wifi_receive_frame(s, &frame, -42)) {
+        error_setg(errp, "raw RX DMA rejected the frame");
+    }
+}
+
+/* The capture is the latest complete descriptor before MAC rewriting. */
+static char *s3_wifi_raw_tx(Object *obj, Error **errp)
+{
+    static const char hex_chars[] = "0123456789abcdef";
+    Esp32WifiState *s = ESP32S3_WIFI(obj);
+    char hex[2 * sizeof(s->s3_raw_tx_bytes) + 1];
+    size_t i;
+
+    for (i = 0; i < s->s3_raw_tx_length; i++) {
+        uint8_t byte = s->s3_raw_tx_bytes[i];
+        hex[2 * i] = hex_chars[byte >> 4];
+        hex[2 * i + 1] = hex_chars[byte & 15];
+    }
+    hex[2 * i] = '\0';
+    return g_strdup_printf("%" PRIu64 ":%s", s->s3_raw_tx_sequence, hex);
+}
