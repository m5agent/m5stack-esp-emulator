-/* The capture is the latest complete descriptor before MAC rewriting. */
+/* Sequence numbers refer to captures since the last controller reset. */
+static void s3_wifi_raw_tx_append(GString *out, Esp32WifiState *s,
+                                  uint64_t sequence)
+{
+    static const char hex[] = "0123456789abcdef";
+    const Esp32S3RawTxFrame *frame;
+
+    g_string_append_printf(out, "%" PRIu64 ":", sequence);
+    if (!sequence) {
+        return;
+    }
+    frame = &s->s3_raw_tx_window[(sequence - 1) % ESP32S3_RAW_TX_WINDOW_SIZE];
+    for (size_t i = 0; i < frame->length; i++) {
+        g_string_append_c(out, hex[frame->bytes[i] >> 4]);
+        g_string_append_c(out, hex[frame->bytes[i] & 15]);
+    }
+}
