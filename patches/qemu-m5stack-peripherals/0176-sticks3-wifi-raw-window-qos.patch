+static char *s3_wifi_raw_tx_window(Object *obj, Error **errp)
+{
+    Esp32WifiState *s = ESP32S3_WIFI(obj);
+    uint64_t count = MIN(s->s3_raw_tx_sequence, ESP32S3_RAW_TX_WINDOW_SIZE);
+    GString *out = g_string_new(NULL);
+
+    for (uint64_t i = 0; i < count; i++) {
+        if (i) {
+            g_string_append_c(out, '\n');
+        }
+        s3_wifi_raw_tx_append(out, s, s->s3_raw_tx_sequence - count + 1 + i);
+    }
+    return g_string_free(out, false);
 }
 
