+static void esp32c3_jtag_schedule(ESP32C3UsbJtagState *s)
+{
+    timer_mod_ns(s->host_timer, MIN(s->next_frame_ns, s->next_in_ns));
+}
+
+static void esp32c3_jtag_sync_host(ESP32C3UsbJtagState *s, int64_t now)
+{
+    bool changed = false;
+
+    if (now >= s->next_frame_ns) {
+        int64_t frames = 1 + (now - s->next_frame_ns) / USB_FRAME_NS;
+        s->next_frame_ns += frames * USB_FRAME_NS;
+        if (esp32c3_jtag_host_attached(s)) {
+            s->frame = (s->frame + frames) & 0x7ff;
+            s->int_raw |= IRQ_SOF;
+        }
+        changed = true;
+    }
+    if (now >= s->next_in_ns) {
+        int done = s->tx_len ? qemu_chr_fe_write(&s->chr, s->tx, s->tx_len) : 0;
+        if (done > 0) {
+            s->tx_bytes += done;
+            s->tx_len -= done;
+            memmove(s->tx, s->tx + done, s->tx_len);
+        }
+        if (s->tx_len) {
+            s->next_in_ns = now + USB_DATA_IN_NS;
+        } else {
+            s->next_in_ns = INT64_MAX;
+            s->tx_packets++;
+            s->committed = false;
+            s->int_raw |= IRQ_IN_EMPTY;
+        }
+        changed = true;
+    }
+    if (changed) {
+        esp32c3_jtag_update_irq(s);
+        esp32c3_jtag_schedule(s);
+    }
+}
+
+static void esp32c3_jtag_host_timer(void *opaque)
+{
+    esp32c3_jtag_sync_host(opaque, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+static void esp32c3_jtag_start_in(ESP32C3UsbJtagState *s, int64_t now)
+{
+    /*
+     * An attached host polls the bulk IN endpoint independently of SOF.
+     * Model one full-speed IN transaction with a short turnaround for a
+     * zero-length packet and enough bus time for a full 64-byte packet.
+     */
+    s->next_in_ns = now + (s->tx_len ? USB_DATA_IN_NS : USB_EMPTY_IN_NS);
+    esp32c3_jtag_schedule(s);
+}
+
+static void esp32c3_jtag_commit(ESP32C3UsbJtagState *s, int64_t now)
+{
+    if (!s->committed) {
+        s->committed = true;
+        s->int_raw &= ~IRQ_IN_EMPTY;
+        if (esp32c3_jtag_host_attached(s)) {
+            esp32c3_jtag_start_in(s, now);
+        }
+    }
 }
 
