+static uint32_t esp32_native_hci_idle_dispatch(void *opaque, CPUState *cs,
+                                               uint32_t idle_target)
+{
+    Esp32NativeHciState *s = opaque;
+    CPUXtensaState *env = cpu_env(cs);
+    uint32_t env_address;
+    uint32_t callback;
+    uint32_t target;
+    Esp32NativeHciPacket *packet;
+
+    BQL_LOCK_GUARD();
+    if (s->c2h_idle_cpu || s->c2h_idle_faulted ||
+        (!s->rx_queue_count && !s->c2h_idle_send_ready) ||
+        !esp32_native_hci_read_u32(cs, s->env_pointer_address, &env_address) ||
+        !env_address ||
+        !esp32_native_hci_read_u32(cs, env_address + s->c2h_callback_offset,
+                                   &callback) ||
+        !callback) {
+        return idle_target;
+    }
+    if (s->rx_queue_count) {
+        if (!s->c2h_idle_buffer) {
+            s->c2h_idle_operation = ESP32_NATIVE_HCI_IDLE_ALLOCATE;
+            env->regs[10] = s->c2h_scratch_size;
+            target = s->c2h_allocator_address;
+        } else {
+            packet = &s->rx_queue[s->rx_queue_head];
+            if (!esp32_native_hci_read_u32(cs, callback + 4, &target) ||
+                !target) {
+                return idle_target;
+            }
+            if (packet->length > s->c2h_scratch_size ||
+                cpu_memory_rw_debug(cs, s->c2h_idle_buffer,
+                                    packet->data, packet->length, true)) {
+                s->c2h_errors++;
+                s->last_error = ESP32_NATIVE_HCI_ERROR_WRITE;
+                s->c2h_idle_faulted = true;
+                return idle_target;
+            }
+            s->c2h_idle_operation = ESP32_NATIVE_HCI_IDLE_RECEIVE;
+            env->regs[10] = s->c2h_idle_buffer;
+            env->regs[11] = packet->length;
+            s->c2h_last_pc = target;
+        }
+    } else {
+        if (!esp32_native_hci_read_u32(cs, callback, &target) || !target) {
+            return idle_target;
+        }
+        s->c2h_idle_send_ready = false;
+        s->c2h_idle_operation = ESP32_NATIVE_HCI_IDLE_SEND_READY;
+    }
+    s->c2h_idle_cpu = cs;
+    return target;
+}
+
+static void esp32_native_hci_idle_complete(void *opaque, CPUState *cs)
+{
+    Esp32NativeHciState *s = opaque;
+    CPUXtensaState *env = cpu_env(cs);
+    uint32_t status = env->regs[10];
+
+    BQL_LOCK_GUARD();
+    if (s->c2h_idle_cpu != cs) {
+        return;
+    }
+    switch (s->c2h_idle_operation) {
+    case ESP32_NATIVE_HCI_IDLE_ALLOCATE:
+        s->c2h_idle_buffer = status;
+        if (!status) {
+            s->c2h_errors++;
+            s->last_error = ESP32_NATIVE_HCI_ERROR_CALLBACK_FAULT;
+            s->c2h_idle_faulted = true;
+        }
+        break;
+    case ESP32_NATIVE_HCI_IDLE_RECEIVE:
+        s->c2h_last_status = status;
+        s->rx_queue_head =
+            (s->rx_queue_head + 1) % ESP32_NATIVE_HCI_QUEUE_DEPTH;
+        s->rx_queue_count--;
+        if (status) {
+            s->c2h_errors++;
+            s->last_error = ESP32_NATIVE_HCI_ERROR_CALLBACK_REJECTED;
+            s->c2h_idle_faulted = true;
+        } else {
+            s->c2h_delivered++;
+        }
+        break;
+    case ESP32_NATIVE_HCI_IDLE_SEND_READY:
+        s->c2h_send_available++;
+        break;
+    case ESP32_NATIVE_HCI_IDLE_NONE:
+        g_assert_not_reached();
+    }
+    s->c2h_idle_cpu = NULL;
+    s->c2h_idle_operation = ESP32_NATIVE_HCI_IDLE_NONE;
+}
