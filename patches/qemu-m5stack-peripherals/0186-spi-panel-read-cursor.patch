+
+/* Readback advances on bus clocks, never on host MMIO reads of the FIFO.
+ * RDDID is 00, ID1, ID2, ID3 in the existing panel identity encoding. */
+void m5_spi_panel_read(M5SpiPanelState *s, uint8_t *data, uint32_t len)
+{
+    for (uint32_t i = 0; i < len; ++i) {
+        data[i] = s->cmd == 0x04 && s->read_offset < 4
+                ? s->read_id >> (8 * s->read_offset) : 0;
+        if (s->read_offset < 4) {
+            ++s->read_offset;
+        }
     }
 }
 
