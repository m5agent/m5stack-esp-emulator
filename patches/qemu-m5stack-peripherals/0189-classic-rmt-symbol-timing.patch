-static void classic_rmt_progress_tx(M5ClassicRmtState *s, unsigned channel)
+static int64_t classic_rmt_deadline(M5ClassicRmtState *s, unsigned channel)
+{
+    /* APB ticks are 12.5 ns. Retain the half nanosecond between symbols and
+     * round only the timer deadline, so repeated odd durations do not drift. */
+    return s->tx_deadline_ns[channel] + s->tx_half_ns[channel];
