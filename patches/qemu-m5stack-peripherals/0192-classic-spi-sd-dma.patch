                     (unsigned long)value);
@@ -218,6 +270,17 @@ static void esp32_spi_write(void *opaque, hwaddr addr,
         if (value & 0xfffff) {
             s->m5_dma_out_link = value & 0xfffff;
         }
+        if (value & (1u << 28)) {
+            s->m5_dma_out_link = 0;
+        }
+        break;
+    case 0x108:
+        if (value & 0xfffff) {
+            s->m5_dma_in_link = value & 0xfffff;
+        }
+        if (value & (1u << 28)) {
+            s->m5_dma_in_link = 0;
+        }
         break;
     }
 }
@@ -255,8 +318,36 @@ static void esp32_spi_txrx_buffer(Esp32SpiState *s, void *buf, int tx_bytes, int
     }
 }
 
+static int esp32_spi_pin_cs_level(Esp32SpiState *s, int pin)
+{
+    int route = esp32_gpio_matrix_out_signal(pin, false);
+    int index = -1;
+
+    if (route == 256) { /* SIG_GPIO_OUT_IDX: software GPIO output. */
+        return esp32_gpio_get_line(pin);
+    }
+    if (s->gpio_cs0_signal == 11) { /* HSPI CS0/1/2. */
+        index = route == 11 ? 0 : route == 61 ? 1 : route == 62 ? 2 : -1;
+    } else if (s->gpio_cs0_signal == 68 && route >= 68 && route <= 70) {
+        index = route - 68; /* VSPI CS0/1/2. */
+    }
+    /* A different controller's output must not inherit stale GPIO state. */
+    return index < 0 || (s->pin_reg & (1u << index)) ? 1 : s->gpio_cs0_level;
+}
+
 static void esp32_spi_cs_set(Esp32SpiState *s, int value)
 {
+    s->gpio_cs0_level = value;
+    if (s->spi_slave_ops) {
+        int level = esp32_spi_pin_cs_level(s, s->spi_slave_cs_pin);
+        if (level != s->spi_slave_cs_level) {
+            s->spi_slave_cs_level = level;
+            if (s->spi_slave_ops->set_cs) {
+                s->spi_slave_ops->set_cs(s->spi_slave_opaque, level);
+            }
+        }
+    }
+
     for (int i = 0; i < ESP32_SPI_CS_COUNT; ++i) {
         qemu_set_irq(s->cs_gpio[i], ((s->pin_reg & (1 << i)) == 0) ? value : 1);
     }
@@ -270,60 +361,59 @@ static void esp32_spi_transaction(Esp32SpiState *s, Esp32SpiTransaction *t)
     for (int i = 0; i < t->extra_dummy_bytes; i++) {
