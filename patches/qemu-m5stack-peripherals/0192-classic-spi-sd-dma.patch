+
+void m5_spi_sd_attach_classic(DeviceState *spi_a, DeviceState *spi_b, int cs_pin)
+{
+    /* Both GP-SPI controllers can be routed to the one physical card bus. */
+    M5SpiSdState *s = m5_spi_sd_create();
+    esp32_spi_attach_spi_slave(spi_a, &sd_spi_ops, s, cs_pin);
+    esp32_spi_attach_spi_slave(spi_b, &sd_spi_ops, s, cs_pin);
