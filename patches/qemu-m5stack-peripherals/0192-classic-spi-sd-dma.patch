-static void esp32_spi_m5_dma_panel(Esp32SpiState *s, uint32_t link,
-                                  uint32_t remaining, bool command_phase,
-                                  bool panel_selected)
+/* Classic DMA descriptors use a 20-bit DRAM link, followed by full buffer
+ * and next-descriptor addresses. TX length and RX capacity are distinct. */
+static uint32_t esp32_spi_dma_copy(uint32_t link, uint8_t *data,
+                                  uint32_t bytes, bool receive)
 {
-    uint32_t desc_addr = 0x3ff00000u | (link & 0xfffff);
+    uint32_t address = 0x3ff00000u | (link & 0xfffff);
+    uint32_t copied = 0;
 
-    for (unsigned descriptors = 0; remaining && descriptors < 4096;
-         descriptors++) {
+    for (unsigned seen = 0; copied < bytes && address && seen < 4096; seen++) {
         uint32_t desc[3];
-        uint32_t length, eof, buf;
-
-        cpu_physical_memory_read(desc_addr, desc, sizeof(desc));
-        length = (desc[0] >> 12) & 0xfff;
-        length = MIN(length, remaining);
-        eof = (desc[0] >> 30) & 1;
-        buf = desc[1];
-        if (length) {
-            uint8_t *data = g_malloc(length);
-            cpu_physical_memory_read(buf, data, length);
-            esp32_spi_txrx_buffer(s, data, length, 0);
-            if (panel_selected) {
-                m5_spi_panel_write((M5SpiPanelState *)s->m5_panel,
-                                   data, length, command_phase);
+        cpu_physical_memory_read(address, desc, sizeof(desc));
+        if (!(desc[0] & (1u << 31))) {
+            break;
+        }
+        uint32_t capacity = receive ? desc[0] & 0xfff : (desc[0] >> 12) & 0xfff;
+        uint32_t length = MIN(capacity, bytes - copied);
+        if (!length) {
+            break;
+        }
+        if (receive) {
+            cpu_physical_memory_write(desc[1], data + copied, length);
+            /* Return ownership after the buffer bytes are visible. */
+            desc[0] = (desc[0] & ~0xc0fff000u) | (length << 12);
+            if (copied + length == bytes) {
+                desc[0] |= 1u << 30;
             }
-            g_free(data);
-            remaining -= length;
+            cpu_physical_memory_write(address, desc, sizeof(uint32_t));
+        } else {
+            cpu_physical_memory_read(desc[1], data + copied, length);
         }
-        if (eof || desc[2] == 0) {
+        copied += length;
+        if (!receive && (desc[0] & (1u << 30))) {
             break;
         }
-        desc_addr = desc[2];
+        address = desc[2];
+    }
+    return copied;
+}
+
+static void esp32_spi_dma_transfer(Esp32SpiState *s, uint32_t tx_bytes,
+                                    uint32_t rx_bytes, bool command_phase,
+                                    bool panel_selected)
+{
+    /* MOSI/MISO length registers are 24-bit bit counts. */
+    uint32_t bytes = MAX(tx_bytes, rx_bytes);
+    uint8_t *data = g_malloc0(bytes);
+    uint32_t fifo_size = sizeof(s->data_reg);
+
+    if (s->m5_dma_out_link && tx_bytes) {
+        uint32_t supplied = esp32_spi_dma_copy(s->m5_dma_out_link, data,
+                                                tx_bytes, false);
+        /* A truncated/unowned chain cannot manufacture bytes on MOSI. */
+        if (supplied < tx_bytes) {
+            tx_bytes = supplied;
+            rx_bytes = MIN(rx_bytes, supplied);
+        }
+    } else {
+        for (uint32_t i = 0; i < tx_bytes; i++) {
+            data[i] = ((uint8_t *)s->data_reg)[i % fifo_size];
+        }
+    }
+    if (panel_selected && tx_bytes) {
+        m5_spi_panel_write((M5SpiPanelState *)s->m5_panel, data,
+                           tx_bytes, command_phase);
+    }
+    esp32_spi_txrx_buffer(s, data, tx_bytes, rx_bytes);
+    if (panel_selected && rx_bytes) {
+        m5_spi_panel_read((M5SpiPanelState *)s->m5_panel, data, rx_bytes);
+    }
+    if (s->m5_dma_in_link && rx_bytes) {
+        esp32_spi_dma_copy(s->m5_dma_in_link, data, rx_bytes, true);
+    } else if (rx_bytes) {
+        memcpy(s->data_reg, data, MIN(rx_bytes, fifo_size));
     }
+    s->m5_dma_out_link = 0;
+    s->m5_dma_in_link = 0;
+    g_free(data);
 }
 
 static uint64_t esp32_spi_read(void *opaque, hwaddr addr, unsigned int size)
@@ -185,10 +231,10 @@ static void esp32_spi_write(void *opaque, hwaddr addr,
         s->user2_reg = value;
         break;
