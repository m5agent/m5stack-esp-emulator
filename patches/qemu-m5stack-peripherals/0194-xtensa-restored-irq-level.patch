 static void translate_rsr_ccount(DisasContext *dc, const OpcodeArg arg[],
                                  const uint32_t par[])
 {
 #ifndef CONFIG_USER_ONLY
     translator_io_start(&dc->base);
     gen_helper_update_ccount(tcg_env);
     tcg_gen_mov_i32(arg[0].out, cpu_SR[par[0]]);
     /*
      * Timing loops poll CCOUNT until the virtual clock advances. End the
      * translation block after the read so tightly looping guests cannot
      * observe a frozen value inside one TB.
      */
     dc->base.is_jmp = DISAS_TOO_MANY;
