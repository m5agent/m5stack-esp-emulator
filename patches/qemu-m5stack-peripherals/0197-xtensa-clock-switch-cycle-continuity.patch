 static void xtensa_ccompare_cb(void *opaque)
 {
     XtensaCcompareTimer *ccompare = opaque;
     CPUXtensaState *env = ccompare->env;
     unsigned i = ccompare - env->ccompare;
 
     qemu_set_irq(env->irq_inputs[env->config->timerint[i]], 1);
 }
 
 static void xtensa_set_runstall(void *opaque, int irq, int active)
 {
     CPUXtensaState *env = opaque;
     xtensa_runstall(env, active);
 }
 
+void xtensa_cpu_update_clock_hz(XtensaCPU *cpu, unsigned hz, uint64_t now)
+{
+    CPUXtensaState *env = &cpu->env;
+    Clock *clock = cpu->clock;
+    uint64_t period = CLOCK_PERIOD_FROM_HZ(hz);
+
+    /* Classic ESP32 CPU clock selection switches between running sources. */
+    assert(hz > 0);
+    if (period == clock_get(clock)) {
+        return;
+    }
+
+    if (!xtensa_option_enabled(env->config, XTENSA_OPTION_TIMER_INTERRUPT)) {
+        clock_update(clock, period);
+        return;
+    }
+
+    /* Carry forward all ticks accumulated at the previous rate. The new
+     * rate applies only to time after this clock change. */
+    env->ccount_base += (uint32_t)clock_ns_to_ticks(clock, now - env->time_base);
+    env->time_base = now;
+    env->ccount_time = now;
+    env->sregs[CCOUNT] = env->ccount_base;
+    clock_update(clock, period);
+
+    for (unsigned i = 0; i < env->config->nccompare; i++) {
+        QEMUTimer *timer = env->ccompare[i].timer;
+
+        /* Do not rearm idle timers or alter a match already due. A latched
+         * compare IRQ is acknowledged only by the guest compare write. */
+        if (timer && timer_pending(timer) && timer_expire_time_ns(timer) > now) {
+            uint32_t delta = env->sregs[CCOMPARE + i] - env->ccount_base;
+
+            timer_mod_ns(timer, now + clock_ticks_to_ns(clock, delta ? delta : 1));
+        }
+    }
+}
+
 void xtensa_irq_init(CPUXtensaState *env)
 {
     unsigned i;
 
     env->irq_inputs = qemu_allocate_irqs(xtensa_set_irq, env,
                                          env->config->ninterrupt);
     if (xtensa_option_enabled(env->config, XTENSA_OPTION_TIMER_INTERRUPT)) {
         env->time_base = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
         env->ccount_base = env->sregs[CCOUNT];
         for (i = 0; i < env->config->nccompare; ++i) {
             env->ccompare[i].env = env;
             env->ccompare[i].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
                     xtensa_ccompare_cb, env->ccompare + i);
         }
     }
     for (i = 0; i < env->config->nextint; ++i) {
         unsigned irq = env->config->extint[i];
 
         env->ext_irq_inputs[i] = env->irq_inputs[irq];
     }
