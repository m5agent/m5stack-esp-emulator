 type_init(plus2_hold_register)
 
+enum {
+    PLUS2_LCD_CS = 5,
+    PLUS2_LCD_SCK = 13,
+    PLUS2_LCD_DC = 14,
+    PLUS2_LCD_SDA = 15,
+    PLUS2_LCD_READ_ID = 0x04,
+    PLUS2_LCD_READ_BITS = 32,
+};
+
+typedef struct Plus2GpioLcd {
+    M5SpiPanelState *panel;
+    Esp32GpioPeerInput *sda;
+    Esp32GpioPadObserver *observers[4];
+    bool selected, clock, sda_driven, read_pending, reading;
+    uint8_t shift, write_bits, read_bits, read_byte;
+} Plus2GpioLcd;
+
+static bool plus2_lcd_gpio_output(const Esp32GpioPadSnapshot *pad)
+{
+    return pad->mux_path == ESP32_GPIO_MUX_GPIO_MATRIX && !pad->override_mask &&
+           pad->oe_known && pad->oe && pad->drive_known &&
+           (!pad->open_drain || !pad->drive_level);
+}
+
+static void plus2_lcd_release(Plus2GpioLcd *bus)
+{
+    if (bus->sda_driven) {
+        esp32_gpio_drive_peer_input_deferred(bus->sda, -1);
+        bus->sda_driven = false;
+    }
+}
+
+static void plus2_lcd_clear(Plus2GpioLcd *bus)
+{
+    plus2_lcd_release(bus);
+    bus->selected = false;
+    bus->clock = false;
+    bus->read_pending = false;
+    bus->reading = false;
+    bus->write_bits = 0;
+    bus->read_bits = 0;
+}
+
+static void plus2_lcd_gpio_change(void *opaque, const Esp32GpioPadEvent *event)
+{
+    Plus2GpioLcd *bus = opaque;
+    Esp32GpioState *gpio = esp32_gpio_get_controller(false);
+    Esp32GpioPadSnapshot cs, sck, dc, sda;
+
+    if (event->cause == ESP32_GPIO_PAD_RESET ||
+        !esp32_gpio_pad_snapshot(gpio, PLUS2_LCD_CS, &cs) ||
+        !plus2_lcd_gpio_output(&cs) || cs.drive_level ||
+        !esp32_gpio_pad_snapshot(gpio, PLUS2_LCD_SCK, &sck) ||
+        !plus2_lcd_gpio_output(&sck)) {
+        plus2_lcd_clear(bus);
+        return;
+    }
+    esp32_gpio_pad_snapshot(gpio, PLUS2_LCD_DC, &dc);
+    esp32_gpio_pad_snapshot(gpio, PLUS2_LCD_SDA, &sda);
+    if (!bus->selected) {
+        bus->selected = true;
+        bus->clock = sck.drive_level;
+        return;
+    }
+
+    bool host_drives = plus2_lcd_gpio_output(&sda);
+    bool host_releases = !sda.oe ||
+                         (sda.drive_known && sda.open_drain && sda.drive_level);
+    bool host_receives = sda.mux_path == ESP32_GPIO_MUX_GPIO_MATRIX &&
+                         !sda.override_mask && sda.oe_known && host_releases &&
+                         sda.fun_ie;
+    bool data_phase = plus2_lcd_gpio_output(&dc) && dc.drive_level;
+    if (bus->reading && (!host_receives || !data_phase)) {
+        plus2_lcd_release(bus);
+        bus->reading = bus->read_pending = false;
+    }
+    if (bus->read_pending && data_phase && host_receives) {
+        bus->read_pending = false;
+        bus->reading = true;
+        bus->read_bits = 0;
+    }
+    if (bus->clock == sck.drive_level) {
+        return;
+    }
+    bus->clock = sck.drive_level;
+    if (bus->reading) {
+        /* The first rising edge is the ST7789V2 turnaround clock. Present
+         * each output bit on its following falling edge for the next sample. */
+        if (!bus->clock) {
+            if (bus->read_bits == PLUS2_LCD_READ_BITS) {
+                plus2_lcd_release(bus);
+                bus->reading = false;
+                return;
+            }
+            unsigned bit = bus->read_bits++ % 8;
+            if (bit == 0) {
+                m5_spi_panel_read(bus->panel, &bus->read_byte, 1);
+            }
+            esp32_gpio_drive_peer_input_deferred(bus->sda,
+                                                 (bus->read_byte >> (7 - bit)) & 1);
+            bus->sda_driven = true;
+        }
+        return;
+    }
+    if (!bus->clock || !host_drives || !plus2_lcd_gpio_output(&dc)) {
+        return;
+    }
+    bus->shift = (bus->shift << 1) | sda.drive_level;
+    if (++bus->write_bits == 8) {
+        m5_spi_panel_write(bus->panel, &bus->shift, 1, !data_phase);
+        bus->read_pending = !data_phase && bus->shift == PLUS2_LCD_READ_ID;
+        bus->write_bits = 0;
+    }
+}
+
+static void plus2_lcd_attach_gpio(M5SpiPanelState *panel)
+{
+    static Plus2GpioLcd bus;
+    static const unsigned pins[] = {
+        PLUS2_LCD_CS, PLUS2_LCD_SCK, PLUS2_LCD_DC, PLUS2_LCD_SDA,
+    };
+    Esp32GpioState *gpio = esp32_gpio_get_controller(false);
+
+    bus.panel = panel;
+    bus.sda = esp32_gpio_attach_peer_input(gpio, PLUS2_LCD_SDA, &error_fatal);
+    for (unsigned i = 0; i < ARRAY_SIZE(pins); i++) {
+        Esp32GpioPadSnapshot initial;
+
+        bus.observers[i] = esp32_gpio_observe_pad(gpio, pins[i],
+                                plus2_lcd_gpio_change, &bus, &initial, &error_fatal);
+    }
+}
