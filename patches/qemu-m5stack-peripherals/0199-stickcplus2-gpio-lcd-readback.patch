+/* Release a line driven by the corresponding deferred-input endpoint. */
+void esp32_gpio_release_input_deferred(int pin)
+{
+    if (pin < 0 || pin >= GPIO_NPINS) { return; }
+    g_external_seen &= ~(1ULL << pin);
+    g_ext_in |= 1ULL << pin;
+}
