+Esp32GpioPeerInput *esp32_gpio_attach_peer_input(Esp32GpioState *s,
+                                                unsigned pin, Error **errp)
+{
+    if (!gpio_pad_valid(s, pin) || g_peer_inputs[pin].gpio) {
+        error_setg(errp, "GPIO%u cannot attach another peripheral driver", pin);
+        return NULL;
+    }
+    Esp32GpioPeerInput *peer = &g_peer_inputs[pin];
+    *peer = (Esp32GpioPeerInput){ .gpio = s, .pin = pin };
+    return peer;
+}
+
+void esp32_gpio_drive_peer_input_deferred(Esp32GpioPeerInput *peer, int level)
+{
+    assert(peer && peer->gpio == g_gpio_device && level >= -1 && level <= 1);
+    uint64_t bit = 1ULL << peer->pin;
+    if (level < 0) {
+        g_peer_drive_mask &= ~bit;
+    } else {
+        g_peer_drive_mask |= bit;
+        g_peer_drive_high = (g_peer_drive_high & ~bit) | (level ? bit : 0);
+    }
+}
