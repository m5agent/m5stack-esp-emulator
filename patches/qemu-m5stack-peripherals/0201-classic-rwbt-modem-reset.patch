+
+static void esp32_rwbt_reset_mac(Esp32BtState *s)
+{
+    timer_del(&s->slot_timer);
+    timer_del(&s->fine_timer);
+    timer_del(&s->gross_timer);
+    s->rwbt_slot_enabled = false;
+    s->rwbt_fine_armed = false;
+    s->rwbt_gross_armed = false;
+    s->rwbt_int_raw &= ESP32_RWBT_SLEEP_IRQ;
+    s->regs[ESP32_RWBT_INT_MASK / 4] &= ESP32_RWBT_SLEEP_IRQ;
+    s->regs[ESP32_RWBT_FINE_TARGET / 4] = 0;
+    s->regs[ESP32_RWBT_GROSS_TARGET / 4] = 0;
+    s->regs[ESP32_RWBT_BASE_TIME / 4] = 0;
+    s->regs[ESP32_RWBT_FINE_TIME / 4] = 0;
+}
+
+static void esp32_rwbt_reset_low_power(Esp32BtState *s)
+{
+    bool clock_stopped = s->rwbt_clock_stopped;
+
+    timer_del(&s->sleep_timer);
+    s->sleeping = false;
+    s->wake_pending = false;
+    s->sleep_final_ticks = 0;
+    s->rwbt_int_raw &= ~ESP32_RWBT_SLEEP_IRQ;
+    s->regs[ESP32_RWBT_INT_MASK / 4] &= ~ESP32_RWBT_SLEEP_IRQ;
+    s->regs[ESP32_RWBT_BASE_CORRECTION / 4] = 0;
+    s->regs[ESP32_RWBT_FINE_CORRECTION / 4] = 0;
+    s->regs[ESP32_RWBT_SLEEP_CONTROL / 4] = 0;
+    s->regs[ESP32_RWBT_SLEEP_TARGET / 4] = 0;
+    s->regs[ESP32_RWBT_SLEEP_PRESET / 4] = 0;
+    if (clock_stopped) {
+        s->rwbt_time_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        s->rwbt_clock_stopped = false;
+        esp32_rwbt_set_slot_deadline(s);
+        if (s->rwbt_fine_armed) {
+            esp32_rwbt_set_fine_deadline(s);
+        }
+        if (s->rwbt_gross_armed) {
+            esp32_rwbt_set_gross_deadline(s);
+        }
+    }
+}
+
+static void esp32_rwbt_modem_reset(void *opaque, int domain, int level)
+{
+    Esp32SocState *soc = ESP32_SOC(opaque);
+    Esp32BtState *s = soc->bt_state;
+
+    if (!level || !s) {
+        return;
+    }
+    uint32_t reset = soc->dport.core_rst_en;
+    bool mac = FIELD_EX32(reset, DPORT_CORE_RST_EN, RW_BTMAC_RST);
+    bool lp = FIELD_EX32(reset, DPORT_CORE_RST_EN, RW_BTLP_RST);
+    bool mac_asserted = mac && !s->rwbt_mac_reset;
+    bool lp_asserted = lp && !s->rwbt_lp_reset;
+
+    /* Both domain levels come from one write, including simultaneous swaps. */
+    s->rwbt_mac_reset = mac;
+    s->rwbt_lp_reset = lp;
+    if (mac_asserted) {
+        esp32_rwbt_reset_mac(s);
+        esp32_ble_reset_time(s);
+    }
+    if (lp_asserted) {
+        esp32_rwbt_reset_low_power(s);
+    }
+    if (mac && lp && (mac_asserted || lp_asserted)) {
+        esp32_rwbt_reset_sleep(s);
+    }
+    esp32_rwbt_update_irq(s);
+}
