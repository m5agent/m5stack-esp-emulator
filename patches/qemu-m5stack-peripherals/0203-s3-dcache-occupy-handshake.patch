+/* ESP-IDF's 16KB DCache configuration reserves the first 16KB of DROM
+ * as internal/DMA SRAM. The unified MMU can still map IROM code in that
+ * page; IDF keeps its DROM alias unused via .flash_rodata_dummy. Other
+ * occupied ranges retain their MMU backing/permissions: this functional
+ * model has no cache replacement or timing to pin. */
+static void esp32s3_cache_occupy(ESP32S3CacheState *s)
+{
+    uint32_t ctrl = s->regs[ESP32S3_CACHE_REG_IDX(A_EXTMEM_DCACHE_CTRL)];
+    uint32_t mode = FIELD_EX32(ctrl, EXTMEM_DCACHE_CTRL, BLOCKSIZE_MODE);
+    uint32_t addr = s->regs[ESP32S3_CACHE_REG_IDX(A_EXTMEM_DCACHE_OCCUPY_ADDR)];
+    uint32_t items = s->regs[ESP32S3_CACHE_REG_IDX(A_EXTMEM_DCACHE_OCCUPY_SIZE)];
+    uint32_t line_size = 16u << mode;
+    uint64_t length = (uint64_t)items * line_size;
+
+    if (mode > 2 || addr != ESP32S3_DCACHE_BASE || length != 0x4000 ||
+        (ctrl & R_EXTMEM_DCACHE_CTRL_SIZE_MODE_MASK)) {
+        return;
+    }
+    memory_region_set_enabled(&s->occupy_window, true);
+}
