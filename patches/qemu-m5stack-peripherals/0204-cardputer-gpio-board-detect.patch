+    M5SpiPanelState *panel;
+    Esp32GpioState *gpio;
+    unsigned cs_pin, sck_pin, dc_pin, sda_pin;
+    Esp32GpioPeerInput *sda;
+    bool selected, clock, sda_driven, read_pending, reading;
+    uint8_t shift, write_bits, read_bits, read_byte;
+} M5SpiPanelGpio;
+
 struct M5SpiPanelState {
     DeviceState parent_obj;
+    M5SpiPanelGpio gpio;
     QemuConsole *con;
     QEMUTimer *refresh_timer;
     QEMUBH *refresh_bh;
@@ -507,6 +518,128 @@
     return s->read_id;
 }
 
+static bool m5_spi_panel_gpio_output(const Esp32GpioPadSnapshot *pad)
+{
+    return pad->mux_path == ESP32_GPIO_MUX_GPIO_MATRIX && !pad->override_mask &&
+           pad->oe_known && pad->oe && pad->drive_known &&
+           (!pad->open_drain || !pad->drive_level);
+}
+
+static void m5_spi_panel_gpio_release(M5SpiPanelGpio *bus)
+{
+    if (bus->sda_driven) {
+        esp32_gpio_drive_peer_input_deferred(bus->sda, -1);
+        bus->sda_driven = false;
+    }
+}
+
+static void m5_spi_panel_gpio_clear(M5SpiPanelGpio *bus)
+{
+    m5_spi_panel_gpio_release(bus);
+    bus->selected = false;
+    bus->clock = false;
+    bus->read_pending = false;
+    bus->reading = false;
+    bus->write_bits = 0;
+    bus->read_bits = 0;
+}
+
+static void m5_spi_panel_gpio_change(void *opaque, const Esp32GpioPadEvent *event)
+{
+    M5SpiPanelGpio *bus = opaque;
+    Esp32GpioState *gpio = bus->gpio;
+    Esp32GpioPadSnapshot cs, sck, dc, sda;
+
+    if (event->cause == ESP32_GPIO_PAD_RESET ||
+        !esp32_gpio_pad_snapshot(gpio, bus->cs_pin, &cs) ||
+        !m5_spi_panel_gpio_output(&cs) || cs.drive_level ||
+        !esp32_gpio_pad_snapshot(gpio, bus->sck_pin, &sck) ||
+        !m5_spi_panel_gpio_output(&sck)) {
+        m5_spi_panel_gpio_clear(bus);
+        return;
+    }
+    esp32_gpio_pad_snapshot(gpio, bus->dc_pin, &dc);
+    esp32_gpio_pad_snapshot(gpio, bus->sda_pin, &sda);
+    if (!bus->selected) {
+        bus->selected = true;
+        bus->clock = sck.drive_level;
+        return;
+    }
+
+    bool host_drives = m5_spi_panel_gpio_output(&sda);
+    bool host_releases = !sda.oe ||
+                         (sda.drive_known && sda.open_drain && sda.drive_level);
+    bool host_receives = sda.mux_path == ESP32_GPIO_MUX_GPIO_MATRIX &&
+                         !sda.override_mask && sda.oe_known && host_releases &&
+                         sda.fun_ie;
+    bool data_phase = m5_spi_panel_gpio_output(&dc) && dc.drive_level;
+    if (bus->reading && (!host_receives || !data_phase)) {
+        m5_spi_panel_gpio_release(bus);
+        bus->reading = bus->read_pending = false;
+    }
+    if (bus->read_pending && data_phase && host_receives) {
+        bus->read_pending = false;
+        bus->reading = true;
+        bus->read_bits = 0;
+    }
+    if (bus->clock == sck.drive_level) {
+        return;
+    }
+    bus->clock = sck.drive_level;
+    if (bus->reading) {
+        /* The first rising edge is the ST7789V2 turnaround clock. Present
+         * each output bit on its following falling edge for the next sample. */
+        if (!bus->clock) {
+            if (bus->read_bits == 32) {
+                m5_spi_panel_gpio_release(bus);
+                bus->reading = false;
+                return;
+            }
+            unsigned bit = bus->read_bits++ % 8;
+            if (bit == 0) {
+                m5_spi_panel_read(bus->panel, &bus->read_byte, 1);
+            }
+            esp32_gpio_drive_peer_input_deferred(bus->sda,
+                                                 (bus->read_byte >> (7 - bit)) & 1);
+            bus->sda_driven = true;
+        }
+        return;
+    }
+    if (!bus->clock || !host_drives || !m5_spi_panel_gpio_output(&dc)) {
+        return;
+    }
+    bus->shift = (bus->shift << 1) | sda.drive_level;
+    if (++bus->write_bits == 8) {
+        m5_spi_panel_write(bus->panel, &bus->shift, 1, !data_phase);
+        bus->read_pending = !data_phase && bus->shift == 0x04;
+        bus->write_bits = 0;
+    }
+}
+
+void m5_spi_panel_attach_gpio(M5SpiPanelState *panel, Esp32GpioState *gpio,
+                              unsigned cs, unsigned sck, unsigned dc,
+                              unsigned sda)
+{
+    M5SpiPanelGpio *bus = &panel->gpio;
+    const unsigned pins[] = { cs, sck, dc, sda };
+
+    assert(!bus->gpio);
+    bus->panel = panel;
+    bus->gpio = gpio;
+    bus->cs_pin = cs;
+    bus->sck_pin = sck;
+    bus->dc_pin = dc;
+    bus->sda_pin = sda;
+    bus->sda = esp32_gpio_attach_peer_input(gpio, sda, &error_fatal);
+    for (unsigned i = 0; i < ARRAY_SIZE(pins); i++) {
+        Esp32GpioPadSnapshot initial;
+
+        esp32_gpio_observe_pad(
+            gpio, pins[i], m5_spi_panel_gpio_change, bus, &initial,
+            &error_fatal);
+    }
+}
+
