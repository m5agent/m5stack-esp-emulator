+static bool softap_fixture_beacon(const mac80211_frame *frame)
+{
+    static const char ssid[] = "fixture-ap-test";
+    const uint8_t *data = frame->data_and_fcs;
+    size_t end;
+
+    if (frame->frame_length < IEEE80211_HEADER_SIZE + 12 + ETH_FCS_LEN ||
+        frame->frame_length > IEEE80211_HEADER_SIZE + sizeof(frame->data_and_fcs) ||
+        (data[10] & 0x11) != 1 ||
+        (frame->transmitter_address[0] & 1) ||
+        memcmp(frame->transmitter_address, frame->address_3, ETH_ALEN)) {
+        return false;
+    }
+    end = frame->frame_length - IEEE80211_HEADER_SIZE - ETH_FCS_LEN;
+    for (size_t offset = 12; offset + 2 <= end;) {
+        uint8_t tag = data[offset];
+        size_t length = data[offset + 1];
+
+        offset += 2;
+        if (length > end - offset) {
+            return false;
+        }
+        if (tag == IEEE80211_BEACON_PARAM_SSID) {
+            return length == sizeof(ssid) - 1 &&
+                !memcmp(data + offset, ssid, length);
+        }
+        offset += length;
+    }
+    return false;
+}
+
+static void softap_fixture_manage(Esp32WifiState *s, mac80211_frame *frame)
+{
+    unsigned subtype = frame->frame_control.sub_type;
+    const uint8_t *data = frame->data_and_fcs;
+    access_point_info fixture = { .ssid = "fixture-ap-test" };
+
+    if (subtype == IEEE80211_TYPE_MGT_SUBTYPE_BEACON) {
+        if (s->ap_state == Esp32_WLAN__STATE_NOT_AUTHENTICATED &&
+            softap_fixture_beacon(frame)) {
+            memcpy(s->associated_ap_macaddr, frame->transmitter_address,
+                   ETH_ALEN);
+            s->ap_state = Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED;
+            send_single_frame(s, frame,
+                              Esp32_WLAN_create_authentication_request());
+        }
+        return;
+    }
+    if (memcmp(frame->transmitter_address, s->associated_ap_macaddr, ETH_ALEN) ||
+        memcmp(frame->address_3, s->associated_ap_macaddr, ETH_ALEN) ||
+        memcmp(frame->receiver_address, s->macaddr, ETH_ALEN)) {
+        return;
+    }
+    if (subtype == IEEE80211_TYPE_MGT_SUBTYPE_AUTHENTICATION &&
+        s->ap_state == Esp32_WLAN__STATE_STA_NOT_AUTHENTICATED &&
+        frame->frame_length >= IEEE80211_HEADER_SIZE + 6 + ETH_FCS_LEN &&
+        !memcmp(data, (uint8_t[]) { 0, 0, 2, 0, 0, 0 }, 6)) {
+        s->ap_state = Esp32_WLAN__STATE_STA_AUTHENTICATED;
+        send_single_frame(s, frame,
+                          Esp32_WLAN_create_association_request(&fixture));
+    } else if (subtype == IEEE80211_TYPE_MGT_SUBTYPE_ASSOCIATION_RESP &&
+               s->ap_state == Esp32_WLAN__STATE_STA_AUTHENTICATED &&
+               frame->frame_length >= IEEE80211_HEADER_SIZE + 6 + ETH_FCS_LEN &&
+               !data[2] && !data[3]) {
+        s->ap_state = Esp32_WLAN__STATE_SOFTAP_ASSOCIATED;
+        qemu_flush_queued_packets(qemu_get_queue(s->nic));
+    } else if (subtype == IEEE80211_TYPE_MGT_SUBTYPE_DISASSOCIATION ||
+               subtype == IEEE80211_TYPE_MGT_SUBTYPE_DEAUTHENTICATION) {
+        Esp32_WLAN_reset_softap_peer(s);
+    }
 }
 
