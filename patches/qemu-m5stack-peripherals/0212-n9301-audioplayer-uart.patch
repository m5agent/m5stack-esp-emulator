+enum {
+    N9301_PLAYBACK = 0x04,
+    N9301_VOLUME = 0x06,
+    N9301_LOOP = 0x0b,
+    N9301_ERROR = 0xaa,
+};
+
+static uint8_t n9301_checksum(const uint8_t *data, size_t length)
+{
+    uint8_t checksum = 0;
+
+    for (size_t index = 0; index < length; index++) {
+        checksum += data[index];
+    }
+    return checksum;
+}
+
+static void n9301_reply(GPIOUnit *g, ESP32UARTState *uart, unsigned index,
+                        uint8_t cmd, uint8_t sub, uint16_t value, bool wide)
+{
+    uint8_t frame[] = { cmd, (uint8_t)~cmd, wide ? 3 : 2, sub,
+                        wide ? value >> 8 : value, value, 0 };
+    size_t length = frame[2] + 4;
+
+    if (esp32_gpio_matrix_in_pin(uart_signal[index], true) != g->unit->white ||
+        length > fifo8_num_free(&uart->rx_fifo)) {
+        return;
+    }
+    frame[length - 1] = n9301_checksum(frame, length - 1);
+    esp32_uart_inject_rx(uart, frame, length);
+    g->unit->read_bytes += length;
+    g->at_frames_injected++;
+    g_free(g->last_rx);
+    g->last_rx = g_malloc(length * 2 + 1);
+    for (size_t i = 0; i < length; i++) {
+        sprintf(g->last_rx + i * 2, "%02x", frame[i]);
+    }
+}
+
+static void n9301_playback(GPIOUnit *g, ESP32UARTState *uart, unsigned index,
+                           const uint8_t *data, size_t length)
+{
+    uint8_t sub = data[0];
+    uint16_t selected;
+
+    if (sub == 0x06 || sub == 0x16) {
+        if (length != 3) {
+            return;
+        }
+        selected = (data[1] << 8) | data[2];
+        if (!selected || selected > g->n9301_media_tracks) {
+            n9301_reply(g, uart, index, N9301_ERROR, 0xff, 0x04, false);
+            return;
+        }
+        g->n9301_track = selected;
+        g->n9301_status = sub == 0x06 ? 1 : 0;
+    } else if (length != 1) {
+        return;
+    }
+
+    switch (sub) {
+    case 0x01:  /* Play or resume. */
+        g->n9301_status = 1;
+        break;
+    case 0x02:
+        if (g->n9301_status == 1) {
+            g->n9301_status = 2;
+        }
+        break;
+    case 0x03:
+    case 0x14:
+        g->n9301_status = 0;
+        break;
+    case 0x04:
+        g->n9301_track = g->n9301_track == 1 ?
+                         g->n9301_media_tracks : g->n9301_track - 1;
+        g->n9301_status = 1;
+        break;
+    case 0x05:
+        g->n9301_track = g->n9301_track == g->n9301_media_tracks ?
+                         1 : g->n9301_track + 1;
+        g->n9301_status = 1;
+        break;
+    }
+
+    switch (sub) {
+    case 0x00:
+    case 0x01:
+    case 0x02:
+    case 0x03:
+        n9301_reply(g, uart, index, N9301_PLAYBACK, 0,
+                    g->n9301_status, false);
+        break;
+    case 0x04:
+    case 0x05:
+    case 0x06:
+    case 0x0e:
+    case 0x16:
+        n9301_reply(g, uart, index, N9301_PLAYBACK, 0x0e,
+                    g->n9301_track, true);
+        break;
+    case 0x08:  /* Online-device mask, SD bit. */
+        n9301_reply(g, uart, index, N9301_PLAYBACK, sub, 2, false);
+        break;
+    case 0x09:  /* Playback device, SD. */
+        n9301_reply(g, uart, index, N9301_PLAYBACK, sub, 1, false);
+        break;
+    case 0x0d:
+    case 0x18:  /* The indexed fixture has one directory. */
+        n9301_reply(g, uart, index, N9301_PLAYBACK, sub,
+                    g->n9301_media_tracks, true);
+        break;
+    }
+}
+
+static void n9301_command(GPIOUnit *g, ESP32UARTState *uart, unsigned index)
+{
+    uint8_t cmd = g->n9301_frame[0];
+    size_t length = g->n9301_frame[2];
+    const uint8_t *data = g->n9301_frame + 3;
+
+    g->at_frames_sent++;
+    if (!g->n9301_media_tracks || !length) {
+        return;
+    }
+    if (cmd == N9301_PLAYBACK) {
+        n9301_playback(g, uart, index, data, length);
+    } else if (cmd == N9301_VOLUME) {
+        if (length == 1 && data[0] == 0) {
+            n9301_reply(g, uart, index, cmd, 0, g->n9301_volume, false);
+        } else if (length == 2 && data[0] == 1 && data[1] <= 30) {
+            g->n9301_volume = data[1];
+        } else if (length == 1 && data[0] == 2 && g->n9301_volume < 30) {
+            g->n9301_volume++;
+        } else if (length == 1 && data[0] == 3 && g->n9301_volume > 0) {
+            g->n9301_volume--;
+        }
+    } else if (cmd == N9301_LOOP) {
+        if (length == 1 && data[0] == 0) {
+            n9301_reply(g, uart, index, cmd, 0, g->n9301_loop_mode, false);
+        } else if (length == 2 && data[0] == 1 && data[1] <= 5) {
+            g->n9301_loop_mode = data[1];
+            g->n9301_status = 0;
+        }
+    }
+}
+
+static void n9301_receive(GPIOUnit *g, ESP32UARTState *uart, unsigned index,
+                          uint8_t byte)
+{
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+
+    if (g->n9301_length && now - g->n9301_frame_start_ms >= 500) {
+        g->n9301_length = 0;
+        g->n9301_invalid_frames++;
+    }
+    if (g->n9301_length == 1 &&
+        (g->n9301_frame[0] ^ byte) != UINT8_MAX) {
+        g->n9301_length = 0;
+        g->n9301_invalid_frames++;
+    }
+    if (g->n9301_length == 2 && byte > sizeof(g->n9301_frame) - 4) {
+        g->n9301_length = 0;
+        g->n9301_invalid_frames++;
+        return;
+    }
+    if (g->n9301_length == 0) {
+        g->n9301_frame_start_ms = now;
+    }
+    g->n9301_frame[g->n9301_length++] = byte;
+    if (g->n9301_length < 4 ||
+        g->n9301_length != (size_t)g->n9301_frame[2] + 4) {
+        return;
+    }
+    if (n9301_checksum(g->n9301_frame, g->n9301_length - 1) == byte) {
+        g->unit->transactions++;
+        n9301_command(g, uart, index);
+    } else {
+        g->n9301_invalid_frames++;
+    }
+    g->n9301_length = 0;
+}
+
+static void n9301_media_get(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    GPIOUnit *g = opaque;
+
+    count_get(obj, v, name, &g->n9301_media_tracks, errp);
+}
+
+static void n9301_media_set(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    GPIOUnit *g = opaque;
+    uint64_t count;
+
+    if (!visit_type_uint64(v, name, &count, errp)) {
+        return;
+    }
+    if (g->n9301_media_frozen || (g->at_responses && *g->at_responses) ||
+        count > UINT16_MAX) {
+        error_setg(errp, "AudioPlayer indexed media is a creation-only "
+                   "fixture with 0..65535 tracks and requires protocol mode");
+        return;
+    }
+    g->n9301_media_tracks = count;
+    g->n9301_track = count ? 1 : 0;
+    g->unit->input_events++;
+}
