diff --git a/include/hw/timer/esp32s3_iwdt_trace.h b/include/hw/timer/esp32s3_iwdt_trace.h
new file mode 100644
--- /dev/null
+++ b/include/hw/timer/esp32s3_iwdt_trace.h
@@ -0,0 +1,29 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#ifndef HW_TIMER_ESP32S3_IWDT_TRACE_H
+#define HW_TIMER_ESP32S3_IWDT_TRACE_H
+
+/* Host diagnostics only. No field is visible to the guest or migrates. */
+typedef struct ESPS3IwdtTrace {
+    bool dumped;
+    uint64_t alarms[2];
+    uint64_t coalesced[2];
+    int64_t last_alarm_ns[2];
+    int64_t last_expire_ns[2];
+    uint64_t acknowledgements[2][2]; /* [vCPU][target] */
+    int64_t last_ack_ns[2][2];
+    uint64_t irq_rises[3]; /* WDT, TARGET0, TARGET1 */
+    uint64_t irq_falls[3];
+    bool irq_level[3];
+    uint8_t routes[3][2];
+    bool cpu_irq_snapshot_available;
+    uint32_t cpu_ps[2];
+    uint32_t cpu_intenable[2];
+    uint32_t cpu_intset[2];
+    uint64_t feed_attempts;
+    uint64_t feeds;
+    int feed_cpu;
+    int64_t last_feed_ns;
+    int64_t last_feed_deadline_ns;
+} ESPS3IwdtTrace;
+
+#endif
