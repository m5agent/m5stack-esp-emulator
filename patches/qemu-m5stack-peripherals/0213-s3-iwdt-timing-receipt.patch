+static void esp_s3_iwdt_trace_dump(ESPS3IwdtTrace *trace, ESPWdtState *wdt)
+{
+    g_autoptr(GString) line = g_string_new("M5_S3_IWDT_STAGE0 ");
+
+    trace->dumped = true;
+    g_string_append_printf(line, "{\"schema_version\":1,\"now_ns\":%" PRId64
+            ",\"feed_attempts\":%" PRIu64 ",\"feeds\":%" PRIu64
+            ",\"feed_cpu\":%d,\"last_feed_ns\":%" PRId64
+            ",\"last_feed_deadline_ns\":%" PRId64
+            ",\"stage0_ticks\":%u,\"stage1_ticks\":%u"
+            ",\"wdt_config0\":%u,\"wdt_prescaler\":%u"
+            ",\"wdt_hz\":%" PRIu64 ",\"wdt_irq_enabled\":%u",
+            qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), trace->feed_attempts,
+            trace->feeds, trace->feeds ? trace->feed_cpu : -1,
+            trace->last_feed_ns, trace->last_feed_deadline_ns,
+            wdt->stage[0], wdt->stage[1], wdt->config0, wdt->prescaler,
+            (uint64_t)wdt->counter.frequency, wdt->int_enabled);
+    g_string_append_printf(line, ",\"alarms\":[%" PRIu64 ",%" PRIu64 "]"
+            ",\"coalesced\":[%" PRIu64 ",%" PRIu64 "]"
+            ",\"last_alarm_ns\":[%" PRId64 ",%" PRId64 "]"
+            ",\"last_expire_ns\":[%" PRId64 ",%" PRId64 "]"
+            ",\"acks\":[[%" PRIu64 ",%" PRIu64 "],[%" PRIu64 ",%" PRIu64 "]]"
+            ",\"last_ack_ns\":[[%" PRId64 ",%" PRId64 "],[%" PRId64 ",%" PRId64 "]]",
+            trace->alarms[0], trace->alarms[1],
+            trace->coalesced[0], trace->coalesced[1],
+            trace->last_alarm_ns[0], trace->last_alarm_ns[1],
+            trace->last_expire_ns[0], trace->last_expire_ns[1],
+            trace->acknowledgements[0][0], trace->acknowledgements[0][1],
+            trace->acknowledgements[1][0], trace->acknowledgements[1][1],
+            trace->last_ack_ns[0][0], trace->last_ack_ns[0][1],
+            trace->last_ack_ns[1][0], trace->last_ack_ns[1][1]);
+    g_string_append_printf(line, ",\"irq_sources\":[55,57,58],\"irq_rises\":[%" PRIu64 ",%" PRIu64 ",%" PRIu64 "]"
+            ",\"irq_falls\":[%" PRIu64 ",%" PRIu64 ",%" PRIu64 "]"
+            ",\"irq_level\":[%u,%u,%u],\"routes\":[[%u,%u],[%u,%u],[%u,%u]]"
+            ",\"cpu_irq_snapshot_available\":%s,\"cpu_ps\":[%u,%u],\"cpu_intenable\":[%u,%u],\"cpu_intset\":[%u,%u]}\n",
+            trace->irq_rises[0], trace->irq_rises[1], trace->irq_rises[2],
+            trace->irq_falls[0], trace->irq_falls[1], trace->irq_falls[2],
+            trace->irq_level[0], trace->irq_level[1], trace->irq_level[2],
+            trace->routes[0][0], trace->routes[0][1], trace->routes[1][0],
+            trace->routes[1][1], trace->routes[2][0], trace->routes[2][1],
+            trace->cpu_irq_snapshot_available ? "true" : "false",
+            trace->cpu_ps[0], trace->cpu_ps[1], trace->cpu_intenable[0],
+            trace->cpu_intenable[1], trace->cpu_intset[0], trace->cpu_intset[1]);
+    fputs(line->str, stderr);
+}
 
