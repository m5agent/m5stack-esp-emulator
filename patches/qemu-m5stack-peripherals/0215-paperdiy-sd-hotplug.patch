+M5SpiSdState *m5_spi_sd_attach_s3_pair(DeviceState *spi_a, DeviceState *spi_b,
+                                      int cs_pin)
+{
+    M5SpiSdState *s = m5_spi_sd_create();
+
+    esp32s3_gpspi_attach_spi_slave(spi_a, &sd_spi_ops, s, cs_pin);
+    esp32s3_gpspi_attach_spi_slave(spi_b, &sd_spi_ops, s, cs_pin);
+    return s;
+}
+
+bool m5_spi_sd_inserted(const M5SpiSdState *s)
+{
+    return s->inserted;
+}
+
+bool m5_spi_sd_set_inserted(M5SpiSdState *s, bool inserted)
+{
+    if (inserted && !s->image) {
+        return false;
+    }
+    if (s->inserted != inserted) {
+        /* Drop partial commands, responses and writes when the card is removed. */
+        *s = (M5SpiSdState) {
+            .image = s->image,
+            .image_size = s->image_size,
+            .trace = s->trace,
+            .inserted = inserted,
+        };
+        sd_set_identity(s, s->image_size);
+    }
+    return true;
+}
