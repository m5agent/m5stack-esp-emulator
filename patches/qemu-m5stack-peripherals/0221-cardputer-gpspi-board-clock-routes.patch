+static bool gpspi_clock_routed(Esp32s3GpspiState *s, int pin, int iomux_func)
+{
+    Esp32GpioPadSnapshot pad;
+
+    if (pin < 0) {
+        return true;
+    }
+    if (!esp32_gpio_pad_snapshot(esp32_gpio_get_controller(true), pin, &pad)) {
+        return false;
+    }
+    return (pad.mux_path == ESP32_GPIO_MUX_GPIO_MATRIX &&
+            pad.out_sel == s->clock_signal) ||
+           (iomux_func >= 0 && pad.iomux_valid && pad.mcu_sel == iomux_func);
+}
