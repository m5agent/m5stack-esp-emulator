diff --git a/hw/m5stopwatch/m5cardputer.c b/hw/m5stopwatch/m5cardputer.c
--- a/hw/m5stopwatch/m5cardputer.c
+++ b/hw/m5stopwatch/m5cardputer.c
@@ -101,6 +101,14 @@
     esp32s3_gpspi_attach(spi, gdma, NULL, panel, dma);
     esp32s3_gpspi_set_dc_pin(spi, 34);
     esp32s3_gpspi_set_panel_cs_pin(spi, 37);
+    /* GPIO36 is the panel clock; GPIO40 is microSD SCK. */
+    if (dma == GDMA_SPI2) {
+        /* FSPICLK matrix signal 101, or GPIO36 IOMUX function 2. */
+        esp32s3_gpspi_set_clock_routes(spi, 101, 36, 2, 40);
+    } else {
+        /* SPI3_CLK matrix signal 66. SPI3 has no direct IOMUX route. */
+        esp32s3_gpspi_set_clock_routes(spi, 66, 36, -1, 40);
+    }
     m5_spi_sd_attach(spi, 12);
 }
 
