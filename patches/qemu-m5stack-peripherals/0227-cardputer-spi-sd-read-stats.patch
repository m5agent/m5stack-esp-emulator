@@ -131,6 +146,21 @@ static const M5SpiSlaveOps sd_spi_ops = {
     .transfer = sd_spi_transfer,
 };
 
+static void sd_spi_observe_cs(void *opaque, int level)
+{
+    M5SpiSdState *s = opaque;
+
+    if (level) {
+        /* The observer discards a response interrupted by deasserting CS. */
+        s->read_response_pending = false;
+    }
+}
+
+static const M5SpiSlaveOps sd_spi_observed_ops = {
+    .set_cs = sd_spi_observe_cs,
+    .transfer = sd_spi_transfer,
+};
+
 static void sd_set_response_lead(M5SpiSdState *s, const uint8_t *data,
