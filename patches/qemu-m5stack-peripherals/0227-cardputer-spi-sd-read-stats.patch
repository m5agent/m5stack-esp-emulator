     s->response_pos = 0;
     s->next_mode = SD_IDLE;
     s->mode = size ? SD_RESPONSE : SD_IDLE;
+    s->read_response_pending = false;
 }
 
 static void sd_set_response(M5SpiSdState *s, const uint8_t *data,
@@ -195,6 +226,19 @@ static void sd_read_block(M5SpiSdState *s, bool first)
     response[prefix + SD_BLOCK_SIZE] = crc >> 8;
     response[prefix + SD_BLOCK_SIZE + 1] = crc & 0xff;
     sd_set_response_lead(s, response, prefix + SD_BLOCK_SIZE + 2, first ? 2 : 1);
+    if (s->read_stats) {
+        if (first) {
+            s->read_generation = s->read_stats->reset_generation;
+            if (s->multi_read) {
+                s->read_stats->accepted_cmd18++;
+            } else {
+                s->read_stats->accepted_cmd17++;
+            }
+        }
+        /* Keep the whole CMD18 stream in the epoch of its accepted command. */
+        s->read_response_pending =
+            s->read_generation == s->read_stats->reset_generation;
+    }
     if (s->multi_read) {
         s->sector++;
         s->next_mode = SD_READ_NEXT;
@@ -392,6 +436,11 @@ static uint8_t sd_spi_transfer(void *opaque, uint8_t tx)
     case SD_RESPONSE:
         out = s->response[s->response_pos++];
         if (s->response_pos >= s->response_len) {
+            if (s->read_response_pending &&
+                s->read_generation == s->read_stats->reset_generation) {
+                s->read_stats->completed_blocks++;
+            }
+            s->read_response_pending = false;
             s->mode = s->next_mode;
             s->next_mode = SD_IDLE;
             s->response_len = 0;
@@ -497,6 +546,60 @@ bool m5_spi_sd_attach(DeviceState *spi, int cs_pin)
     return s->image != NULL;
 }
 
+static void sd_read_stats_reset(void *opaque)
+{
+    M5SpiSdReadStats *stats = opaque;
+
+    stats->reset_generation++;
+    stats->accepted_cmd17 = 0;
+    stats->accepted_cmd18 = 0;
+    stats->completed_blocks = 0;
+}
+
+static void sd_get_read_stats(Object *obj, Visitor *v, const char *name,
+                              void *opaque, Error **errp)
+{
+    const M5SpiSdReadStats *stats = opaque;
+    QDict *result = qdict_new();
+    QObject *value = QOBJECT(result);
+
+    qdict_put_int(result, "schema_version", 1);
+    qdict_put_bool(result, "media_present", stats->media_present);
+    qdict_put(result, "reset_generation", qnum_from_uint(stats->reset_generation));
+    qdict_put(result, "accepted_cmd17", qnum_from_uint(stats->accepted_cmd17));
+    qdict_put(result, "accepted_cmd18", qnum_from_uint(stats->accepted_cmd18));
+    qdict_put(result, "completed_blocks", qnum_from_uint(stats->completed_blocks));
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
+}
+
+static void sd_release_read_stats(Object *obj, const char *name, void *opaque)
+{
+    qemu_unregister_reset(sd_read_stats_reset, opaque);
+    g_free(opaque);
+}
+
+M5SpiSdReadStats *m5_spi_sd_register_read_stats(Object *machine)
+{
+    M5SpiSdReadStats *stats = g_new0(M5SpiSdReadStats, 1);
+
+    /* Supported slots have fixed media for the lifetime of this machine. */
+    qemu_register_reset(sd_read_stats_reset, stats);
+    object_property_add(machine, "spi-sd-read-stats", "any", sd_get_read_stats,
+                        NULL, sd_release_read_stats, stats);
+    return stats;
+}
+
+void m5_spi_sd_attach_observed(DeviceState *spi, int cs_pin,
+                              M5SpiSdReadStats *stats)
+{
+    M5SpiSdState *s = m5_spi_sd_create();
+
+    s->read_stats = stats;
+    stats->media_present |= s->inserted;
+    esp32s3_gpspi_attach_spi_slave(spi, &sd_spi_observed_ops, s, cs_pin);
+}
+
 M5SpiSdState *m5_spi_sd_attach_s3_pair(DeviceState *spi_a, DeviceState *spi_b,
                                       int cs_pin)
 {
