+
+static void esp32s3_rtc_try_gpio_wake(void *opaque)
+{
+    Esp32s3RtcCntlState *s = opaque;
+    bool active;
+
+    if (!s->gpio_sleep_pending || !runstate_check(RUN_STATE_SUSPENDED) ||
+        !esp32s3_gpio_sleep_wakeup(&active) || !active) {
+        return;
+    }
+    s->gpio_sleep_pending = false;
+    esp32s3_rtc_set_gpio_sleep_state(s, (s->sleep_state & ~RTC_SLEEP_EN) |
+                                   RTC_SLEEP_WAKEUP);
+    s->wakeup_cause = RTC_GPIO_TRIGGER;
+    s->sleep_raw |= RTC_SLEEP_WAKEUP_IRQ;
+    esp32s3_rtc_sleep_irq(s);
+    esp32s3_rtc_resume_clock(s);
+    qemu_system_wakeup_request(QEMU_WAKEUP_REASON_OTHER, &error_abort);
+}
+
+static void esp32s3_rtc_suspended(Notifier *notifier, void *data)
+{
+    Esp32s3RtcCntlState *s = container_of(notifier, Esp32s3RtcCntlState,
+                                        suspend_notifier);
+    if (s->gpio_sleep_pending) {
+        /* In the native non-icount lane, disabling timer dispatch does not
+         * stop the virtual clock's underlying tick counter. The digital
+         * watchdog must not gain the wall time spent in GPIO light sleep. */
+        cpu_disable_ticks();
+        s->gpio_sleep_clock_stopped = true;
+        /* The notifier runs before the run-state transition commits. */
+        qemu_bh_schedule(s->wake_bh);
+    }
+}
+
+static bool esp32s3_rtc_start_gpio_sleep(Esp32s3RtcCntlState *s, uint32_t value)
+{
+    bool active;
+
+    /* This path models digital GPIO light sleep only. A sleep using a
+     * different or additional source still requires that source's model. */
+    if (s->gpio_sleep_pending || (s->digital_power & RTC_DIG_WRAP_PD_EN) ||
+        (s->wakeup_state >> RTC_WAKEUP_ENABLE_SHIFT) != RTC_GPIO_TRIGGER ||
+        !esp32s3_gpio_sleep_wakeup(&active)) {
+        return false;
+    }
+    value &= ~(RTC_SLEEP_REJECT | RTC_SLEEP_WAKEUP | RTC_SLEEP_REJECT_CLEAR);
+    s->wakeup_cause = 0;
+    s->reject_cause = 0;
+    if (active && (s->sleep_reject & RTC_LIGHT_SLEEP_REJECT_EN) &&
+        (s->sleep_reject & (RTC_GPIO_TRIGGER << RTC_REJECT_ENABLE_SHIFT))) {
+        esp32s3_rtc_set_gpio_sleep_state(s, (value & ~RTC_SLEEP_EN) |
+                                       RTC_SLEEP_REJECT);
+        s->reject_cause = RTC_GPIO_TRIGGER;
+        s->sleep_raw |= RTC_SLEEP_REJECT_IRQ;
+        esp32s3_rtc_sleep_irq(s);
+        return true;
+    }
+    esp32s3_rtc_set_gpio_sleep_state(s, value);
+    s->gpio_sleep_pending = true;
+    qemu_system_suspend_request();
+    return true;
+}
