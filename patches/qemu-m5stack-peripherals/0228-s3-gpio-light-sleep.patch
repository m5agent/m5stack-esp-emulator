+static void esp32s3_rtc_sleep_irq(Esp32s3RtcCntlState *s)
+{
+    qemu_set_irq(s->irq, !!(s->sleep_raw & s->sleep_enable));
+}
+
+static void esp32s3_rtc_resume_clock(Esp32s3RtcCntlState *s)
+{
+    if (s->gpio_sleep_clock_stopped) {
+        s->gpio_sleep_clock_stopped = false;
+        cpu_enable_ticks();
+    }
+}
