+bool esp32s3_gpio_sleep_wakeup(bool *active)
+{
+    bool armed = false;
+
+    *active = false;
+    if (!g_gpio_s3 || !g_gpio_device) {
+        return false;
+    }
+    for (unsigned pin = 0; pin < 49; pin++) {
+        uint32_t cfg = g_regs[0x74 / 4 + pin];
+        unsigned type = (cfg >> 7) & 7;
+        Esp32GpioPadSnapshot pad;
+
+        if (!(cfg & (1u << 10))) {
+            continue;
+        }
+        if ((type != 4 && type != 5) ||
+            !esp32_gpio_pad_snapshot(g_gpio_device, pin, &pad) ||
+            !pad.fun_ie || !pad.receiver_known) {
+            return false;
+        }
+        armed = true;
+        *active |= pad.receiver_level == (type == 5);
+    }
+    return armed;
+}
