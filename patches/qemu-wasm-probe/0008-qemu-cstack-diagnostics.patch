+
+#include <emscripten/stack.h>
+#include <emscripten/heap.h>
+#include <pthread.h>
+
+static __thread unsigned m5_swap_logs;
+static __thread unsigned m5_swap_id;
+
+static void m5_swap_stack_log(const char *phase, uintptr_t sp,
+                              unsigned swap_id, CoroutineEmscripten *from,
+                              CoroutineEmscripten *to, CoroutineAction action)
+{
+    if (m5_swap_logs >= 256) {
+        return;
+    }
+    m5_swap_logs++;
+    fprintf(stderr,
+            "M5_CSTACK_SWAP tid=%p log=%u swap=%u phase=%s sp=%p "
+            "from=%p to=%p action=%d from_saved_sp=%p to_saved_sp=%p "
+            "from_base=%p from_limit=%p to_base=%p to_limit=%p "
+            "heap=%zu stack_base=%p stack_end=%p\n",
+            (void *)pthread_self(), m5_swap_logs, swap_id, phase, (void *)sp,
+            (void *)from, (void *)to, action,
+            from->fiber.stack_ptr, to->fiber.stack_ptr,
+            from->fiber.stack_base, from->fiber.stack_limit,
+            to->fiber.stack_base, to->fiber.stack_limit, emscripten_get_heap_size(),
+            (void *)emscripten_stack_get_base(), (void *)emscripten_stack_get_end());
+}
+
 CoroutineAction qemu_coroutine_switch(Coroutine *from_, Coroutine *to_,
                       CoroutineAction action)
 {
+    unsigned m5_this_swap = ++m5_swap_id;
     CoroutineEmscripten *from = DO_UPCAST(CoroutineEmscripten, base, from_);
     CoroutineEmscripten *to = DO_UPCAST(CoroutineEmscripten, base, to_);
 
     set_current(to_);
     to->action = action;
+    m5_swap_stack_log("before_swap", emscripten_stack_get_current(),
+                      m5_this_swap, from, to, action);
     emscripten_fiber_swap(&from->fiber, &to->fiber);
+    m5_swap_stack_log("after_swap", emscripten_stack_get_current(),
+                      m5_this_swap, from, to, action);
     return from->action;
 }
 
