+static unsigned icount_high_priority_irq_cpus;
+
+void icount_note_high_priority_irq(int cpu_index, bool active)
+{
+    unsigned mask = 1U << cpu_index;
+
+    if (!icount_enabled()) {
+        return;
+    }
+    if (active) {
+        icount_high_priority_irq_cpus |= mask;
+    } else {
+        icount_high_priority_irq_cpus &= ~mask;
+    }
+}
+
+void icount_yield_for_high_priority_irq(CPUState *cpu)
+{
+    if (icount_enabled() && icount_high_priority_irq_cpus) {
+        cpu_exit(cpu);
+    }
+}
+
+bool icount_high_priority_irq_active(void)
+{
+    return icount_enabled() && icount_high_priority_irq_cpus != 0;
+}
 
