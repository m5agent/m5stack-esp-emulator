From: m5agent <m5agent@local>
Subject: [PATCH] Cardputer ADV: map symbolic QKeyCodes to the physical matrix

QAPI enum ordering is not alphabetical. Preserve the real TCA8418 FIFO and
map each physical key explicitly, including Fn navigation press/release.
COMPOSE is the board-specific carrier for the physical Fn matrix key.

diff --git a/hw/m5stopwatch/m5_spi_panel.c b/hw/m5stopwatch/m5_spi_panel.c
index d97f972f..dd57f4a1 100644
--- a/hw/m5stopwatch/m5_spi_panel.c
+++ b/hw/m5stopwatch/m5_spi_panel.c
@@ -398,260 +398,324 @@ static uint32_t m5_panel_pixel_rgb(M5SpiPanelState *s, uint32_t x, uint32_t y)
         mx = s->off_x + s->vis_w - 1 - x;
         my = s->off_y + s->vis_h - 1 - y;
         break;
     case 3:
         mx = s->off_x + s->vis_h - 1 - y;
         my = s->off_y + x;
         break;
     default:
         break;
     }
 
     uint16_t p = s->mem[my * s->mem_w + mx];
     bool on = s->disp_on && !s->sleep;
     bool invert = s->physical_invert ^ s->controller_invert;
     if (invert) {
         p = ~p;
     }
     uint32_t r = ((p >> 11) & 0x1f) * 255 / 31;
     uint32_t g = ((p >> 5) & 0x3f) * 255 / 63;
     uint32_t b = (p & 0x1f) * 255 / 31;
     if (!on) {
         r = g = b = 0;
     }
     return (r << 16) | (g << 8) | b;
 }
 
 static void m5_panel_dump_ppm(M5SpiPanelState *s)
 {
     if (!s->dump_path) {
         return;
     }
 
     FILE *f = fopen(s->dump_path, "wb");
     if (!f) {
         return;
     }
     fprintf(f, "P6\n%u %u\n255\n", s->vis_w, s->vis_h);
     for (uint32_t y = 0; y < s->vis_h; y++) {
         for (uint32_t x = 0; x < s->vis_w; x++) {
             uint32_t rgb = m5_panel_pixel_rgb(s, x, y);
             uint8_t bytes[3] = { rgb >> 16, rgb >> 8, rgb };
             fwrite(bytes, sizeof(bytes), 1, f);
         }
     }
     fclose(f);
 }
 
 static void m5_panel_refresh_tick(void *opaque)
 {
     M5SpiPanelState *s = opaque;
     int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
     if (getenv("M5SW_PANEL_REFRESH_TRACE") && s->dirty) {
         fprintf(stderr, "[m5panel-refresh] dirty sample=%04x\n",
                 s->mem[20 * s->mem_w + 20]);
     }
     m5_panel_update(s);
     timer_mod(s->refresh_timer, now + 16666667);
 }
 
 static void m5_panel_refresh_bh(void *opaque)
 {
     m5_panel_update(opaque);
 }
 
 static char *m5_panel_get_dump_path(Object *obj, Error **errp)
 {
     return g_strdup(((M5SpiPanelState *)obj)->dump_path);
 }
 
 static void m5_panel_set_dump_path(Object *obj, const char *value, Error **errp)
 {
     M5SpiPanelState *s = (M5SpiPanelState *)obj;
     g_free(s->dump_path);
     s->dump_path = g_strdup(value);
 }
 
 static bool m5_panel_get_refresh_now(Object *obj, Error **errp)
 {
     return false;
 }
 
 static void m5_panel_set_refresh_now(Object *obj, bool value, Error **errp)
 {
     M5SpiPanelState *s = (M5SpiPanelState *)obj;
     if (value) {
         s->dirty = true;
         m5_panel_update(s);
         m5_panel_dump_ppm(s);
     }
 }
 
 static uint8_t tca8418_event(int row, int col, bool down)
 {
     int raw_row = col / 2;
     int raw_col = row + ((col % 2) ? 4 : 0);
     int value = raw_row * 10 + raw_col + 1;
 
     return value | (down ? 0x80 : 0);
 }
 
+/* QKeyCode follows PC scan-code order, not an A..Z numeric range.
+ * Positions follow UIFlow2 2.5.3 KeyboardI2C's 4x14 physical key map.
+ * The board's TCA8418 FIFO and guest I2C decoder remain the data plane.
+ */
 static bool tca8418_key_pos(int qcode, int *row, int *col)
 {
-    if (qcode >= Q_KEY_CODE_A && qcode <= Q_KEY_CODE_Z) {
-        int index = qcode - Q_KEY_CODE_A;
-        *row = index < 10 ? 2 : 3;
-        *col = index < 10 ? 2 + index : 3 + index - 10;
-        return true;
-    }
-    switch (qcode) {
-    case Q_KEY_CODE_RET:
-        *row = 2;
-        *col = 13;
-        return true;
-    case Q_KEY_CODE_SPC:
-        *row = 3;
-        *col = 13;
-        return true;
-    case Q_KEY_CODE_TAB:
-        *row = 1;
-        *col = 0;
-        return true;
-    case Q_KEY_CODE_BACKSPACE:
-        *row = 0;
-        *col = 13;
-        return true;
-    default:
-        return false;
+    static const struct {
+        int qcode;
+        uint8_t row;
+        uint8_t col;
+    } keys[] = {
+        { Q_KEY_CODE_GRAVE_ACCENT, 0, 0 },
+        { Q_KEY_CODE_1, 0, 1 },
+        { Q_KEY_CODE_2, 0, 2 },
+        { Q_KEY_CODE_3, 0, 3 },
+        { Q_KEY_CODE_4, 0, 4 },
+        { Q_KEY_CODE_5, 0, 5 },
+        { Q_KEY_CODE_6, 0, 6 },
+        { Q_KEY_CODE_7, 0, 7 },
+        { Q_KEY_CODE_8, 0, 8 },
+        { Q_KEY_CODE_9, 0, 9 },
+        { Q_KEY_CODE_0, 0, 10 },
+        { Q_KEY_CODE_MINUS, 0, 11 },
+        { Q_KEY_CODE_EQUAL, 0, 12 },
+        { Q_KEY_CODE_BACKSPACE, 0, 13 },
+        { Q_KEY_CODE_TAB, 1, 0 },
+        { Q_KEY_CODE_Q, 1, 1 },
+        { Q_KEY_CODE_W, 1, 2 },
+        { Q_KEY_CODE_E, 1, 3 },
+        { Q_KEY_CODE_R, 1, 4 },
+        { Q_KEY_CODE_T, 1, 5 },
+        { Q_KEY_CODE_Y, 1, 6 },
+        { Q_KEY_CODE_U, 1, 7 },
+        { Q_KEY_CODE_I, 1, 8 },
+        { Q_KEY_CODE_O, 1, 9 },
+        { Q_KEY_CODE_P, 1, 10 },
+        { Q_KEY_CODE_BRACKET_LEFT, 1, 11 },
+        { Q_KEY_CODE_BRACKET_RIGHT, 1, 12 },
+        { Q_KEY_CODE_BACKSLASH, 1, 13 },
+        { Q_KEY_CODE_COMPOSE, 2, 0 },
+        { Q_KEY_CODE_SHIFT, 2, 1 },
+        { Q_KEY_CODE_A, 2, 2 },
+        { Q_KEY_CODE_S, 2, 3 },
+        { Q_KEY_CODE_D, 2, 4 },
+        { Q_KEY_CODE_F, 2, 5 },
+        { Q_KEY_CODE_G, 2, 6 },
+        { Q_KEY_CODE_H, 2, 7 },
+        { Q_KEY_CODE_J, 2, 8 },
+        { Q_KEY_CODE_K, 2, 9 },
+        { Q_KEY_CODE_L, 2, 10 },
+        { Q_KEY_CODE_SEMICOLON, 2, 11 },
+        { Q_KEY_CODE_APOSTROPHE, 2, 12 },
+        { Q_KEY_CODE_RET, 2, 13 },
+        { Q_KEY_CODE_CTRL, 3, 0 },
+        { Q_KEY_CODE_META_L, 3, 1 },
+        { Q_KEY_CODE_ALT, 3, 2 },
+        { Q_KEY_CODE_Z, 3, 3 },
+        { Q_KEY_CODE_X, 3, 4 },
+        { Q_KEY_CODE_C, 3, 5 },
+        { Q_KEY_CODE_V, 3, 6 },
+        { Q_KEY_CODE_B, 3, 7 },
+        { Q_KEY_CODE_N, 3, 8 },
+        { Q_KEY_CODE_M, 3, 9 },
+        { Q_KEY_CODE_COMMA, 3, 10 },
+        { Q_KEY_CODE_DOT, 3, 11 },
+        { Q_KEY_CODE_SLASH, 3, 12 },
+        { Q_KEY_CODE_SPC, 3, 13 },
+        { Q_KEY_CODE_SHIFT_R, 2, 1 },
+        { Q_KEY_CODE_CTRL_R, 3, 0 },
+        { Q_KEY_CODE_META_R, 3, 1 },
+        { Q_KEY_CODE_ALT_R, 3, 2 },
+    };
+
+    for (size_t i = 0; i < ARRAY_SIZE(keys); i++) {
+        if (keys[i].qcode == qcode) {
+            *row = keys[i].row;
+            *col = keys[i].col;
+            return true;
+        }
     }
+    return false;
 }
 
 static void m5_panel_keyboard_event(int qcode, bool down)
 {
     int row, col;
 
-    if (qcode == Q_KEY_CODE_LEFT || qcode == Q_KEY_CODE_RIGHT ||
-        qcode == Q_KEY_CODE_UP || qcode == Q_KEY_CODE_DOWN) {
-        int fn_raw = tca8418_event(2, 0, down);
-        int direction_raw;
-
-        if (qcode == Q_KEY_CODE_LEFT) {
-            direction_raw = tca8418_event(3, 10, down);
-        } else if (qcode == Q_KEY_CODE_DOWN) {
-            direction_raw = tca8418_event(3, 11, down);
-        } else if (qcode == Q_KEY_CODE_RIGHT) {
-            direction_raw = tca8418_event(3, 12, down);
-        } else {
-            direction_raw = tca8418_event(2, 11, down);
-        }
-        if (down) {
-            m5sw_keyboard_event(fn_raw);
-            m5sw_keyboard_event(direction_raw);
-        } else {
-            m5sw_keyboard_event(direction_raw);
-            m5sw_keyboard_event(fn_raw);
+    switch (qcode) {
+    case Q_KEY_CODE_ESC:
+        row = 0; col = 0;
+        break;
+    case Q_KEY_CODE_DELETE:
+        row = 0; col = 13;
+        break;
+    case Q_KEY_CODE_LEFT:
+        row = 3; col = 10;
+        break;
+    case Q_KEY_CODE_DOWN:
+        row = 3; col = 11;
+        break;
+    case Q_KEY_CODE_RIGHT:
+        row = 3; col = 12;
+        break;
+    case Q_KEY_CODE_UP:
+        row = 2; col = 11;
+        break;
+    default:
+        if (tca8418_key_pos(qcode, &row, &col)) {
+            m5sw_keyboard_event(tca8418_event(row, col, down));
         }
         return;
     }
 
-    if (tca8418_key_pos(qcode, &row, &col)) {
-        m5sw_keyboard_event(tca8418_event(row, col, down));
+    /* Logical navigation keys are physical Fn chords. Release the key
+     * before Fn so the original decoder can observe both matching edges.
+     */
+    uint8_t fn_raw = tca8418_event(2, 0, down);
+    uint8_t key_raw = tca8418_event(row, col, down);
+    if (down) {
+        m5sw_keyboard_event(fn_raw);
+        m5sw_keyboard_event(key_raw);
+    } else {
+        m5sw_keyboard_event(key_raw);
+        m5sw_keyboard_event(fn_raw);
     }
 }
 
 static void m5_panel_input(DeviceState *dev, QemuConsole *src, InputEvent *evt)
 {
     M5SpiPanelState *s = M5_SPI_PANEL(dev);
     if (getenv("M5SW_INPUT_TRACE")) {
         fprintf(stderr, "[m5panel-input] type=%d\n", evt->type);
     }
     switch (evt->type) {
     case INPUT_EVENT_KIND_KEY: {
         InputKeyEvent *key = evt->u.key.data;
         int q = qemu_input_key_value_to_qcode(key->key);
         int down = key->down;
         if (getenv("M5SW_INPUT_TRACE")) {
             fprintf(stderr, "[m5panel-input] qcode=%d down=%d\n", q, down);
         }
         if (s->keyboard) {
             m5_panel_keyboard_event(q, down);
             break;
         }
         if (s->plc_keys) {
             if (q == Q_KEY_CODE_A) {
                 m5sw_plc_key_set(0, down);
             } else if (q == Q_KEY_CODE_B) {
                 m5sw_plc_key_set(1, down);
             } else if (q == Q_KEY_CODE_C) {
                 m5sw_plc_key_set(2, down);
             }
             break;
         }
         if (s->touch_buttons
             && (q == Q_KEY_CODE_A || q == Q_KEY_CODE_B || q == Q_KEY_CODE_C)) {
             int x;
 
             if (q == Q_KEY_CODE_A) {
                 x = s->vis_w / 6;
             } else if (q == Q_KEY_CODE_B) {
                 x = s->vis_w / 2;
             } else {
                 x = s->vis_w * 5 / 6;
             }
             /*
              * Keep the press in the panel's synchronized pointer state:
              * QEMU invokes input_sync immediately after each key event.
              * Core2's raw touch band extends past the 240-pixel glass.
              */
             s->mouse_btn = down;
             s->mouse_x = x;
             s->mouse_y = s->vis_h + 20;
             break;
         }
         switch (q) {
         case Q_KEY_CODE_A: case Q_KEY_CODE_LEFT: case Q_KEY_CODE_1:
             esp32_gpio_set_input(s->key_a_pin, !down);
             break;
         case Q_KEY_CODE_B: case Q_KEY_CODE_RIGHT: case Q_KEY_CODE_2:
             esp32_gpio_set_input(s->key_b_pin, !down);
             break;
         case Q_KEY_CODE_P: case Q_KEY_CODE_3:
             m5sw_pwr_button(down);
             break;
         default:
             break;
         }
         break;
     }
     case INPUT_EVENT_KIND_ABS: {
         InputMoveEvent *m = evt->u.abs.data;
         int v = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
                                       INPUT_EVENT_ABS_MAX, 0, s->vis_w - 1);
         if (m->axis == INPUT_AXIS_X) {
             s->mouse_x = v;
         } else if (m->axis == INPUT_AXIS_Y) {
             s->mouse_y = qemu_input_scale_axis(m->value, INPUT_EVENT_ABS_MIN,
                                                INPUT_EVENT_ABS_MAX, 0, s->vis_h - 1);
         }
         break;
     }
     case INPUT_EVENT_KIND_BTN: {
         InputBtnEvent *b = evt->u.btn.data;
         if (b->button == INPUT_BUTTON_LEFT) {
             s->mouse_btn = b->down;
         }
         break;
     }
     default:
         break;
     }
 }
 
 static void m5_panel_input_sync(DeviceState *dev)
 {
     M5SpiPanelState *s = M5_SPI_PANEL(dev);
     if (s->touch) {
         m5sw_ft_touch_set_pin(s->mouse_btn, s->mouse_x, s->mouse_y,
                               s->touch_int_pin);
     }
 }
 
