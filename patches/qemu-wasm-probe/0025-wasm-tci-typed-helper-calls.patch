Subject: [WASM] call common TCI helpers without the JavaScript FFI bridge

Use the exact WASM32 lowered signature for zero to seven i32/pointer arguments
and void/i32 results. Preserve tci_tb_ptr, result extraction and the original
helper functions; unsupported types, wide arguments/results and varargs retain
libffi. Keep Asyncify, fiber handling and the cpu_exec longjmp stack restore.
This target-specific ABI optimization is not enabled for native host builds.

diff --git a/tcg/tci.c b/tcg/tci.c
--- a/tcg/tci.c
+++ b/tcg/tci.c
@@ -23,6 +23,10 @@
 #include "tcg/tcg-ldst.h"
 #include <ffi.h>
 
+#ifdef __EMSCRIPTEN__
+#include "tci-wasm-call.h"
+#endif
+
 
 /*
  * Enable TCI assertions only when debugging TCG (and without NDEBUG defined).
@@ -407,7 +411,13 @@
 
                 /* Helper functions may need to access the "return address" */
                 tci_tb_ptr = (uintptr_t)tb_ptr;
+#ifdef __EMSCRIPTEN__
+                if (!m5_wasm_tci_call(cif, func, stack, call_slots)) {
+                    ffi_call(cif, func, stack, call_slots);
