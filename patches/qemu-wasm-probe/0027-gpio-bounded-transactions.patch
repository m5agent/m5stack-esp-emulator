+static uint64_t gpio_line64_captured(Esp32GpioState *s,
+                         const Esp32GpioPadSnapshot captured[54])
+{
+    uint64_t line = gpio_legacy_line64();
+    if (!g_gpio_device || !g_gpio_s3) { return line; }
+    if (s != g_gpio_device) { return gpio_line64(); }
+    /* The caller has just captured these pads, with no intervening writes or
+     * callbacks. Unknown/invalid pads retain the same current legacy bits as
+     * gpio_line64; receiver/FUN_IE filtering does not belong to this raw line. */
+    for (unsigned pin = 0; pin < 49; pin++) {
+        if (!gpio_pad_valid(s, pin) || !captured[pin].known) { continue; }
+        uint64_t bit = 1ULL << pin;
+        line = captured[pin].level ? line | bit : line & ~bit;
+    }
+    return line;
+}
