     if (a->enable_reg != b->enable_reg) { changed |= ESP32_GPIO_PAD_CHANGE_ENABLE; }
     if (a->epoch != b->epoch || a->controller_generation != b->controller_generation) {
         changed |= ESP32_GPIO_PAD_CHANGE_RESET;
     }
     return changed;
 }
 
