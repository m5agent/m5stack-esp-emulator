-static void translate_memw(DisasContext *dc, const OpcodeArg arg[],
-                           const uint32_t par[])
+/* Under icount, IRQ enter/return/reset update this mask on the shared vCPU
+ * thread. A zero mask makes the original helper a no-op. Check it in TCG IR
+ * so ordinary memw/retw avoid a helper ABI transition and global-register sync.
+ * A nonzero mask retains the original helper, including sender-side retw.
+ * Global icount mode is intentional: replay TBs may clear CF_USE_ICOUNT. */
+static void gen_high_priority_irq_yield(uint32_t handler_only)
 {
     if (icount_enabled()) {
-        gen_helper_high_priority_irq_yield(tcg_env, tcg_constant_i32(1));
+        TCGv_i32 active = tcg_temp_new_i32();
+        TCGLabel *skip = gen_new_label();
+
+        tcg_gen_ld_i32(active,
+                       tcg_constant_ptr(icount_high_priority_irq_state()), 0);
+        tcg_gen_brcondi_i32(TCG_COND_EQ, active, 0, skip);
+        gen_helper_high_priority_irq_yield(tcg_env,
+                                           tcg_constant_i32(handler_only));
+        gen_set_label(skip);
     }
+}
+
+static void translate_memw(DisasContext *dc, const OpcodeArg arg[],
+                           const uint32_t par[])
+{
+    gen_high_priority_irq_yield(1);
     tcg_gen_mb(TCG_BAR_SC | TCG_MO_ALL);
 }
 
