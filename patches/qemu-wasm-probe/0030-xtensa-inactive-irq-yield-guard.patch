     tcg_gen_deposit_i32(tmp, tmp, cpu_R[0], 0, 30);
-    if (icount_enabled()) {
-        gen_helper_high_priority_irq_yield(tcg_env, tcg_constant_i32(0));
-    }
+    gen_high_priority_irq_yield(0);
     gen_helper_retw(tcg_env, cpu_R[0]);
     gen_jump(dc, tmp);
 }
