@@ -18,6 +19,18 @@
 #define R_CAM_CTRL   0x04
 #define R_CAM_CTRL1  0x08
 #define R_CAM_RGB    0x0c
+#define R_LCD_USER   0x14
+#define LCD_DOUT_CYCLES_MASK 0x1fff
+#define LCD_ALWAYS_OUT BIT(13)
+#define LCD_BYTE_ORDER_8 BIT(19)
+#define LCD_BIT_ORDER BIT(21)
+#define LCD_WIDE BIT(23)
+#define LCD_DOUT BIT(24)
+#define LCD_UPDATE BIT(20)
+#define LCD_START BIT(27)
+#define LCD_RESET BIT(28)
+#define LCD_TRANS_DONE BIT(1)
+#define LCD_I80_MAX_BYTES 1024
 #define R_INT_ENA    0x64
 #define R_INT_RAW    0x68
 #define R_INT_ST     0x6c
@@ -36,6 +49,8 @@ struct M5LcdCamState {
     MemoryRegion iomem;
     qemu_irq irq;
     ESPGdmaState *gdma;
+    M5LcdI80Output i80_output;
