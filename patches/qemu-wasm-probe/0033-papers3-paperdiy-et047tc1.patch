+static void lcd_i80_transfer(M5LcdCamState *s, uint32_t user)
+{
+    if (user & LCD_DOUT) {
+        uint8_t bytes[LCD_I80_MAX_BYTES];
+        uint32_t channel;
+        uint32_t count;
+
+        if ((user & LCD_WIDE) ||
+            !esp_gdma_get_channel_periph(s->gdma, GDMA_LCDCAM,
+                                         ESP_GDMA_OUT_IDX, &channel)) {
+            return;
+        }
+        count = esp_gdma_get_out_transfer_size(s->gdma, channel,
+                                               sizeof(bytes) + 1);
+        if (!count || count > sizeof(bytes) ||
+            (!(user & LCD_ALWAYS_OUT) &&
+             count != (user & LCD_DOUT_CYCLES_MASK) + 1) ||
+            !esp_gdma_read_channel(s->gdma, channel, bytes, count)) {
+            return;
+        }
+        if (user & LCD_BYTE_ORDER_8) {
+            for (unsigned i = 0; i + 1 < count; i += 2) {
+                uint8_t swap = bytes[i];
+                bytes[i] = bytes[i + 1];
+                bytes[i + 1] = swap;
+            }
+        }
+        if (user & LCD_BIT_ORDER) {
+            for (unsigned i = 0; i < count; i++) {
+                uint8_t b = bytes[i];
+                b = ((b >> 1) & 0x55) | ((b & 0x55) << 1);
+                b = ((b >> 2) & 0x33) | ((b & 0x33) << 2);
+                bytes[i] = (b >> 4) | (b << 4);
+            }
+        }
+        s->i80_output(s->i80_opaque, bytes, count);
+    }
+
+    s->regs[R_LCD_USER / 4] &= ~LCD_START;
+    s->int_raw |= LCD_TRANS_DONE;
+    lcd_cam_update_irq(s);
+}
+
 static void lcd_cam_write(void *opaque, hwaddr addr, uint64_t value,
                           unsigned size)
 {
@@ -275,6 +333,16 @@ static void lcd_cam_write(void *opaque, hwaddr addr, uint64_t value,
         }
         break;
     }
+    case R_LCD_USER:
+        if (s->i80_output) {
+            s->regs[addr / 4] = v & ~(LCD_UPDATE | LCD_RESET);
+            if ((v & (LCD_START | LCD_RESET)) == LCD_START) {
+                lcd_i80_transfer(s, v);
+            }
+        } else {
+            s->regs[addr / 4] = v;
+        }
+        break;
     case R_INT_ENA:
         s->int_ena = v;
         lcd_cam_update_irq(s);
@@ -383,3 +451,12 @@ void m5_lcd_cam_attach(DeviceState *dev, ESPGdmaState *gdma,
         s->frame_data_size = MIN(size, UINT32_MAX);
     }
 }
