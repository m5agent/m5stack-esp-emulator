+/* M5Stack Cardputer K132 (ESP32-S3FN8 + ST7789 240x135 + GPIO keyboard) */
+static void m5cardputer_machine_init(MachineState *machine)
+{
+    m5_board = M5_BOARD_CARDPUTER;
+    esp32s3_machine_init(machine);
+}
+
+static void m5cardputer_machine_class_init(ObjectClass *oc, void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(oc);
+    mc->desc = "M5Stack Cardputer K132 (ESP32-S3FN8, ST7789 240x135)";
+    mc->init = m5cardputer_machine_init;
+    mc->max_cpus = 2;
+    mc->default_cpus = 2;
+    mc->default_ram_size = 0;
+    mc->fixup_ram_size = esp32s3_fixup_ram_size;
+}
+
+static const TypeInfo m5cardputer_info = {
+    .name = MACHINE_TYPE_NAME("m5cardputer"),
+    .parent = TYPE_ESP32S3_MACHINE,
+    .instance_size = sizeof(Esp32s3MachineState),
+    .class_init = m5cardputer_machine_class_init,
+};
+
+static void m5cardputer_machine_type_init(void)
+{
+    type_register_static(&m5cardputer_info);
+}
+
+type_init(m5cardputer_machine_type_init);
