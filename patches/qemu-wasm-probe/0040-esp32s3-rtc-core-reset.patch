-static void esp32s3_cpu_stall(void* opaque, int n, int level)
+static void esp32s3_cpu_stall(void *opaque, int n, int level)
 {
+    Esp32s3SocState *s = ESP32S3_SOC(opaque);
+    XtensaCPU *cpu = &s->cpu[n];
+
+    if (!!level == cpu->env.runstall) {
+        return;
+    }
+    if (!level) {
+        /* A release can arrive before the target consumes a pending halt. */
+        cpu_reset_interrupt(CPU(cpu), CPU_INTERRUPT_HALT);
+    }
+    xtensa_runstall(&cpu->env, level);
 }
 
