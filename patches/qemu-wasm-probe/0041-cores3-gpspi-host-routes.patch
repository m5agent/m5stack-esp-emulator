+static bool gpspi_panel_selected(Esp32s3GpspiState *s, bool transferring)
+{
+    Esp32s3GpspiState *bus = s->board_bus;
+    const M5GpspiPanelRoute *route = s->panel_route;
+    Esp32GpioPadSnapshot cs;
+
+    if (bus->panel_cs_pin < 0) {
+        return true;
+    }
+    if (!route) {
+        return !bus->panel_cs_level;
+    }
+    if (!esp32_gpio_pad_snapshot(esp32_gpio_get_controller(true),
+                                 bus->panel_cs_pin, &cs)) {
+        return false;
+    }
+    if (cs.out_sel == 256) {
+        return !bus->panel_cs_level;
+    }
+    if (!transferring || cs.out_sel != route->cs0_signal ||
+        cs.mux_path != ESP32_GPIO_MUX_GPIO_MATRIX || cs.override_mask ||
+        esp32_gpio_matrix_out_signal(route->clk_pin, true) != route->clk_signal ||
+        esp32_gpio_matrix_out_signal(route->mosi_pin, true) != route->mosi_signal) {
+        return false;
+    }
+
+    uint32_t misc = s->regs[R_MISC / 4];
+    bool output_enabled = (!cs.oen_sel || cs.enable_reg) ^ cs.oen_inv;
+    bool active_high = !!(misc & MISC_CS0_POL) ^ cs.out_inv;
+    return output_enabled && !active_high &&
+           !(misc & (MISC_CS0_DIS | MISC_CK_DIS));
+}
