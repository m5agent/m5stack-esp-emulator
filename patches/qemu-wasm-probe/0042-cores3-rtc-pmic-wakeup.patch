+
+static bool pcf8563_level_irq_enabled(M5swI2CDev *s)
+{
+    return (s->regs[RTC_CONTROL2] & (RTC_TIMER_PULSE | RTC_TIMER_IRQ_EN)) ==
+           RTC_TIMER_IRQ_EN;
