+static void pmic_rtc_wake_request(void *opaque)
+{
+    M5swI2CDev *s = opaque;
+
+    if (s->rtc_power_off && s->rtc_irq_low &&
+        runstate_check(RUN_STATE_SUSPENDED)) {
+        qemu_system_wakeup_request(QEMU_WAKEUP_REASON_RTC, NULL);
+    }
+}
+
+static void pmic_rtc_irq(void *opaque, int n, int level)
+{
+    M5swI2CDev *s = opaque;
+
+    if (s->rtc_irq_low == !level) {
+        return;
+    }
+    s->rtc_irq_low = !level;
+    if (s->rtc_power_off && s->rtc_irq_low) {
+        timer_mod_ns(s->power_rtc_debounce,
+                     qemu_clock_get_ns(QEMU_CLOCK_HOST) + 16 * SCALE_MS);
+    } else {
+        timer_del(s->power_rtc_debounce);
+    }
+}
+
+static void pmic_rtc_power_on(M5swI2CDev *s)
+{
+    s->rtc_power_off = false;
+    s->power_enabled = true;
+    timer_del(s->power_rtc_debounce);
+}
+
+static void pmic_rtc_resumed(Notifier *notifier, void *opaque)
+{
+    M5swI2CDev *s = container_of(notifier, M5swI2CDev, power_rtc_resume);
+    WakeupReason reason = *(WakeupReason *)opaque;
+
+    if (!s->rtc_power_off) {
+        return;
+    }
+    pmic_rtc_power_on(s);
+    if (reason == QEMU_WAKEUP_REASON_RTC) {
+        s->regs[0x20] = BIT(1); /* AXP2101 power-on cause: IRQ held low. */
+        fprintf(stderr, "[m5-power] model=axp2101 action=on source=rtc-irq\n");
+    }
+    /* The AXP power-good signal restarts the SoC after its rails return. */
+    qemu_system_reset(SHUTDOWN_CAUSE_GUEST_RESET);
+}
