+static int64_t pcf8563_tick_ns(M5swI2CDev *s)
+{
+    static const int64_t ticks[] = {
+        NANOSECONDS_PER_SECOND / 4096, NANOSECONDS_PER_SECOND / 64,
+        NANOSECONDS_PER_SECOND, INT64_C(60) * NANOSECONDS_PER_SECOND,
+    };
+    return ticks[s->regs[RTC_TIMER_CONTROL] & 3];
+}
+
+static int64_t pcf8563_next_expiry(M5swI2CDev *s, int64_t now)
+{
+    int64_t period = pcf8563_tick_ns(s) * s->regs[RTC_TIMER_COUNT];
+    int64_t elapsed = MAX(0, now - s->rtc_countdown_start);
+    return MAX(now, s->rtc_countdown_start) + period - elapsed % period;
+}
+
+static uint8_t pcf8563_countdown_read(M5swI2CDev *s)
+{
+    if (!pcf8563_countdown_enabled(s)) {
+        return s->regs[RTC_TIMER_COUNT];
+    }
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+    int64_t remaining = pcf8563_next_expiry(s, now) - now;
+    return MIN(s->regs[RTC_TIMER_COUNT],
+               DIV_ROUND_UP(remaining, pcf8563_tick_ns(s)));
+}
+
+static void pcf8563_update_irq(M5swI2CDev *s)
+{
+    uint8_t ctrl = s->regs[RTC_CONTROL2];
+    bool timer_irq = pcf8563_level_irq_enabled(s) && (ctrl & RTC_TIMER_FLAG);
+    bool alarm_irq = (ctrl & RTC_ALARM_IRQ_EN) && (ctrl & RTC_ALARM_FLAG);
+
+    /* INT is open-drain with a board pull-up. */
+    qemu_set_irq(s->rtc_irq, !(timer_irq || alarm_irq));
+}
+
+static void pcf8563_schedule_countdown(M5swI2CDev *s)
+{
+    if (pcf8563_countdown_enabled(s) &&
+        !(s->regs[RTC_CONTROL2] & RTC_TIMER_FLAG)) {
+        int64_t now = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+        timer_mod_ns(s->rtc_countdown, pcf8563_next_expiry(s, now));
+    } else {
+        timer_del(s->rtc_countdown);
+    }
+}
+
+static void pcf8563_countdown_expired(void *opaque)
+{
+    M5swI2CDev *s = opaque;
+
+    s->regs[RTC_CONTROL2] |= RTC_TIMER_FLAG;
+    fprintf(stderr, "[m5-rtc] model=pcf8563 action=timer-expired ctrl2=0x%02x\n",
+            s->regs[RTC_CONTROL2]);
+    pcf8563_update_irq(s);
+}
+
+static void pcf8563_write_timer(M5swI2CDev *s, uint8_t reg, uint8_t value)
+{
+    if (reg == RTC_CONTROL2) {
+        const uint8_t flags = RTC_ALARM_FLAG | RTC_TIMER_FLAG;
+        const uint8_t controls = RTC_TIMER_PULSE | RTC_ALARM_IRQ_EN | RTC_TIMER_IRQ_EN;
+        /* An asserted flag remains set only if written as one. */
+        s->regs[reg] = (value & controls) | (s->regs[reg] & value & flags);
+        pcf8563_update_irq(s);
+    } else {
+        if (reg == RTC_TIMER_CONTROL) {
+            value &= RTC_TIMER_ENABLE | 3;
+        }
+        if (s->regs[reg] != value || reg == RTC_TIMER_COUNT) {
+            s->rtc_countdown_start = qemu_clock_get_ns(QEMU_CLOCK_HOST);
+            s->regs[reg] = value;
+        }
+    }
+    pcf8563_schedule_countdown(s);
+}
+
+void m5sw_connect_rtc_pmic_wakeup(DeviceState *rtc_dev, DeviceState *pmic_dev)
+{
+    M5swI2CDev *rtc = M5SW_I2C_DEV(rtc_dev);
+    M5swI2CDev *pmic = M5SW_I2C_DEV(pmic_dev);
+
+    assert(rtc->model == M_PCF8563 && pmic->model == M_AXP2101);
+    rtc->rtc_countdown = timer_new_ns(QEMU_CLOCK_HOST,
+                                      pcf8563_countdown_expired, rtc);
+    pmic->power_rtc_debounce = timer_new_ns(QEMU_CLOCK_HOST,
+                                           pmic_rtc_wake_request, pmic);
+    pmic->power_rtc = rtc;
+    pmic->power_rtc_resume.notify = pmic_rtc_resumed;
+    qemu_register_wakeup_notifier(&pmic->power_rtc_resume);
+    qemu_register_wakeup_support();
+    qdev_init_gpio_out_named(rtc_dev, &rtc->rtc_irq, "rtc-int", 1);
+    qdev_init_gpio_in_named(pmic_dev, pmic_rtc_irq, "rtc-wake", 1);
+    qdev_connect_gpio_out_named(rtc_dev, "rtc-int", 0,
+                                qdev_get_gpio_in_named(pmic_dev, "rtc-wake", 0));
+    pcf8563_update_irq(rtc);
+}
