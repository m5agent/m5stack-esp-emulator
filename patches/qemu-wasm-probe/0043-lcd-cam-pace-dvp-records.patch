@@ -129,6 +129,22 @@ static void lcd_cam_fill_frame(M5LcdCamState *s, uint8_t *data, uint32_t len)
     s->frame_offset = (s->frame_offset + len) % frame_bytes;
 }
 
+static void lcd_cam_schedule_capture(M5LcdCamState *s, int64_t interval_ns)
+{
+    timer_mod_ns(s->capture_timer,
+                 qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + interval_ns);
+}
+
+static void lcd_cam_schedule_record(M5LcdCamState *s)
+{
+    uint64_t bytes = MIN(s->chunk_len, s->frame_bytes - s->frame_offset);
+    uint64_t interval = DIV_ROUND_UP((NANOSECONDS_PER_SECOND / 30) * bytes,
+                                     s->frame_bytes);
+
+    /* Pace the synthesized DVP stream at a nominal 30 source frames/s. */
+    lcd_cam_schedule_capture(s, interval);
+}
+
 static void lcd_cam_capture(M5LcdCamState *s)
