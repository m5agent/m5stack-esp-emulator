+#include "hw/qdev-properties-system.h"
 #include "hw/sysbus.h"
 #include "hw/misc/esp32c3_jtag.h"
 
 
+/*
+ * Fixed USB Serial/JTAG CDC IN endpoint, distinct from USB OTG.
+ * Off without an explicit virtual host chardev.
+ */
+enum {
+    EP1 = 0x00,
+    EP1_CONF = 0x04,
+    INT_RAW = 0x08,
+    INT_STATUS = 0x0c,
+    INT_ENABLE = 0x10,
+    INT_CLEAR = 0x14,
+    CONF0 = 0x18,
+    FRAME_NUM = 0x24,
+
+    WR_DONE = BIT(0),
+    IN_DATA_FREE = BIT(1),
+    IRQ_SOF = BIT(1),
+    IRQ_IN_EMPTY = BIT(3),
+    PHY_EXTERNAL = BIT(0),
+    PAD_PULL_OVERRIDE = BIT(8),
+    DP_PULLUP = BIT(9),
+    PAD_ENABLE = BIT(14),
+
+    USB_FRAME_NS = 1000000,
+    USB_EMPTY_IN_NS = 8000,
+    USB_DATA_IN_NS = 64000,
+};
+
+static void esp32c3_jtag_update_irq(ESP32C3UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_enable) != 0);
+}
+
+static bool esp32c3_jtag_host_attached(ESP32C3UsbJtagState *s)
+{
+    return (s->conf & PAD_ENABLE) && !(s->conf & PHY_EXTERNAL) &&
+           (!(s->conf & PAD_PULL_OVERRIDE) || (s->conf & DP_PULLUP));
+}
+
+static void esp32c3_jtag_schedule(ESP32C3UsbJtagState *s)
+{
+    timer_mod_ns(s->host_timer, MIN(s->next_frame_ns, s->next_in_ns));
+}
+
+static void esp32c3_jtag_sync_host(ESP32C3UsbJtagState *s, int64_t now)
+{
+    bool changed = false;
+
+    if (now >= s->next_frame_ns) {
+        int64_t frames = 1 + (now - s->next_frame_ns) / USB_FRAME_NS;
+        s->next_frame_ns += frames * USB_FRAME_NS;
+        if (esp32c3_jtag_host_attached(s)) {
+            s->frame = (s->frame + frames) & 0x7ff;
+            s->int_raw |= IRQ_SOF;
+        }
+        changed = true;
+    }
+    if (now >= s->next_in_ns) {
+        int done = s->tx_len ? qemu_chr_fe_write(&s->chr, s->tx, s->tx_len) : 0;
+        if (done > 0) {
+            s->tx_bytes += done;
+            s->tx_len -= done;
+            memmove(s->tx, s->tx + done, s->tx_len);
+        }
+        if (s->tx_len) {
+            s->next_in_ns = now + USB_DATA_IN_NS;
+        } else {
+            s->next_in_ns = INT64_MAX;
+            s->tx_packets++;
+            s->committed = false;
+            s->int_raw |= IRQ_IN_EMPTY;
+        }
+        changed = true;
+    }
+    if (changed) {
+        esp32c3_jtag_update_irq(s);
+        esp32c3_jtag_schedule(s);
+    }
+}
+
+static void esp32c3_jtag_host_timer(void *opaque)
+{
+    esp32c3_jtag_sync_host(opaque, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+}
+
+static void esp32c3_jtag_start_in(ESP32C3UsbJtagState *s, int64_t now)
+{
+    /*
+     * An attached host polls the bulk IN endpoint independently of SOF.
+     * Model one full-speed IN transaction with a short turnaround for a
+     * zero-length packet and enough bus time for a full 64-byte packet.
+     */
+    s->next_in_ns = now + (s->tx_len ? USB_DATA_IN_NS : USB_EMPTY_IN_NS);
+    esp32c3_jtag_schedule(s);
+}
+
+static void esp32c3_jtag_commit(ESP32C3UsbJtagState *s, int64_t now)
+{
+    if (!s->committed) {
+        s->committed = true;
+        s->int_raw &= ~IRQ_IN_EMPTY;
+        if (esp32c3_jtag_host_attached(s)) {
+            esp32c3_jtag_start_in(s, now);
+        }
+    }
+}
+
 static uint64_t esp32c3_jtag_read(void *opaque, hwaddr addr, unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
-    return 0;
+
+    if (!s->host_timer) {
+        return 0;
+    }
+    esp32c3_jtag_sync_host(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    switch (addr) {
+    case EP1_CONF:
+        return !s->committed && s->tx_len < sizeof(s->tx) ? IN_DATA_FREE : 0;
+    case INT_RAW:
+        return s->int_raw;
+    case INT_STATUS:
+        return s->int_raw & s->int_enable;
+    case INT_ENABLE:
+        return s->int_enable;
+    case CONF0:
+        return s->conf;
+    case FRAME_NUM:
+        return s->frame;
+    default:
+        return 0;
+    }
 }
 
-static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value,
+                              unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
+
+    if (!s->host_timer) {
+        return;
+    }
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    esp32c3_jtag_sync_host(s, now);
+    switch (addr) {
+    case EP1:
+        if (!s->committed && s->tx_len < sizeof(s->tx)) {
+            s->tx[s->tx_len++] = value;
+            if (s->tx_len == sizeof(s->tx)) {
+                esp32c3_jtag_commit(s, now);
+            }
+        }
+        break;
+    case EP1_CONF:
+        if (value & WR_DONE) {
+            esp32c3_jtag_commit(s, now);
+        }
+        break;
+    case INT_ENABLE:
+        s->int_enable = value & (IRQ_SOF | IRQ_IN_EMPTY);
+        break;
+    case INT_CLEAR:
+        s->int_raw &= ~value;
+        break;
+    case CONF0:
+        s->conf = value & 0x1ffff;
+        if (!esp32c3_jtag_host_attached(s)) {
+            s->next_in_ns = INT64_MAX;
+            esp32c3_jtag_schedule(s);
+        } else if (s->committed && s->next_in_ns == INT64_MAX) {
+            esp32c3_jtag_start_in(s, now);
+        }
+        break;
+    }
+    esp32c3_jtag_update_irq(s);
 }
 
