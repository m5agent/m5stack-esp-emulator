+static void cc1101_peer_get_state(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    const M5Cc1101SpiState *s = opaque;
+    const char digits[] = "0123456789abcdef";
+    char hex[2 * CC1101_FIFO_SIZE + 1];
+    QDict *state = qdict_new();
+
+    for (uint32_t i = 0; i < s->peer_tx_len; i++) {
+        hex[2 * i] = digits[s->peer_tx_frame[i] >> 4];
+        hex[2 * i + 1] = digits[s->peer_tx_frame[i] & 0xf];
+    }
+    hex[2 * s->peer_tx_len] = '\0';
+    qdict_put_int(state, "reset_epoch", s->peer_reset_epoch);
+    qdict_put_int(state, "marcstate", s->marc_state);
+    qdict_put_bool(state, "rx_armed", cc1101_peer_rx_armed(s));
+    qdict_put_bool(state, "gdo0", s->peer_gdo0);
+    qdict_put_int(state, "tx_sequence", s->peer_tx_sequence);
+    qdict_put_str(state, "tx_fifo_hex", hex);
+    qdict_put_int(state, "rx_accepted", s->peer_rx_accepted);
+    qdict_put_int(state, "rx_interrupts", s->peer_rx_interrupts);
+    qdict_put_int(state, "rx_fifo_bytes_read", s->peer_rx_fifo_bytes);
+    qdict_put_int(state, "rx_completed", s->peer_rx_completed);
+    QObject *value = QOBJECT(state);
+    visit_type_any(v, name, &value, errp);
+    qobject_unref(value);
+}
+
+static void cc1101_peer_set_frame(Object *obj, Visitor *v, const char *name,
+                                  void *opaque, Error **errp)
+{
+    M5Cc1101SpiState *s = opaque;
+    g_autofree char *hex = NULL;
+    uint8_t frame[CC1101_FIFO_SIZE];
+    size_t chars;
+
+    if (!visit_type_str(v, name, &hex, errp)) {
+        return;
+    }
+    chars = strlen(hex);
+    if ((chars % 2) || chars < 4 || chars > sizeof(frame) * 2) {
+        error_setg(errp, "Invalid CC1101 peer FIFO frame length");
+        return;
+    }
+    for (size_t i = 0; i < chars / 2; i++) {
+        int hi = g_ascii_xdigit_value(hex[2 * i]);
+        int lo = g_ascii_xdigit_value(hex[2 * i + 1]);
+
+        if (hi < 0 || lo < 0) {
+            error_setg(errp, "Invalid CC1101 peer FIFO frame encoding");
+            return;
+        }
+        frame[i] = (hi << 4) | lo;
+    }
+    if (!cc1101_peer_frame_valid(frame, chars / 2)) {
+        error_setg(errp, "Invalid CC1101 peer FIFO length header");
+        return;
+    }
+    if (!cc1101_peer_receive(s, frame, chars / 2)) {
+        error_setg(errp, "CC1101 peer receiver is not armed");
+    }
+}
+
+static void cc1101_peer_reset(void *opaque)
+{
+    cc1101_reset(opaque);
+}
+
+void m5_cc1101_spi_attach_peer(DeviceState *spi, int cs_pin, int gdo0_pin)
+{
+    M5Cc1101SpiState *s = cc1101_attach(spi, cs_pin, gdo0_pin, true);
+    Object *observer = object_new("container");
+
+    object_property_add_child(qdev_get_machine(), "cc1101-peer", observer);
+    object_property_add(observer, "state", "any", cc1101_peer_get_state,
+                        NULL, NULL, s);
+    object_property_add(observer, "rx-frame-hex", "str", NULL,
+                        cc1101_peer_set_frame, NULL, s);
+    object_unref(observer);
+    qemu_register_reset(cc1101_peer_reset, s);
+}
