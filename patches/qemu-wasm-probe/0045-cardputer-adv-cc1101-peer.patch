+static bool cc1101_peer_frame_valid(const uint8_t *frame, size_t size)
+{
+    return size > 1 && size <= CC1101_FIFO_SIZE && frame[0] == size - 1;
+}
+
+static bool cc1101_peer_rx_armed(const M5Cc1101SpiState *s)
+{
+    return s->peer_enabled && s->marc_state == 0x0d && !s->packet_ready;
+}
+
+static bool cc1101_peer_receive(M5Cc1101SpiState *s,
+                               const uint8_t *frame, size_t size)
+{
+    if (!cc1101_peer_frame_valid(frame, size) || !cc1101_peer_rx_armed(s)) {
+        return false;
+    }
+    memcpy(s->rx_fifo, frame, size);
+    s->rx_fifo[size] = 0x80; /* Deterministic RSSI byte. */
+    s->rx_fifo[size + 1] = 0x80; /* CRC OK, deterministic LQI. */
+    s->rx_len = size + 2;
