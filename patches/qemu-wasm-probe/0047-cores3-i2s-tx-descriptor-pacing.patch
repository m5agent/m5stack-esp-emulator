+static bool i2s_decode_standard_tx(M5I2SState *s, uint32_t tx_conf)
+{
+    /* ESP32-S3 TRM §28.6. Standard mode uses two 16-bit wire slots.
+     * In copy-mono mode one enabled slot's DMA sample feeds both wire slots.
+     */
+    static const uint32_t clocks[] = {40000000, 240000000, 160000000, 0};
+    uint32_t conf1 = s->regs[R_TX_CONF1 / 4];
+    uint32_t clkm = s->regs[R_TX_CLKM_CONF / 4];
+    uint32_t div = s->regs[R_TX_CLKM_DIV_CONF / 4];
+    uint32_t tdm = s->regs[R_TX_TDM_CTRL / 4];
+    uint32_t slot_mask = tdm & 0xffff;
+    bool mono = tx_conf & TX_MONO;
+    uint32_t clock = clocks[(clkm >> 27) & 3];
+    uint32_t integer = clkm & 0xff;
+    uint32_t bck_div = ((conf1 >> 7) & 0x3f) + 1;
+    uint32_t x = (div >> 18) & 0x1ff;
+    uint32_t y = (div >> 9) & 0x1ff;
+    uint32_t z = div & 0x1ff;
+    uint32_t fraction_den = 1, fraction_num = 0;
+    uint64_t divisor;
+    uint32_t rate;
+
+    if (!(tx_conf & TX_TDM) || (tx_conf & (TX_PDM | TX_SLAVE)) ||
+        (clkm & (TX_CLK_ENABLE | TX_CLK_ACTIVE)) !=
+            (TX_CLK_ENABLE | TX_CLK_ACTIVE) || !clock || !integer ||
+        ((conf1 >> 13) & 0x1f) != 15 || ((conf1 >> 24) & 0x1f) != 15 ||
+        ((tdm >> 16) & 0xf) != 1) {
+        return false;
+    }
+    if (mono ? !(tx_conf & TX_CHAN_EQUAL) ||
+                   (slot_mask != 1 && slot_mask != 2) : slot_mask != 3) {
+        return false;
+    }
+    if (z) {
+        if (!y || y >= z) {
+            return false;
+        }
+        fraction_den = (x + 1) * z + y;
+        fraction_num = div & TX_CLK_DIV_YN1 ? fraction_den - z : z;
+    } else if (div & TX_CLK_DIV_YN1) {
+        return false;
+    }
+    divisor = ((uint64_t)integer * fraction_den + fraction_num) * bck_div * 32;
+    rate = ((uint64_t)clock * fraction_den + divisor / 2) / divisor;
+    if (rate < 8000 || rate > 192000) {
+        return false;
+    }
+    s->paced_tx_rate = rate;
+    s->paced_tx_frame_bytes = mono ? 2 : 4;
+    return true;
+}
+
+static int64_t i2s_tx_descriptor_period(const M5I2SState *s, uint32_t bytes)
+{
+    if (!bytes || bytes % s->paced_tx_frame_bytes) {
+        return 20 * SCALE_MS;
+    }
+    return (uint64_t)(bytes / s->paced_tx_frame_bytes) * NANOSECONDS_PER_SECOND
+        / s->paced_tx_rate;
+}
+
+static void i2s_paced_tx_timer(void *opaque)
+{
+    M5I2SState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+    int64_t anchor = now;
+    uint32_t channel, desc, bytes;
+    int64_t period;
+
+    if (!s->tx_started) {
+        return;
+    }
+    if (!s->gdma || !esp_gdma_get_channel_periph(s->gdma, GDMA_I2S1,
+                                                ESP_GDMA_OUT_IDX, &channel)) {
+        s->paced_tx_due_ns = 0;
+        timer_mod(s->paced_tx_timer, now + SCALE_MS);
+        return;
+    }
+    desc = esp_gdma_peek_out_descriptor(s->gdma, channel, &bytes);
+    if (s->paced_tx_due_ns && channel == s->paced_tx_channel &&
+        desc == s->paced_tx_desc && bytes == s->paced_tx_desc_bytes) {
+        anchor = s->paced_tx_due_ns;
+        i2s_complete_dma(s, channel);
+        desc = esp_gdma_peek_out_descriptor(s->gdma, channel, &bytes);
+    }
+    period = i2s_tx_descriptor_period(s, bytes);
+    /* Keep phase through ordinary timer jitter. A long host delay must not
+     * replay a burst of queued IRQs into a guest that could not refill GDMA.
+     */
+    s->paced_tx_due_ns = (anchor + period > now ? anchor : now) + period;
+    s->paced_tx_channel = channel;
+    s->paced_tx_desc = desc;
+    s->paced_tx_desc_bytes = bytes;
+    timer_mod(s->paced_tx_timer, s->paced_tx_due_ns);
+}
