+static uint32_t esp_gdma_out_descriptor_addr(DmaConfigState *state)
+{
+    const uint32_t high = (ESP_GDMA_RAM_ADDR >> 20) << 20;
+
+    return state->current_desc_addr ? state->current_desc_addr
+        : high | FIELD_EX32(state->link, GDMA_OUT_LINK, ADDR);
+}
+
+/* Observe the next descriptor without moving the ring or raising an IRQ. */
+uint32_t esp_gdma_peek_out_descriptor(ESPGdmaState *s, uint32_t chan,
+                                     uint32_t *length)
+{
+    DmaConfigState *state = &s->ch_conf[ESP_GDMA_OUT_IDX][chan];
+    uint32_t addr = esp_gdma_out_descriptor_addr(state);
+    GdmaLinkedList desc;
+
+    *length = 0;
+    if (!addr || !esp_gdma_read_descr(s, addr, &desc)) {
+        return 0;
+    }
+    *length = desc.config.length;
+    return addr;
+}
