-static char *m5_panel_logical_orientation_get(Object *obj, Error **errp)
+static bool m5_panel_logical_axes_exchanged(const M5SpiPanelState *s)
 {
-    M5SpiPanelState *s = (M5SpiPanelState *)obj;
     /* CASET/RASET select the next drawing rectangle, not the panel rotation.
      * A small fillRect/text write must not change the presentation. MADCTL.MV
      * exchanges logical axes; glass_rotation accounts for board mounting.
      */
-    bool exchanged = s->apply_madctl && s->vis_w != s->vis_h &&
-                     (!!(s->madctl & 0x20) != !!(s->glass_rotation & 1));
-    return g_strdup(exchanged ? "portrait" : "landscape");
+    return s->apply_madctl && s->vis_w != s->vis_h &&
+           (!!(s->madctl & 0x20) != !!(s->glass_rotation & 1));
+}
+
+static char *m5_panel_logical_orientation_get(Object *obj, Error **errp)
+{
+    return g_strdup(m5_panel_logical_axes_exchanged((M5SpiPanelState *)obj)
+                    ? "portrait" : "landscape");
+}
+
+static void m5_panel_portrait_rotation_get(Object *obj, Visitor *v,
+                                           const char *name, void *opaque,
+                                           Error **errp)
+{
+    M5SpiPanelState *s = (M5SpiPanelState *)obj;
+    int64_t rotation = 0;
+
+    if (m5_panel_logical_axes_exchanged(s)) {
+        /* Follow guest logical +X through MADCTL to memory, then undo the
+         * physical glass-to-memory transform. A positive native Y derivative
+         * needs a positive Z rotation in the viewer (Y up).
+         */
+        uint8_t axis_flip = (s->glass_rotation & 1) ? 0x40 : 0x80;
+        bool memory_axis_reversed = !!(s->madctl & axis_flip);
+        bool glass_axis_reversed = !!(s->glass_rotation & 2);
+        rotation = memory_axis_reversed == glass_axis_reversed ? 90 : -90;
+    }
+    visit_type_int(v, name, &rotation, errp);
 }
 
