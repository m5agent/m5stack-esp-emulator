diff --git a/m5stack/cmodules/lv_binding_micropython/lvgl/src/misc/lv_anim.c b/m5stack/cmodules/lv_binding_micropython/lvgl/src/misc/lv_anim.c
--- a/m5stack/cmodules/lv_binding_micropython/lvgl/src/misc/lv_anim.c
