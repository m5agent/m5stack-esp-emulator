diff --git a/m5stack/components/M5Unified/emulator_hooks.cpp b/m5stack/components/M5Unified/emulator_hooks.cpp
new file mode 100644
index 00000000..64461711
--- /dev/null
+++ b/m5stack/components/M5Unified/emulator_hooks.cpp
@@ -0,0 +1,29 @@
+/*
+ * Host-visible display and touch mailbox for the UIFlow2 ESP32-P4
+ * emulator test build.
+ *
+ * The symbols stay in the firmware ELF so a GDB client can read the
+ * framebuffer pointer and inject touch state without modifying the
+ * public USB/esptool download path.
+ */
+#include <stdint.h>
+
+extern "C" {
+
+uint8_t *m5_emu_framebuffer = nullptr;
+uint32_t m5_emu_framebuffer_width = 0;
+uint32_t m5_emu_framebuffer_height = 0;
+
+/*
+ * [0] down, [1] x, [2] y, [3] touch id, [4] pressure, [5] sequence
+ */
+volatile uint32_t m5_emu_touch_state[8] = {};
+
+/*
+ * Tab5 has no wired Ethernet path, but the shared M5Things/WebREPL sources
+ * still reference this symbol. Keep the emulator build linkable without
+ * changing the production network behavior.
+ */
+bool lan_connected = false;
+
+}
