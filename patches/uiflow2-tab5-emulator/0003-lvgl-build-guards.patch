diff --git a/gen/gen_mpy_atomic.sh b/gen/gen_mpy_atomic.sh
new file mode 100644
index 0000000..b5e98dd
--- /dev/null
+++ b/gen/gen_mpy_atomic.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -u
+
+output=$1
+shift
+temporary="${output}.tmp"
+
+for attempt in 1 2 3; do
+    if "$@" > "${temporary}" && [[ -s "${temporary}" ]]; then
+        mv "${temporary}" "${output}"
+        exit 0
+    fi
+    sleep 1
+done
+
+rm -f "${temporary}"
+exit 1
