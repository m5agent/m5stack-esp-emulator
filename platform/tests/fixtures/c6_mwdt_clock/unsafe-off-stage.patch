--- a/hw/timer/esp_timg.c
+++ b/hw/timer/esp_timg.c
@@ -222,10 +222,7 @@
     wdt->counter.value = 0;
     wdt->source_cycles = 0;
     wdt->source_fraction = 0;
-    /* A zero hold must still wait for a synchronous MWDT counter edge.
