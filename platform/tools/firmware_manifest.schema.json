{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://m5stack.local/schemas/firmware-manifest-v1.json",
  "title": "M5Stack Firmware Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "artifact",
    "target",
    "security",
    "provenance",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "m5stack-firmware-manifest"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "size",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "merged-flash",
            "segmented-flash"
          ]
        },
        "file": {
          "type": "string"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_size": {
          "type": "integer",
          "minimum": 0
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "padded": {
          "type": "boolean"
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offset",
              "file",
              "size",
              "sha256"
            ],
            "properties": {
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "file": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "declared_integrity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "algorithms",
                  "weak_digest"
                ],
                "properties": {
                  "status": {
                    "const": "verified"
                  },
                  "algorithms": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "size",
                        "sha256",
                        "sha1",
                        "md5"
                      ]
                    }
                  },
                  "weak_digest": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soc",
        "flash_size"
      ],
      "properties": {
        "soc": {
          "type": [
            "string",
            "null"
          ]
        },
        "chip_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "flash_size": {
          "type": "integer",
          "minimum": 1
        },
        "psram_size": {
          "type": [
            "integer",
            "null"
          ]
        },
        "partition_table": {
          "type": "object"
        },
        "application": {
          "type": [
            "object",
            "null"
          ]
        },
        "filesystems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "permission_policy": {
                      "$ref": "#/$defs/filesystem_permission_policy"
                    }
                  }
                }
              },
              "permission_model": {
                "$ref": "#/$defs/filesystem_permission_model"
              },
              "permission_summary": {
                "$ref": "#/$defs/filesystem_permission_summary"
              },
              "directory_permissions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "permission_policy": {
                      "$ref": "#/$defs/filesystem_permission_policy"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "secure_boot",
        "flash_encryption",
        "efuse"
      ],
      "properties": {
        "secure_boot": {
          "enum": [
            "unknown",
            "disabled",
            "not-indicated",
            "v1",
            "v2",
            "enabled-unspecified"
          ]
        },
    "secure_boot_image": {
      "type": "object",
      "required": [
        "status",
        "signature_authenticity",
        "trust_root",
        "images"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-found",
            "signed-image-observed",
            "invalid"
          ]
        },
        "signature_authenticity": {
          "const": "not-verified"
        },
        "trust_root": {
          "const": "not-verified"
        },
        "images": {
          "type": "array"
        }
      }
    },
        "trust_root": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "comparison",
            "source",
            "matching_pairs",
            "not_claimed"
          ],
          "properties": {
            "status": {
              "const": "not-verified"
            },
            "comparison": {
              "enum": [
                "not-applicable",
                "efuse-summary-not-included",
                "efuse-key-digest-unavailable",
                "match-unverified-source",
                "mismatch-unverified-source"
              ]
            },
            "source": {
              "enum": [
                "package-espefuse-json-unverified",
                "not-included"
              ]
            },
            "matching_pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "image",
                  "public_key_digest_sha256"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "minLength": 1
                  },
                  "public_key_digest_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "not_claimed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "anti_rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "comparison",
            "source",
            "image_secure_version",
            "efuse_secure_version",
            "not_claimed"
          ],
          "properties": {
            "status": {
              "const": "not-verified"
            },
            "comparison": {
              "enum": [
                "image-secure-version-unavailable",
                "efuse-summary-not-included",
                "efuse-secure-version-unavailable",
                "image-below-efuse-unverified-source",
                "image-satisfies-efuse-unverified-source"
              ]
            },
            "source": {
              "enum": [
                "package-espefuse-json-unverified",
                "not-included"
              ]
            },
            "image_secure_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "efuse_secure_version": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "not_claimed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "flash_encryption": {
          "enum": [
            "unknown",
            "disabled",
            "not-indicated",
            "partition-encryption-marked",
            "enabled"
          ]
        },
        "efuse": {
          "type": "string"
        },
        "secure_boot_config": {
          "enum": [
            "unknown",
            "disabled",
            "not-indicated",
            "v1",
            "v2",
            "enabled-unspecified"
          ]
        },
        "flash_encryption_config": {
          "enum": [
            "unknown",
            "disabled",
            "not-indicated",
            "enabled"
          ]
        },
        "efuse_summary": {
          "type": [
            "object",
            "null"
          ]
        },
        "secure_version": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "importer",
        "source_format"
      ],
      "properties": {
        "importer": {
          "type": "string"
        },
        "source_format": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "firmware_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "elf": {
          "$ref": "#/$defs/resource"
        },
        "map": {
          "$ref": "#/$defs/resource"
        },
        "sdkconfig": {
          "$ref": "#/$defs/resource"
        },
        "flasher_args": {
          "$ref": "#/$defs/resource"
        },
        "sbom": {
          "$ref": "#/$defs/resource"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "detected": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "source",
              "flag"
            ],
            "properties": {
              "capability": {
                "type": "string"
              },
              "source": {
                "const": "sdkconfig"
              },
              "flag": {
                "type": "string"
              }
            }
          }
        },
        "observed": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability",
              "source",
              "confidence",
              "signatures"
            ],
            "properties": {
              "capability": {
                "type": "string"
              },
              "source": {
                "const": "image-signature"
              },
              "confidence": {
                "const": "low"
              },
              "signatures": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            }
          }
        },
        "observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "source",
            "bytes_total",
            "bytes_scanned",
            "truncated"
          ],
          "properties": {
            "status": {
              "enum": [
                "SCANNED",
                "TRUNCATED"
              ]
            },
            "source": {
              "const": "normalized-flash"
            },
            "bytes_total": {
              "type": "integer",
              "minimum": 1
            },
            "bytes_scanned": {
              "type": "integer",
              "minimum": 1
            },
            "truncated": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "source_license_scan": {
      "$ref": "#/$defs/source_license_scan"
    },
    "license_policy": {
      "$ref": "#/$defs/license_policy"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "REJECTED"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "coverage",
        "urls",
        "encoded_blobs",
        "findings",
        "sbom",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "CLEAN",
            "REVIEW_REQUIRED"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": true
        },
        "urls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "scheme",
              "host",
              "url_sha256",
              "path_sha256",
              "offset",
              "length"
            ]
          }
        },
        "encoded_blobs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "encoding",
              "entropy",
              "length",
              "offset",
              "sha256"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "code",
              "category",
              "severity",
              "message"
            ]
          }
        },
        "sbom": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "status",
            "format",
            "spec_version",
            "component_count",
            "licenses"
          ]
        },
        "limits": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "license_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "decision",
        "allowed_licenses",
        "denied_licenses",
        "discovered_licenses",
        "sources",
        "findings",
        "coverage",
        "limits"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "PASS",
            "REVIEW_REQUIRED",
            "REJECTED"
          ]
        },
        "decision": {
          "enum": [
            "allowlisted",
            "review",
            "rejected"
          ]
        },
        "allowed_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "denied_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "discovered_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "license"
            ],
            "properties": {
              "source": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "code",
              "severity",
              "message"
            ]
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": true
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "size",
        "sha256"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "filesystem_permission_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "model",
        "unix_mode",
        "runtime_enforcement"
      ],
      "properties": {
        "source": {
          "enum": [
            "fat-directory-entry",
            "filesystem-metadata"
          ]
        },
        "model": {
          "enum": [
            "fat-attributes",
            "none"
          ]
        },
        "unix_mode": {
          "enum": [
            "not-applicable",
            "not-recorded"
          ]
        },
        "read_only_attribute": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "hidden": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "system": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "archive": {
          "type": [
            "boolean",
            "string"
          ]
        },
        "runtime_enforcement": {
          "enum": [
            "not-proven"
          ]
        }
      }
    },
    "filesystem_permission_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "unix_mode",
        "runtime_enforcement",
        "claim"
      ],
      "properties": {
        "kind": {
          "enum": [
            "fat-attributes",
            "none"
          ]
        },
        "source": {
          "enum": [
            "fat-directory-entry",
            "filesystem-metadata"
          ]
        },
        "unix_mode": {
          "enum": [
            "not-applicable",
            "not-recorded"
          ]
        },
        "runtime_enforcement": {
          "enum": [
            "not-proven"
          ]
        },
        "claim": {
          "type": "string"
        }
      }
    },
    "filesystem_permission_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "files_with_policy",
        "unix_mode_recorded",
        "fat_read_only_attribute_count",
        "fat_hidden_count",
        "fat_system_count",
        "model",
        "runtime_enforcement"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "files_with_policy": {
          "type": "integer",
          "minimum": 0
        },
        "unix_mode_recorded": {
          "type": "integer",
          "minimum": 0
        },
        "fat_read_only_attribute_count": {
          "type": "integer",
          "minimum": 0
        },
        "fat_hidden_count": {
          "type": "integer",
          "minimum": 0
        },
        "fat_system_count": {
          "type": "integer",
          "minimum": 0
        },
        "model": {
          "enum": [
            "fat-attributes",
            "none"
          ]
        },
        "runtime_enforcement": {
          "enum": [
            "NOT RUN"
          ]
        }
      }
    },
    "source_license_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "method",
        "files",
        "limits",
        "coverage",
        "not_claimed"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "enum": [
            "PASS",
            "PARTIAL",
            "NOT_PROVIDED"
          ]
        },
        "method": {
          "const": "bounded-source-spdx-header-scan"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "size",
              "sha256",
              "declared_licenses"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "path_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "redacted": {
                "type": "boolean"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "declared_licenses": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "limits": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        },
        "not_claimed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "requirement": {},
        "available": {},
        "path": {
          "type": "string"
        }
      }
    }
  }
}
