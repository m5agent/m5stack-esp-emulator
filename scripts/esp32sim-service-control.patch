+    fn schedule_encoder(&mut self, delta: i32, step: u64) -> bool {
+        let Some((clk, dt)) = self.bus.board_ref().encoder() else { return false };
+        let mut cycle = (self.bus.cycles() + step).max(self.script.knob_next);
+        for _ in 0..delta.unsigned_abs() {
+            for (phase, (pin, level)) in Self::quadrature(clk, dt, delta > 0).into_iter().enumerate() {
+                self.script.events.push((cycle, ScriptAction::EncoderEdge {
+                    pin, level, phase, direction: i64::from(delta.signum()),
+                }));
+                cycle += step;
+            }
+            cycle += step * 4;
+        }
+        self.script.knob_next = cycle;
+        self.script.encoder.target += i64::from(delta);
+        self.script.events[self.script.pos..].sort_by_key(|event| event.0);
+        true
+    }
+
     fn service_schedule(&mut self, hold_ms: u32, action: ScriptAction) {
         let until = self.bus.cycles().saturating_add(u64::from(hold_ms) * (S::CPU_HZ / 1000));
         self.script.events.push((until, action));
