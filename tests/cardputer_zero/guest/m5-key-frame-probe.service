[Unit]
Description=CardputerZero emulator key and framebuffer probe
After=systemd-user-sessions.service m5-probe.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/m5-key-frame-probe
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
